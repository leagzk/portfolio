---
import Base from '../layouts/Base.astro';
import '../styles/case-study.css';
import Banner from '../components/Banner.astro';
import PageIntro from '../components/PageIntro.astro';
import Tenet from '../components/Tenet.astro';
import Carousel from '../components/Carousel.astro';
import ChapterTabs from '../components/ChapterTabs.astro';
import Equations from '../components/Equations.astro';
import Dots from '../components/Dots.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { sommaire } from '../lib/chapitres';
import { chercheurImages } from '../lib/images';
import IdeaVisual from '../assets/elements-system/idea-visual.svg';
import ConsumerVisual from '../assets/elements-system/consumer-visual.svg';
import ContributorVisual from '../assets/elements-system/contributor-visual.svg';
import MaintainerVisual from '../assets/elements-system/maintainer-visual.svg';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
  Les chapitres, en un seul endroit.

  Ils alimentent deux choses a la fois : les onglets lateraux (<ChapterTabs>) et
  les surtitres de section. Ecrits deux fois, le numero et l'ancre auraient
  derive des la premiere reorganisation - et une navigation qui pointe a cote
  est pire qu'une absence de navigation. Le numero n'est d'ailleurs plus ecrit
  du tout : il vient du rang dans le tableau, donc reordonner renumerote.

  `onglet` est ecrit pour TOUS les chapitres, meme quand il repete le titre :
  les deux ne suivent pas la meme regle. Le surtitre est une phrase de section
  et garde son article - « 01 - The results ». L'onglet est une etiquette de
  sommaire : pas d'article, meme forme partout, et le plus court possible parce
  que c'est lui qui decide si les huit ancres tiennent dans la barre sur mobile.
  Les laisser retomber sur `titre` par defaut aurait fait cohabiter les deux
  regles dans la meme liste sans que ca se voie.
*/
const chapitres = [
  { id: 'ch-results',      titre: 'The results',                  onglet: 'Results' },
  { id: 'ch-stakes',       titre: 'The stakes',                   onglet: 'Stakes' },
  { id: 'ch-problem',      titre: 'The problem',                  onglet: 'Problem' },
  { id: 'ch-failure',      titre: 'The failure, and the decision', onglet: 'Failure' },
  { id: 'ch-owned',        titre: 'What I owned',                 onglet: 'What I owned' },
  { id: 'ch-architecture', titre: 'The architecture',             onglet: 'Architecture' },
  { id: 'ch-community',    titre: 'The community',                onglet: 'Community' },
  { id: 'ch-next',         titre: "Where I'd take it next",       onglet: "What's next" },
];

/* Surtitre d'un chapitre : « 05 - What I owned ». Le numero vient du rang, donc
   reordonner renumerote ; un id inconnu jette au lieu de vider un surtitre.
   Voir src/lib/chapitres.ts. */
const { surtitre: chap } = sommaire(chapitres);

/*
  Meme convention que system-event : le glob resout les images a la compilation,
  donc un nom errone casse le build au lieu de produire un 404 silencieux.
*/
const fichiers = import.meta.glob<ImageMetadata>('../assets/elements-system/*.webp', {
  eager: true,
  import: 'default',
});
const img = chercheurImages(fichiers, 'elements-system');

/*
  Les trois axes de la plateforme. La ligne `tension` n'est pas une legende :
  c'est elle qui porte le propos - un tableau dirait « categories paralleles »,
  alors que le sujet est qu'elles se connectent.
*/
const capacites = [
  { axe: 'Brand × Product', titre: 'Corporate Experience',
    description: 'The Sanofi brand expressed across corporate and marketing surfaces: identity, theming, multi-brand coherence.',
    tension: 'Where the brand becomes tangible.' },
  { axe: 'Brand × Product', titre: 'Product Foundations',
    description: 'The mandatory building blocks of every experience: principles, accessibility, grids, spatial system, motion, data visualisation, theming.',
    tension: 'The digital non-negotiables.' },
  { axe: 'System', titre: 'Design System',
    description: 'The reusable, scalable foundation: token architecture, component libraries, integrated guidelines, engineering standards.',
    tension: 'From token to production.' },
  { axe: 'System', titre: 'Experience Patterns',
    description: 'Standardized but flexible design and interaction patterns: from internal AI-driven tooling to marketing interfaces, business-specific.',
    tension: 'Learn once, apply everywhere.' },
  { axe: 'People', titre: 'Practitioner Experience',
    description: 'The service layer around the people who use and contribute to the system: tiered service model, onboarding, unified tooling, rituals, academy.',
    tension: 'The humans who use it, and those who craft it.' },
  { axe: 'People', titre: 'Community of Practice',
    description: 'The governance and culture that turn contribution into practice: inner source model, contribution pathways, shared rituals, practice leadership.',
    tension: 'The humans who grow it.' },
];

/*
  Les quatre captures forment une suite rhetorique, portee par les titres
  incrustes dans les images : « You may think it is a Figma library », puis les
  produits, les fils de discussion, l'equipe. L'ordre du tableau EST l'argument -
  le reordonner casse la phrase.
*/
const facettes = [
  { src: img('elements-library'), caption: 'Libraries',
    alt: "Figma library screens: a Sanofi navigation bar, buttons, form controls, a data table and a date picker, shown in light and dark mode" },
  { src: img('elements-digitalproducts-implementation'), caption: 'Product Implementation',
    alt: "Two Sanofi products in production - a component explorer on a laptop and a public campaign page on a desktop screen - with a mobile study card in front" },
  { src: img('elements-support'), caption: 'Integrated support',
    alt: "Two phone screens side by side: a question answered in the Elements Slack community, and a GitHub issue on the design system component library" },
  { src: img('elements-team'), caption: 'Global team',
    alt: "Portraits of the team arranged over a world map, showing how widely its members are spread" },
];

/*
  Les sept produits, dans l'ordre de la chaine design -> dev. L'ordre EST la
  these : on part des tokens et on finit sur la vitrine, sans qu'aucun relais
  n'attende un humain. Le reordonner casse la demonstration du ÷3.
*/
const produits = [
  { nom: 'Token architecture', note: 'multi-brand, multi-theme, multi-surface' },
  { nom: 'Libraries', note: 'Figma and React, hosted on GitHub' },
  { nom: 'Figma Companion', note: 'palettes, accessibility checks, layout scaffolding directly from the canvas' },
  { nom: 'Storybook', note: 'source of truth, living, versioned documentation' },
  { nom: 'Elements MCP', note: 'integrated into AI design and engineering workflows' },
  { nom: 'Integrated support channels', note: 'Slack and Teams streams with automation layers' },
  { nom: 'Elements Portal', note: 'showcase website' },
];

/* Terme = suite. Le renversement est le sujet, d'ou le traitement en bandeau. */
const mecanismes = [
  { terme: 'Rigour', suite: 'nothing ships on a hunch.',
    note: "No component, no roadmap line ever shipped without discovery: what the ecosystem actually needs, what already exists. Then one shared convention, written down - so the standard isn't a review at the end, it's the default at the start." },
  { terme: 'Responsibility', suite: 'the floor, not the reach.',
    note: 'WCAG AA as the Sanofi digital standard, not our own bar. Full library audited to 100% before our first major, then held there - so no product team paid the cost downstream.' },
  { terme: 'Ethics', suite: 'a constraint nobody asked me to keep.',
    note: 'When AI entered the strategy, I set the line before we built: pragmatic where it accelerates the craft, absolute where it would decide for a human, quality guardrails non-negotiable throughout. Not everyone draws it. I do.' },
];

/*
  Les quatre resultats. `pose` place la carte au bureau ; sous 1024px le
  conteneur devient un rail et ces valeurs sont neutralisees par le CSS.
*/
const resultats = [
  { pose: 'left:0%;top:8px;--rot:-3deg',
    chiffre: '100%', quoi: 'adoption across the 3 Digital Accelerators',
    detail: 'R&D, Commercial, Manufacturing. Every product in the perimeter runs on Elements.',
    lien: { href: 'https://jobs.sanofi.com/fr/digital-accelerator', label: 'Discover more' } },
  { pose: 'left:26%;top:96px;--rot:2deg',
    chiffre: '86%', quoi: 'average component usage per product',
    detail: 'Adopted, and depended on: when a team builds on Elements, 86% of their live interface is the system. The cost-rationalization bet, paid - teams build on it, not around it.' },
  { pose: 'left:52%;top:0px;--rot:-1.5deg',
    chiffre: '÷3', quoi: 'time-to-launch on strategic launches',
    detail: 'Like Beyfortus®. The wait between experts, removed. What used to take a handoff chain now ships in seconds - accessible, responsive, on-brand by default.' },
  { pose: 'left:74%;top:80px;--rot:3deg',
    chiffre: '35+', quoi: 'contributors, from zero, in 18 months',
    detail: 'Inner source, not headcount - the system grows because people own it, not because I staffed it.' },
];

/*
  Le faisceau de preuves du chapitre 07, dans le meme dispositif que les
  resultats. Trois differences avec `resultats`, qui justifient le type explicite :

  - le ton est NOMME et non deduit du rang. Les resultats sont quatre chiffres
    interchangeables, ou coupler la couleur a l'index est sans risque ; ici la
    serie melange un chiffre, deux affirmations et un visuel, et reordonner le
    propos ne doit pas reordonner les couleurs avec lui.
  - une carte peut n'avoir aucun chiffre. C'est alors la phrase qui porte le
    poids visuel, d'ou le corps plus grand pose par `--say`.
  - une carte peut n'etre qu'un visuel, sans texte ni gouttiere.
*/
type Preuve = {
  /** placement au bureau ; neutralise par le CSS sous 1024px, comme `resultats` */
  pose: string;
  ton?: 'red' | 'ink';
  chiffre?: string;
  /** exposant du chiffre, a l'echelle de « /5 » */
  suffixe?: string;
  titre?: string;
  detail?: string;
  /*
    Pastille ronde dans l'angle bas-droit. Booleen et non chaine : c'etait un
    emoji, c'est desormais un dessin au trait unique a cette carte - il n'y a
    donc plus rien a passer, seulement a dire si la pastille est la.
    Purement decoratif, d'ou aria-hidden a la pose.
  */
  badge?: boolean;
  /** carte-visuel : l'image occupe toute la carte, sans texte */
  image?: { src: ImageMetadata; alt: string };
};
const preuves: Preuve[] = [
  { pose: 'left:0%;top:16px;--rot:-2.5deg',
    chiffre: '4.7', suffixe: '/5', titre: 'practitioner satisfaction',
    detail: "People don't comply with Elements, they trust it." },
  /* les deux phrases dans `titre` et non l'une en `detail` : la chute porte
     autant que l'amorce, la reduire au corps de legende l'aurait desamorcee */
  { pose: 'left:26%;top:104px;--rot:2.5deg', ton: 'red',
    titre: "The MCP didn't come from my roadmap initially. It came from a contributor.",
    badge: true },
  { pose: 'left:52%;top:0px;--rot:-1.5deg',
    image: { src: img('design-community'),
      alt: 'The design community gathered outside in front of the Arc de Triomphe in Paris, fifteen practitioners posing together on a winter afternoon' } },
  { pose: 'left:74%;top:92px;--rot:3deg', ton: 'ink',
    titre: 'Not a system people obey - one they own.',
    detail: "That's what growing a culture means." },
];
---
<Base title="Elements - Léa Giezek"
  description="At global scale, a system isn't managed - it's governed. Building Sanofi's experience system: 45+ products, a €1M budget, 0 to 35+ contributors, and a Design System Awards governance finalist."
  current="system-practice-elements" noindex>

<!-- ═══ 00 · HOOK ═══ -->
  <div class="card">
    <Banner home>
      <p class="banner__standards">At global scale a system isn't managed, it's governed</p>
      <span class="banner__culture" style="--culture-size:17cqw" aria-hidden="true">Governance.</span>
    </Banner>

    <PageIntro eyebrow="Elements - Sanofi global experience system">
      <p class="p-intro__lead">At Sanofi, I built Elements to remove the frictions between experts, reduce time to launch and enhance product experience at scale. Moving then from a design system as a product to one platform, one pipeline, brand and product and engineering pouring into the same chain.</p>

      <p class="p-intro__lead">But the external recognition that means the most to me is the category we were named in at the <b>global Design System Awards 2025: Governance, finishing finalist alongside HP and Tesco.</b> Because this was never only a craft story. It was a leadership one. Starting back in 2022 as Design Lead, managing today the platform as the Director.</p>

    </PageIntro>
  </div>

  <ChapterTabs chapitres={chapitres} />


<!-- ═══ 01 · THE RESULTS — remonte en tete : la preuve avant l'argument ═══ -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-results">
    <div class="ls-head">
      <p class="ls-eyebrow"><span>{chap('ch-results')}</span></p>
      <h2 class="ls-title" id="ch-results">A structure only counts if it holds.</h2>
      {/* la reponse au titre, remontee du corps : c'est la relance du chapitre,
          pas un paragraphe parmi trois - meme place que sur /system-event */}
      <p class="ls-lede">This one does - and the numbers are the system's, not mine.</p>
    </div>

    <div class="ls-body ls-body--wide">
      <p>It started with a bold call: switching a role to embrace a new direction, and selling it to my Head of Design to win the sponsorship it needed. From there - <b>zero users to a community of 2000+ practitioners</b>, and a system built to rest in many hands, never mine alone.</p>
      <p>I set the direction, carried it to leadership, then handed my team the operational goal as OKRs of their own - always tied to the company's annual business objectives, so our ambition lived inside a shared project, never beside it.</p>
    </div>

    {/* Cartes manipulables au-dela de 1024px, rail a snap en dessous. Aucune
        n'est exclue du selecteur de drag : contrairement aux tuiles de l'accueil,
        celui-ci a vraiment des cartes a deplacer. */}
    {/*
      .el-figs-wrap n'est pas decoratif : il porte le rythme vertical du bloc, et
      c'est lui qui rallume les pastilles sous 1024px (`.el-figs-wrap .dots`).
      Sans lui le carrousel reste navigable, mais muet - aucun repere de position.
    */}
    <div class="el-figs-wrap">
      <div class="el-figs" id="elfigs">
        {resultats.map((r, i) => (
          <div class:list={['el-fig-card', `el-fig-card--${i + 1}`]} style={r.pose}>
            <p class="el-fig__n">{r.chiffre}</p>
            <p class="el-fig__q">{r.quoi}</p>
            <p class="el-fig__l">{r.detail}</p>
            {r.lien && (
              <ExternalLink href={r.lien.href} class="el-fig__cta">{r.lien.label}</ExternalLink>
            )}
          </div>
        ))}
      </div>
      <Dots id="elfigdots" count={resultats.length} label="Results" itemLabel="Result" />
    </div>

    <p class="ls-claim ls-claim--big">Adopted. Trusted. Extended.<br><b>Everything a system needs to outlive the person who built it.</b></p>

    <div class="ls-body ls-body--wide">
      <p><b>And none of it was measured after the fact.</b> I ran the platform on live instruments, read as decisions and not trophies: DORA metrics reviewed every sprint for delivery health, a practitioner satisfaction survey at least twice a year, product priorities re-reviewed quarterly against the business's own priorities, and end-of-session feedback from every community ritual.</p>
      <p>The data didn't prove the work was good. It told me where to invest, what to deprecate, and which product needed support next - and it changed how we worked: we iterated our whole support model on it, reshaped the rituals, and introduced rotating roles because the signal told us to.</p>
    </div>
  </section>

<!-- ═══ 02 · THE STAKES ═══ -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-stakes">
    <div class="ls-head">
      <p class="ls-eyebrow"><span>{chap('ch-stakes')}</span></p>
      <h2 class="ls-title" id="ch-stakes">One global and unified system.</h2>
    </div>

    <div class="ls-body ls-body--wide">
      <p>Elements is Sanofi's unified experience system - <b>one design language</b> serving digital products and delivery platforms globally, from B2B and B2C platforms to internal tools, across products, brands and themes.</p>
      <p>Some of those platforms carry hundreds of surfaces on their own - <b>one marketing platform alone owns the delivery of 200+ websites worldwide.</b> Systematize at the source, and you reach every one of them at once.</p>
    </div>

    {/*
      depart 0 et non 1 comme sur /system-event : ces quatre vignettes se lisent
      dans l'ordre - « you may think it is a Figma library », puis les produits,
      les fils, l'equipe - et ouvrir sur la deuxieme couperait la phrase.
      sizes : la hauteur est plafonnee a 440px et le ratio est 16/9, donc une
      vignette approche 780px de large, trois fois la valeur par defaut.
      Trois clauses parce qu'il y a trois regimes : hauteur plafonnee au-dela de
      900px, hauteur encore fluide entre 721 et 899 (~70vw de large a ce ratio),
      puis `wide` qui reprend la main sous 720px et cale la largeur sur l'ecran.
    */}
    <Carousel id="elfacettes" label="What Elements is" itemLabel="Facet"
      start={0} sizes="(min-width: 900px) 780px, (min-width: 721px) 70vw, 84vw" wide slides={facettes} />

    <p class="ls-sub el-after-fig">That's the scope that makes the stakes real.<br><b>A system this size is two bets in one.</b></p>

    <div class="ls-body ls-body--wide">
      <p><b>Cost rationalization</b> first, by mutualizing practice so every product team doesn't rebuild the same thing 45 times. Second, <b>experience at scale</b>: one coherent journey across every user touchpoint. Service design for an entire organization, from employee to patient.</p>
      <p>Both bets only pay if the system is adopted. A system nobody trusts is the worst of both worlds: you fund the platform <em>and</em> the fragmentation it was meant to erase - while the experience stays broken touchpoint by touchpoint. And at this scale, every lost hour of velocity is lost across all of them at once.</p>
    </div>

    <p class="ls-cap el-scope">Multi-brand · multi-theme · B2B / B2C / internal · from employee to patient · worldwide</p>
  </section>

<!-- ═══ 03 · THE PROBLEM ═══ -->
  {/*
    Traite au layout de /philosophy : les trois mouvements deviennent des Tenet,
    donc ce sont eux qui portent les <h2>. La section n'a plus de .ls-title - elle
    est etiquetee par aria-label, exactement comme .creed sur philosophy.
  */}
  <section class="ls-chapter ls-reveal" id="ch-problem" aria-label="The problem">
    <div class="ls-head">
      <p class="ls-eyebrow"><span>{chap('ch-problem')}</span></p>
    </div>

    <div class="el-creed">
      <Tenet num="01" title="Nobody meets.">
        <p>A designer ships a spec. An engineer rebuilds it from scratch. A marketer briefs an agency for a palette the system already had. That's the tax. <b>Not incompetence - distance.</b> Three crafts, three silos, each solving in private what the others had already solved. And it wasn't one handoff, it was the whole ecosystem.</p>
      </Tenet>

      <Tenet num="02" title="The what was fragmented.">
        <p>An ecosystem of products and touchpoints that didn't share a language, built on assets that didn't connect. Augmenting <b>design and engineering debts</b>, for every new product launch, at global scale.</p>
      </Tenet>

      <Tenet num="03" title="The how was worse.">
        <p>Practices siloed team by team, none standardized. Everyone solving the same problems privately, in parallel, paying the same cost forty-five times over. This is where time goes. Not into the work - into the gaps between people redoing what already exists. Meanwhile the system itself can ship in seconds, digital constraints built in: accessible, responsive, on-brand by default. <b>The capability was there. The structure to use it wasn't.</b></p>
      </Tenet>
    </div>
  </section>

<!-- ═══ 04 · THE FAILURE — bloc sombre, le coeur emotionnel ═══ -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-failure">
    <div class="card ls-dark">
      <div class="ls-dark__inner">
        <p class="ls-eyebrow ls-eyebrow--light"><span>{chap('ch-failure')}</span></p>
        <h2 class="ls-title" id="ch-failure">You can't outsource the thing your whole system depends on.</h2>

        <div class="ls-body ls-body--light">
          <p>That's the lesson. Here's the half I don't get to blame on anyone else.</p>
          <p>The engineering was externalized before my time - not my call. But <b>the early bet I shared, and got wrong, was priority.</b> Sanofi's rebranding was a massive effort, and we poured the roadmap into brand alignment - a beautifully unified, on-brand system. Piloted on sanofi.com, we were boxed into its framework, and we quietly deprioritized what product teams actually needed.</p>
          {/* le lien vit dans un <p> et non nu entre deux paragraphes : .ls-body
              espace ses blocs avec `p + p`, et un <a> intercale ferait perdre sa
              marge haute au paragraphe suivant */}
          <p class="ls-dark__rule"><a class="btn3" href="/system-brand">Deep dive in the origin story <span class="btn3__i">→</span></a></p>
          <p>So the system was coherent, and barely adopted. It took me too long to see it: we'd built it brand-first and at arm's length - for the brand, and through a vendor, but not for the people who had to build on it. <b>A design system nobody adopts is the oldest failure in the field</b> - and we'd walked straight into it.</p>
          <p>So I stopped fixing the output and fixed both sources. I pushed to internalize engineering - inside Sanofi, one team, one objective: adoption. And I led the rebuild from zero - design foundations, Figma kit, React repos - this time from a holistic view of the whole portfolio and the experience it had to serve. Brand <em>and</em> product, connected, because I'd learned what it costs to choose one.</p>
          <p>It wasn't the safe path. Internalizing means owning the budget, the hiring, the reorg - <b>a €1M bet on a model, not a line item.</b> I drove it, and I carried it through.</p>
        </div>

        <p class="el-lesson">The best architecture I built started as the one I got backwards.</p>
      </div>
    </div>
  </section>

<!-- ═══ 05 · WHAT I OWNED ═══ -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-owned">
    <div class="ls-head">
      <p class="ls-eyebrow"><span>{chap('ch-owned')}</span></p>
      <h2 class="ls-title" id="ch-owned">The decision was the easy part.</h2>
      <p class="ls-lede"><b>A decision is easy to claim - owning it isn't.</b> I didn't just call for internalization; I carried everything that came after.</p>
    </div>

    {/*
      Etait un registre <dl> - « The money », « The people », « The structure »...
      chaque poste etiquete et defini. La prose remplace les etiquettes : ce qui
      etait un inventaire de perimetres devient le recit de ce qu'il a fallu
      trancher, et l'ordre porte desormais l'argument (batir, puis gouverner,
      puis parier) la ou le registre laissait choisir son entree.
    */}
    <div class="ls-body ls-body--wide">
      <p>I designed the target org - its capabilities, its roles, one operating model - and wrote the job descriptions that made it real. Then I hired into them: from one designer to the roles the system needed, and a Practitioner Experience capability I scoped, defined and staffed from nothing. The budget came with it, and the line between what the platform funded and what it shipped was mine to draw.</p>
      <p>Governance was where I refused the easy answer. Two models, not one. A <b>hybrid, federated model</b> for how the system gets built - a centralized core my team owned, contribution opened outward through inner source, never fully federated: that's the trap. And a <b>tiered service model</b> for how support got prioritized, weighted by each product's place in the Sanofi portfolio and re-reviewed quarterly against the business's own priorities - so support followed strategy, not the loudest request.</p>
      <p><b>Scaling is a series of bets, and I refused to place them blind.</b> Every decision got the same reading: what it opened, what it exposed, what it cost to reverse. I surfaced them rather than waiting for them to surface - then locked each one with the team or my stakeholders, so no bet was mine alone to carry once it was made.</p>
    </div>

    {/* pas de <br> ici, contrairement aux autres .ls-claim de la page : les deux
        phrases s'enchainent, elles ne se repondent pas de part et d'autre d'une
        cesure. Le retour a la ligne vient de la mesure (30ch), pas du markup. */}
    <p class="ls-claim ls-claim--head">This is the layer no contributor can claim. <b>Not the components - the conditions.</b></p>
  </section>

<!-- ═══ 06 · THE ARCHITECTURE — quatre mouvements ═══ -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-architecture">
    <div class="ls-head">
      <p class="ls-eyebrow"><span>{chap('ch-architecture')}</span></p>
      <h2 class="ls-title" id="ch-architecture">You maintain a design system. You run a platform.</h2>
    </div>

    <!-- 6a · trois axes -->
    <div class="ls-body ls-body--wide">
      <p>Elements isn't a single product anymore. <b>It's a platform</b> - several products under one governance, one pipeline, for one community. Three axes, six capabilities. And the tension is the point: they aren't parallel axes; each one only works because the other two hold their end.</p>
    </div>

    {/*
      Meme anatomie que .case sur l'accueil : bandeau colore + corps blanc.
      Pas de composant partage pour autant - .case porte un href et rend toute
      la carte cliquable via .btn3::after ; un axe ne mene nulle part. Ce qui se
      partage, ce sont les tokens (--accent, --r-lg, --edge), pas le markup.
    */}
    <div class="el-axes-wrap">
      <ul class="el-axes" id="elaxes">
        {capacites.map((c) => (
          <li class="el-axis">
            <div class="el-axis__top">
              <span class="el-axis__eyebrow">{c.axe}</span>
              <span class="el-axis__name">{c.titre}</span>
            </div>
            <div class="el-axis__body">
              <p class="el-axis__desc">{c.description} <b>{c.tension}</b></p>
            </div>
          </li>
        ))}
      </ul>
      <Dots id="elaxesdots" count={capacites.length} label="Capabilities" itemLabel="Capability" />
    </div>

    <!-- 6b · le pipeline -->
    {/* La direction est passee dans le titre. Elle vivait avant dans un
        « design → dev » separe, hors du rail pour qu'il ne defile pas avec lui :
        une ligne de plus a placer, et une fleche qui mentait des que la chaine
        passait a la verticale. Dans le titre elle ne peut plus se desolidariser
        de ce qu'elle annonce. */}
    <h3 class="ls-sub el-movement">Seven products, one pipeline from design to dev.</h3>
    <ol class="el-pipe" aria-label="The seven products of the platform, from design to dev">
      {produits.map((p, i) => (
        <li class="el-pipe__node">
          <span class="el-pipe__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="el-pipe__name">{p.nom}</span>
          <span class="el-pipe__note">{p.note}</span>
        </li>
      ))}
    </ol>

    <div class="ls-body ls-body--wide">
      <p><b>The pipeline is the thesis made physical.</b> Brand, design and engineering pour into the same chain - the wait between experts, engineered out. That's the ÷3: not people working faster, but expertises no longer waiting on each other.</p>
    </div>

    <figure class="ls-fig el-shot">
      <Image src={img('Elements-toolingsuite')}
        alt="The Elements mark at the centre of its tooling suite, each tool grouped by role: documentation with Confluence and Zeroheight, design libraries with Figma, code packages with GitHub and React, code showcase with Storybook, communities with Slack and Teams, and AI solutions"
        layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
    </figure>

    <!-- 6c · comment ca tient -->
    <h3 class="ls-sub el-movement">How it holds itself.</h3>
    <div class="ls-body ls-body--wide">
      <p>I didn't build a system I hold together. I built the conditions where it holds itself. <b>Autonomous streams</b>, split by capability, each owned and moving without a central decision - held inside a <b>collective framing</b>, so a stream deciding alone still decides inside a frame it co-wrote. <b>Shared rituals</b> are the connective tissue keeping five hubs one system rather than an archipelago. And every week, the same conversation: <b>is the work moving, and is the person growing.</b> A team that isn't well doesn't ship, so wellbeing isn't a nice-to-have on the side - it's load-bearing.</p>
      <p>On top of that, <b>a standing feedback loop</b>: we didn't just ship the system, we questioned how we built it - interviewing practitioners, collecting feedback, testing our own ways of working, and reprioritizing support against what we heard. The system improves; so does the team that makes it.</p>
      <p>And when a product team was under water, we got into the work <em>with</em> them - ego aside, hands in: reviewing their codebase, auditing with concrete proposals, co-building to share the load. That wasn't just me; it was the standard I set and asked everyone to carry. You don't point at the problem from across the room, you cross it. <b>A team that only points the way isn't leading; it's watching.</b></p>
    </div>

    {/*
      Le <dl> est conserve : chaque equation est bien un terme et sa definition.

      Plus de cartes, plus de rail, plus de pastilles : trois colonnes separees
      par des filets, posees sur un bandeau blanc qui traverse la page. Les
      cartes portaient l'affordance du carrousel - sans leur bord, un rail de
      colonnes de texte ne se signale plus, et on ne sait plus ou l'une finit.
      Sous 1024px les colonnes s'empilent et les filets basculent a l'horizontale.
    */}
    <Equations entete="I don't state values. I install them." volets={mecanismes} />
    <!-- 6d · l equipe, bloc chaud -->
    <h3 class="ls-sub el-movement">The team that runs it.</h3>
    <div class="ls-body ls-body--wide">
      <p><b>I owned the <em>why</em> and the <em>what</em>. They owned the <em>how</em></b> - and made it sharper than I could have specified. Each capability runs itself, day to day, through the team I recruited and grew. Agile is the tempo, not a checkbox: the metronome keeping six capabilities and seven products in sync without a central hand. Nothing shipped without us aligned, and nothing waited on me to be decided.</p>
    </div>

    {/*
      Le trio aux Design System Awards, dans le cercle de l'accueil : meme forme,
      meme entree (stickIn), meme anneau au survol (tilePulse). La parente
      visuelle n'est pas decorative - la photo de l'accueil est celle de Lea
      seule, celle-ci est celle des trois, et c'est exactement le propos du
      chapitre : le systeme ne tient pas dans une seule paire de mains.
    */}
    <div class="el-trio ls-reveal">
      <figure class="el-trio__photo">
        <Image src={img('lea-nicolas-rodolphe-elements-awards')}
          alt="Léa Giezek, Nicolas Chatelain and Rodolphe Peruzza together at the Design System Awards"
          layout="constrained" sizes="(min-width: 900px) 620px, 118vw" loading="lazy" decoding="async" />
      </figure>
      <div class="el-trio__body">
        <p>For example, <ExternalLink href="https://nicolaschatelain.com" variant="inline">Nicolas Chatelain</ExternalLink> was leading the People axis from Experience Operations enablement to Community of Practice engagement plan and POC. In parallel, <ExternalLink href="https://rodolphe.design/chat" variant="inline">Rodolphe Peruzza</ExternalLink> was leading the System axis, from craft to experiences patterns industrialization.</p>
      </div>
    </div>

    {/* Le chiffre porte la duree, pas le detail : les trois autres faits sont des
        mesures, pas des slogans, et vivent donc dans le corps juste apres. */}
    <p class="el-big el-big--phrase"><span class="el-big__n">Zero resignations</span><span class="el-big__l">in three years</span></p>

    <div class="ls-body ls-body--wide">
      <p>Design went from one to five. One contractor converted to full-time. Average completed engagement: <b>23 months against a one-year target.</b></p>
      <p>The people who left in 2026 left for reasons none of us chose - a group budget call, a product remap, a scoped engagement that ended as planned. <b>Not one left me.</b> That's not luck. People stay where their growth and their wellbeing are part of the plan, not an afterthought, the same care I built into the system, pointed at the team.</p>
    </div>

    <p class="ls-claim ls-claim--head">My job wasn't to hold it up.<br><b>It was to build a structure that outlasts any of us.</b></p>
  </section>

<!-- ═══ 07 · THE COMMUNITY ═══ -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-community">
    <div class="ls-head">
      <p class="ls-eyebrow"><span>{chap('ch-community')}</span></p>
      <h2 class="ls-title" id="ch-community">A design system you install. A community you have to earn.</h2>
      <p class="ls-lede">Most system owners treat community as a comms afterthought. I made it the strategy.</p>
    </div>

    <div class="ls-body ls-body--wide">
      <p>The bet: adoption never comes from mandate - only from ownership. So the system had to belong to its users, not to me. <b>A system nobody believes in dies with its founder; one a community owns, outlives them.</b></p>
      <p><b>Experience runs both ways.</b> Elements serves end users - patients, healthcare professionals - but it also serves the people who build for them. A practitioner is a user too. So their practice gets the same care as any patient journey: fluid, productive, coherent across every perimeter. <em>Design the experience of the people designing the experience.</em></p>
    </div>

    {/*
      Le rang est pose entre l'argument et sa mise en oeuvre. Au-dessus, les deux
      paragraphes qui etablissent que le praticien est un utilisateur ; en
      dessous, celui qui raconte comment la capability a fait vivre le parcours.
      Le rang tombe donc a l'endroit exact ou « de consumer a maintainer » cesse
      d'etre une idee pour devenir un dispositif - on le voit avant de lire ce
      qui l'a construit.
    */}
    <div class="el-practice">
      <p class="el-path" aria-label="The practitioner path: consumer, then contributor, then maintainer">
        <span class="el-path__s"><span class="el-path__i" aria-hidden="true"><ConsumerVisual /></span>consumer</span><span class="el-path__a" aria-hidden="true">→</span><span class="el-path__s"><span class="el-path__i" aria-hidden="true"><ContributorVisual /></span>contributor</span><span class="el-path__a" aria-hidden="true">→</span><span class="el-path__s"><span class="el-path__i" aria-hidden="true"><MaintainerVisual /></span>maintainer</span>
      </p>

      <div class="ls-body ls-body--wide el-practice__body">
        <p>So I created the <b>Practitioner Experience capability</b> to make that real, and elevate one of my team members to run it, identifying how the career growth potential and the outcome for the company were seamlessly paired. I set the direction - community-led adoption, contribution over control, a path that graduates a practitioner from consumer to contributor to maintainer. My team proposed, built and ran the machine: the Elements Portal, the monthly Elements Demo, the office hours, the contribution and triage rituals, the onboarding path.</p>
      </div>
    </div>

    <div class="ls-body ls-body--wide">
      <p>This is how <b>30+ designers across 5 international hubs</b> and <b>2000+ practitioners</b> became one community - end to end, from onboarding to production readiness. Not a mailing list: a practice, running on a contribution model adapted from Zalando's, where everyone gives at the level of their skill, from a flagged issue to a full component.</p>
    </div>

    <div class="ls-body ls-body--wide">
      <p>Taking a system from near-zero to 86% average usage ratio per product in production isn't a launch - it's <b>change management at scale</b>: shifting habits across more than 45 product teams, turning resistance into ownership one team, one hub, or even one priority at a time. It takes patience and it takes refusing - the two are the same discipline, not opposites.</p>
      <p>And it's where careers grew, mine included: people levelled up by contributing and teaching, not by climbing a ladder - growth through the community, and reverse mentoring that kept me learning as much as I led.</p>
    </div>

    {/*
      Ces quatre cartes etaient quatre blocs disperses le long du chapitre : un
      grand chiffre, une claim, un visuel et la note de fin. Separes, chacun
      n'etait qu'une respiration entre deux paragraphes. Reunis dans le
      dispositif du 01, ils deviennent ce qu'ils sont - le faisceau de preuves
      du chapitre - et la serie ferme la section a la place de la note.

      Le meme `.el-figs-wrap` que les resultats : c'est lui qui porte le rythme
      vertical ET qui rallume les pastilles sous 1024px.
    */}
    <div class="el-figs-wrap">
      <div class="el-figs" id="elproof">
        {preuves.map((p) => (
          <div
            class:list={['el-fig-card', p.ton && `el-fig-card--${p.ton}`,
                         p.image && 'el-fig-card--img',
                         p.badge && 'el-fig-card--mark',
                         !p.chiffre && !p.image && 'el-fig-card--say']}
            style={p.pose}
          >
            {p.image ? (
              /* sizes cale sur la largeur reelle de la carte : clamp(210,24vw,264)
                 au bureau, clamp(210,62%,280) dans le rail - jamais 100vw */
              <Image src={p.image.src} alt={p.image.alt} layout="constrained"
                sizes="(min-width: 1025px) 280px, 65vw" loading="lazy" decoding="async" />
            ) : (
              <>
                {p.chiffre && <p class="el-fig__n">{p.chiffre}{p.suffixe && <span>{p.suffixe}</span>}</p>}
                <p class="el-fig__q">{p.titre}</p>
                {p.detail && <p class="el-fig__l">{p.detail}</p>}
                {p.badge && <span class="el-fig__mark" aria-hidden="true"><IdeaVisual /></span>}
              </>
            )}
          </div>
        ))}
      </div>
      <Dots id="elproofdots" count={preuves.length} label="What the community proved" itemLabel="Proof" />
    </div>
  </section>


<!-- ═══ 08 · WHERE I'D TAKE IT NEXT ═══ -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-next">
    <div class="ls-head">
      <p class="ls-eyebrow"><span>{chap('ch-next')}</span></p>
      <h2 class="ls-title" id="ch-next">I removed the wait between design and engineering. There's one wait left.</h2>
    </div>

    <div class="ls-body ls-body--wide">
      <p>I've argued Elements belongs closer to engineering - one reporting line from design to production. Not for tidiness: because <b>the border between design and engineering is dissolving.</b> AI-augmented workflows are already redrawing both crafts, and a structure that keeps them siloed slows everyone down.</p>
      <p>Bringing them under one line isn't reorg for its own sake. It's <b>velocity</b>, and it's <b>proximity</b> - sitting end to end with product teams instead of handing work across expertise walls. I'd rather build that structure before the shift forces it than retrofit it after. The move I made once - agency to in-house - pointed here. <b>This is the next mile of the same road.</b></p>
    </div>
  </section>

  {/* pas de titre a pointer ici, la chute est en <p> : d'ou l'aria-label */}
  <section class="ls-closing ls-closing--left ls-reveal" aria-label="In closing">
    <p class="ls-closing__t">Design systems ship standards.<br>Experience systems <em>grow culture</em>.</p>
  </section>

</Base>

<style is:global>
  /* ═══ propre a cette page ═══
     Les motifs `el-` n'existaient pas : ils portent des formes que /system-event
     n'avait pas besoin de produire (chiffres poses grand, axes, pipeline,
     equations). La charpente narrative vient de case-study.css. */



  /* l amorce, sortie du hero */

  /*
    Les quatre chiffres, en cartes manipulables. Au bureau elles sont posees en
    absolu et se deplacent a la souris ; sous 1024px le conteneur devient un rail
    a snap avec pastilles - meme mecanique que les tuiles de l accueil, mais ici
    aucune carte n est exclue du drag, donc il fonctionne vraiment.
  */
  .el-figs-wrap{margin:var(--sp-20) 0}
  .el-figs{position:relative;height:clamp(360px,40vw,430px);touch-action:none}
  /* le placement (left/top/--rot) vient du champ `pose` de chaque entree, pose
     en style inline. Les `left:var(--x);top:var(--y)` qui trainaient ici ne
     servaient rien : --x/--y ne sont ecrits nulle part sur ces cartes, et le
     style inline l'emportait de toute facon. */
  .el-fig-card{position:absolute;width:clamp(210px,24vw,264px);
    padding:var(--sp-12);border-radius:28px;background:var(--card);
    border:1px solid var(--line);border-width:max(1px,var(--edge-w));border-color:var(--line);
    box-shadow:0 18px 38px -22px rgba(120,30,10,.28);cursor:grab;user-select:none;
    transform:rotate(var(--rot));transition:transform .22s cubic-bezier(.22,1,.36,1),box-shadow .22s ease;z-index:1}
  .el-fig-card:hover{transform:rotate(0deg) translateY(-6px) scale(1.02);
    box-shadow:0 28px 52px -24px rgba(120,30,10,.4);z-index:20}
  .el-fig-card.grabbing{cursor:grabbing;transform:rotate(0deg) scale(1.03);z-index:30}
  /*
    Deux ecritures pour les memes tons, et c'est voulu : les resultats les
    tiennent de leur rang (--2, --3), la serie du chapitre 07 les nomme (--red,
    --ink). La ou quatre chiffres sont interchangeables, l'index suffit ; la ou
    la serie melange chiffre, phrases et visuel, la couleur doit pouvoir rester
    en place quand le propos bouge.
  */
  .el-fig-card--2,.el-fig-card--red{background:var(--tile-red)}
  .el-fig-card--2 .el-fig__n,.el-fig-card--red .el-fig__n{color:var(--tile-red-ink)}
  .el-fig-card--2 .el-fig__l,.el-fig-card--red .el-fig__l{color:var(--tile-red-ink);opacity:.72}
  /*
    Carte noire, meme procede que .dc2 sur l accueil : le fond prend --ink et le
    texte passe en blanc en entier. L accent bleu de --accent-alt, tenu en theme
    contrast, ne passerait pas sur ce fond - d ou le chiffre en blanc lui aussi.
  */
  .el-fig-card--3,.el-fig-card--ink{background:var(--ink)}
  .el-fig-card--3 .el-fig__n,.el-fig-card--3 .el-fig__q,
  .el-fig-card--ink .el-fig__n,.el-fig-card--ink .el-fig__q{color:#fff}
  .el-fig-card--3 .el-fig__l,.el-fig-card--ink .el-fig__l{color:rgba(255,255,255,.72)}
  /*
    Carte sans chiffre : c'est la phrase qui porte, elle prend donc le corps que
    le chiffre occupait. Sans ca elle tombait a 17px - la taille d'une legende
    sous un chiffre de 60px - et la carte se lisait comme s'il lui manquait
    quelque chose au-dessus.
  */
  .el-fig-card--say .el-fig__q{margin-top:0;font-size:clamp(19px,1.9vw,23px);line-height:1.16}
  /*
    Pastille ronde blanche dans l'angle bas-droit.

    En flux et non en position:absolute : pose en absolu, elle passait sous le
    texte des que la carte etait courte - or ces cartes n'ont pas de hauteur
    fixe, elles suivent leur contenu. La carte devient donc une colonne flex,
    et `margin:auto 0 0 auto` colle la pastille en bas a droite de l'espace
    restant. Le padding de la carte (--sp-12) fait le reste : c'est lui qui
    tient l'ecart aux deux bords, donc les deux valeurs restent solidaires
    sans qu'on ait a les repeter ici.
    La marge basse garantit l'ecart minimum au texte quand il ne reste aucun
    espace a distribuer. Elle vise `p:last-of-type` et non une classe precise :
    la derniere ligne de la carte est tantot le titre, tantot le detail, et la
    pastille est un <span> - elle ne peut donc pas etre prise pour cible.
  */
  /*
    overflow:hidden est ce qui rend le debordement possible : le dessin sort du
    cadre par l'angle bas-droit et c'est le rayon de 28px de la carte qui le
    coupe. Sans lui, il deborderait par-dessus le coin arrondi et la carte
    perdrait sa silhouette.
  */
  .el-fig-card--mark{display:flex;flex-direction:column;overflow:hidden}
  .el-fig-card--mark p:last-of-type{margin-bottom:var(--sp-06)}
  /*
    Plus de pastille : le dessin est pose a meme la carte, en grand, ancre dans
    l'angle bas-droit et rogne - meme traitement que .dc-hand sur l'accueil.
    Les marges negatives valent le padding de la carte plus 20px : elles
    annulent la gouttiere pour que le dessin atteigne vraiment le bord, puis
    mordent dessus. `margin-top:auto` le plaque en bas de la colonne flex.
    Blanc sur --tile-red : c'est un filigrane, pas un pictogramme. Le rapport
    de contraste est volontairement sous le seuil - il n'y a rien a y lire,
    l'element est aria-hidden et le propos de la carte est dans son titre.
  */
  .el-fig__mark{color:#fff;flex:none;
    width:clamp(132px,15vw,180px);height:clamp(132px,15vw,180px);
    margin:auto calc(var(--sp-12) * -1 - 20px) calc(var(--sp-12) * -1 - 20px) auto;
    display:grid;place-items:center;line-height:1;user-select:none}
  .el-fig__mark svg{width:100%;height:100%}

  /* carte-visuel : pas de gouttiere, l'image EST la carte */
  .el-fig-card--img{padding:0;overflow:hidden}
  /* l'image porte le rayon de la carte via son overflow:hidden, elle n'a donc
     ni bord ni rayon propre - deux rayons concentriques se verraient */
  .el-fig-card--img img{display:block;width:100%;height:auto}
  .el-fig__n{font-family:var(--display);font-weight:400;font-size:clamp(36px,4.6vw,60px);line-height:.95;
    letter-spacing:-.03em;color:var(--accent-alt)}
  /* exposant du chiffre, meme rapport que le « /5 » de .el-big__n */
  .el-fig__n span{font-size:.45em;color:var(--ink-muted)}
  .el-fig__q{margin-top:12px;font-family:var(--display);font-weight:400;font-size:17px;line-height:1.2;
    letter-spacing:-.01em;color:var(--ink)}
  .el-fig__l{margin-top:8px;font-size:13px;line-height:1.45;color:var(--ink-muted)}
  /* la carte porte user-select:none pour le glisser : on le rend au lien, sinon
     son libelle n'est ni selectionnable ni copiable */
  .el-fig__cta{margin-top:var(--sp-06);font-size:14px;user-select:auto}
  /* .btn3 svg fait 20px, cale sur un libelle de 16px ; ici le libelle est a 14px */
  .el-fig__cta svg{width:16px;height:16px}


  /* les trois metiers : le rythme fait le travail */
  /*
    Equivalent local de .creed sur /philosophy : .tenet:first-of-type annule son
    padding haut, il faut donc un ecart porte par le conteneur. .creed elle-meme
    vit dans philosophy.astro et ne serait pas emise ici.
  */
  .el-creed{margin:var(--sp-16) 0 var(--sp-03)}
  /*
    Mondrian, et Mondrian seul : les trois chiffres prennent les trois aplats du
    peintre - rouge, bleu, jaune. Ailleurs ils restent sur --accent, ou la
    variation n'aurait aucun sens : les trois autres themes n'ont qu'une couleur.

    Cible `.tenet__num` uniquement, c'est-a-dire le GRAND chiffre : il porte
    aria-hidden et n'existe qu'au-dela de 900px. En dessous c'est .tenet__idx
    qui reprend le numero, en vrai texte de 12px - le laisser sur --accent y
    garde un contraste utilisable.

    Mesures sur le canvas Mondrian (#F4F1E9) : rouge 5,0:1, bleu 6,4:1,
    jaune 1,3:1. Le jaune est donc decoratif au sens strict - a 72px il se lit
    comme une forme, pas comme une valeur, et rien ne s'y perd puisque le titre
    juste a cote porte le sens. Choix assume, comme les bandeaux de .el-axis :
    ne pas "corriger" en aplat lisible sans le redemander a Lea.
  */
  [data-theme="contrast"] .el-creed .tenet:nth-of-type(1) .tenet__num{color:var(--accent)}
  [data-theme="contrast"] .el-creed .tenet:nth-of-type(2) .tenet__num{color:var(--accent-alt)}
  [data-theme="contrast"] .el-creed .tenet:nth-of-type(3) .tenet__num{color:var(--highlight)}

  /* titre de mouvement, a l interieur d un chapitre */
  .el-movement{margin-top:var(--sp-20)}

  /*
    Trois axes, a l'anatomie des cartes de case de l'accueil : bandeau
    --hero-grad puis corps blanc. La ligne de tension porte toujours le propos.
    Pas de :hover qui souleve la carte, contrairement a .case : ces cartes ne
    mènent nulle part, un mouvement au survol promettrait un clic qui n'existe pas.
    minmax(0,1fr) et non 1fr : « Corporate Design Experience » ferait sinon
    deborder sa colonne, un item de grille refusant de passer sous min-content.
  */
  /*
    Le schema de la suite d'outils est un aplat blanc opaque, a deux points du
    canvas (#FFFFFF contre #F6F6F4) : sans filet ses bords se perdraient. On ne
    peut pas s'en remettre a --edge, nul par defaut et pose seulement en Mondrian.
  */
  .el-shot{margin-top:var(--sp-16);background:var(--card);
    border:1px solid var(--line);border-width:max(1px,var(--edge-w))}

  .el-axes-wrap{margin:var(--sp-14) 0 0}
  /*
    Carrousel a toutes les largeurs, et non une grille 3x2 qui cede en rail sous
    900px. Six capacites sur deux rangees se lisaient comme deux groupes de
    trois - or les trois axes ne sont pas empilables, ils tiennent ensemble.
    Une seule ligne qui defile dit la bonne chose : une serie, parcourue.

    Le rail sort de la grille et court d'un bord a l'autre de l'ecran, a toutes
    les largeurs. Le padding lateral vaut --bleed-pad (tokens.css), le meme token
    que .ls-carousel__track et .eq-band : la premiere carte reste donc calee sur
    la colonne de texte pendant que la serie file hors cadre a droite. Les deux
    carrousels de la page se comportent ainsi a l'identique, et sous 900px la
    formule retombe d'elle-meme sur --sp-03 sans qu'on ait a la redire.

    Le padding vertical n'est pas du confort : overflow-x:auto rogne aussi en
    vertical, et sans lui l'ombre portee des cartes serait coupee.
  */
  .el-axes{list-style:none;margin:0 calc(50% - 50vw);width:100vw;
    display:flex;gap:var(--sp-02);overflow-x:auto;scroll-snap-type:x mandatory;
    scrollbar-width:none;
    padding:var(--sp-02) var(--bleed-pad) var(--sp-10)}
  .el-axes::-webkit-scrollbar{display:none}
  .el-axes-wrap .dots{display:flex}
  /* en vw et non en % : le conteneur fait desormais 100vw, un pourcentage s'y
     lirait comme une fraction de la colonne alors qu'il n'en est plus une.
     ~3,5 cartes visibles : assez pour lire la serie, assez peu pour que le bord
     coupe dise qu'elle continue */
  .el-axis{flex:0 0 clamp(250px,23vw,340px);scroll-snap-align:center;
    background:var(--card);border-radius:var(--r-lg);overflow:hidden;
    display:flex;flex-direction:column;min-width:0;
    box-shadow:0 16px 34px -20px rgba(120,30,10,.25);
    border:var(--edge-w) solid var(--edge)}
  /*
    Bandeau en --hero-grad, comme .case__top sur l'accueil.

    Le degrade s'eclaircit vers la droite (#FFE1C5 en spicy) : tout texte blanc
    qui l'atteint devient illisible. Les deux max-width ci-dessous ne sont donc
    pas de la mise en page, ce sont des garde-fous de contraste - ils font passer
    le texte a la ligne pendant que le fond est encore sature. Toute augmentation
    de ces valeurs, ou du corps du texte, degrade directement la lisibilite.
    Le blanc est plein et non translucide : a 70% il retomberait de moitie.

    Choix arbitre avec Lea, mesures a l'appui, le 26/07/2026. En theme spicy les
    titres tombent entre 2,90 et 3,61:1 et les eyebrows autour de 3,7:1 - donc
    sous les seuils AA (3:1 pour ces corps de titre, 4,5:1 pour l'eyebrow). C'est
    assume, au meme titre que le rouge de marque a 4:1 : les themes mono (15,8:1)
    et contrast (5,7:1) sont le remede accessible. Ne pas "corriger" en aplat
    sans le lui redemander.
  */
  .el-axis__top{background:var(--hero-grad);padding:var(--sp-12);color:#fff}
  /*
    Garde-fous en pourcentage et non en ch : le degrade se calcule sur la largeur
    du bandeau, donc la seule mesure qui compte est la fraction parcourue, pas un
    nombre de caracteres. Au-dela d'environ 46% le fond est trop clair pour du
    blanc ; 42% laisse la marge du retour a la ligne.
  */
  /*
    Declarations reprises telles quelles de .case__idx / .case__when / .case__name
    sur l'accueil - corps, graisses, interlettrages, couleurs, espacements.
    L'axe tient lieu de categorie, le benefice tient lieu de date.

    Seuls ajouts : les max-width. Ils ne touchent pas au styling, ils decident
    seulement ou la ligne se coupe. Sans eux le texte traverse tout le bandeau et
    finit sur le #FFE1C5 du degrade, ou il devient illisible - mesure a l'appui,
    1,5:1 pour le benefice et 1,8:1 pour le titre.
  */
  .el-axis__eyebrow{font-weight:700;font-size:12px;letter-spacing:.12em;
    text-transform:uppercase;color:#fff}
  .el-axis__name{display:block;font-family:var(--display);font-weight:400;
    font-size:clamp(15px,1.5vw,16px);line-height:1.15;letter-spacing:-.01em;color:#fff;
    margin-top:.4em;white-space:nowrap}
  /*
    Mondrian : les bandeaux alternent rouge, bleu, jaune sur les six cartes.
    Ailleurs ils restent sur --hero-grad, les autres themes n'ayant qu'une
    couleur a proposer.

    Le jaune ne peut PAS garder le texte blanc du bandeau : #fff sur #F7D000
    tombe a 1,5:1, c'est illisible. Il passe donc sur --on-highlight (#111),
    que le theme definit exactement pour ce cas - 12,6:1. Rouge et bleu gardent
    le blanc, mesures a 5,7:1 et 7,2:1. Contrairement au « 03 » de .el-creed,
    ce texte-la porte le sens de la carte : il n'y a rien a assumer ici.
  */
  [data-theme="contrast"] .el-axis:nth-child(3n+1) .el-axis__top{background:var(--accent)}
  [data-theme="contrast"] .el-axis:nth-child(3n+2) .el-axis__top{background:var(--accent-alt)}
  [data-theme="contrast"] .el-axis:nth-child(3n+3) .el-axis__top{background:var(--highlight)}
  [data-theme="contrast"] .el-axis:nth-child(3n+3) .el-axis__eyebrow,
  [data-theme="contrast"] .el-axis:nth-child(3n+3) .el-axis__name{color:var(--on-highlight)}

  .el-axis__body{padding:var(--sp-12);display:flex;flex-direction:column;flex:1}
  .el-axis__desc{font-size:15px;line-height:1.55;color:var(--ink-soft);flex:1}
  /* le benefice ferme la description : meme traitement que le gras de .ls-body */
  .el-axis__desc b{color:var(--ink);font-weight:700}

  /* pipeline : la forme dit « une seule chaine, zero handoff » */
  /* sp-14 et non sp-06 : cette marge portait l'ecart au « design → dev » qui
     precedait la chaine ; sans lui c'est elle qui doit tenir l'ecart au titre */
  .el-pipe{list-style:none;margin:var(--sp-14) 0 0;padding:0;display:flex;align-items:stretch;gap:0;
    overflow-x:auto;scrollbar-width:none}
  .el-pipe::-webkit-scrollbar{display:none}
  .el-pipe__node{flex:1 1 0;min-width:150px;position:relative;padding:var(--sp-08) var(--sp-03) var(--sp-08) 0;
    display:grid;gap:6px;align-content:start}
  .el-pipe__node::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:var(--accent-alt);opacity:.28}
  .el-pipe__node::after{content:"";position:absolute;left:0;top:-4px;width:10px;height:10px;border-radius:50%;
    background:var(--accent-alt)}
  .el-pipe__n{font-size:11px;letter-spacing:.12em;color:var(--ink-muted);
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  .el-pipe__name{font-family:var(--display);font-weight:400;font-size:clamp(17px,1.8vw,22px);line-height:1.15;color:var(--ink)}
  .el-pipe__note{font-size:13px;line-height:1.45;color:var(--ink-muted)}
  /*
    Au-dela de 900px la chaine ne defile plus : ni snap, ni pastilles, ni bord
    coupe pour le signaler. Tout ce qui depasse la colonne de 1032px est donc
    perdu sans que rien ne le dise - et avec sept maillons, `min-width:150px`
    depassait de 18px. On rend la largeur au partage (min-width:0, sept colonnes
    egales de ~147px) et on descend le corps du libelle en consequence : 22px
    dans 127px de texte mettait « Integrated support channels » sur trois lignes
    hautes qui desequilibraient toute la rangee.
    En dessous de 900px on ne touche a rien : la c'est un rail, il DOIT deborder.
  */
  @media(min-width:901px){
    .el-pipe__node{min-width:0;padding-right:var(--sp-02)}
    .el-pipe__name{font-size:clamp(15px,1.5vw,19px)}
  }

  /* les gens : prose, jamais une grille */
  .el-trio{margin:var(--sp-16) 0 0;display:grid;
    grid-template-columns:clamp(200px,26vw,320px) minmax(0,1fr);
    gap:var(--sp-14);align-items:center}
  /*
    Cercle repris de .dcard--photo sur l'accueil. Deux differences assumees :
    l'image passe par <Image> et non par un fond CSS (elle vit dans src/assets,
    donc elle merite le pipeline responsive), et le conteneur porte donc
    overflow:hidden + object-fit pour recadrer comme le ferait `center/cover`.
  */
  .el-trio__photo{position:relative;margin:0;aspect-ratio:1;border-radius:50%;overflow:hidden;
    background:var(--tile-red);box-shadow:0 22px 44px -20px rgba(120,30,10,.30)}
  /*
    Recadrage en deux temps, parce qu'un seul ne suffit pas.

    1. object-position - la photo est un 2/3 vertical (2000x3000) et les visages
       occupent le tiers HAUT du cadre. Un carre centre prend la bande du milieu :
       il coupait le haut du crane du premier et remplissait le bas du cercle de
       jambes. 10% et non 0 : cale tout en haut, le cadrage gagnait 200px de
       guirlande vide et collait le menton de la troisieme au bord du cercle.
    2. scale() - il reste une quatrieme personne sous le trio, et aucun cadrage
       carre ne l'exclut : elle est dans la meme bande que les trois autres. On
       zoome donc dans la fenetre pour ne garder que son centre. A 1.9 le cercle
       montre ~53% de la largeur d'origine ; les deux valeurs sont solidaires,
       toucher l'une sans l'autre fait revenir le quatrieme visage par le bas.

    Le scale vit sur l'img et non sur .el-trio__photo : la figure porte deja
    l'animation d'entree (stickIn), qui ecraserait cette transform.
    sizes suit : on affiche 320px mais on n'utilise que 53% du fichier, donc il
    en faut ~620 sous peine d'un cercle flou.
  */
  .el-trio__photo img{width:100%;height:100%;object-fit:cover;object-position:center 10%;
    transform:scale(1.9);display:block}
  [data-theme="contrast"] .el-trio__photo{border:var(--edge-w) solid var(--edge);box-shadow:none}
  /*
    L'anneau au survol. Il ne peut pas vivre sur .el-trio__photo lui-meme :
    overflow:hidden le rognerait, alors qu'il doit deborder de 3px. D'ou le
    frere en position absolue, pose par-dessus et transparent aux clics.
  */
  .el-trio__photo::after{content:"";position:absolute;inset:0;border-radius:50%;
    border:2px solid var(--ring);opacity:0;pointer-events:none}
  .el-trio__photo:hover::after{animation:tilePulse .9s ease-out}
  .el-trio__body{font-size:clamp(16px,1.6vw,20px);line-height:1.62;color:var(--ink-soft);max-width:52ch}
  /*
    Meme entree que les tuiles de l'accueil. --rot doit exister : stickIn
    l'interpole dans son rotate(), et une custom property absente rend toute la
    transform invalide - l'animation ne jouerait pas du tout. 0deg ici, la ou
    l'accueil incline ses tuiles : une photo de groupe penchee se lit comme un
    defaut de cadrage, pas comme une intention.
  */
  .el-trio__photo{--rot:0deg}
  .js .el-trio__photo{opacity:0;transform:rotate(var(--rot)) scale(.4)}
  .js .el-trio.in .el-trio__photo{animation:stickIn .55s cubic-bezier(.34,1.56,.64,1) forwards}

  /* le lien externe inline (.xlink) est emis par <ExternalLink> : il suit le
     composant au lieu d'attendre dans le <style> de la page qui s'en servait */

  /* un chiffre pose grand et seul */
  .el-big{margin:var(--sp-20) 0;display:grid;gap:10px;justify-items:start}
  .el-big__n,.el-big--phrase .el-big__l{font-family:var(--display);font-weight:400;
    font-size:clamp(40px,7vw,96px);line-height:.95;letter-spacing:-.03em;color:var(--accent-alt)}
  .el-big__n span{font-size:.45em;color:var(--ink-muted)}
  .el-big__l{font-size:clamp(15px,1.5vw,18px);line-height:1.5;color:var(--ink-muted);max-width:44ch}
  /*
    Variante « une seule phrase ». Le second segment n'est pas une legende sous
    le chiffre mais la fin de la phrase - « Zero resignations in three years » -
    donc il en reprend exactement le traitement. Deux consequences :
    - gap a 0. A 10px entre deux lignes de 96px, la phrase se lisait comme deux
      affirmations posees l'une sous l'autre, ce que la legende EST dans l'autre
      .el-big de la page (« 4.7/5 » et sa glose), mais pas celle-ci.
    - max-width neutralise. Les 44ch de la legende sont une mesure de lecture
      pour du corps de 18px ; a 96px ils couperaient la phrase au hasard.
  */
  .el-big--phrase{gap:0}
  .el-big--phrase .el-big__l{max-width:none}

  /*
    Le parcours du praticien : trois pastilles rondes reliees par des fleches.

    La gouttiere est calculee et non prise dans l'echelle : les trois cercles et
    les deux fleches doivent tenir sur UNE ligne jusqu'en bas de la plage, sans
    quoi le parcours se lit comme deux groupes au lieu d'une progression.
    Mesure a 375px : 3x88 + 2x~14 de fleche + 4x8 de gouttiere = 324px pour 343
    disponibles. flex-wrap reste, en filet, si une police de secours elargit tout.

    Le mot passe de 32px a clamp(12px,1.6vw,19px) : il n'est plus pose sur une
    ligne libre mais inscrit dans un disque, et c'est le diametre qui commande.
  */
  /*
    Le parcours et les deux paragraphes qu'il illustre, empiles. Ce bloc a ete
    essaye en deux colonnes, parcours a gauche : abandonne, le rang de trois
    cercles se lit sur une ligne et une ligne demande toute la largeur.
    Ce qui reste de l'essai et qui compte : les deux paragraphes ont ete
    remontes ICI, sous le rang, parce que ce sont eux qui nomment les trois
    etats. Le premier paragraphe du chapitre, lui, pose le pari d'adoption et
    reste au-dessus.
    La marge haute vaut --sp-16 PLUS --sp-08 : le dessin sort d'environ 20% de
    la hauteur du cercle par le haut, et --sp-16 seul ne laissait que 5px avant
    le paragraphe precedent - le dessin mordait dessus.
  */
  .el-practice{margin:calc(var(--sp-16) + var(--sp-08)) 0 var(--sp-16)}
  .el-practice__body{margin-top:var(--sp-12)}

  /* nowrap : le parcours est une ligne, a toutes les largeurs. Ce sont les
     cercles qui cedent, pas le rang qui casse - voir .el-path__s. */
  .el-path{margin:0;display:flex;flex-wrap:nowrap;align-items:center;
    gap:clamp(8px,1.6vw,20px);
    font-family:var(--display);font-weight:400;line-height:1.1;
    letter-spacing:-.01em;color:var(--ink)}
  /*
    Les trois cercles se PARTAGENT la ligne au lieu d'avoir une taille imposee.
    Une largeur en clamp avait un plancher de 104px : a 375px d'ecran il fallait
    380px pour trois cercles, leurs fleches et leurs jours, contre 343
    disponibles - le rang passait a deux lignes. Ici chacun prend le tiers de ce
    qui reste apres les fleches et les jours, quelle que soit la largeur, et le
    max-width l'empeche de depasser le palier haut sur grand ecran.
    `min-width:0` sans quoi un element flex refuse de descendre sous la largeur
    de son contenu, et `aspect-ratio` pour que le cercle reste rond puisque sa
    hauteur n'est plus ecrite.
  */
  .el-path__s{position:relative;flex:1 1 0;min-width:0;max-width:208px;
    aspect-ratio:1;
    border-radius:50%;background:var(--card);
    box-shadow:0 16px 34px -20px rgba(120,30,10,.28);
    /*
      Pas de contour, meme en Mondrian, ou tout objet en porte un par defaut :
      le disque blanc n'est pas ici une surface a delimiter, c'est le fond du
      dessin. Un cercle noir de 2px autour d'un trait rouge donnait deux
      contours concentriques et fermait une vignette qui doit au contraire
      deborder. Meme decision que pour le cercle blanc du bloc gouvernance sur
      l'accueil.
    */
    /*
      Contenu cale en BAS et non centre. Centre, la marge sous le mot etait ce
      qui restait apres que la marge negative du dessin ait pris sa part - donc
      15px, et pas reglable : gagner de l'air sous le mot en agrandissant le
      cercle en redonnait autant au dessin. Ancre en bas avec un padding, la
      marge sous le libelle est ecrite, et le dessin deborde par le haut de ce
      qu'il veut.

      Le padding est en `em` et SURTOUT PAS en pourcentage : un padding en
      pourcentage se resout sur la largeur du CONTENANT, pas sur l'element.
      `15%` valait donc 15% des 1032px du rang, soit 155px de padding dans un
      cercle de 194 - le dessin y avait ete comprime de 170 a 34px. En em, la
      reference est la taille du mot lui-meme, ce qui est la bonne unite pour
      l'air qu'on lui laisse, et elle suit le cercle puisque les deux sont en vw.
    */
    display:flex;flex-direction:column;align-items:center;justify-content:flex-end;
    padding-bottom:1.7em;
    gap:.8em;text-align:center;font-size:clamp(12px,1.6vw,19px);
    /*
      Le grossissement passe par la propriete `scale` et NON par `transform`.
      C'est deliberatif : la decouverte progressive du parcours anime deja le
      `transform` de ces memes elements, avec un delai par rang (--d) qui monte
      a .44s. Un hover ecrit sur la meme propriete aurait herite de ce delai -
      le cercle aurait grossi une demi-seconde apres le survol - et il aurait
      fallu se battre a la specificite contre `.js .el-path.in > *`. Deux
      proprietes distinctes se composent sans qu'aucune des deux ne cede.
    */
    transition:scale .25s cubic-bezier(.22,1,.36,1),box-shadow .25s ease}
  .el-path__s:hover{scale:1.07;box-shadow:0 24px 46px -22px rgba(120,30,10,.42)}
  /*
    L'anneau de pulsation a ete retire : chaque vignette a desormais son propre
    geste au survol, et deux signaux simultanes sur le meme element se
    concurrencaient. Le grossissement du disque, lui, reste - c'est le retour
    « cet element repond », pas une animation de contenu.

    Les trois gestes suivent le dispositif de la vignette gouvernance de
    l'accueil : le SVG porte des crochets de classe, la page porte le mouvement.
    transform-box:fill-box pour que transform-origin se lise sur la boite du
    groupe et non sur le viewBox entier - sans lui, « 50% 100% » designerait le
    bas du carre de 100, pas le pied de la plante.
  */
  .el-path__i .leaf,.el-path__i .plant,.el-path__i .pour{transform-box:fill-box}

  /*
    01 - la feuille se pose. Deux etats a interpoler, donc une transition : elle
    part de dehors et le second etat doit TENIR, ce qu'une keyframe n'aurait pas
    fait - elle aurait rendu la feuille a sa place de depart.
    Origine en bas pour que la rotation la fasse pivoter en se posant, et non
    tourner sur elle-meme.
  */
  .js .el-path__i .leaf{transform-origin:50% 100%;
    /*
      Ces quatre valeurs sortent d'une mesure, pas d'un gout : il fallait
      satisfaire deux contraintes a la fois - degager l'encre de la main (sinon
      la feuille n'est pas « dehors ») et ne pas descendre sur le libelle, qui
      n'est qu'a 16px sous le dessin. Une simple translation echouait : assez
      basse pour quitter l'avant-bras, elle touchait le mot.
      Le `scale` debloque les deux. La feuille au repos est plus petite, donc
      elle tient plus bas sans mordre sur le mot - et elle reprend sa taille en
      se posant, ce qui appuie l'idee qu'elle arrive. Releve : chevauchement
      avec la main nul, 5px avant le mot.
    */
    transform:translate(24px,36px) rotate(-30deg) scale(.76);
    transition:transform .6s cubic-bezier(.22,1,.36,1) .3s}
  .js .el-path.in .leaf{transform:none}

  /*
    02 - la plante pousse. scaleY depuis le pied de la tige, la ou elle rejoint
    les mains : c'est le bas de la boite du groupe, d'ou l'origine a 100%.
    Elle part quasi couchee (5% de hauteur) et depasse legerement avant de se
    poser : c'est ce depassement qui fait lire une pousse plutot qu'un
    etirement. Le leger balancement - un degre de part et d'autre - evite que la
    tige monte comme un ascenseur.
  */
  .el-path__i .plant{transform-origin:50% 100%}
  /*
    L'etat couche est pose AVANT l'animation, sur .js seul. Sans lui la plante
    s'afficherait a sa taille pleine puis se retracterait d'un coup au moment ou
    la keyframe demarre - le `both` ne tient l'image de depart que pendant le
    delai, pas avant que l'animation existe.
  */
  .js .el-path__i .plant{transform:scale(.66,.05) rotate(-5deg)}
  @keyframes elPlantePousse{
    0%{transform:scale(.66,.05) rotate(-5deg)}
    62%{transform:scale(1.05,1.08) rotate(2.5deg)}
    100%{transform:none}
  }
  .js .el-path.in .plant{animation:elPlantePousse .82s cubic-bezier(.22,1,.36,1) .52s both}

  /*
    03 - l'arrosoir s'incline. Keyframes, parce que le geste doit REVENIR : une
    inclinaison tenue apres coup ressemblerait a un dessin de travers. Il penche,
    tient l'angle un instant - le temps qu'on lise l'arrosage - puis se redresse.
    L'angle est negatif parce qu'en SVG le sens positif est horaire et que le
    bec se trouve a GAUCHE du pivot : positif, il serait monte au lieu de piquer
    vers la plante. L'origine est posee au poignet plutot qu'au centre du
    groupe, sinon l'arrosoir aurait tourne autour de lui-meme.
  */
  .el-path__i .pour{transform-origin:78% 58%}
  @keyframes elArrosoirPenche{
    0%{transform:none}
    32%,62%{transform:rotate(-13deg)}
    100%{transform:none}
  }
  .js .el-path.in .pour{animation:elArrosoirPenche 1.5s cubic-bezier(.4,0,.2,1) .74s both}
  /*
    Le dessin SORT de la pastille, c'est le principe : le disque d'origine
    n'occupait que 73% du viewBox, donc rendre le SVG a 100% du cercle rend au
    dessin le debordement que l'artiste avait prevu. La marge haute negative le
    fait deborder par le haut et libere le bas du disque pour le mot.
    Rien ici ne coupe : .el-path__s n'a pas d'overflow:hidden - c'est deja ce
    qui laissait passer son anneau de pulsation.
  */
  /*
    Le dessin est HORS FLUX, et c'est ce qui rend le reste possible.
    Dans le flux, sa hauteur s'ajoutait a celle du mot et du padding : la somme
    depassait le diametre, et comme la hauteur d'un element flex vient de son
    contenu, l'`aspect-ratio` du cercle cedait - il s'allongeait en ovale et le
    dessin ne debordait plus de rien. En absolu il ne pese plus sur la hauteur :
    le cercle reste rond, et le dessin sort par le haut autant qu'il veut.
    `bottom` en em cale sa base au-dessus du mot : 1.7em de padding bas, ~1.2em
    de mot, .8em de respiration - les memes unites que celles qui placent le
    mot, donc les deux bougent ensemble.
  */
  .el-path__i{position:absolute;left:50%;bottom:3.7em;transform:translateX(-50%);
    width:88%;aspect-ratio:1;
    color:var(--accent);display:grid;place-items:center;line-height:1}
  .el-path__i svg{width:100%;height:100%;overflow:visible}
  .el-path__a{flex:none;color:var(--accent-alt);font-size:clamp(16px,2vw,26px)}
  /* sous 560px, chaque pixel rendu par les jours et les fleches revient aux
     cercles - c'est ce qui garde les libelles lisibles a 375px */
  @media (max-width:560px){
    .el-path{gap:6px}
    .el-path__a{font-size:14px}
  }

  /* La chute est ferree a gauche - cette page n'a plus de sous-ligne sous la
     phrase, et tout son chapitrage l'est deja, du premier eyebrow a la derniere
     carte. Porte par .ls-closing--left (case-study.css), partage avec
     /operating-system. */

  .el-after-fig{margin-top:var(--sp-16)}
  .el-scope{margin-top:var(--sp-16)}

  /* la lecon du bloc sombre : posee seule */
  .el-lesson{margin-top:var(--sp-16);font-family:var(--display);font-weight:400;
    font-size:clamp(24px,3.4vw,44px);line-height:1.1;letter-spacing:-.02em;color:#fff;max-width:24ch}

  /* ═══ decouverte progressive ═══
     Meme grammaire que .tenet et que les tuiles de l'accueil : le bloc entier
     n'apparait pas d'un coup, ses elements se posent l'un apres l'autre dans
     l'ordre de lecture. Ce qui se lit comme une suite (un chemin, une chaine)
     se DECOUVRE comme une suite - la forme raconte le propos.
     Tout est conditionne a `.js` : sans script, rien n'est masque. */

  /*
    Le chemin du praticien. Les delais sont poses par --d et non par des regles
    nth-child separees : les cinq enfants alternent mot / fleche, et c'est la
    fleche qui doit arriver AVANT le mot qu'elle amene - sinon le mot apparait
    puis la fleche le rattrape, ce qui inverse la lecture.
  */
  .js .el-path > *{opacity:0;transform:translateY(10px)}
  /*
    `scale` et `box-shadow` sont rappeles ici alors qu'ils appartiennent au
    survol : `transition` est une propriete raccourcie, donc cette regle - plus
    specifique que .el-path__s - remettait leurs deux transitions a zero et le
    cercle grossissait d'un coup au lieu de s'etirer.
    Seuls opacity et transform portent le delai --d : le survol doit repondre
    tout de suite, pas une demi-seconde apres le pointeur.
  */
  .js .el-path.in > *{opacity:1;transform:none;
    transition:opacity .5s ease var(--d,0s),transform .55s cubic-bezier(.22,1,.36,1) var(--d,0s),
      scale .25s cubic-bezier(.22,1,.36,1),box-shadow .25s ease}
  .js .el-path.in > :nth-child(2){--d:.14s}
  .js .el-path.in > :nth-child(3){--d:.22s}
  .js .el-path.in > :nth-child(4){--d:.36s}
  .js .el-path.in > :nth-child(5){--d:.44s}

  /*
    Les trois volets, a toutes les largeurs. Cette regle etait gardee par un
    min-width:1025px tant que le bloc devenait un rail en dessous : carrousel()
    y pilotait le meme `transform` (l'arc) et les deux se battaient a chaque
    image. Le rail n'existe plus - les volets s'empilent - donc la garde non plus.
  */
  @media(max-width:1024px){
    /* rail a snap : le conteneur perd sa hauteur fixe, les cartes rentrent dans le flux */
    .el-figs{height:auto;display:flex;overflow-x:auto;gap:var(--sp-03);scroll-snap-type:x mandatory;
      touch-action:auto;padding:var(--sp-08) 0 var(--sp-12);scrollbar-width:none;
      margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);width:100vw;
      padding-left:var(--sp-03);padding-right:var(--sp-03)}
    .el-figs::-webkit-scrollbar{display:none}
    .el-fig-card{position:relative!important;left:auto!important;top:auto!important;
      flex:0 0 clamp(210px,62%,280px);scroll-snap-align:center;transform:none;cursor:default}
    .el-fig-card:hover{transform:none;box-shadow:0 18px 38px -22px rgba(120,30,10,.28)}
    .el-figs-wrap .dots{display:flex}

  }
  @media(max-width:900px){
    /*
      Le rail est deja en pleine largeur au-dessus, et sa formule de padding
      retombe seule sur --sp-03 ici. Ne reste que ce qui change vraiment : une
      gouttiere plus large, et une carte qui occupe presque tout le viewport,
      comme les resultats et les mecanismes. Hauteur egale via
      align-items:stretch, defaut du flex.
    */
    .el-axes{gap:var(--sp-03)}
    .el-axis{flex:0 0 clamp(250px,74vw,330px)}
    .el-pipe{margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);width:100vw;
      padding:0 var(--sp-03);scroll-snap-type:x proximity}
    .el-pipe__node{scroll-snap-align:start}
  }
  @media(max-width:720px){
    /*
      La chaine passe a la verticale.

      En rail horizontal sur 375px, cinq etapes tiennent en cinq demi-cartes :
      on ne voit jamais la chaine, seulement un fragment, et rien ne dit qu'il
      en reste. Or c'est la chaine ENTIERE qui porte la these - « une seule
      chaine, zero handoff ». Verticale, elle se lit d'un bloc, dans le sens de
      defilement du telephone, et chaque maillon se decouvre a son tour.

      Le trait passe du haut du noeud a sa gauche : c'est le meme ::before, on
      n'echange que les axes. left est calcule pour que le trait (2px) tombe au
      centre du point (10px) place a -var(--sp-08).
    */
    .el-pipe{display:block;overflow:visible;scroll-snap-type:none;
      margin:var(--sp-14) 0 0;width:auto;padding:0 0 0 var(--sp-08)}
    .el-pipe__node{min-width:0;padding:0 0 var(--sp-12);scroll-snap-align:none}
    .el-pipe__node:last-child{padding-bottom:0}
    /* bottom negatif : a 0 le trait s'arrete au bord du noeud, soit 2px au-dessus
       du point suivant - un cheveu de blanc, mais la chaine parait rompue */
    .el-pipe__node::before{left:calc(var(--sp-08) * -1 + 4px);right:auto;top:6px;bottom:-4px;
      width:2px;height:auto}
    /* le dernier maillon ne relie rien : un trait qui pend annoncerait une suite */
    .el-pipe__node:last-child::before{display:none}
    .el-pipe__node::after{left:calc(var(--sp-08) * -1);top:2px}
    /* decouverte progressive : le trait se tire, le point s'allume, le texte monte */
    .js .el-pipe__node{opacity:0;transform:translateY(14px)}
    .js .el-pipe__node.in{opacity:1;transform:none;
      transition:opacity .5s ease,transform .55s cubic-bezier(.22,1,.36,1)}
    .js .el-pipe__node::before{transform:scaleY(0);transform-origin:top}
    .js .el-pipe__node.in::before{transform:scaleY(1);
      transition:transform .55s cubic-bezier(.22,1,.36,1) .12s}
    .js .el-pipe__node::after{transform:scale(0)}
    .js .el-pipe__node.in::after{transform:scale(1);
      transition:transform .4s cubic-bezier(.34,1.56,.64,1) .06s}

    /* le cercle passe au-dessus du texte. width et non 1fr : etale sur toute la
       colonne il ferait un disque de 343px de haut avant la premiere phrase */
    .el-trio{grid-template-columns:1fr;gap:var(--sp-08)}
    .el-trio__photo{width:clamp(160px,52vw,240px);justify-self:start}
  }
  /*
    reveal() pose la classe immediatement sous prefers-reduced-motion, mais la
    transition, elle, se declencherait quand meme. On la coupe partout ou cette
    page en ajoute - meme clause que pour .ls-reveal dans case-study.css.
  */
  @media(prefers-reduced-motion:reduce){
    .js .el-path > *,.js .el-path.in > *,
    .js .el-pipe__node,.js .el-pipe__node.in{opacity:1;transform:none;transition:none}
    .js .el-pipe__node::before,.js .el-pipe__node.in::before,
    .js .el-pipe__node::after,.js .el-pipe__node.in::after{transform:none;transition:none}
    /* animation:none et pas seulement transition : le cercle entre par une
       keyframe, que couper une transition ne desamorcerait pas */
    .js .el-trio__photo,.js .el-trio.in .el-trio__photo{opacity:1;transform:none;animation:none}
    .el-trio__photo:hover::after{animation:none}
    /* `scale` et non `transform` : c'est la propriete que porte le survol des
       pastilles, la neutraliser ailleurs ne l'atteindrait pas */
    .el-path__s,.el-path__s:hover{scale:1;transition:none}
    /* les trois gestes des vignettes : deux sont des keyframes, un est une
       transition - il faut couper les deux mecanismes, pas un seul */
    /* reveal() pose .in tout de suite ici : il faut donc neutraliser l'etat de
       DEPART autant que l'animation, sinon la plante resterait couchee et la
       feuille dehors - deux dessins qui n'aboutissent jamais */
    .js .el-path__i .plant,.js .el-path.in .plant{transform:none;animation:none}
    .js .el-path__i .leaf,.js .el-path.in .leaf{transform:none;transition:none}
    .js .el-path.in .pour{transform:none;animation:none}
    .el-path__s:hover::after{animation:none}
  }
</style>

<script>
  import { revealAll } from '../scripts/reveal';
  import { rendreDeplacable } from '../scripts/drag';
  import { carrousel, ARC_VIGNETTE } from '../scripts/carousel';
  import type { OptionsCarrousel } from '../scripts/carousel';

  /* les pastilles d'un rail, dans l'ordre du DOM */
  const pastilles = (id: string) => [
    ...document.querySelectorAll<HTMLElement>(`#${id} .dot`),
  ];

  revealAll('.ls-reveal', { threshold: 0, rootMargin: '0px 0px -10% 0px' });
  /* sans cet appel, `.js .tenet{opacity:0}` laisserait la section 03 invisible */
  revealAll('.tenet', { threshold: 0, rootMargin: '0px 0px -12% 0px' });

  /*
    Decouverte progressive. Chaque element est observe pour lui-meme et non
    revele avec sa section : une chaine de sept maillons depasse la hauteur
    d'ecran, donc une reveal de section jouerait
    l'animation des elements du bas pendant qu'ils sont encore hors champ.
    Le rootMargin negatif attend qu'ils soient franchement entres.
    Les regles CSS correspondantes sont conditionnees a `.js` : si ce script ne
    s'execute pas, rien n'est masque.
  */
  revealAll('.el-pipe__node', { threshold: 0, rootMargin: '0px 0px -10% 0px' });
  revealAll('.el-path', { threshold: 0.3 });

  /* au-dela de 1024px les cartes se deplacent ; en deca le conteneur est un rail */
  rendreDeplacable('.el-fig-card', '(max-width:1024px)');

  /*
    Le glisser ecoute pointerdown sur la carte entiere, lien compris : partir du
    bouton deplacerait la carte, et setPointerCapture rendrait le clic imprevisible.
    On arrete l'evenement au lien pour qu'il ne remonte jamais jusqu'a la carte.
  */
  document.querySelectorAll('.el-fig-card a').forEach((a) => {
    a.addEventListener('pointerdown', (e) => e.stopPropagation());
  });

  /* le carrousel des facettes s'amorce lui-meme, dans <Carousel> */

  /*
    Les trois rails propres a la page. `slides` est resolu DANS la piste par
    carrousel(), donc le meme selecteur '.el-fig-card' ne fait pas se croiser les
    resultats et les preuves.

    Les cartes ne se deplacent qu'au-dela de 1024px ; en deca le conteneur est un
    rail, d'ou `actifSi` sur ces deux-la. Les axes, eux, sont un carrousel a
    toutes les largeurs - ce n'est plus une grille qui cede en rail sous 900px -
    donc pas de garde.

    depart : les resultats ouvrent sur la deuxieme carte, qui est au centre du
    jeu ; les preuves sur la premiere, parce que ces quatre-la se lisent dans
    l'ordre et que c'est elle qui porte le chiffre.
  */
  const rail = (id: string, o: Omit<OptionsCarrousel, 'classeDotActive'>) => {
    const piste = document.getElementById(id);
    if (piste) carrousel(piste, { ...o, classeDotActive: 'is-active' });
  };

  rail('elaxes', { slides: '.el-axis', dots: pastilles('elaxesdots'),
    arc: { y: 12, deg: 3, scale: 0.04 }, depart: 0 });
  rail('elfigs', { slides: '.el-fig-card', dots: pastilles('elfigdots'),
    arc: ARC_VIGNETTE, actifSi: '(max-width:1024px)', depart: 1 });
  rail('elproof', { slides: '.el-fig-card', dots: pastilles('elproofdots'),
    arc: ARC_VIGNETTE, actifSi: '(max-width:1024px)', depart: 0 });
</script>
