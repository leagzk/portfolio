---
/*
  ═══ Etude de cas Governance — Systematize a practice (BRIEF §7) ═══

  AUCUNE MAQUETTE POUR CETTE PAGE, et c'est la premiere chose a savoir. Le
  dossier design-reference n'en contient pas : le brief demande « appliquer le
  systeme a Governance », pas de reproduire un artboard. Le gabarit est donc
  celui de Language (§5) - hero, chiffres cles, composition de trois cartes
  depliables, sections au filet - et la COMPOSITION EST DESSINEE ICI. Ses
  proportions ne sont pas celles de Language : deux etudes qui se suivent ne
  doivent pas presenter la meme grille, sans quoi le dispositif se lit comme un
  gabarit et non comme une composition.

  LES CHIFFRES SONT ALIGNES SUR LE CV, ce que le brief §7 demande explicitement.
  Trois ecarts corriges au passage : l'usage moyen de composants passe de 86 a
  87%, les 810+ jours de developpement economises apparaissent, et la communaute
  n'est plus decrite par ses seuls 30+ designers - ils sont 300+ praticiens
  interdisciplinaires sur 5 hubs, dans une organisation Experience Design de 100.

  HUIT CHAPITRES DEVIENNENT TROIS TEMPS. La page faisait 1 067 lignes et huit
  chapitres a plat avec un sommaire flottant. Rien n'est supprime : le propos
  des huit est redistribue entre problem / approach / proof, et la chute du 08
  ferme la page. Ce qui disparait, ce sont les DISPOSITIFS devenus inutiles -
  le sommaire, les cartes jetees en vrac, les bandeaux d'equations - remplaces
  par ceux du gabarit.

  LES VISUELS SONT TOUS CONSERVES : les quatre facettes, la suite d'outils, la
  photo de la communaute, celle du trio aux Awards, et les quatre dessins au
  trait. Les quatre premiers font 8 000 x 4 500 - du 16/9 natif, donc un cadre
  au meme rapport ne rogne rien.
*/
import Base from '../layouts/Base.astro';
import '../styles/etude.css';
import Hero from '../components/Hero.astro';
import ChiffresCles from '../components/ChiffresCles.astro';
import type { Chiffre } from '../components/ChiffresCles.astro';
import CarteDossier from '../components/CarteDossier.astro';
import Carrousel from '../components/Carrousel.astro';
import type { Vignette } from '../components/Carrousel.astro';
import Figure from '../components/Figure.astro';
import Tuiles from '../components/Tuiles.astro';
import type { Tuile } from '../components/Tuiles.astro';
import Bouton from '../components/Bouton.astro';
import Loupe from '../components/Loupe.astro';
import Icone from '../components/Icone.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { chercheurImages } from '../lib/images';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
/* INLINES : ces quatre dessins suivent le theme par currentColor, ce qu'un
   <img> ne permet pas. Voir l'en-tete de system-brand.astro pour le detail. */
import IdeaVisual from '../assets/elements-system/idea-visual.svg';
import ConsumerVisual from '../assets/elements-system/consumer-visual.svg';
import ContributorVisual from '../assets/elements-system/contributor-visual.svg';
import MaintainerVisual from '../assets/elements-system/maintainer-visual.svg';

/* Resolues a la compilation : un nom errone casse le build, la ou un chemin en
   chaine aurait produit un 404 silencieux en production. */
const fichiers = import.meta.glob<ImageMetadata>('../assets/elements-system/*.webp', {
  eager: true, import: 'default',
});
const img = chercheurImages(fichiers, 'elements-system');

/*
  ─── Chiffres cles (BRIEF §5.2) ───
  Les quatre du CV, dans l'ordre ou ils se defendent : ce que le perimetre a
  adopte, a quel point il en depend, ce que ca fait gagner, et qui le fait
  vivre. Le dernier n'est pas une mesure de plus - c'est celui qui dit que le
  systeme ne tient pas dans une seule paire de mains.
*/
const chiffres: Chiffre[] = [
  { nombre: '100%', quoi: 'adoption in the 3 Digital Accelerators', couleur: 'rouge', motif: 'plein',
    contexte: 'R&D, Commercial, Manufacturing. Every product in the perimeter runs on Elements.' },
  { nombre: '87%', quoi: 'component usage per product', couleur: 'bleu', motif: 'bande',
    contexte: 'Teams build on the system, not around it.' },
  { nombre: '÷3', quoi: 'time-to-launch on strategic launches', couleur: 'jaune', motif: 'plein',
    contexte: 'Like Beyfortus®. 810+ development days saved.' },
  { nombre: '35+', quoi: 'contributors, from zero in 18 months', couleur: 'rouge', motif: 'encadre',
    contexte: 'Inner source, not headcount. 4.7/5 practitioner satisfaction.' },
  /*
    LE CINQUIEME PROUVE LA DIRECTION, PAS LE SYSTEME. Les quatre premiers
    disent ce que la plateforme a produit ; celui-ci dit ce que l'equipe est
    devenue. C'etait la seule preuve de leadership de la page, et elle vivait
    au troisieme tiers du troisieme chapitre - derriere un clic, a l'endroit
    le plus enterre, pour l'argument le plus cherche.
  */
  { nombre: '0', quoi: 'resignations in three years', couleur: 'noir', motif: 'plein',
    contexte: 'Design went from one to five. Average completed engagement: 23 months against a one-year target.' },
];

/*
  ─── Les quatre facettes de la plateforme ───
  L'ORDRE EST L'ARGUMENT, porte par les titres incrustes dans les images :
  « you may think it is a Figma library », puis les produits en production, les
  fils de support, l'equipe. Le reordonner casse la phrase.
  Les fichiers font 8 000 x 4 500, du 16/9 natif : le cadre du carrousel est au
  meme rapport, donc rien n'est rogne et rien ne flotte.
*/
const facettes: Vignette[] = [
  { nom: 'elements-library', legende: 'Libraries', titre: 'Libraries',
    alt: 'Figma library screens: a Sanofi navigation bar, buttons, form controls, a data table and a date picker, shown in light and dark mode' },
  { nom: 'elements-digitalproducts-implementation', legende: 'Product implementation', titre: 'Product implementation',
    alt: 'Two Sanofi products in production - a component explorer on a laptop and a public campaign page on a desktop screen - with a mobile study card in front' },
  { nom: 'elements-support', legende: 'Integrated support', titre: 'Integrated support',
    alt: 'Two phone screens side by side: a question answered in the Elements Slack community, and a GitHub issue on the design system component library' },
  { nom: 'elements-team', legende: 'Global team', titre: 'Global team',
    alt: 'Portraits of the team arranged over a world map, showing how widely its members are spread' },
].map((f) => ({ src: img(f.nom), alt: f.alt, legende: f.legende, titre: f.titre }));

/*
  ─── Trois axes, six capabilites ───
  LA TENSION EST LE PROPOS : ce ne sont pas trois axes paralleles, chacun ne
  tient que parce que les deux autres tiennent leur bout. D'ou la chute au
  verso de chaque tuile - c'est elle qu'on retourne pour lire, et c'est elle qui
  dit a quoi sert la capabilite.
  Six tuiles sur trois colonnes : les deux rangees font les trois axes, un axe
  par paire de colonnes voisines.
*/
const capacites: Tuile[] = [
  { eyebrow: 'Brand × Product', rappel: true, couleur: 'rouge', titre: 'Corporate Experience',
    texte: 'The Sanofi brand expressed across corporate and marketing surfaces: identity, theming, multi-brand coherence. <strong>Where the brand becomes tangible.</strong>' },
  { eyebrow: 'Brand × Product', rappel: true, couleur: 'bleu', titre: 'Product Foundations',
    texte: 'The mandatory building blocks of every experience: principles, accessibility, grids, spatial system, motion, data visualisation, theming. <strong>The digital non-negotiables.</strong>' },
  { eyebrow: 'System', rappel: true, couleur: 'jaune', titre: 'Design System',
    texte: 'The reusable, scalable foundation: token architecture, component libraries, integrated guidelines, engineering standards. <strong>From token to production.</strong>' },
  { eyebrow: 'System', rappel: true, couleur: 'noir', titre: 'Experience Patterns',
    texte: 'Standardized but flexible design and interaction patterns, from internal AI-driven tooling to marketing interfaces, business-specific. <strong>Learn once, apply everywhere.</strong>' },
  { eyebrow: 'People', rappel: true, couleur: 'bleu', titre: 'Practitioner Experience',
    texte: 'The service layer around the people who use and contribute to the system: tiered service model, onboarding, unified tooling, rituals, academy. <strong>The humans who use it, and those who craft it.</strong>' },
  { eyebrow: 'People', rappel: true, couleur: 'rouge', titre: 'Community of Practice',
    texte: 'The governance and culture that turn contribution into practice: inner source model, contribution pathways, shared rituals, practice leadership. <strong>The humans who grow it.</strong>' },
];

/*
  ─── Les sept produits, dans l'ordre de la chaine design → dev ───
  L'ORDRE EST LA THESE : on part des tokens et on finit sur la vitrine, sans
  qu'aucun relais n'attende un humain. Le reordonner casse la demonstration du
  ÷3.
*/
const produits = [
  { intitule: 'Token architecture', note: 'multi-brand, multi-theme, multi-surface' },
  { intitule: 'Libraries', note: 'Figma and React, hosted on GitHub' },
  { intitule: 'Figma Companion', note: 'palettes, accessibility checks, layout scaffolding from the canvas' },
  { intitule: 'Storybook', note: 'source of truth, living, versioned documentation' },
  { intitule: 'Elements MCP', note: 'integrated into AI design and engineering workflows' },
  { intitule: 'Support channels', note: 'Slack and Teams streams with automation layers' },
  { intitule: 'Elements Portal', note: 'showcase website' },
].map((p, i) => ({ ...p, repere: String(i + 1).padStart(2, '0') }));

/*
  ─── Les trois mecanismes ───
  Terme = suite : le renversement est le sujet. Ce ne sont pas des valeurs
  affichees mais des contraintes installees, et la troisieme est celle que
  personne n'avait demandee.

  LES TITRES DISENT UN FAIT, PAS UN PRINCIPE - LE PRINCIPE A SA PAGE. Deux
  d'entre eux etaient repris mot pour mot d'Operating System : « Nothing
  ships on a hunch » ouvre son principe 01, et « The floor, not the reach »
  comprime le titre de son 03. Un lecteur qui enchaine les deux pages lisait
  deux fois la meme phrase, et c'etait la page de PREUVE qui s'affaiblissait,
  alors que c'est elle qui detient les faits. Les eyebrows - Rigour,
  Responsibility, Ethics - suffisent a tenir le lien entre les deux pages.

  Les corps suivent : chacun disait ce que son titre dit desormais. Le
  premier passe donc a ce que la discovery regardait VRAIMENT, le second a ce
  que « continuously tested » veut dire - des controles la ou le travail se
  fait, donc une regression qui ne sort jamais du systeme. Le detail de
  l'outillage (axe, les controles natifs de Storybook, la revue manuelle) est
  deja sur Operating System : le rapatrier ici recreerait le doublon qu'on
  vient d'enlever, et deshabillerait une page merge. « So no product team paid the
  cost downstream » tombe pour la meme raison - c'est la phrase du principe
  03 ; a sa place, ce que ca change pour une equipe produit.

  LA TROISIEME NE BOUGE PAS : « A constraint nobody asked me to keep » n'est
  reprise nulle part, et c'est la seule des trois qui raconte un arbitrage
  plutot qu'une mesure.
*/
const mecanismes: Tuile[] = [
  { eyebrow: 'Rigour', couleur: 'rouge', titre: 'Every component passed discovery and community testing.',
    texte: "What the ecosystem actually needs, what already exists, what the people who build with it say back - then one shared convention, written down. <strong>The standard isn't a review at the end, it's the default at the start.</strong>" },
  { eyebrow: 'Responsibility', couleur: 'bleu', titre: '100% WCAG AA before the first major, and continuously tested within the pipeline.',
    texte: 'WCAG AA as the Sanofi digital standard, not our own bar. The checks live where the work happens, so a regression never leaves the system. <strong>Accessibility stopped being a debt a product team inherits.</strong>' },
  { eyebrow: 'Ethics', couleur: 'noir', titre: 'A constraint nobody asked me to keep.',
    texte: 'When AI entered the strategy, I set the line before we built: pragmatic where it accelerates the craft, absolute where it would decide for a human, quality guardrails non-negotiable throughout. <strong>Not everyone draws it. I do.</strong>' },
];
---
<Base
  title="Governance - Systematize a practice - Léa Giezek"
  description="At global scale a system isn't managed, it's governed. Sanofi's experience system: 45+ products, €1M a year, 35+ contributors, Design System Awards finalist."
>

  <Hero
    courant="system-practice-elements"
    eyebrow="Systematize a practice · Sanofi · 2022 - now"
    filigrane="Governance"
    mesure={12.3}
  >
    At global scale, a system isn't managed. It's governed.
    <Fragment slot="intro">
      I built Elements to remove the friction between experts, cut time to launch
      and raise product experience at scale - then moved it from a design system
      to a platform: one pipeline where brand, design and engineering pour into
      the same chain. <b>Design Lead in 2022, Director today: a core team of 9, a
      €1M platform, 45+ product teams.</b>
    </Fragment>
  </Hero>

  <div class="etude">

    {/*
      L'INTRO DIT UNE RESPONSABILITE, PAS UN ORGANIGRAMME. Elle finissait sur
      « Starting in 2022 as Design Lead, running the platform today as its
      Director » : la place la plus lue d'un paragraphe occupee par une
      progression de titres. Un lecteur VP y cherche la TAILLE de ce qui a ete
      tenu - une equipe, un budget, un perimetre -, et les trois chiffres
      existaient deja, enterres dans les chapitres : 9 personnes, 1M d'euros,
      45+ equipes produit. Ils remontent ou on les lit.

      ILS NE DOUBLENT PAS LA BANDE DE CHIFFRES, qui ne montre que des
      RESULTATS - 100% d'adoption, 87% d'usage, le /3, 35+ contributeurs, zero
      demission. Ceux de l'intro sont des moyens. C'est la difference entre ce
      qu'on vous confie et ce que vous en faites.

      ET LA DEFINITION NE PASSE PAS DANS LE HERO. L'echange a ete envisage :
      « Elements is Sanofi's unified experience system… » en description, et
      l'intro redescendue dans la case. Le hero dirait alors ce qu'est un
      OUTIL juste apres un titre qui affirme une position de gouvernance - le
      lecteur apprendrait ce que contient un catalogue avant d'apprendre ce
      qu'a fait quelqu'un. La portee par surfaces et par marques est une
      preuve de perimetre : sa place est contre les chiffres, pas avant eux.

      LA DEFINITION A QUITTE LA COMPOSITION POUR LE BANDEAU. Elle y etait une
      case parmi les chapitres ; elle est maintenant la grande case
      typographique au milieu des chiffres, sur le modele du bloc de l'accueil.
      Elle se lit donc AVANT les chapitres, ce qui est son role - dire ce
      qu'est le systeme dont les quatre chapitres racontent l'histoire.

      SANS BOUTON : la case dit ce qu'EST le systeme, elle n'envoie nulle part.
      Un appel a l'action y ouvrait une porte de sortie a l'endroit exact ou
      l'on vient d'entrer, et la nav porte deja Operating Model.
    */}
    <ChiffresCles chiffres={chiffres} variante="mondrian">
      <Fragment slot="definition">
        <p class="clef-def__eb">The system</p>
        <p class="clef-def__phrase">Elements is Sanofi&apos;s unified experience system - <strong>one design language</strong> serving digital products and delivery platforms globally, from B2B and B2C platforms to internal tools, across products, brands and themes.</p>
      </Fragment>
    </ChiffresCles>

    {/*
      ─── La composition des 3 cartes (BRIEF §5.3) ───
      Sept colonnes, cinq rangees, mais PAS celles de Language, et surtout TROIS
      LARGEURS DE CARTE DIFFERENTES - 600, 436 et 372px a 1120. A portees egales
      les trois faisaient 434 et la composition se lisait en deux colonnes
      jumelles, ce qui est une mise en page, pas une composition. La carte du
      probleme s'etale sur quatre colonnes, celle de l'approche sur trois,
      celle de la preuve sur deux mais sur toute la hauteur.

      data-grille : crochet du trace anime des filets (src/scripts/grille.ts).
      Les cases decoratives portent un .compo__plat qui pousse depuis son coin ;
      les cases blanches n'ont rien a animer et n'en ont donc pas.

      LES TROIS CARTES SONT ECRITES DANS L'ORDRE 01 → 02 → 03, pas dans celui de
      la composition : c'est le DOM qui donne la tabulation et l'empilement
      mobile. Leur place au bureau vient de `aire`, qui n'en depend pas.
    */}
    <div class="compo" id="composition" data-grille>
      <CarteDossier
        id="carte-problem"
        rang="01"
        intitule="The problem"
        titre="Three crafts, three silos - and a system nobody adopted."
        synthese="A designer ships a spec, an engineer rebuilds it, a marketer briefs an agency for a palette the system already had. Then we built the answer brand-first, through a vendor - coherent, but barely adopted."
        couleur="rouge"
        commande="pan-problem"
        large
        aire="1 / 1 / 3 / 5"
      />

      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 1 / 4 / 2"><span class="compo__plat compo__plat--gris"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 2 / 4 / 3"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 3 / 4 / 4"><span class="compo__plat compo__plat--bleu"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 4 / 4 / 5"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 5 / 2 / 6"><span class="compo__plat compo__plat--jaune"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 5 / 3 / 6"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 5 / 4 / 6"><span class="compo__plat compo__plat--rouge"></span></div>

      {/*
        LA CASE QUI RESPIRE. La definition occupait les quatre cases du bas a
        droite ; partie dans le bandeau, elle a laisse un trou - et un trou,
        dans cette composition, ce n'est pas du blanc, c'est le FOND NOIR qui
        reparait. Une seule case blanche le couvre, et sans la redecouper en
        quatre : c'est la respiration de la grille, apres trois cartes et une
        rangee de couleurs.
      */}
      <div class="compo__decor" aria-hidden="true" style="grid-area:4 / 6 / 6 / 8"></div>

      <CarteDossier
        id="carte-approach"
        rang="02"
        intitule="The approach"
        titre="I stopped fixing the output and fixed both sources."
        synthese="Internalize the engineering, rebuild from zero, and run it as a platform: three axes, six capabilities, two governance models - a centralized core, contribution opened outward."
        couleur="bleu"
        commande="pan-approach"
        aire="1 / 6 / 4 / 8"
      />


      <CarteDossier
        id="carte-proof"
        rang="03"
        intitule="The proof"
        titre="Adopted. Trusted. Extended."
        synthese="100% adoption across the three Digital Accelerators, 87% of each product's interface, launches shipped three times faster - and 35+ contributors who keep it alive without me."
        couleur="jaune"
        commande="pan-proof"
        aire="4 / 1 / 6 / 3"
      />

      {/*
        LA QUATRIEME CARTE : le « qui ». Les trois premieres suivent le
        systeme - le probleme, l'approche, la preuve - et cette quatrieme suit
        les gens. Elle prend les colonnes 3 a 5 de la bande basse, la ou 02
        s'arretait et ou vivaient l'aplat noir et le rouge ; 02 recule d'une
        colonne, et les deux cartes font 354 et 345px, soit la meme bande.

        NOIRE, ET C'EST LA SEULE. Le rouge, le bleu et le jaune sont pris par
        les trois chapitres du systeme ; le noir dit que celui-ci parle d'autre
        chose - et il reste dans la palette Mondrian, qui s'en sert autant que
        des trois autres.
      */}
      <CarteDossier
        id="carte-team"
        rang="04"
        intitule="The team"
        titre="I didn't build a system I hold together."
        synthese="Autonomy, a capability each person owns, and one question every week: is the work moving, and is the person growing. Zero resignations in three years - and an Awards category that called it a leadership story."
        couleur="noir"
        commande="pan-team"
        aire="4 / 3 / 6 / 6"
      />
    </div>

    {/* ═══════════ 01 · The problem ═══════════ */}
    <section class="pan" id="pan-problem" aria-labelledby="titre-problem">
      {/* Un titre de niveau 2, invisible mais dans le plan du document : sans
          lui on sauterait de h1 a h3. Voir system-brand.astro. */}
      <h2 class="sr-only" id="titre-problem">01 &middot; The problem</h2>

      <div class="subsec">
        {/* Le CV n'a pas d'item pour le probleme - il ne liste que des
            realisations. « Root cause » suit sa forme - deux mots sans
            article, comme Investment case - et nomme le SUJET du bloc comme
            tous les autres surtitres de la page. C'est aussi ce que le bloc
            etablit, au mot pres : « Not incompetence - distance », puis « The
            capability was there. The structure to use it wasn't. » Un
            goulot d'etranglement est un symptome ; la cause est en amont. */}
        <p class="eb">Root cause</p>
        <div class="split">
          <p class="lead">Not incompetence. <em class="em-rouge">Distance.</em></p>
          <div class="body">
            <p><strong data-sommaire>Nobody meets. Everybody rebuilds. In silos, again and again.</strong> A designer ships a spec. An engineer rebuilds it from scratch. A marketer briefs an agency for a palette the system already had. Three crafts, three silos, each solving in private what the others had already solved.</p>
            <p>And it wasn't one handoff. The <em>what</em> was fragmented: products and touchpoints that didn't share a language, <strong>design and engineering debt compounding with every launch</strong>, at global scale. The <em>how</em> was worse: practices siloed team by team. Some platforms carry hundreds of surfaces on their own - one marketing platform alone delivers 200+ websites worldwide. <strong data-sommaire>The same cost, paid forty-five times over.</strong> <strong data-sommaire>The capability was there. The structure to use it wasn't.</strong></p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">Investment case</p>
        <div class="split">
          <p class="lead">A system this size is <em class="em-rouge">two bets in one.</em> It only pays if it's adopted.</p>
          <div class="body">
            <p><strong>Cost rationalization</strong> first, so forty-five product teams stop rebuilding the same thing. <strong>Systematize at the source, and you reach every one of them at once.</strong> Then <strong>experience at scale</strong>: one coherent journey across every touchpoint - service design for an entire organization, from employee to patient.</p>
            <p>A system nobody trusts is the worst of both worlds: you fund the platform <em>and</em> the fragmentation it was meant to erase.</p>
          </div>
        </div>
      </div>

      {/*
        Le bloc sombre porte l'aveu, et lui seul : c'est le moment ou le recit
        se retourne. Le mettre en corps courant l'aurait noye entre deux
        analyses ; lui donner tout le chapitre, comme avant, en faisait six
        paragraphes au noir ou l'accent n'accentuait plus rien.
      */}
      {/*
        LE BLOC SOMBRE REPASSE EN SOUS-PARTIE. Il isolait l'aveu sur fond noir,
        et c'etait defendable tant que le chapitre n'avait pas de grammaire :
        maintenant que les trois blocs partagent surtitre, phrase forte a
        gauche et texte a droite, celui-la rompait la colonne sans que le
        contenu le demande - l'aveu tient dans la phrase, pas dans le fond.

        La chute garde son role de chute, en exergue : c'est le seul endroit du
        chapitre ou une phrase conclut au lieu d'avancer.
      */}
      <div class="subsec">
        <p class="eb">Executive partnership</p>
        <div class="split">
          <p class="lead">A €1M bet on a model, <em class="em-rouge">not a line item.</em></p>
          <div class="body">
            <p><strong>You can't outsource the thing your whole system depends on.</strong> The engineering was externalized before my time - not my call. But <strong>the bet I shared, and got wrong, was priority.</strong> Sanofi's rebranding was a massive effort, and we poured the roadmap into brand alignment - a beautifully unified system, piloted on sanofi.com and boxed into its framework. We quietly deprioritized what product teams actually needed.</p>
            <p>So the system was coherent, and barely adopted. <strong>A design system nobody adopts is the oldest failure in the field</strong>, and we'd walked straight into it.</p>
            <p>So I stopped fixing the output and fixed both sources. <strong>I pushed to internalize engineering</strong> - inside Sanofi, one team, one objective: adoption. And I led the rebuild from zero, this time from a holistic view of the whole portfolio. <strong>Internalizing means owning the budget, the hiring, the reorg. I drove it, and I carried it through.</strong></p>
          </div>
        </div>
      </div>

      {/* Le pied de chapitre : retour au sommaire a gauche, chapitre suivant
          a droite. Voir .pan__pied dans etude.css et [data-haut] dans
          src/scripts/dossier.ts. */}
      <div class="pan__pied">
        <button class="pan__haut" type="button" data-haut aria-label="Back to the top of the chapters">
          <Icone nom="fleche-haut" taille={20} />
        </button>
        <Bouton variante="bleu" class="suite" commande="carte-approach">Next: the approach →</Bouton>
      </div>
    </section>

    {/* ═══════════ 02 · The approach ═══════════ */}
    <section class="pan" id="pan-approach" aria-labelledby="titre-approach">
      <h2 class="sr-only" id="titre-approach">02 &middot; The approach</h2>

      <div class="subsec">
        <p class="eb">Organisation &amp; people</p>
        <div class="split">
          <p class="lead">Scaling is a series of bets. <em class="em-rouge">I refused to place them blind.</em></p>
          <div class="body">
            <p><strong data-sommaire>The decision was the easy part. Owning it wasn't.</strong> I designed the target org - its capabilities, its roles, one operating model - and wrote the job descriptions that made it real. Then I hired into them: from one designer to <strong>a core team of 9, organised by capability with accountable leads</strong>. The budget came with it, and the line between what the platform funded and what it shipped was mine.</p>
            <p>Governance was where I refused the easy answer - two models, not one. <strong data-sommaire>A centralized core for building, a tiered service for support.</strong> The build side stays hybrid: my team owns the core, contribution opens outward through inner source, never fully federated - that's the trap. The support side is tiered by each product's place in the portfolio and re-reviewed quarterly, so it follows strategy and not the loudest request.</p>
            <p>I set the direction, carried it to leadership, then handed my team the operational goal as <strong>OKRs of their own</strong>, tied to the company's annual objectives - our ambition inside a shared project, never beside it. Every decision got the same reading: what each opened, what it exposed, what it cost to reverse - surfaced early, then locked with the team or my stakeholders.</p>
          </div>
        </div>
        <p class="qt">This is the layer no contributor can claim. <strong>Not the components - the conditions.</strong></p>
      </div>

      <div class="subsec">
        <p class="eb">Vision &amp; strategy</p>
        <div class="split">
          <p class="lead" data-sommaire>You maintain a design system. <em class="em-bleu">You run a platform.</em></p>
          <div class="body">
            <p>Elements isn't a single product anymore. It's several products under one governance, one pipeline, for one community. <strong>Three axes, six capabilities</strong> - and the tension is the point: they aren't parallel, each one only works because the other two hold their end.</p>
            {/* Elle conclut l'architecture, pas l'erreur : posee au chapitre 01
                elle commentait la faute avant qu'on ait vu ce qu'elle a produit.
                Ici, le lecteur vient de lire les trois axes - la phrase dit d'ou
                ils viennent. */}
            <p class="qt"><strong>The best architecture I built started as the one I got backwards.</strong></p>
          </div>
        </div>
        <Tuiles tuiles={capacites} colonnes={3} label="Three axes, six capabilities" hauteur={300} />
      </div>

      <div class="subsec">
        <p class="eb">Build</p>
        <ol class="chaine">
          {produits.map((p) => (
            <li class="chaine__pas">
              <span class="chaine__n">{p.repere}</span>
              <span class="chaine__nom">{p.intitule}</span>
              <span class="chaine__note">{p.note}</span>
            </li>
          ))}
        </ol>
        <div class="body">
          <p><strong>The pipeline is the thesis made physical.</strong> Brand, design and engineering pour into the same chain - the wait between experts, engineered out. That's the ÷3: not people working faster, but expertises no longer waiting on each other.</p>
        </div>
        <Figure
          src={img('Elements-toolingsuite')}
          alt="The Elements mark at the centre of its tooling suite, each tool grouped by role: documentation with Confluence and Zeroheight, design libraries with Figma, code packages with GitHub and React, code showcase with Storybook, communities with Slack and Teams, and AI solutions"
          legende="The tooling suite, grouped by role"
          ratio="16 / 9"
          sizes="(min-width: 900px) 1040px, 92vw"
        />
      </div>

      <div class="subsec">
        <p class="eb">I don't state values. I install them.</p>
        <Tuiles tuiles={mecanismes} colonnes={3} label="The three mechanisms" hauteur={320} />
      </div>

      {/* Le pied de chapitre : retour au sommaire a gauche, chapitre suivant
          a droite. Voir .pan__pied dans etude.css et [data-haut] dans
          src/scripts/dossier.ts. */}
      <div class="pan__pied">
        <button class="pan__haut" type="button" data-haut aria-label="Back to the top of the chapters">
          <Icone nom="fleche-haut" taille={20} />
        </button>
        <Bouton variante="bleu" class="suite" commande="carte-proof">Next: the proof →</Bouton>
      </div>
    </section>

    {/* ═══════════ 03 · The proof ═══════════ */}
    <section class="pan" id="pan-proof" aria-labelledby="titre-proof">
      <h2 class="sr-only" id="titre-proof">03 &middot; The proof</h2>

      <div class="subsec">
        <p class="eb">Business impact</p>
        <div class="split">
          <p class="lead">The numbers are the system's, <em class="em-rouge">not mine.</em></p>
          <div class="body">
            <p><strong data-sommaire>A structure only counts if it holds.</strong> This one does. It started with a bold call: switching a role to a new direction, and selling it to my Head of Design to win the sponsorship it needed. From there, <strong>zero users to a community of 2,000+ practitioners.</strong></p>
            <p><strong>And none of it was measured after the fact.</strong> I ran the platform on live instruments, read as decisions and not trophies: DORA metrics every sprint, a practitioner satisfaction survey twice a year, priorities re-reviewed quarterly. The data told me where to invest, what to deprecate, which product needed support next - and we acted on it: the support model rebuilt, the rituals reshaped, rotating roles introduced because the signal said so.</p>
            <p>4.7 out of 5 on practitioner satisfaction, twice a year. <strong data-sommaire>People don't comply with Elements, they trust it.</strong></p>
            <p class="qt">Adopted. Trusted. Extended. <strong>Everything a system needs to outlive the person who built it.</strong></p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">What Elements actually is</p>
        <Carrousel
          label="Facets of the platform"
          eyebrow="You may think it is a Figma library"
          vignettes={facettes}
          ratio="16 / 9"
          fr={1.7778}
          largeur="78%"
          {/* Deux colonnes au bureau : les cinq facettes se voient d'un coup,
              la cinquieme ouvre sa rangee. Sous 860px la piste revient, parce
              qu'une mosaique de cinq captures y ferait cinq ecrans a traverser
              avant la suite du chapitre. */}
          mosaique={2}
          sizes="(min-width: 900px) 520px, 90vw"
        />
        <p class="cap portee">Multi-brand &middot; multi-theme &middot; B2B / B2C / internal &middot; from employee to patient &middot; worldwide</p>
      </div>

      <div class="subsec">
        <p class="eb">Influence &amp; community</p>
        <div class="split">
          <p class="lead">A design system you install. <em class="em-bleu">A community you have to earn.</em></p>
          <div class="body">
            <p>Most system owners treat community as a comms afterthought. I made it the strategy - adoption never comes from mandate, only from ownership. <strong>A system nobody believes in dies with its founder; one a community owns, outlives them.</strong></p>
            <p><strong>Experience runs both ways.</strong> Elements serves end users - patients, healthcare professionals - and it serves the people who build for them. A practitioner is a user too, so their practice gets the same care as any patient journey. <em>Design the experience of the people designing the experience.</em></p>
          </div>
        </div>

        {/* Le rang tombe a l'endroit exact ou « de consumer a maintainer » cesse
            d'etre une idee pour devenir un dispositif. */}
        <p class="parcours" aria-label="The practitioner path: consumer, then contributor, then maintainer">
          <span class="parcours__s"><span class="parcours__i" aria-hidden="true"><ConsumerVisual /></span>consumer</span>
          <span class="parcours__a" aria-hidden="true"><Icone nom="fleche" taille={20} /></span>
          <span class="parcours__s"><span class="parcours__i" aria-hidden="true"><ContributorVisual /></span>contributor</span>
          <span class="parcours__a" aria-hidden="true"><Icone nom="fleche" taille={20} /></span>
          <span class="parcours__s"><span class="parcours__i" aria-hidden="true"><MaintainerVisual /></span>maintainer</span>
        </p>

        <div class="split split--haut">
          <div class="body">
            <p>So I created the <strong>Practitioner Experience capability</strong> to make that real, and elevated one of my team to run it - her career growth and the company's outcome, paired. I set the direction: community-led adoption, contribution over control. My team built and ran the machine - the Portal, the Demo, office hours, contribution and triage rituals, onboarding.</p>
            <p>This is how a <strong>core interdisciplinary community of 300+ across 5 global hubs</strong> - 30+ product designers among them, partnering with an Experience Design Organisation of 100 - became one practice. Not a mailing list: a contribution model adapted from Zalando's, where everyone gives at the level of their skill.</p>
          </div>
          <div class="pile">
            <Figure
              src={img('design-community')}
              alt="The design community gathered outside in front of the Arc de Triomphe in Paris, fifteen practitioners posing together on a winter afternoon"
              legende="The community, in one place for once"
              ratio="3 / 4"
              ajuste="cover"
              sizes="(min-width: 900px) 420px, 90vw"
            />
          </div>
        </div>

        <div class="body">
          <p><strong data-sommaire>87% average usage per product in production, from near-zero.</strong> That isn't a launch - it's <strong>change management at scale</strong>: turning resistance into ownership across 45+ product teams, one team, one hub, one priority at a time. It takes patience and it takes refusing - the two are the same discipline, not opposites.</p>
        </div>

      </div>

      {/* Le pied de chapitre : retour au sommaire a gauche, chapitre suivant
          a droite. Voir .pan__pied dans etude.css et [data-haut] dans
          src/scripts/dossier.ts. */}
      <div class="pan__pied">
        <button class="pan__haut" type="button" data-haut aria-label="Back to the top of the chapters">
          <Icone nom="fleche-haut" taille={20} />
        </button>
        <Bouton variante="bleu" class="suite" commande="carte-team">Next: the team &rarr;</Bouton>
      </div>
    </section>
    {/* ═══════════ 04 · The team ═══════════ */}
    <section class="pan" id="pan-team" aria-labelledby="titre-team">
      <h2 class="sr-only" id="titre-team">04 &middot; The team</h2>

      <div class="subsec">
        <div class="split">
          <p class="lead">Every week, the same question: <em class="em-rouge">is the work moving, and is the person growing.</em></p>
          <div class="body">
            <p><strong data-sommaire>I didn't build a system I hold together. I built the conditions where it holds itself.</strong></p>
            <ul class="pts">
            <li><strong>Autonomous streams</strong>, split by capability, each moving without a central decision - inside a <strong>collective framing</strong>, so a stream deciding alone still decides inside a frame it co-wrote.</li>
            <li><strong>Shared rituals</strong> are the connective tissue keeping five hubs one system rather than an archipelago.</li>
            {/* Cette puce ouvrait sur « A team that isn't well doesn't ship » :
                mot pour mot la premiere phrase du footer, qui se lit au bas de
                CETTE page comme des six autres. Elle dit maintenant ce que la
                page est seule a pouvoir dire - non pas la conviction, mais la
                place qu'elle a prise dans un plan. */}
            <li><strong>Wellbeing was a line in the plan</strong>, not a nice-to-have on the side - load-bearing, and resourced like any other dependency.</li>
            <li>When a product team was under water, we got into the work <em>with</em> them - auditing, co-building, sharing the load. The standard I set: you don't point at the problem from across the room, you cross it. <strong>A team that only points the way isn't leading; it's watching.</strong></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">People</p>
        <div class="split split--haut">
          <div class="pile">
            <p class="lead" data-sommaire>Zero resignations <em class="em-rouge">in three years.</em></p>
            <div class="body">
              <p><strong>I owned the <em>why</em> and the <em>what</em>. They owned the <em>how</em></strong> - and made it sharper than I could have specified. Each capability runs itself through the team I recruited and grew; agile is the tempo, not a checkbox. <strong>Nothing shipped without us aligned, and nothing waited on me to be decided.</strong> Design went from one to five. Average completed engagement: <strong>23 months against a one-year target.</strong></p>
              <p>The people who left in 2026 left for reasons none of us chose - a budget call, a product remap, a scoped engagement that ended as planned. <strong>Not one left me.</strong> People stay where their growth and their wellbeing are part of the plan - the same care I built into the system, pointed at the team.</p>
              <p class="qt" data-sommaire>My job wasn't to hold it up. <strong>It was to build a structure that outlasts any of us.</strong></p>
            </div>
          </div>
          <div class="pile">
            <Figure
              src={img('lea-nicolas-rodolphe-elements-awards')}
              alt="Léa Giezek, Nicolas Chatelain and Rodolphe Peruzza together at the Design System Awards"
              legende="<strong>Design System Awards 2025</strong> <span class='tag tag--on'>Governance finalist</span> alongside HP and Tesco. The recognition that means the most to me is the <em>category</em> - because this was never only a craft story. It was a leadership one."
              {/* LA SOURCE EST CARREE depuis qu'on l'a recadree a 940x940 sur
                  l'original 2000x3000 : « cover » n'a donc plus rien a rogner.
                  Le recadrage est dans le fichier et non dans le CSS parce
                  qu'aucun reglage d'`object-position` ne pouvait exclure le
                  quatrieme visage - un carre garde les deux tiers de la hauteur
                  d'une image 2:3, et ce visage commence au-dessus de ce seuil. */}
              ratio="1 / 1"
              ajuste="cover"
              sizes="(min-width: 900px) 420px, 90vw"
            />
            <p class="cap"><ExternalLink href="https://nicolaschatelain.com" variant="inline">Nicolas Chatelain</ExternalLink> led the People axis, from Experience Operations enablement to the Community of Practice engagement plan. <ExternalLink href="https://rodolphe.design/chat" variant="inline">Rodolphe Peruzza</ExternalLink> led the System axis, from craft to experience-pattern industrialization.</p>
          </div>
        </div>
      </div>

      {/* Le dessin et sa preuve : l.idee n.est pas venue de la feuille de
          route, et c.est tout le propos du chapitre. */}
      <div class="subsec">
        <p class="eb">Innovation</p>
        <div class="taught">
          <div class="taught__viz" aria-hidden="true"><IdeaVisual /></div>
          <div class="body">
          {/* UN SEUL PARAGRAPHE : l'idee venue d'un contributeur et les carrieres
              qui ont grandi la sont la meme phrase - la premiere est la preuve
              de la seconde. Separees, la chute retombait avant d'avoir servi.
              L'exergue garde son filet : c'est elle qui porte. */}
            <p class="qt">The Elements MCP didn&apos;t come from my roadmap. <strong>It came from a contributor.</strong> And it&apos;s where careers grew, mine included: people levelled up by contributing and teaching, not by climbing a ladder - reverse mentoring that kept me learning as much as I led.</p>
          </div>
        </div>
      </div>

      <div class="closing">
        <h2>I removed the wait between design and engineering. <em class="em-bleu">There's one wait left.</em></h2>
        <p class="cbody">I've argued Elements belongs closer to engineering - one reporting line from design to production. Not for tidiness: the border between design and engineering is dissolving, and a structure that keeps the two crafts siloed slows everyone down. It's <strong>velocity</strong>, and it's <strong>proximity</strong> - end to end with product teams instead of handing work across expertise walls. Better to build that structure before the shift forces it than retrofit it after. The move I made once - agency to in-house - pointed here. <strong>This is the next mile of the same road.</strong></p>
        <p class="cbody">Not a system people obey - one they own. <strong>That's what growing a culture means.</strong></p>
        <p class="signature">Design systems ship standards.<br /><em class="em-bleu">Experience systems grow culture.</em></p>
        <Bouton variante="bleu" href="/system-event">See it off the screen →</Bouton>
      </div>

      {/* LE PIED DU DERNIER CHAPITRE. A gauche, le meme retour en haut
          qu'ailleurs : il remonte sans rien refermer. A droite, pas de
          « Next: ... » - il n'y a pas de tuile 05, et le sommaire des
          quatre cartes est reduit a celle-ci ; ce bouton-la le rouvre. Les deux
          remontent, l'un garde le chapitre ouvert, l'autre referme tout.
          Voir .pan__pied dans etude.css et dossier.ts. */}
      <div class="pan__pied">
        <button class="pan__haut" type="button" data-haut aria-label="Back to the top of the chapters">
          <Icone nom="fleche-haut" taille={20} />
        </button>
        <Bouton variante="noir" class="suite" ferme>Back to the four chapters &uarr;</Bouton>
      </div>
    </section>

  </div>

  {/* une seule loupe pour toutes les series agrandissables de la page */}
  <Loupe />

</Base>

<style is:global>
  /* ═══ Ce qui est propre a l'etude Governance ═══ */

  /*
    LA COMPOSITION. Sept colonnes et cinq rangees, comme Language, mais avec
    d'autres proportions et un autre decoupage : la bande fine traverse au
    milieu et non au tiers, la colonne large est la quatrieme, et la carte de la
    preuve occupe toute la hauteur a droite. Deux etudes qui se suivent ne
    doivent pas presenter la meme grille - le dispositif se lirait comme un
    gabarit, et non comme une composition.

    LES RANGEES SONT DES PLANCHERS, PAS DES HAUTEURS FIXES. En pixels fixes, les
    colonnes retrecissent entre 861 et 1120px pendant que les rangees ne bougent
    pas : la synthese gagne des lignes et la carte, qui est en overflow:hidden,
    les avale. C'est le defaut mesure sur Language a l'etape 4, et il n'y a
    aucune raison de le refaire ici.

    AU-DESSUS DU POINT DE RUPTURE SEULEMENT : etude.css remet la composition sur
    une colonne sous 860px, et cette declaration-ci vit dans la page, donc PLUS
    LOIN dans le bundle. A specificite egale elle gagnerait, y compris dans la
    requete media.
  */
  @media(min-width:861px){
    .compo{grid-template-columns:15fr 24fr 9fr 18fr 11fr 23fr 18fr;
      grid-template-rows:minmax(190px,auto) minmax(80px,auto) 36px
        minmax(200px,auto) minmax(70px,auto)}
  }

  /*
    ─── La chaine des sept produits ───
    Sept colonnes separees par le filet, comme la composition : c'est une
    CHAINE, et le filet est ce qui dit que chaque maillon touche le suivant.
    Des cartes detachees auraient montre sept produits ; la chaine montre un
    pipeline, qui est le propos.
  */
  .pan .chaine{list-style:none;margin:0;padding:0;display:grid;
    grid-template-columns:repeat(7,minmax(0,1fr));gap:var(--rule-fine);
    background:var(--text);border:var(--rule-fine) solid var(--text)}
  .pan .chaine__pas{background:var(--white);padding:20px 14px;display:flex;
    flex-direction:column;gap:8px;min-width:0}
  .pan .chaine__n{font-family:var(--display);font-size:13px;font-weight:900;
    letter-spacing:.12em;color:var(--red)}
  .pan .chaine__nom{font-weight:700;font-size:15px;line-height:1.25}
  .pan .chaine__note{font-size:13px;line-height:1.5;color:var(--text-body)}

  /*
    ─── Le parcours du praticien ───
    consumer → contributor → maintainer. Les trois dessins sont INLINES et non
    poses en <img> : leur trait suit --accent par currentColor, ce qu'un
    document separe ne permet pas.
  */
  .pan .parcours{margin:0;display:flex;align-items:center;justify-content:center;
    gap:20px;flex-wrap:wrap;padding:28px 20px;
    border:var(--rule-fine) solid var(--text);background:var(--white)}
  .pan .parcours__s{display:flex;align-items:center;gap:12px;
    font-family:var(--display);font-size:22px;font-weight:900;letter-spacing:-.01em}
  .pan .parcours__i{display:grid;place-items:center;width:46px;height:46px;
    flex:none;color:var(--accent)}
  .pan .parcours__i svg{width:100%;height:auto;display:block}
  .pan .parcours__a{display:grid;place-items:center;color:var(--blue)}

  /* Le perimetre, en une ligne centree sous les quatre facettes : c'est une
     legende de serie, pas un paragraphe. */
  .pan .portee{text-align:center;letter-spacing:.06em}

  /*
    LA SIGNATURE FERME LA PAGE, et c'est la phrase du site entier - celle du
    hero d'accueil, de la banniere LinkedIn et du CV (BRIEF §0bis). Elle est
    posee en display, au-dessus du bouton, et c'est le seul endroit de l'etude
    ou une phrase n'a ni surtitre ni corps autour d'elle.
  */
  .pan .signature{margin:8px 0 0;font-family:var(--display);font-size:30px;
    line-height:1.15;font-weight:900;letter-spacing:-.02em;max-width:640px}

  @media(max-width:860px){
    .pan .signature{font-size:24px}
    /* Sept colonnes a 390px font 48px de large : la chaine se replie en deux,
       et le filet continue de dire que les maillons se touchent. */
    .pan .chaine{grid-template-columns:repeat(2,minmax(0,1fr))}
    .pan .parcours{gap:12px;padding:20px 16px}
    .pan .parcours__s{font-size:18px}
    .pan .parcours__i{width:38px;height:38px}
  }
</style>

