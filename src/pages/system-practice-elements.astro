  .el-equations{margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--sp-03)}
  .el-eq{padding:var(--sp-12);border-radius:28px;background:var(--card);
    border:1px solid var(--line);border-width:max(1px,var(--edge-w));border-color:var(--line);
    box-shadow:0 18px 38px -22px rgba(120,30,10,.28)}
  /* le corps descend de clamp(24px,3vw,40px) a l'echelle des titres de carte de
     la page : a 40px, « per-capability ownership » tenait sur quatre lignes dans
     une colonne de 280px */
  .el-eq__line{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 var(--sp-02);
    font-family:var(--display);font-weight:400;font-size:clamp(20px,2.1vw,28px);line-height:1.15;letter-spacing:-.02em}
  .el-eq__v{color:var(--ink)}
  .el-eq__s{color:var(--ink-muted)}
  .el-eq__m{color:var(--accent-alt)}
  .el-eq__note{margin:12px 0 0;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:var(--ink-muted)}

  /* les gens : prose, jamais une grille */
  .el-people{list-style:none;margin:var(--sp-08) 0 0;padding:0;display:grid;gap:var(--sp-06);max-width:62ch}
  .el-people li{font-size:clamp(16px,1.6vw,20px);line-height:1.62;color:var(--ink-soft)}
