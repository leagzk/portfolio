---
/*
  ═══ Etude de cas Governance — Systematize a practice (BRIEF §7) ═══

  AUCUNE MAQUETTE POUR CETTE PAGE, et c'est la premiere chose a savoir. Le
  dossier design-reference n'en contient pas : le brief demande « appliquer le
  systeme a Governance », pas de reproduire un artboard. Le gabarit est donc
  celui de Language (§5) - hero, chiffres cles, composition de trois cartes
  depliables, sections au filet - et la COMPOSITION EST DESSINEE ICI. Ses
  proportions ne sont pas celles de Language : deux etudes qui se suivent ne
  doivent pas presenter la meme grille, sans quoi le dispositif se lit comme un
  gabarit et non comme une composition.

  LES CHIFFRES SONT ALIGNES SUR LE CV, ce que le brief §7 demande explicitement.
  Trois ecarts corriges au passage : l'usage moyen de composants passe de 86 a
  87%, les 810+ jours de developpement economises apparaissent, et la communaute
  n'est plus decrite par ses seuls 30+ designers - ils sont 300+ praticiens
  interdisciplinaires sur 5 hubs, dans une organisation Experience Design de 100.

  HUIT CHAPITRES DEVIENNENT TROIS TEMPS. La page faisait 1 067 lignes et huit
  chapitres a plat avec un sommaire flottant. Rien n'est supprime : le propos
  des huit est redistribue entre problem / approach / proof, et la chute du 08
  ferme la page. Ce qui disparait, ce sont les DISPOSITIFS devenus inutiles -
  le sommaire, les cartes jetees en vrac, les bandeaux d'equations - remplaces
  par ceux du gabarit.

  LES VISUELS SONT TOUS CONSERVES : les quatre facettes, la suite d'outils, la
  photo de la communaute, celle du trio aux Awards, et les quatre dessins au
  trait. Les quatre premiers font 8 000 x 4 500 - du 16/9 natif, donc un cadre
  au meme rapport ne rogne rien.
*/
import Base from '../layouts/Base.astro';
import '../styles/etude.css';
import Hero from '../components/Hero.astro';
import ChiffresCles from '../components/ChiffresCles.astro';
import type { Chiffre } from '../components/ChiffresCles.astro';
import CarteDossier from '../components/CarteDossier.astro';
import Carrousel from '../components/Carrousel.astro';
import type { Vignette } from '../components/Carrousel.astro';
import Figure from '../components/Figure.astro';
import Tuiles from '../components/Tuiles.astro';
import type { Tuile } from '../components/Tuiles.astro';
import Bouton from '../components/Bouton.astro';
import Loupe from '../components/Loupe.astro';
import Icone from '../components/Icone.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { chercheurImages } from '../lib/images';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
/* INLINES : ces quatre dessins suivent le theme par currentColor, ce qu'un
   <img> ne permet pas. Voir l'en-tete de system-brand.astro pour le detail. */
import IdeaVisual from '../assets/elements-system/idea-visual.svg';
import ConsumerVisual from '../assets/elements-system/consumer-visual.svg';
import ContributorVisual from '../assets/elements-system/contributor-visual.svg';
import MaintainerVisual from '../assets/elements-system/maintainer-visual.svg';

/* Resolues a la compilation : un nom errone casse le build, la ou un chemin en
   chaine aurait produit un 404 silencieux en production. */
const fichiers = import.meta.glob<ImageMetadata>('../assets/elements-system/*.webp', {
  eager: true, import: 'default',
});
const img = chercheurImages(fichiers, 'elements-system');

/*
  ─── Chiffres cles (BRIEF §5.2) ───
  Les quatre du CV, dans l'ordre ou ils se defendent : ce que le perimetre a
  adopte, a quel point il en depend, ce que ca fait gagner, et qui le fait
  vivre. Le dernier n'est pas une mesure de plus - c'est celui qui dit que le
  systeme ne tient pas dans une seule paire de mains.
*/
const chiffres: Chiffre[] = [
  { nombre: '100%', quoi: 'adoption in the 3 Digital Accelerators',
    contexte: 'R&D, Commercial, Manufacturing. Every product in the perimeter runs on Elements.' },
  { nombre: '87%', quoi: 'component usage per product',
    contexte: 'Teams build on the system, not around it.' },
  { nombre: '÷3', quoi: 'time-to-launch on strategic launches',
    contexte: 'Like Beyfortus®. 810+ development days saved.' },
  { nombre: '35+', quoi: 'contributors, from zero in 18 months',
    contexte: 'Inner source, not headcount. 4.7/5 practitioner satisfaction.' },
];

/*
  ─── Les quatre facettes de la plateforme ───
  L'ORDRE EST L'ARGUMENT, porte par les titres incrustes dans les images :
  « you may think it is a Figma library », puis les produits en production, les
  fils de support, l'equipe. Le reordonner casse la phrase.
  Les fichiers font 8 000 x 4 500, du 16/9 natif : le cadre du carrousel est au
  meme rapport, donc rien n'est rogne et rien ne flotte.
*/
const facettes: Vignette[] = [
  { nom: 'elements-library', legende: 'Libraries', titre: 'Libraries',
    alt: 'Figma library screens: a Sanofi navigation bar, buttons, form controls, a data table and a date picker, shown in light and dark mode' },
  { nom: 'elements-digitalproducts-implementation', legende: 'Product implementation', titre: 'Product implementation',
    alt: 'Two Sanofi products in production - a component explorer on a laptop and a public campaign page on a desktop screen - with a mobile study card in front' },
  { nom: 'elements-support', legende: 'Integrated support', titre: 'Integrated support',
    alt: 'Two phone screens side by side: a question answered in the Elements Slack community, and a GitHub issue on the design system component library' },
  { nom: 'elements-team', legende: 'Global team', titre: 'Global team',
    alt: 'Portraits of the team arranged over a world map, showing how widely its members are spread' },
].map((f) => ({ src: img(f.nom), alt: f.alt, legende: f.legende, titre: f.titre }));

/*
  ─── Trois axes, six capabilites ───
  LA TENSION EST LE PROPOS : ce ne sont pas trois axes paralleles, chacun ne
  tient que parce que les deux autres tiennent leur bout. D'ou la chute au
  verso de chaque tuile - c'est elle qu'on retourne pour lire, et c'est elle qui
  dit a quoi sert la capabilite.
  Six tuiles sur trois colonnes : les deux rangees font les trois axes, un axe
  par paire de colonnes voisines.
*/
const capacites: Tuile[] = [
  { eyebrow: 'Brand × Product', rappel: true, couleur: 'rouge', titre: 'Corporate Experience',
    texte: 'The Sanofi brand expressed across corporate and marketing surfaces: identity, theming, multi-brand coherence. <strong>Where the brand becomes tangible.</strong>' },
  { eyebrow: 'Brand × Product', rappel: true, couleur: 'bleu', titre: 'Product Foundations',
    texte: 'The mandatory building blocks of every experience: principles, accessibility, grids, spatial system, motion, data visualisation, theming. <strong>The digital non-negotiables.</strong>' },
  { eyebrow: 'System', rappel: true, couleur: 'jaune', titre: 'Design System',
    texte: 'The reusable, scalable foundation: token architecture, component libraries, integrated guidelines, engineering standards. <strong>From token to production.</strong>' },
  { eyebrow: 'System', rappel: true, couleur: 'noir', titre: 'Experience Patterns',
    texte: 'Standardized but flexible design and interaction patterns, from internal AI-driven tooling to marketing interfaces, business-specific. <strong>Learn once, apply everywhere.</strong>' },
  { eyebrow: 'People', rappel: true, couleur: 'bleu', titre: 'Practitioner Experience',
    texte: 'The service layer around the people who use and contribute to the system: tiered service model, onboarding, unified tooling, rituals, academy. <strong>The humans who use it, and those who craft it.</strong>' },
  { eyebrow: 'People', rappel: true, couleur: 'rouge', titre: 'Community of Practice',
    texte: 'The governance and culture that turn contribution into practice: inner source model, contribution pathways, shared rituals, practice leadership. <strong>The humans who grow it.</strong>' },
];

/*
  ─── Les sept produits, dans l'ordre de la chaine design → dev ───
  L'ORDRE EST LA THESE : on part des tokens et on finit sur la vitrine, sans
  qu'aucun relais n'attende un humain. Le reordonner casse la demonstration du
  ÷3.
*/
const produits = [
  { intitule: 'Token architecture', note: 'multi-brand, multi-theme, multi-surface' },
  { intitule: 'Libraries', note: 'Figma and React, hosted on GitHub' },
  { intitule: 'Figma Companion', note: 'palettes, accessibility checks, layout scaffolding from the canvas' },
  { intitule: 'Storybook', note: 'source of truth, living, versioned documentation' },
  { intitule: 'Elements MCP', note: 'integrated into AI design and engineering workflows' },
  { intitule: 'Support channels', note: 'Slack and Teams streams with automation layers' },
  { intitule: 'Elements Portal', note: 'showcase website' },
].map((p, i) => ({ ...p, repere: String(i + 1).padStart(2, '0') }));

/*
  ─── Les trois mecanismes ───
  Terme = suite : le renversement est le sujet. Ce ne sont pas des valeurs
  affichees mais des contraintes installees, et la troisieme est celle que
  personne n'avait demandee.
*/
const mecanismes: Tuile[] = [
  { eyebrow: 'Rigour', couleur: 'rouge', titre: 'Nothing ships on a hunch.',
    texte: "No component, no roadmap line ever shipped without discovery: what the ecosystem actually needs, what already exists. Then one shared convention, written down. <strong>The standard isn't a review at the end, it's the default at the start.</strong>" },
  { eyebrow: 'Responsibility', couleur: 'bleu', titre: 'The floor, not the reach.',
    texte: 'WCAG AA as the Sanofi digital standard, not our own bar. Full library audited to 100% before our first major, then held there. <strong>So no product team paid the cost downstream.</strong>' },
  { eyebrow: 'Ethics', couleur: 'noir', titre: 'A constraint nobody asked me to keep.',
    texte: 'When AI entered the strategy, I set the line before we built: pragmatic where it accelerates the craft, absolute where it would decide for a human, quality guardrails non-negotiable throughout. <strong>Not everyone draws it. I do.</strong>' },
];
---
<Base
  title="Governance - Systematize a practice - Léa Giezek"
  description="At global scale a system isn't managed, it's governed. Sanofi's experience system: 45+ products, €1M a year, 35+ contributors, Design System Awards finalist."
>

  <Hero
    courant="system-practice-elements"
    eyebrow="Systematize a practice · Sanofi · 2022 - now"
    filigrane="Governance"
  >
    At global scale, a system isn't managed. It's governed.
    <Fragment slot="intro">
      I built Elements to remove the friction between experts, cut time to launch
      and raise product experience at scale - then moved it from a design system
      to a platform: one pipeline where brand, design and engineering pour into
      the same chain. Starting in 2022 as <b>Design Lead</b>, running the platform
      today as its <b>Director</b>.
    </Fragment>
  </Hero>

  <div class="etude">

    <ChiffresCles chiffres={chiffres} />

    {/*
      ─── La composition des 3 cartes (BRIEF §5.3) ───
      Sept colonnes, cinq rangees, mais PAS celles de Language, et surtout TROIS
      LARGEURS DE CARTE DIFFERENTES - 600, 436 et 372px a 1120. A portees egales
      les trois faisaient 434 et la composition se lisait en deux colonnes
      jumelles, ce qui est une mise en page, pas une composition. La carte du
      probleme s'etale sur quatre colonnes, celle de l'approche sur trois,
      celle de la preuve sur deux mais sur toute la hauteur.

      data-grille : crochet du trace anime des filets (src/scripts/grille.ts).
      Les cases decoratives portent un .compo__plat qui pousse depuis son coin ;
      les cases blanches n'ont rien a animer et n'en ont donc pas.

      LES TROIS CARTES SONT ECRITES DANS L'ORDRE 01 → 02 → 03, pas dans celui de
      la composition : c'est le DOM qui donne la tabulation et l'empilement
      mobile. Leur place au bureau vient de `aire`, qui n'en depend pas.
    */}
    <div class="compo" id="composition" data-grille>
      <CarteDossier
        id="carte-problem"
        rang="01"
        intitule="The problem"
        titre="Three crafts, three silos - and a system nobody adopted."
        synthese="A designer ships a spec, an engineer rebuilds it, a marketer briefs an agency for a palette the system already had. Then we built the answer brand-first, through a vendor - coherent, and barely adopted."
        couleur="rouge"
        commande="pan-problem"
        large
        aire="1 / 1 / 3 / 5"
      />

      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 1 / 4 / 2"><span class="compo__plat compo__plat--gris"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 2 / 4 / 3"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 3 / 4 / 4"><span class="compo__plat compo__plat--bleu"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 4 / 4 / 5"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 5 / 2 / 6"><span class="compo__plat compo__plat--jaune"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 5 / 3 / 6"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 5 / 4 / 6"><span class="compo__plat compo__plat--rouge"></span></div>

      <CarteDossier
        id="carte-approach"
        rang="02"
        intitule="The approach"
        titre="I stopped fixing the output and fixed both sources."
        synthese="Internalize the engineering, rebuild from zero, and run it as a platform: three axes, six capabilities, two governance models - a centralized core, contribution opened outward."
        couleur="bleu"
        commande="pan-approach"
        aire="4 / 1 / 6 / 4"
      />

      <div class="compo__decor" aria-hidden="true" style="grid-area:4 / 4 / 5 / 5"><span class="compo__plat compo__plat--noir"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:5 / 4 / 6 / 5"></div>

      <CarteDossier
        id="carte-proof"
        rang="03"
        intitule="The proof"
        titre="Adopted. Trusted. Extended."
        synthese="100% adoption across the three Digital Accelerators, 87% of each product's interface, launches shipped three times faster - and 35+ contributors who keep it alive without me."
        couleur="jaune"
        commande="pan-proof"
        aire="1 / 6 / 4 / 8"
      />

      <div class="compo__decor" aria-hidden="true" style="grid-area:4 / 5 / 5 / 6"><span class="compo__plat compo__plat--rouge"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:4 / 6 / 5 / 7"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:4 / 7 / 5 / 8"><span class="compo__plat compo__plat--gris"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:5 / 5 / 6 / 6"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:5 / 6 / 6 / 7"><span class="compo__plat compo__plat--bleu"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:5 / 7 / 6 / 8"></div>
    </div>

    {/* ═══════════ 01 · The problem ═══════════ */}
    <section class="pan" id="pan-problem" aria-labelledby="titre-problem">
      {/* Un titre de niveau 2, invisible mais dans le plan du document : sans
          lui on sauterait de h1 a h3. Voir system-brand.astro. */}
      <h2 class="sr-only" id="titre-problem">01 &middot; The problem</h2>

      <div class="subsec">
        <div class="split">
          <p class="lead">Nobody meets. <em class="em-rouge">That's the tax.</em></p>
          <div class="body">
            <p>A designer ships a spec. An engineer rebuilds it from scratch. A marketer briefs an agency for a palette the system already had. <strong>Not incompetence - distance.</strong> Three crafts, three silos, each solving in private what the others had already solved. And it wasn't one handoff, it was the whole ecosystem.</p>
            <p>The <em>what</em> was fragmented: an ecosystem of products and touchpoints that didn't share a language, built on assets that didn't connect - <strong>design and engineering debt compounding with every launch</strong>, at global scale.</p>
            <p>The <em>how</em> was worse. Practices siloed team by team, none standardized, everyone paying the same cost forty-five times over. This is where time goes: not into the work, into the gaps between people redoing what already exists. Meanwhile the system itself can ship in seconds, accessible, responsive and on-brand by default. <strong>The capability was there. The structure to use it wasn't.</strong></p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">The stakes</p>
        <div class="split">
          <p class="lead">A system this size is <em class="em-bleu">two bets in one.</em></p>
          <div class="body">
            <p>Elements is Sanofi's unified experience system - <strong>one design language</strong> serving digital products and delivery platforms globally, from B2B and B2C platforms to internal tools, across products, brands and themes.</p>
            <p><strong>Cost rationalization</strong> first, by mutualizing practice so every product team doesn't rebuild the same thing 45 times. Second, <strong>experience at scale</strong>: one coherent journey across every touchpoint. Service design for an entire organization, from employee to patient.</p>
            <p>Both bets only pay if the system is adopted. A system nobody trusts is the worst of both worlds: you fund the platform <em>and</em> the fragmentation it was meant to erase - while the experience stays broken touchpoint by touchpoint. At this scale, every lost hour of velocity is lost across all of them at once.</p>
            <p class="qt">Some of those platforms carry hundreds of surfaces on their own - one marketing platform alone delivers 200+ websites worldwide. <strong>Systematize at the source, and you reach every one of them at once.</strong></p>
          </div>
        </div>
      </div>

      {/*
        Le bloc sombre porte l'aveu, et lui seul : c'est le moment ou le recit
        se retourne. Le mettre en corps courant l'aurait noye entre deux
        analyses ; lui donner tout le chapitre, comme avant, en faisait six
        paragraphes au noir ou l'accent n'accentuait plus rien.
      */}
      <div class="dark">
        <p class="eb">The failure, and the decision</p>
        <h3 class="h3">You can't outsource the thing your whole system depends on.</h3>
        <p>That's the lesson. Here's the half I don't get to blame on anyone else. The engineering was externalized before my time - not my call. But <strong>the early bet I shared, and got wrong, was priority.</strong> Sanofi's rebranding was a massive effort, and we poured the roadmap into brand alignment - a beautifully unified, on-brand system, piloted on sanofi.com and boxed into its framework. We quietly deprioritized what product teams actually needed.</p>
        <p>So the system was coherent, and barely adopted. It took me too long to see it: we'd built it brand-first and at arm's length - for the brand, and through a vendor, but not for the people who had to build on it. <strong>A design system nobody adopts is the oldest failure in the field</strong>, and we'd walked straight into it.</p>
        <p>So I stopped fixing the output and fixed both sources. <strong>I pushed to internalize engineering</strong> - inside Sanofi, one team, one objective: adoption. And I led the rebuild from zero - design foundations, Figma kit, React repos - this time from a holistic view of the whole portfolio and the experience it had to serve. Brand <em>and</em> product, connected, because I'd learned what it costs to choose one.</p>
        <p>It wasn't the safe path. Internalizing means owning the budget, the hiring, the reorg - <strong>a €1M bet on a model, not a line item.</strong> I drove it, and I carried it through.</p>
        <p class="dark__chute">The best architecture I built started as the one I got backwards.</p>
        <Bouton variante="bleu" href="/system-brand">Deep dive in the origin story →</Bouton>
      </div>

      <Bouton variante="bleu" class="suite" commande="carte-approach">Next: the approach →</Bouton>
    </section>

    {/* ═══════════ 02 · The approach ═══════════ */}
    <section class="pan" id="pan-approach" aria-labelledby="titre-approach">
      <h2 class="sr-only" id="titre-approach">02 &middot; The approach</h2>

      <div class="subsec">
        <p class="eb">What I owned</p>
        <div class="split">
          <p class="lead">The decision was the easy part. <em class="em-rouge">Owning it wasn't.</em></p>
          <div class="body">
            <p>I designed the target org - its capabilities, its roles, one operating model - and wrote the job descriptions that made it real. Then I hired into them: from one designer to <strong>a core team of 9, organised by capability with accountable leads</strong>, and a Practitioner Experience capability I scoped, defined and staffed from nothing. The budget came with it, and the line between what the platform funded and what it shipped was mine to draw.</p>
            <p>Governance was where I refused the easy answer. <strong>Two models, not one.</strong> A hybrid, federated model for how the system gets built - a centralized core my team owned, contribution opened outward through inner source, never fully federated: that's the trap. And a tiered service model for how support got prioritized, weighted by each product's place in the portfolio and re-reviewed quarterly against the business's own priorities - so support followed strategy, not the loudest request.</p>
            <p>I set the direction, carried it to leadership, then handed my team the operational goal as <strong>OKRs of their own</strong> - always tied to the company's annual business objectives, so our ambition lived inside a shared project, never beside it.</p>
            <p><strong>Scaling is a series of bets, and I refused to place them blind.</strong> Every decision got the same reading: what it opened, what it exposed, what it cost to reverse. I surfaced them rather than waiting for them to surface, then locked each one with the team or my stakeholders - so no bet was mine alone to carry once it was made.</p>
          </div>
        </div>
        <p class="qt">This is the layer no contributor can claim. <strong>Not the components - the conditions.</strong></p>
      </div>

      <div class="subsec">
        <p class="eb">The architecture</p>
        <div class="split">
          <p class="lead">You maintain a design system. <em class="em-bleu">You run a platform.</em></p>
          <div class="body">
            <p>Elements isn't a single product anymore. It's several products under one governance, one pipeline, for one community. <strong>Three axes, six capabilities</strong> - and the tension is the point: they aren't parallel, each one only works because the other two hold their end.</p>
          </div>
        </div>
        <Tuiles tuiles={capacites} colonnes={3} label="Three axes, six capabilities" hauteur={300} />
      </div>

      <div class="subsec">
        <p class="eb">Seven products, one pipeline from design to dev</p>
        <ol class="chaine">
          {produits.map((p) => (
            <li class="chaine__pas">
              <span class="chaine__n">{p.repere}</span>
              <span class="chaine__nom">{p.intitule}</span>
              <span class="chaine__note">{p.note}</span>
            </li>
          ))}
        </ol>
        <div class="body">
          <p><strong>The pipeline is the thesis made physical.</strong> Brand, design and engineering pour into the same chain - the wait between experts, engineered out. That's the ÷3: not people working faster, but expertises no longer waiting on each other.</p>
        </div>
        <Figure
          src={img('Elements-toolingsuite')}
          alt="The Elements mark at the centre of its tooling suite, each tool grouped by role: documentation with Confluence and Zeroheight, design libraries with Figma, code packages with GitHub and React, code showcase with Storybook, communities with Slack and Teams, and AI solutions"
          legende="The tooling suite, grouped by role"
          ratio="16 / 9"
          sizes="(min-width: 900px) 1040px, 92vw"
        />
      </div>

      <div class="subsec">
        <div class="split">
          <p class="lead">I didn't build a system I hold together. <em class="em-rouge">I built the conditions where it holds itself.</em></p>
          <ul class="pts">
            <li><strong>Autonomous streams</strong>, split by capability, each owned and moving without a central decision - held inside a <strong>collective framing</strong>, so a stream deciding alone still decides inside a frame it co-wrote.</li>
            <li><strong>Shared rituals</strong> are the connective tissue keeping five hubs one system rather than an archipelago.</li>
            <li>Every week, the same conversation: <strong>is the work moving, and is the person growing.</strong> A team that isn't well doesn't ship - wellbeing isn't a nice-to-have on the side, it's load-bearing.</li>
            <li><strong>A standing feedback loop</strong>: we didn't just ship the system, we questioned how we built it - interviewing practitioners, testing our own ways of working, reprioritizing support against what we heard. <strong>The system improves; so does the team that makes it.</strong></li>
            <li>When a product team was under water, we got into the work <em>with</em> them - reviewing their codebase, auditing with concrete proposals, co-building to share the load. That wasn't just me; it was the standard I set and asked everyone to carry. You don't point at the problem from across the room, you cross it. <strong>A team that only points the way isn't leading; it's watching.</strong></li>
          </ul>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">I don't state values. I install them.</p>
        <Tuiles tuiles={mecanismes} colonnes={3} label="The three mechanisms" hauteur={320} />
      </div>

      <Bouton variante="bleu" class="suite" commande="carte-proof">Next: the proof →</Bouton>
    </section>

    {/* ═══════════ 03 · The proof ═══════════ */}
    <section class="pan" id="pan-proof" aria-labelledby="titre-proof">
      <h2 class="sr-only" id="titre-proof">03 &middot; The proof</h2>

      <div class="subsec">
        <p class="eb">The results</p>
        <div class="split">
          <p class="lead">A structure only counts <em class="em-rouge">if it holds.</em></p>
          <div class="body">
            <p>This one does - and the numbers are the system's, not mine. It started with a bold call: switching a role to embrace a new direction, and selling it to my Head of Design to win the sponsorship it needed. From there, <strong>zero users to a community of 2,000+ practitioners</strong>, and a system built to rest in many hands, never mine alone.</p>
            <p><strong>And none of it was measured after the fact.</strong> I ran the platform on live instruments, read as decisions and not trophies: DORA metrics every sprint, a practitioner satisfaction survey twice a year, product priorities re-reviewed quarterly, end-of-session feedback from every ritual. The data didn't prove the work was good - it told me where to invest, what to deprecate, and which product needed support next - and it changed how we worked: we iterated our whole support model on it, reshaped the rituals, and introduced rotating roles because the signal told us to.</p>
            <p>4.7 out of 5 on practitioner satisfaction, twice a year. <strong>People don't comply with Elements, they trust it.</strong></p>
            <p class="qt">Adopted. Trusted. Extended. <strong>Everything a system needs to outlive the person who built it.</strong></p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">What Elements actually is</p>
        <Carrousel
          label="Facets of the platform"
          eyebrow="You may think it is a Figma library"
          vignettes={facettes}
          ratio="16 / 9"
          fr={1.7778}
          largeur="78%"
          sizes="(min-width: 900px) 820px, 90vw"
        />
        <p class="cap portee">Multi-brand &middot; multi-theme &middot; B2B / B2C / internal &middot; from employee to patient &middot; worldwide</p>
      </div>

      <div class="subsec">
        <p class="eb">The community</p>
        <div class="split">
          <p class="lead">A design system you install. <em class="em-bleu">A community you have to earn.</em></p>
          <div class="body">
            <p>Most system owners treat community as a comms afterthought. I made it the strategy. The bet: adoption never comes from mandate, only from ownership. <strong>A system nobody believes in dies with its founder; one a community owns, outlives them.</strong></p>
            <p><strong>Experience runs both ways.</strong> Elements serves end users - patients, healthcare professionals - but it also serves the people who build for them. A practitioner is a user too, so their practice gets the same care as any patient journey: fluid, productive, coherent across every perimeter. <em>Design the experience of the people designing the experience.</em></p>
          </div>
        </div>

        {/* Le rang tombe a l'endroit exact ou « de consumer a maintainer » cesse
            d'etre une idee pour devenir un dispositif. */}
        <p class="parcours" aria-label="The practitioner path: consumer, then contributor, then maintainer">
          <span class="parcours__s"><span class="parcours__i" aria-hidden="true"><ConsumerVisual /></span>consumer</span>
          <span class="parcours__a" aria-hidden="true"><Icone nom="fleche" taille={20} /></span>
          <span class="parcours__s"><span class="parcours__i" aria-hidden="true"><ContributorVisual /></span>contributor</span>
          <span class="parcours__a" aria-hidden="true"><Icone nom="fleche" taille={20} /></span>
          <span class="parcours__s"><span class="parcours__i" aria-hidden="true"><MaintainerVisual /></span>maintainer</span>
        </p>

        <div class="split split--haut">
          <div class="body">
            <p>So I created the <strong>Practitioner Experience capability</strong> to make that real, and elevated one of my team to run it - identifying how her career growth and the outcome for the company were seamlessly paired. I set the direction - community-led adoption, contribution over control, a path that graduates a practitioner from consumer to contributor to maintainer. My team proposed, built and ran the machine: the Elements Portal, the monthly Demo, the office hours, the contribution and triage rituals, the onboarding path.</p>
            <p>This is how a <strong>core interdisciplinary community of 300+ across 5 global hubs</strong> - 30+ product designers among them, partnering with an Experience Design Organisation of 100 - became one practice, end to end, from onboarding to production readiness. Not a mailing list: a contribution model adapted from Zalando's, where everyone gives at the level of their skill, from a flagged issue to a full component.</p>
          </div>
          <div class="pile">
            <Figure
              src={img('design-community')}
              alt="The design community gathered outside in front of the Arc de Triomphe in Paris, fifteen practitioners posing together on a winter afternoon"
              legende="The community, in one place for once"
              ratio="3 / 4"
              ajuste="cover"
              sizes="(min-width: 900px) 420px, 90vw"
            />
          </div>
        </div>

        <div class="body">
          <p>Taking a system from near-zero to <strong>87% average usage per product in production</strong> isn't a launch - it's <strong>change management at scale</strong>: shifting habits across more than 45 product teams, turning resistance into ownership one team, one hub, one priority at a time. It takes patience and it takes refusing - the two are the same discipline, not opposites.</p>
        </div>

        {/* Le dessin et sa preuve : l.idee n.est pas venue de la feuille de
            route, et c.est tout le propos du chapitre. */}
        <div class="taught">
          <div class="taught__viz" aria-hidden="true"><IdeaVisual /></div>
          <div class="body">
            <p class="qt">The Elements MCP didn&apos;t come from my roadmap. <strong>It came from a contributor.</strong></p>
            <p>And it&apos;s where careers grew, mine included: people levelled up by contributing and teaching, not by climbing a ladder - growth through the community, and reverse mentoring that kept me learning as much as I led.</p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">The team that runs it</p>
        <div class="split split--haut">
          <div class="pile">
            <p class="lead">Zero resignations <em class="em-rouge">in three years.</em></p>
            <div class="body">
              <p><strong>I owned the <em>why</em> and the <em>what</em>. They owned the <em>how</em></strong> - and made it sharper than I could have specified. Each capability runs itself, day to day, through the team I recruited and grew. Agile is the tempo, not a checkbox: the metronome keeping six capabilities and seven products in sync without a central hand. <strong>Nothing shipped without us aligned, and nothing waited on me to be decided.</strong> Design went from one to five. One contractor converted to full-time. Average completed engagement: <strong>23 months against a one-year target.</strong></p>
              <p>The people who left in 2026 left for reasons none of us chose - a group budget call, a product remap, a scoped engagement that ended as planned. <strong>Not one left me.</strong> People stay where their growth and their wellbeing are part of the plan, not an afterthought - the same care I built into the system, pointed at the team.</p>
              <p class="qt">My job wasn't to hold it up. <strong>It was to build a structure that outlasts any of us.</strong></p>
            </div>
          </div>
          <div class="pile">
            <Figure
              src={img('lea-nicolas-rodolphe-elements-awards')}
              alt="Léa Giezek, Nicolas Chatelain and Rodolphe Peruzza together at the Design System Awards"
              legende="<strong>Design System Awards 2025</strong> <span class='tag tag--on'>Governance finalist</span> alongside HP and Tesco. The recognition that means the most to me is the <em>category</em> - because this was never only a craft story. It was a leadership one."
              ratio="2 / 3"
              ajuste="cover"
              sizes="(min-width: 900px) 420px, 90vw"
            />
            <p class="cap"><ExternalLink href="https://nicolaschatelain.com" variant="inline">Nicolas Chatelain</ExternalLink> led the People axis, from Experience Operations enablement to the Community of Practice engagement plan. <ExternalLink href="https://rodolphe.design/chat" variant="inline">Rodolphe Peruzza</ExternalLink> led the System axis, from craft to experience-pattern industrialization.</p>
          </div>
        </div>
      </div>

      <div class="closing">
        <h2>I removed the wait between design and engineering. <em class="em-bleu">There's one wait left.</em></h2>
        <p class="cbody">I've argued Elements belongs closer to engineering - one reporting line from design to production. Not for tidiness: because the border between design and engineering is dissolving, and a structure that keeps the two crafts siloed slows everyone down. Bringing them under one line isn't reorg for its own sake: it's <strong>velocity</strong>, and it's <strong>proximity</strong> - sitting end to end with product teams instead of handing work across expertise walls. I'd rather build that structure before the shift forces it than retrofit it after. The move I made once - agency to in-house - pointed here. <strong>This is the next mile of the same road.</strong></p>
        <p class="cbody">Not a system people obey - one they own. <strong>That's what growing a culture means.</strong></p>
        <p class="signature">Design systems ship standards.<br /><em class="em-bleu">Experience systems grow culture.</em></p>
        <Bouton variante="bleu" href="/system-event">See it off the screen →</Bouton>
      </div>

      {/* Fin du dernier chapitre : il n'y a pas de tuile 04, et le sommaire des
          trois cartes est reduit a celle-ci. Ce bouton le rouvre - voir
          dossier.ts. Il est a la place des deux « Next: ... », ferre a droite. */}
      <Bouton variante="noir" class="suite" ferme>Back to the three chapters ↑</Bouton>
    </section>

  </div>

  {/* une seule loupe pour toutes les series agrandissables de la page */}
  <Loupe />

