---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
/* Astro 5.7+ : un .svg importe devient un composant, inline dans le HTML.
   C'est ce qui permet a currentColor de descendre du conteneur - un
   background-image ou un <img> seraient opaques a la couleur du theme. */
import GovernanceVisual from '../assets/index/governance-visual.svg';
import DesignVisual from '../assets/index/design-visual.svg';
import Banner from '../components/Banner.astro';
import Dots from '../components/Dots.astro';
---
<Base title="Léa Giezek - Experience systems that grow culture"
  description="Design and experience systems lead. Fifteen years across brand, retail, agency and product - I don't systematize what I haven't practiced."
  loader>

<!-- CARD 1 : banner + intro -->
  <div class="card">
    <Banner photo>
        <p class="banner__standards">Design systems ship standards,</p>
        <p class="banner__grow">Experience systems grow culture</p>
        <span class="banner__culture" style="--culture-size:26cqw" aria-hidden="true">System.</span>
    </Banner>

    <div class="intro" id="intro">
      <div class="intro__id">
        <div class="intro__photo" role="img" aria-label="Portrait of Léa Giezek"></div>
        <div class="intro__text">
          <h1 class="intro__name">Léa Giezek</h1>
          <p class="intro__lead">Fifteen years across brand, retail, agency and product - every rung of the craft before the direction. I don't systematize what I haven't practiced - and I nurture the practice and the people, not just the system.</p>
          <div class="intro__cta"><a class="btn btn--primary" href="/philosophy">Philosophy →</a></div>
        </div>
      </div>
    </div>
  </div>

  <!-- CRAFT TILES on the grey canvas -->
  <div class="drag" id="drag" aria-label="Craft and portrait">
        <div class="dcard dcard--photo" style="left:0%;top:108px;--rot:-3deg" role="img" aria-label="Portrait of Léa Giezek"></div>
        {/*
          Ordre du DOM : dc3, dc2, dc1. Il ne decide de rien au bureau - les
          cartes sont en position:absolute avec un left/top et un z-index
          explicites - mais il EST l'ordre du rail sous 1024px, ou .dcard--photo
          est masquee et ou les trois cartes defilent. D'ou la lecture voulue :
          « hands dirty first », puis l'ingenierie, puis la direction.
        */}
        <div class="dcard dc3 dcard--flip" style="left:23%;top:0px;--rot:-5deg" tabindex="0">
          <div class="dcard__inner">
            <div class="dcard__face dcard__front"><p class="dcard__t">I lead the way I learned: hands dirty first.</p><span class="dc-hand" aria-hidden="true"><DesignVisual /></span></div>
            <div class="dcard__face dcard__back"><p class="dcard__b">Having done the work myself is what tells me <b>when to step in and when to stay out</b> - close enough to help when it counts, <b>never close enough to hover.</b></p></div>
          </div>
        </div>
        <div class="dcard dc2 dcard--flip dc2--flip" style="left:46%;top:116px;--rot:3.5deg" tabindex="0">
          <div class="dcard__inner">
            <div class="dcard__face dcard__front"><p class="dcard__t">Enough engineering to earn the room.</p><span class="dc2__kbd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="3" width="12" height="18" rx="6"/><path d="M12 7v3"/></svg>Ctrl + Cmd + C</span></div>
            <div class="dcard__face dcard__back"><p class="dcard__b"><b>I read the code and ran component QA myself</b> - to back my team up when they needed it, and to understand the work well enough <b>never to decide against it.</b></p></div>
          </div>
        </div>
        <div class="dcard dc1 dcard--flip dc1--grid" style="left:70%;top:12px;--rot:3deg" tabindex="0">
          <div class="dcard__inner">
            <div class="dcard__face dcard__front"><p class="dcard__t">Direction earned, not assigned.</p></div>
            <div class="dcard__face dcard__back"><p class="dcard__b">I've designed <b>the brand, the product, the system</b>. So when I set direction, it's grounded in the work - <b>I know what it costs to execute.</b></p></div>
          </div>
        </div>
      </div>
  {/* trois pastilles pour les trois cartes retournables - .dcard--photo n'en a
      pas, elle est masquee des que le bloc devient un rail */}
  <Dots id="dots" count={3} label="Tiles" itemLabel="Tile" />

  <!-- OPERATING SYSTEM bridge -->
  <section class="osbridge" aria-labelledby="os-title">
    <div class="osbridge__body">
      <h2 class="osbridge__title" id="os-title">The best governance is the kind you don't have to police.</h2>
      <p class="osbridge__text">Rigor and care aren't opposites - they're the same discipline. Every principle here trades the easy version for the one that lasts: discovery before code, ethics before AI, wellbeing before delivery. <b>Distribute the ownership, or become the bottleneck.</b></p>
      <a class="btn btn--ghost" href="/operating-system">Operating System →</a>
    </div>
    <div class="osbridge__viz">
      <div class="osbridge__visual" aria-hidden="true"><GovernanceVisual /></div>
    </div>
  </section>

  <!-- I don't build design systems -->
  {/*
    Une <section> ne devient une region annoncable que si elle porte un nom
    accessible ; sans lui elle est un conteneur generique et disparait du rotor.
    On pointe le titre visible plutot que d'inventer un aria-label : le nom
    annonce est alors exactement celui qui est lu a l'ecran.
  */}
  <section class="betlede" aria-labelledby="betlede-t">
    <h2 class="osbridge__title" id="betlede-t">I don't build design systems. I build experience systems.</h2>
    <p class="osbridge__text">Fifty would be padding. Three prove it - a platform, a brand, and a space you could immerse yourself in. <b>Same thinking, three worlds - no craft left in a silo.</b></p>
  </section>
  <div class="cases">
    <CaseCard idx="Systematized a practice" when="2023 - now" name="Governance" href="/system-practice-elements"><b>The product failed. The platform scaled.</b> Same system, rebuilt from zero - into the standard a strategic digital portfolio depends on, and the community that makes it last.</CaseCard>
    <CaseCard idx="Systematized a brand" when="2018 - 2022" name="Language" href="/system-brand">2,500 people, one language - before I'd have called it a design system. Not just product, not just design, not just communication: <b>anything can be systematized</b> once you understand each craft, and how to connect the dots. The pattern, five years early.</CaseCard>
    <CaseCard idx="Systematized a moment" when="a year in the making" name="Surfaces" href="/system-event">A full identity, a staged space, and an escape game - one live experience, orchestrated end to end. The same thinking, off the screen entirely. <b>Proof it travels anywhere.</b></CaseCard>
  </div>

  <!-- CARD 3 : let's talk -->

</Base>

<style is:global>
  /* CSS propre a cette page, descendu depuis Base.astro :
     les autres pages ne le telechargent plus. */
  .intro{padding:var(--sp-16)}
  .intro__photo{display:none}
  .intro__name{font-family:var(--display);font-weight:400;font-size:clamp(32px,4.2vw,52px);line-height:1;letter-spacing:-.02em}
  .intro__lead{font-size:clamp(16px,1.7vw,20px);color:var(--ink-soft);margin-top:12px;max-width:52ch}
  /* .intro__cta vit dans shared.css : /404 le porte aussi */
  .drag{position:relative;height:clamp(390px,42vw,450px);margin:clamp(60px,6vw,84px) 0 var(--sp-03);touch-action:none}
  .dcard{position:absolute;width:clamp(230px,27vw,290px);padding:var(--sp-08);border-radius:36px;border:5px solid #fff;background:var(--card);box-shadow:0 22px 44px -20px rgba(120,30,10,.30);cursor:grab;transform:rotate(var(--rot));transition:transform .22s cubic-bezier(.22,1,.36,1),box-shadow .22s ease;user-select:none;z-index:1}
  .dcard:hover{transform:rotate(0deg) translateY(-8px) scale(1.02);box-shadow:0 34px 60px -24px rgba(120,30,10,.42);z-index:20}
  .dcard.grabbing{cursor:grabbing;transform:rotate(0deg) scale(1.03);box-shadow:0 34px 64px -24px rgba(120,30,10,.5);z-index:30}
  [data-theme="contrast"] .dcard{border:var(--edge-w) solid var(--edge);box-shadow:none}
  [data-theme="contrast"] .dcard--flip{border:none}
  [data-theme="contrast"] .dcard--flip .dcard__face{border:var(--edge-w) solid var(--edge);box-shadow:none}
  .dcard__t{font-family:var(--display);font-weight:400;font-size:clamp(20px,2vw,24px);color:var(--ink);letter-spacing:-.01em;line-height:1.12}
  /* 16px fixe, comme .case__hook plus bas : les deux familles de cartes
     racontent la meme chose a deux endroits, elles se lisent au meme corps.
     C'etait un clamp montant a 20px, donc plus gros que les cards de cas. */
  .dcard__b{font-size:16px;color:var(--ink-soft);margin-top:12px}
  .dcard--photo{padding:0;aspect-ratio:1;border-radius:50%;background:var(--portrait) center/cover no-repeat;z-index:3;border:none;cursor:default}
  .dcard--photo::after{content:"";position:absolute;inset:-3px;border-radius:50%;border:2px solid var(--ring);opacity:0;pointer-events:none}
  .dcard--photo:hover::after{animation:tilePulse .9s ease-out}
  .js .drag .dcard{opacity:0;transform:rotate(var(--rot)) scale(.4)}
  .js .drag.in .dcard{animation:stickIn .55s cubic-bezier(.34,1.56,.64,1) forwards}
  .js .drag.in .dcard:nth-child(2){animation-delay:.09s}
  .js .drag.in .dcard:nth-child(3){animation-delay:.18s}
  .js .drag.in .dcard:nth-child(4){animation-delay:.27s}
  .dc1{z-index:5}
  .dc2{z-index:7;background:var(--ink)}
  /* Ordre d'empilement, eclate sur cinq regles et donc ecrit ici une fois :
     .dcard 1 → .dcard--photo 3 → .dc1 5 → .dc3 6 → .dc2 7, puis 20 au survol
     et 30 pendant un glisser (drag.ts recompte a partir de 10, donc toute carte
     saisie passe devant). .dc2 occupe la position centrale et passe au premier
     plan ; elle recouvre donc le coin bas-droit de .dc3, ou vit la vignette. */
  .dc3{z-index:6;background:var(--tile-red)}
  .dc2 .dcard__t,.dc2 .dcard__b{color:#fff}
  .dc3 .dcard__t,.dc3 .dcard__b{color:var(--tile-red-ink)}
  .dcard--flip{background:transparent;border:none;box-shadow:none;padding:0;cursor:pointer;perspective:1100px;height:clamp(224px,25vw,264px)}
  .dcard--flip .dcard__inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .7s cubic-bezier(.4,0,.2,1)}
  .dcard--flip:hover .dcard__inner,.dcard--flip:focus-visible .dcard__inner,.dcard--flip.flipped .dcard__inner{transform:rotateY(180deg)}
  .dcard--flip:hover,.dcard--flip:focus-visible{transform:rotate(var(--rot));box-shadow:none}
  .dcard--flip .dcard__face{position:absolute;inset:0;-webkit-backface-visibility:hidden;backface-visibility:hidden;border-radius:36px;border:5px solid #fff;box-shadow:0 22px 44px -20px rgba(120,30,10,.3);padding:24px;display:flex;flex-direction:column;justify-content:center}
  .dcard--flip .dcard__front{background:var(--card)}
  .dcard--flip .dcard__t{line-height:1.2;color:var(--ink)}
  .dcard--flip .dcard__back{background:var(--card);transform:rotateY(180deg)}
  .dcard--flip .dcard__back .dcard__b{color:var(--ink);margin-top:0}
  /*
    Le papier quadrille de la carte « Direction earned ». Les deux tracés et leur
    pas de 36px etaient ecrits en entier a DEUX endroits - une fois sur la face
    avant au bureau, une fois sur l'enveloppe sous 1024px, ou la carte s'ouvre a
    plat. Deux copies de 300 caracteres pour un motif dont seul l'`inset` change.
    Le motif est pose ici une fois ; les deux regles n'ecrivent plus que ce qui
    leur est propre. `var(--grid-line)` reste resolu au point d'usage, donc le
    trait suit toujours le theme.
  */
  .dc1--grid{--grid-paper:linear-gradient(180deg,transparent 0 17px,var(--grid-line) 17px 19px,transparent 19px),linear-gradient(90deg,transparent 0 17px,var(--grid-line) 17px 19px,transparent 19px)}
  .dc1--grid .dcard__front{background:var(--tile-red);overflow:hidden}
  .dc1--grid .dcard__front::before{content:"";position:absolute;inset:var(--sp-12);border-radius:16px;background-image:var(--grid-paper);background-size:100% 36px,36px 100%;background-position:center;background-repeat:repeat;pointer-events:none;z-index:0}
  .dc1--grid .dcard__front .dcard__t{position:relative;z-index:1}
  .dc1--grid .dcard__back{background:var(--tile-red)}
  .dc1--grid .dcard__t,.dc1--grid .dcard__b{color:var(--tile-red-ink)}
  /*
    Vignette sans disque, posee sur le bord bas de la carte.

    margin-top:auto la pousse en bas : la face est une colonne flex en
    justify-content:center, et une marge auto sur le dernier enfant absorbe tout
    l'espace restant. Le margin-bottom negatif compense le padding de 24px de la
    face, pour que le dessin vienne effectivement TOUCHER le bord au lieu de
    flotter au-dessus.

    100% et non 137% : le 137% servait a faire coincider le disque implicite du
    fichier avec un disque CSS. Sans disque, cette correspondance n'a plus
    d'objet et le dessin occupe simplement sa boite.
  */
  /*
    Ferree a droite, donc l'agrandir gagne deux fois : le dessin s'etend vers la
    GAUCHE, c'est-a-dire dans la bande que .dc2 ne recouvre pas. Mesures a
    1440px : .dc2 coupe a 205px du bord de la carte, la vignette est calee a
    288px - a 152px de large il n'en ressortait que 82, a 224 il en ressort 141.
    Le debord bas passe a --sp-14 pour compenser : sans lui, une vignette de
    224px de haut viendrait manger le titre, qui descend a 136px.
  */
  /*
    margin-top et non auto : `auto` ne pousse en bas que s'il reste de la place,
    or la vignette remplit la face - l'espace libre tombe a zero et l'ecart au
    titre disparaissait. C'est justify-content:flex-start sur la face qui epingle
    le titre en haut, et le debord bas qui place la vignette.

    La valeur est NEGATIVE et ce n'est pas une erreur. Le dessin ne remplit pas
    sa boite : son encre ne commence qu'a 8,3% du viewBox, soit 20px de vide en
    haut. A margin-top:16px l'ecart VISUEL au titre valait donc 36px, et la
    vignette paraissait flotter trop bas. A -2px elle remonte de 18px et il reste
    18px de respiration reelle jusqu'au trait. Toucher a l'un sans l'autre casse
    le calcul : si le dessin est re-exporte avec un cadrage plus serre, cette
    valeur doit remonter vers 16.
  */
  /* overflow:hidden - la vignette deborde de ~86px sous la carte, et c'est la
     carte qui la coupe, sur son rayon de 36px. Le meme procede que
     .dc1--grid .dcard__front, donc sans risque pour le retournement 3D. */
  .dc3 .dcard__front{justify-content:flex-start;overflow:hidden}
  /*
    Meme traitement pour la carte jaune, et pas pour la meme raison : son titre
    etait centre verticalement, donc pose a 98px dans une face de 264. Il
    plongeait au milieu de la carte, la ou la carte noire - plus haute et
    voisine - le recouvrait. L'epingler en haut le remonte de ~70px sans deplacer
    la carte, ce qu'aucune remontee raisonnable n'aurait obtenu : il aurait fallu
    84px, soit sortir la carte par le haut du conteneur.
  */
  /*
    padding-right en POURCENTAGE, pour retrecir la colonne de texte sans toucher
    au bord gauche : le titre reste ferre a gauche et passe sur trois lignes.
    Mesures a 1440px : « Direction earned, » fait 209px pour une colonne de 232,
    d'ou deux lignes. A 30% de padding a droite la colonne tombe vers 175px -
    sous les 209 qui forcent la coupe, et au-dessus des 138 de « earned, not »
    qui la feraient partir a quatre lignes.
    En pourcentage et non en px parce que la carte est fluide (27vw) : une valeur
    fixe donnerait quatre lignes sur les ecrans de bureau les plus etroits.
  */
  .dc1 .dcard__front{justify-content:flex-start;padding-right:30%}
  .dc-hand{width:clamp(96px,17vw,224px);height:clamp(96px,17vw,224px);
    color:var(--accent);display:grid;place-items:center;line-height:1;flex:none;
    margin:-2px 0 calc(var(--sp-14) * -1) auto;
    align-self:flex-end}
  .dc-hand svg{width:100%;height:100%}
  .dc2--flip .dcard__front,.dc2--flip .dcard__back{background:var(--ink)}
  .dc2--flip .dcard__front .dcard__t,.dc2--flip .dcard__back .dcard__b{color:#fff}
  .dc2__kbd{display:inline-flex;align-items:center;gap:8px;align-self:flex-start;margin-top:16px;padding:8px 12px;border:1.5px solid rgba(255,255,255,.4);border-radius:12px;font-family:var(--display);font-weight:400;font-size:12px;color:#fff}
  .dc2__kbd svg{width:20px;height:20px}
  .dcard--photo:hover{transform:rotate(var(--rot));z-index:3;box-shadow:0 22px 44px -20px rgba(120,30,10,.3)}
  .osbridge{display:grid;grid-template-columns:2fr 1fr;gap:var(--sp-14);align-items:center;margin:var(--sp-22) 0 clamp(56px,6vw,72px)}
  .osbridge__viz{position:relative;width:100%;max-width:340px;aspect-ratio:1;justify-self:center}
  /*
    Aplat blanc, trait en --accent : c'est le TRAIT qui porte le theme ici.
    Passer par --ink n'aurait rien change a l'oeil - --ink et --tile-red-ink ont
    la meme valeur dans les trois themes - alors que --accent donne le rouge de
    marque en spicy, le quasi-noir en mono et le rouge Mondrian en contrast.
  */
  .osbridge__visual{position:absolute;inset:0;border-radius:50%;background:#fff;color:var(--accent);display:grid;place-items:center;line-height:1}
  /*
    137% et non 100% : le disque occupait 73% du viewBox du fichier d'origine.
    En rendant la vignette a 100/73, son disque implicite retombe exactement sur
    celui du conteneur, et le dessin deborde comme il le doit. Toucher a l'un
    sans l'autre desaligne le trait et l'aplat.
  */
  /* translateY(2%) : le dessin a son centre optique a y=48 pour un viewBox de
     centre 50 - mesure au getBBox(). Deux unites, soit 2% de la hauteur du svg. */
  .osbridge__visual svg{width:137%;height:137%;overflow:visible;transform:translateY(2%)}
  /*
    Survol : la main pousse un fader vers le haut, et redescend en sortant.

    Le dessin est un pupitre - trois faders verticaux, une main qui en tient un.
    Une transition et non une keyframe : l'etat de repos et l'etat survole sont
    deux poses, pas un cycle, et le retour doit s'animer aussi bien que l'aller.

    --course pilote les quatre elements a la fois. Les deux lignes ne se
    deplacent pas, elles RACCOURCISSENT - une ligne qu'on translate laisserait
    un trou a son sommet. D'ou un scaleY calcule sur leur longueur reelle :
    22 unites pour le fader de droite (12,5 → 34,5), 20 pour la centrale basse
    (30,5 → 50,5). Ces deux nombres viennent du fichier ; les changer sans
    changer ceux-ci decalerait le trait de la poignee.

    transform-origin en unites de viewBox, sans toucher a transform-box : c'est
    deja son defaut pour un element SVG. Le point choisi est le SOMMET de chaque
    ligne, pour qu'elle se retracte par le bas, du cote de la main.
  */
  .osbridge__visual .hand,.osbridge__visual .grip,.osbridge__visual .track{
    --course:7px;transition:transform .5s cubic-bezier(.22,1,.36,1)}
  .osbridge__visual .track--grip{transform-origin:70.5px 12.5px}
  .osbridge__visual .track--mid{transform-origin:50.5px 30.5px}
  .osbridge__visual:hover .hand,.osbridge__visual:hover .grip{transform:translateY(calc(var(--course) * -1))}
  /* (22 - 7) / 22 et (20 - 7) / 20 */
  .osbridge__visual:hover .track--grip{transform:scaleY(.682)}
  .osbridge__visual:hover .track--mid{transform:scaleY(.65)}
  .osbridge__title{font-family:var(--display);font-weight:400;font-size:clamp(24px,3vw,40px);line-height:1.25;letter-spacing:-.02em;color:var(--ink);margin-bottom:16px}
  .osbridge__text{font-size:clamp(16px,1.6vw,20px);color:var(--ink-soft);max-width:54ch;margin-bottom:24px}
  .osbridge__text b{color:var(--ink)}
  .betlede{max-width:66%;margin:var(--sp-22) 0 var(--sp-22)}
  .cases{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-02);margin-bottom:clamp(40px,4vw,44px)}
  .case{position:relative;background:#fff;border-radius:var(--r-lg);overflow:hidden;display:flex;flex-direction:column;box-shadow:0 16px 34px -20px rgba(120,30,10,.25);cursor:pointer;transition:box-shadow .25s ease,transform .25s ease;border:var(--edge-w) solid var(--edge)}
  .case:hover{box-shadow:0 26px 50px -22px rgba(120,30,10,.42);transform:translateY(-4px)}
  [data-theme="contrast"] .case:first-child .case__top{background:var(--accent-alt)}
  [data-theme="contrast"] .case:nth-child(2) .case__top{background:var(--highlight)}
  [data-theme="contrast"] .case:nth-child(2) .case__idx,[data-theme="contrast"] .case:nth-child(2) .case__name{color:var(--on-highlight)}
  [data-theme="contrast"] .case:nth-child(2) .case__when{color:color-mix(in srgb, var(--on-highlight) 60%, transparent)}
  .case__top{background:var(--hero-grad);padding:var(--sp-12);color:#fff}
  .case__idx{font-weight:700;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#fff}
  .case__when{display:block;font-weight:600;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.7);margin-top:4px}
  .case__name{display:block;font-family:var(--display);font-weight:400;font-size:clamp(20px,2.4vw,28px);line-height:1;letter-spacing:-.01em;color:#fff;margin-top:.4em}
  .case__body{padding:var(--sp-12);display:flex;flex-direction:column;flex:1}
  .case__hook{font-size:16px;color:var(--ink-soft);flex:1}
  .btn3__i{transition:color .2s}
  @media(max-width:1024px){
    /* les pastilles n apparaissent qu en mode carrousel */
    .dots{display:flex}
  .intro__id{display:flex;gap:16px;align-items:center}
  .intro__photo{display:block;flex:none;width:clamp(88px,18vw,132px);height:clamp(88px,18vw,132px);border-radius:50%;overflow:hidden;border:3px solid var(--card);box-shadow:0 12px 26px -14px rgba(120,30,10,.4);background:var(--portrait) center/cover no-repeat}
  .intro__text{min-width:0}
  /*
    touch-action:auto annule le `none` de la regle racine. Ce `none` sert au
    glisser-deposer des tuiles au bureau : il empeche le navigateur de prendre
    le geste a la place du pointerdown. Mais ici le drag est desactive et .drag
    est devenu un rail defilant - laisser `none` revient a dire au navigateur de
    ne traiter aucun geste tactile dessus, donc le balayage ne fait rien du tout.
    Invisible au test programmatique : scrollLeft et les clics ignorent touch-action.
  */
  .drag{height:auto;display:flex;overflow-x:auto;gap:16px;scroll-snap-type:x mandatory;padding:var(--sp-10) 0 var(--sp-13);-webkit-overflow-scrolling:touch;align-items:stretch;scroll-padding-left:0;touch-action:auto}
  .dcard--photo{display:none}
  .dcard{position:relative!important;left:auto!important;top:auto!important;flex:0 0 clamp(440px,80%,640px);scroll-snap-align:center;transform:none}
  .dcard--flip{height:auto;border:5px solid #fff;border-radius:36px;overflow:hidden;box-shadow:0 24px 44px -26px rgba(40,20,12,.28);transform-origin:50% 58%;transition:transform .08s linear;will-change:transform}
  .dcard--flip:hover{transform:none;box-shadow:0 24px 44px -26px rgba(40,20,12,.28)}
  .dcard--flip .dcard__inner{transform:none!important;display:flex;flex-direction:row;height:100%;align-items:stretch}
  .dcard--flip .dcard__face{position:relative;inset:auto;transform:none!important;-webkit-backface-visibility:visible;backface-visibility:visible;border:none;border-radius:0;box-shadow:none;text-align:left;justify-content:flex-start;padding:var(--sp-04)}
  .dcard--flip .dcard__front{flex:0 0 42%;padding-right:var(--sp-02)}
  .dcard--flip .dcard__back{flex:1 1 auto;padding-left:var(--sp-02)}
  [data-theme="contrast"] .dcard--flip{border-color:var(--edge);border-width:var(--edge-w)}
  [data-theme="contrast"] .dcard--flip .dcard__face{border:none}
  .dc1--grid .dcard__front::before{display:none}
  .dc1--grid .dcard__inner{background:var(--tile-red);isolation:isolate}
  /* le motif lui-meme vient de --grid-paper, pose sur .dc1--grid : seuls le
     porteur (l'enveloppe, non plus la face) et l'inset changent ici */
  .dc1--grid .dcard__inner::before{content:"";position:absolute;inset:var(--sp-07);border-radius:16px;background-image:var(--grid-paper);background-size:100% 36px,36px 100%;background-position:center;background-repeat:repeat;pointer-events:none;z-index:0}
  .dc1--grid .dcard__front,.dc1--grid .dcard__back{background:transparent;z-index:1}
}
  @media(max-width:720px){
  .betlede{max-width:100%}
  .intro__photo{display:none}
  .intro__id{display:block}
}
  /* palier harmonise : etait 880px, aligne sur le 900px de system-event */
  @media(max-width:900px){
  .cases{grid-template-columns:1fr 1fr;gap:var(--sp-02)}
  .case:first-child{grid-column:1 / -1;flex-direction:row}
  .case:first-child .case__top{flex:0 0 clamp(150px,38%,264px);display:flex;flex-direction:column;justify-content:center}
  .case:first-child .case__body{flex:1}
}
  @media(max-width:640px){
  .dcard{flex:0 0 clamp(260px,86%,400px)}
  .dcard--flip .dcard__inner{flex-direction:column}
  .dcard--flip .dcard__face{padding:var(--sp-11)}
  .dcard--flip .dcard__front{flex:0 0 auto;padding-right:var(--sp-11);padding-bottom:8px}
  .dcard--flip .dcard__back{flex:1 1 auto;padding-left:var(--sp-11);padding-top:8px}
  /*
    La face reste une colonne, comme au bureau : la vignette va en bas a droite.
    Elle doit tenir dans .dcard__front, qui ne fait que 42% de la carte - soit
    environ 78px utiles a 375px une fois les 24px de padding retires. D'ou une
    echelle propre au mobile, bien plus petite que le clamp du bureau.
  */
  /*
    Sous 640px .dcard__inner est une colonne : la face avant, donc la vignette,
    passe AVANT la description. Pour la poser sous elle, on la sort du flux.

    position:static sur la face est la cle : en relative elle etait le bloc
    conteneur de la vignette, qui se serait ancree sur elle et non sur la carte.
    Neutralisee, l'ancrage remonte a .dcard, qui est en position:relative depuis
    le palier 1024px.
    Le padding bas de la face arriere reserve la place : sans lui le texte
    passerait sous la vignette des qu'une carte serait courte.
  */
  .dc3 .dcard__front{position:static;overflow:visible}
  .dc3 .dcard__back{padding-bottom:calc(clamp(52px,19vw,78px) + var(--sp-11))}
  /*
    z-index indispensable : .dcard__back est en position:relative avec un fond
    opaque et vient APRES la vignette dans le DOM. Sans cote d'empilement, elle
    peignait par-dessus et la vignette disparaissait - presente, mesurable,
    invisible.
  */
  .dc3 .dc-hand{position:absolute;right:var(--sp-11);bottom:var(--sp-11);z-index:2;
    width:clamp(52px,19vw,78px);height:clamp(52px,19vw,78px);margin:0}
  .osbridge{grid-template-columns:1fr;position:relative}
  .osbridge__body{position:relative;z-index:1}
  .osbridge__viz{position:absolute;inset:0;max-width:none;width:auto;margin:0;justify-self:auto;aspect-ratio:auto;z-index:-1;pointer-events:none}
  /*
    Sous 640px, plus de disque du tout : le trait seul, en filigrane derriere le
    texte (.osbridge__viz est en z-index:-1). C'est le meme procede que le mot
    geant des bannieres - un dessin qu'on devine plutot qu'on ne lit.
    Il occupe donc toute la colonne au lieu d'un rond de 210px.
  */
  .osbridge__visual{inset:auto;left:auto;right:-14%;top:38%;transform:translateY(-50%);width:clamp(240px,72vw,340px);height:clamp(240px,72vw,340px);background:none;color:#fff}
}
  /* palier harmonise : etait 520px, aligne sur le 560px de system-event */
  @media(max-width:560px){
  .cases{grid-template-columns:1fr}
  .case:first-child{grid-column:auto;flex-direction:column}
  .case:first-child .case__top{flex:none;display:block}
}
  @media(prefers-reduced-motion:reduce){
  .case,.dcard,.dcard--flip .dcard__inner{transition:none}
  /* .banner__pepper::after est deja neutralise par Base.astro, qui le rend */
  .dcard--photo::after{animation:none}
  .osbridge__visual .hand,.osbridge__visual .grip,.osbridge__visual .track{transition:none}
    .osbridge__visual:hover .hand,.osbridge__visual:hover .grip,.osbridge__visual:hover .track{transform:none}
  .js .drag .dcard{opacity:1;animation:none;transform:rotate(var(--rot))}
}

  /* l'accueil porte deux lignes de titre : echelle plus petite que shared.css */
  .banner__standards{font-family:var(--display);font-weight:400;font-size:clamp(24px,3vw,40px);line-height:1.04;letter-spacing:-.01em}
  /*
    Surcharge du repli mobile. Seules les deux valeurs qui CHANGENT sont
    reecrites : la gouttiere laterale (--sp-10 au lieu de --sp-04, l'accueil
    portant un titre sur deux lignes) et l'ecart au-dessus. Le reste du repli -
    flex-direction, alignement, min-height - vient de shared.css et etait recopie
    ici a l'identique, ce qui donnait a lire quatre declarations sans effet pour
    en trouver deux qui en avaient un.
  */
  @media(max-width:720px){
    .banner{padding:calc(var(--mobbar-h) + 16px) var(--sp-10) var(--sp-18)}
    .banner__inner{margin-top:clamp(16px,4vw,24px)}
  }
</style>

<script>
  import { revealAll } from '../scripts/reveal';
  import { rendreDeplacable } from '../scripts/drag';
  import { carrousel } from '../scripts/carousel';
  import { initLoader } from '../scripts/loader';
  import { mouvementReduit } from '../scripts/motion';

  /* les cartes photo et les cartes retournables ne se deplacent pas */
  rendreDeplacable('.dcard:not(.dcard--photo):not(.dcard--flip)', '(max-width:720px)');

  /* retournement : le focus seul suffit (CSS), Entree et Espace epinglent */
  document.querySelectorAll<HTMLElement>('.dcard--flip').forEach((c) => {
    c.addEventListener('click', () => c.classList.toggle('flipped'));
    c.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        c.classList.toggle('flipped');
      }
    });
  });

  /*
    Entree en scene des tuiles. Le filet a 2200 ms couvre le cas ou le bloc est
    deja dans le viewport au chargement, sous le loader : l'observateur ne
    declencherait alors jamais.
  */
  const dragEl = document.getElementById('drag');
  if (dragEl) {
    if (mouvementReduit()) dragEl.classList.add('in');
    else {
      revealAll('#drag', { threshold: 0, rootMargin: '0px 0px -60px 0px' });
      setTimeout(() => dragEl.classList.add('in'), 2200);
    }
  }

  /* .talk-card est revele par le layout, qui rend le pied de page */

  if (dragEl) {
    carrousel(dragEl, {
      slides: '.dcard--flip',
      dots: [...document.querySelectorAll<HTMLElement>('#dots .dot')],
      arc: { y: 22, deg: 6.5, scale: 0.055 },
      actifSi: '(max-width:1024px)',
      classeDotActive: 'is-active',
      depart: 1,
    });
  }

  initLoader();
</script>
