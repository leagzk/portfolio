---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Bouton from '../components/Bouton.astro';
import { CV_HREF, CV_POIDS } from '../lib/cv';
import Icone from '../components/Icone.astro';

/*
  LES TROIS ETUDES DE CAS. Les eyebrows n'ont plus de date (BRIEF §6) : elles
  disaient « 2023 - now », « 2018 - 2022 », « a year in the making » - trois
  formats pour une information que la page de chaque recit porte deja.

  `fragment` nomme l'aplat de couleur qui vit dans la case et qui la remplit au
  survol. Il n'est pas decoratif : c'est lui qui distingue les trois cases d'une
  rangee par ailleurs identique, et il annonce la couleur du recit.
  `clair` dit que le texte passe au blanc quand l'aplat remplit la case - vrai
  sur le bleu et le rouge, faux sur le jaune.
*/
/*
  LA LONGUEUR DES ACCROCHES SUIT LA LARGEUR DE LA CASE. Governance occupe 6
  colonnes (511px a 1440) et garde la version longue du site, qui y tient avec
  75px de marge. Language et Surfaces n'en font que 3 (255px) : la version
  longue y debordait de 93px et 27px, et l'overflow de la case la coupait net -
  quatre lignes perdues sur Language, sans que rien ne le signale.
  Leur texte complet vit de toute facon sur leur propre page.
*/
const travaux = [
  {
    aire: 'w1', href: '/system-practice-elements', fragment: 'bleu', clair: true,
    eyebrow: 'Systematize a practice', nom: 'Governance',
    accroche: '<b>The product failed. The platform scaled.</b> Same system, rebuilt from zero - into the standard a strategic digital portfolio depends on, and the community that makes it last.',
  },
  {
    aire: 'w2', href: '/system-brand', fragment: 'jaune', clair: false,
    eyebrow: 'Systematize a brand', nom: 'Language',
    accroche: '2,500 people, one language - then a rebrand, translated for screens. <b>Anything can be systematized.</b>',
  },
  {
    aire: 'w3', href: '/system-event', fragment: 'rouge', clair: true,
    eyebrow: 'Systematize a moment', nom: 'Surfaces',
    accroche: 'One live experience, orchestrated end to end. <b>Proof it travels anywhere.</b>',
  },
];

/*
  LES TROIS PRINCIPES, declares une fois et rendus une fois.

  Au bureau ils occupent deux cases distinctes de la grille - le duo rouge/jaune
  sur une rangee, le carre noir sous le rouge. Sous 720px ils deviennent un rail
  horizontal a trois cartes (§11). C'est le MEME markup dans les deux cas :
  .principes passe de `display:contents` - ou ses enfants remontent dans la
  grille comme s'il n'existait pas - a un rail en flex. Rendre les trois
  principes deux fois aurait double leur texte dans le DOM, donc dans l'export
  de contenu et a l'oreille d'un lecteur d'ecran.

  Les descriptions sont differenciees a dessein (§3.2) : le rouge dit comment je
  dirige les gens, le jaune comment je prends les decisions.
*/
const principes = [
  {
    cle: 'a', couleur: 'rouge', titre: 'I lead the way I learned: hands dirty first.',
    detail: "It's how I lead people: I know <b>when to step in and when to stay out</b> - close enough to help when it counts, <b>never close enough to hover.</b>",
  },
  {
    cle: 'b', couleur: 'jaune', titre: 'Direction earned, not assigned.',
    detail: "It's how I make the calls: I've designed <b>the brand, the product and the system</b>, so my direction comes from the work, not the org chart - <b>I know what it costs to execute.</b>",
  },
  {
    cle: 'c', couleur: 'noir', titre: 'Enough engineering to earn the room.',
    detail: '<b>I read the code and ran component QA myself</b> - to back my team up, and to understand the work well enough <b>never to decide against it.</b>',
  },
];
---
<Base title="Léa Giezek - Experience systems that grow culture"
  description="Moving design practice forward. Fifteen years across brand, retail, agency and product - I nurture the practice and the people, not just the system."
  loader>

<Hero accueil portrait eyebrow="Moving design practice forward" filigrane="Léa Giezek" defiler="composition">
  Design systems <br />ship standards. Experience systems grow culture.
  <Fragment slot="intro">
    Fifteen years across brand, retail, agency and product - every rung of the craft before the direction. I nurture the practice and the people, not just the system. <b>That's my leadership bet.</b>
  </Fragment>
  <Fragment slot="cta">
    <Bouton href={CV_HREF} variante="jaune" icone="telecharger" telechargement={CV_POIDS}>Download CV</Bouton>
  </Fragment>
</Hero>

<div class="comp-zone">
  {/*
    L'AMORCE : le trait du hero continue ici, en noir.
    Le hero est en overflow:hidden pour contenir son filigrane, donc rien ne
    peut en sortir - le trait est forcement en deux morceaux. Chacun porte la
    couleur qui contraste avec SON fond, et la jointure tombe exactement sur
    la frontiere des deux : a l'oeil, c'est une seule ligne qui change de
    couleur en changeant de page.
    Elle occupe les 72px de margin-bottom du hero, et se cale a zero de la
    colonne - donc sur la meme gauche que le titre, l'intro et le bouton.
    C'est grille.ts qui la trace, au moment ou il attaque le premier filet.
  */}
  <span class="comp-amorce" data-amorce aria-hidden="true">
    <span class="comp-amorce__descente"></span>
    <span class="comp-amorce__traverse"></span>
    <span class="comp-amorce__plongeon"></span>
  </span>
  {/*
    data-grille : crochet du trace anime des filets (src/scripts/grille.ts).
    La classe `pre` est posee par le script AVANT la mesure et retiree apres :
    sans elle, la grille noire s'afficherait une fraction de seconde en entier
    avant que les segments ne commencent a se tracer.
  */}
  <div class="comp" id="composition" data-grille>

    {travaux.map((t) => (
      <div class:list={['cell', `cell--${t.aire}`]}>
        <a class:list={['wt', t.clair && 'wt--clair']} href={t.href}>
          <span class="wt__filet" aria-hidden="true"></span>
          {t.aire === 'w2' && <span class="wt__filet wt__filet--bas" aria-hidden="true"></span>}
          <span class="wt__fragment" aria-hidden="true"></span>
          <span class="wt__eyebrow">
            <span>{t.eyebrow}</span>
            <Icone nom="fleche" taille={20} class="wt__fleche" />
          </span>
          <span class="wt__nom">{t.nom}</span>
          <span class="wt__accroche" set:html={t.accroche}></span>
        </a>
      </div>
    ))}

    <figure class="citation">
      <blockquote>Cultivating practice, not just systems, through Design Leadership and Community Building.</blockquote>
      <Bouton href="/philosophy" variante="bleu" icone="fleche">Philosophy</Bouton>
    </figure>

    <div class="principes">
      <div class="duo">
        {/* Les trois filets du duo restent visibles quelle que soit la carte
            ouverte : c'est la ligne noire que le brief veut toujours la (§3.2). */}
        <span class="duo__filet duo__filet--1" aria-hidden="true"></span>
        <span class="duo__filet duo__filet--2" aria-hidden="true"></span>
        <span class="duo__filet duo__filet--3" aria-hidden="true"></span>
        {principes.filter((p) => p.cle !== 'c').map((p) => (
          <button class:list={['pr', `pr--${p.cle}`, `pr--${p.couleur}`]} type="button" aria-expanded="false">
            <span class="pr__dedans">
              <Icone nom="plus" taille={18} class="pr__plus" />
              <span class="pr__titre">{p.titre}</span>
              <span class="pr__detail" set:html={p.detail}></span>
            </span>
          </button>
        ))}
      </div>
      {principes.filter((p) => p.cle === 'c').map((p) => (
        <div class="cell cell--p2">
          <button class:list={['pr', `pr--${p.cle}`, `pr--${p.couleur}`]} type="button" aria-expanded="false">
            <span class="pr__dedans">
              <Icone nom="plus" taille={18} class="pr__plus" />
              <span class="pr__titre">{p.titre}</span>
              <span class="pr__detail" set:html={p.detail}></span>
            </span>
          </button>
        </div>
      ))}
    </div>

    {/*
      Pagination du rail, SOEUR de la piste et non son enfant : dans un flex
      horizontal elle en deviendrait un item et filerait sur la droite, hors
      champ. Masquee au bureau, ou il n'y a rien a paginer - les trois
      principes y sont visibles d'un coup.
    */}
    <div class="principes__pagination" aria-hidden="true">
      <span class="principes__points"><i></i><i></i><i></i></span>
      <span class="principes__swipe">Swipe →</span>
    </div>

    <section class="os" aria-labelledby="os-titre">
      <span class="os__filet" aria-hidden="true"></span>
      <span class="os__bande" aria-hidden="true"></span>
      <p class="os__eyebrow">Operating system</p>
      <h2 class="os__titre" id="os-titre">The best rules are the ones you don't have to police.</h2>
      <p class="os__texte">Rigor and care aren't opposites - they're the same discipline: discovery before code, ethics before AI, wellbeing before delivery. <b>Distribute the ownership, or become the bottleneck.</b></p>
      <Bouton href="/operating-system" variante="rouge" icone="fleche" class="os__cta">Operating System</Bouton>
    </section>

    {/* Rangee basse : trois cases vides de 56px. Elles ne portent pas de
        contenu - ce sont les filets qui les separent qu'on voit, et c'est le
        « rail » du BRIEF §3.2, dont l'utilite reste a trancher. */}
    <div class="rail rail--b1" aria-hidden="true"></div>
    <div class="rail rail--b2" aria-hidden="true"></div>
    <div class="rail rail--b3" aria-hidden="true"></div>
  </div>
</div>

</Base>

<style is:global>
  /* ═══════════ La composition Mondrian (BRIEF §3.2) ═══════════ */

  /* PAS DE LARGEUR NI DE GOUTTIERE ICI. <main> est deja dans le .shell de
     Base.astro - max-width 1120px, padding 24px - et les redeclarer les
     ajoutait : la composition etait rentree de 24px par rapport au titre du
     hero et au footer. Verification a la mesure : .hero__titre et .comp
     doivent avoir le meme `left`. */
  .comp-zone{position:relative;display:flow-root}
  /*
    ─── LE COUDE NOIR ───
    Le trait blanc tombe du CENTRE du portrait ; la grille, elle, commence au
    bord gauche de la colonne. Entre les deux il faut une jointure, et c'est
    elle : on descend dans l'axe de la photo, on traverse vers la gauche, on
    replonge sur le coin de la composition. Trois traits tires l'un apres
    l'autre - c'est le meme geste que les filets de la grille, en trois
    mouvements.

    --portrait-w est un token (tokens.css) parce que Hero.astro s'en sert pour
    la meme mesure : ecrite deux fois, elle derive et le trait cesse d'etre
    droit.
  */
  .comp-amorce{position:absolute;left:0;top:calc(-1 * var(--saut-hero, 72px));
    width:100%;height:var(--saut-hero, 72px);pointer-events:none}
  .comp-amorce > span{position:absolute;background:var(--text)}
  .comp-amorce__descente{left:calc(var(--portrait-w) / 2);top:0;
    width:var(--rule);height:50%;transform:scaleY(0);transform-origin:top}
  .comp-amorce__traverse{left:0;top:50%;height:var(--rule);
    width:calc(var(--portrait-w) / 2 + var(--rule));
    transform:scaleX(0);transform-origin:right}
  .comp-amorce__plongeon{left:0;top:50%;width:var(--rule);height:50%;
    transform:scaleY(0);transform-origin:top}
  .comp-amorce.tracee .comp-amorce__descente{animation:tirerV .34s cubic-bezier(.4,0,.2,1) both}
  .comp-amorce.tracee .comp-amorce__traverse{animation:tirerH .34s cubic-bezier(.4,0,.2,1) .3s both}
  .comp-amorce.tracee .comp-amorce__plongeon{animation:tirerV .34s cubic-bezier(.4,0,.2,1) .58s both}
  @keyframes tirerV{to{transform:scaleY(1)}}
  @keyframes tirerH{to{transform:scaleX(1)}}
  @media(prefers-reduced-motion:reduce){
    .comp-amorce > span{transform:none}
    .comp-amorce.tracee > span{animation:none}
  }
  /* Sous 720px le hero n'a plus de margin-bottom : il n'y a plus de gouffre a
     franchir, et plus de trait non plus. */
  @media(max-width:720px){
    .comp-amorce{display:none}
  }

  /*
    LES FILETS SONT LE FOND, PAS DES BORDURES. La grille porte le noir et un
    `gap` de 2px ; chaque case repose un fond blanc par-dessus. Avec des
    bordures on aurait 4px entre deux cases voisines et 2px aux extremites.

    clip-path:inset(0 1px 1px 1px) rogne un pixel sur trois cotes. C'est le
    correctif du BRIEF §4.3 : le fond noir transparait par l'arrondi de
    sub-pixel sur les bords exterieurs et dessine un filet parasite tout autour
    - la grille doit avoir ses bords OUVERTS, pas un cadre.
  */
  .comp{display:grid;position:relative;gap:var(--rule);background:var(--text);
    scroll-margin-top:calc(var(--chrome-h) + var(--sp-03));
    clip-path:inset(0 1px 1px 1px);
    grid-template-columns:repeat(12,minmax(0,1fr));
    /*
      LA PREMIERE RANGEE EST UN PLANCHER, PAS UNE HAUTEUR. La maquette la pose
      a 300px pour une colonne de 1120 ; en dessous, les trois cases
      retrecissent pendant que la rangee, elle, ne bouge pas, et l'accroche de
      Language - la plus longue des trois, dans la case la plus etroite (3
      colonnes sur 12 contre 6 pour Governance) - gagne des lignes.

      Mesure du symptome : elle depassait de 1px a 1120, de 16px a 1000 et de
      38px a 880, ou elle passe a cinq lignes. Le texte traversait le filet bas
      et courait sur la bande jaune, qui lui prend 32px de plus qu'aux deux
      autres cases.

      « minmax(300px,auto) » garde la valeur de la maquette comme minimum. Encore
      faut-il que le contenu puisse POUSSER la rangee : voir .wt juste apres.
    */
    grid-template-rows:minmax(300px,auto) 240px minmax(342px,auto) 56px;
    grid-template-areas:
      "w1 w1 w1 w1 w1 w1 w2 w2 w2 w3 w3 w3"
      "duo duo duo duo duo duo duo os os os os os"
      "p2 p2 p2 q q q q os os os os os"
      "b1 b1 b1 b2 b2 b2 b2 b3 b3 b3 b3 b3"}
  /*
    `.principes > *` autant que `.comp > *` : .principes est en display:contents,
    donc ses enfants sont des cases de la grille sans en etre les enfants directs.
  */
  .comp > *,.principes > *{background:var(--white);min-width:0;position:relative;overflow:hidden}
  .principes{display:contents}
  /* Enfant direct de .comp : sans display:none elle deviendrait une case. */
  .principes__pagination{display:none}

  .cell--w1{grid-area:w1}
  .cell--w2{grid-area:w2}
  .cell--w3{grid-area:w3}
  .duo{grid-area:duo}
  .cell--p2{grid-area:p2}
  .citation{grid-area:q}
  .os{grid-area:os}
  .rail--b1{grid-area:b1}
  .rail--b2{grid-area:b2}
  .rail--b3{grid-area:b3}

  /* ═══ Rangee 1 : les trois etudes de cas ═══ */
  /*
    Le texte demarre a 88px du haut : l'horizontale qui traverse les trois
    cases est a 56px, et il faut la laisser respirer. C'est la meme valeur dans
    les trois, c'est elle qui fait lire la rangee comme une seule bande.
  */
  /*
    LA TUILE EST DANS LE FLUX, et c'est ce qui donne son plancher a la rangee.
    En position:absolute elle ne comptait pour rien dans le calcul de la
    hauteur : « auto » sur la rangee n'aurait rien change, et le texte sortait
    par le bas d'une case qui ne pouvait pas grandir. C'est deja ce que fait le
    palier mobile, pour la meme raison exactement.

    LES TROIS CASES PASSENT EN GRILLE pour que la tuile s'etire a la hauteur de
    la rangee meme quand c'est une autre qui la fixe : sans cela, le lien - donc
    la cible du clic et l'aplat du survol - s'arreterait a son propre texte.
  */
  .cell--w1,.cell--w2,.cell--w3{display:grid}
  .wt{position:relative;display:flex;flex-direction:column;
    justify-content:flex-start;gap:8px;padding:88px 32px 28px;
    text-decoration:none;color:var(--text);overflow:hidden}
  /* Colonne de gauche de la grille : le texte s'y cale a 48px (BRIEF §1). */
  .cell--w1 .wt{padding-left:var(--pad-square)}
  .cell--w2 .wt{padding-bottom:60px}

  .wt__filet{position:absolute;z-index:0;left:0;right:0;top:56px;height:var(--rule);background:var(--text)}
  /* L'aplat part de son coin d'ancrage et remplit la case au survol. */
  .wt__fragment{position:absolute;z-index:1;
    transition:height .5s cubic-bezier(.2,.7,.2,1),width .5s cubic-bezier(.2,.7,.2,1)}
  .cell--w1 .wt__fragment{left:0;right:0;top:0;height:56px;background:var(--blue);transform-origin:left top}
  .cell--w2 .wt__fragment{left:0;right:0;bottom:0;height:32px;background:var(--yellow);transform-origin:left bottom}
  .cell--w3 .wt__fragment{top:0;right:0;width:96px;height:56px;background:var(--red);transform-origin:right top}
  /* Le filet bas de Language borde sa bande jaune par le haut. */
  .wt__filet--bas{top:auto;bottom:32px}
  /*
    ::after porte LA VERTICALE, et seulement elle - au bureau comme sur mobile.
    Au bureau une seule case en a une : celle qui borde le rectangle rouge de
    Surfaces. Sous 720px les trois en portent une, et c'est la meme regle qui
    change de valeurs.
  */
  .cell--w3 .wt::after{content:"";position:absolute;z-index:0;right:96px;top:0;width:var(--rule);height:56px;background:var(--text)}

  .wt__eyebrow,.wt__nom,.wt__accroche{position:relative;z-index:2;transition:color .3s}
  .wt__eyebrow{display:flex;justify-content:space-between;align-items:center;gap:12px;
    font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.18em;text-transform:uppercase}
  .wt__fleche{flex:none;transition:transform .35s cubic-bezier(.2,.7,.2,1)}
  .wt__nom{font-family:var(--display);font-size:var(--fs-section);font-weight:900;line-height:1}
  .wt__accroche{font-size:14px;line-height:1.55}
  .cell--w1 .wt__accroche{max-width:400px}

  .wt:hover .wt__fragment,.wt:focus-visible .wt__fragment{height:100%;width:100%}
  .wt:hover .wt__fleche,.wt:focus-visible .wt__fleche{transform:translateX(6px)}
  /* Le texte passe au blanc sur le bleu et le rouge, jamais sur le jaune. */
  .wt--clair:hover :is(.wt__eyebrow,.wt__nom,.wt__accroche),
  .wt--clair:focus-visible :is(.wt__eyebrow,.wt__nom,.wt__accroche){color:var(--white)}
  .wt:focus-visible{outline:3px solid var(--blue);outline-offset:-6px}

  /* ═══ Les trois principes ═══ */
  .duo{overflow:hidden}
  /*
    z-index 0 : SOUS les cartes, pas au-dessus. Ces trois verticales decorent le
    blanc de la case ; quand une carte s'etend par-dessus, elles doivent
    disparaitre avec lui. A z-index 4 elles barraient l'aplat deplie.
    La ligne que le brief veut « toujours visible » (§3.2) n'est pas l'une de
    celles-ci : c'est la separation entre les deux cartes, portee par le
    box-shadow interieur du bandeau reduit.
  */
  .duo__filet{position:absolute;top:0;bottom:0;width:var(--rule);background:var(--text);z-index:0}
  /* Les trois verticales du duo. La premiere borde le carre rouge au repos,
     les deux autres prolongent les colonnes de la grille au travers de la case. */
  .duo__filet--1{left:232px}
  .duo__filet--2{left:calc((100% - 12px) * 3 / 7 + 4px)}
  .duo__filet--3{left:calc((100% - 12px) * 6 / 7 + 10px)}

  .pr{all:unset;box-sizing:border-box;position:relative;display:block;cursor:pointer;overflow:hidden}
  .pr__dedans{position:absolute;inset:0;display:flex;flex-direction:column;
    justify-content:space-between;gap:10px;padding:var(--pad-square);overflow:hidden;
    transition:padding .5s}
  .pr__titre{font-family:var(--display);font-weight:900;font-size:var(--fs-tile);line-height:1.12}
  /* La description n'existe qu'ouverte. max-height anime le depliage ; le
     delai sur l'opacite evite qu'elle apparaisse avant d'avoir la place. */
  .pr__detail{font-size:14px;line-height:1.55;opacity:0;max-height:0;overflow:hidden;
    transition:opacity .2s,max-height 0s .2s}
  .pr__plus{position:absolute;top:16px;right:16px;transition:transform .4s cubic-bezier(.2,.7,.2,1)}
  .pr--rouge{background:var(--red);color:var(--white)}
  .pr--jaune{background:var(--yellow);color:var(--text)}
  .pr--noir{background:var(--ink);color:var(--white)}
  .pr:focus-visible{outline:3px solid var(--blue);outline-offset:-6px}

  /* Le duo : deux boutons poses en absolu dans la meme case, qui se partagent
     la largeur. Au survol de l'un, il s'etend et l'autre se reduit a un bandeau
     vertical de 28px - mais la ligne noire qui les separe reste toujours
     visible (BRIEF §3.2), portee par le box-shadow interieur du reduit. */
  .duo .pr{position:absolute;top:0;height:100%;z-index:2;
    transition:left .5s cubic-bezier(.2,.7,.2,1),width .5s cubic-bezier(.2,.7,.2,1)}
  /*
    LES DEUX LARGEURS SE CALCULENT PAREIL, et c'est la le correctif. La carte
    rouge etait figee a 232px pendant que la jaune se place en proportion : des
    que le duo descend sous ~539px, la jaune commence AVANT que la rouge
    finisse et la recouvre. Mesure a 443px de duo : rouge 24→256, jaune a
    partir de 215 - 41px de recouvrement, et le « + » de la rouge (222→240)
    passait entierement dessous. Il disparaissait purement et simplement.
    En proportion, la rouge s'arrete toujours 2px avant la jaune : le filet
    noir du brief §3.2, et rien de plus.
  */
  .pr--a{left:0;width:calc((100% - 12px) * 3 / 7 + 4px)}
  .pr--b{left:calc((100% - 12px) * 3 / 7 + 6px);width:calc((100% - 12px) * 3 / 7 + 4px)}
  /*
    TOUT PASSE PAR :has() SUR LE DUO, y compris l'ouverture au clic. Le survol
    et le focus agissent sur les DEUX boutons - l'un s'etend, l'autre se reduit
    - donc la regle doit partir du parent. L'etat clique est lu au meme endroit,
    sur aria-expanded, plutot que par une classe posee en plus : l'attribut
    porte deja l'etat pour les lecteurs d'ecran, et en faire aussi le crochet de
    style empeche l'affichage et l'annonce de diverger.
  */
  .duo:has(.pr--a:hover) .pr--a,.duo:has(.pr--a:focus-visible) .pr--a,
  .duo:has(.pr--a[aria-expanded="true"]) .pr--a{width:calc(100% - 28px);z-index:3}
  .duo:has(.pr--a:hover) .pr--b,.duo:has(.pr--a:focus-visible) .pr--b,
  .duo:has(.pr--a[aria-expanded="true"]) .pr--b{left:calc(100% - 28px);width:28px;box-shadow:inset 2px 0 0 var(--text)}
  .duo:has(.pr--b:hover) .pr--b,.duo:has(.pr--b:focus-visible) .pr--b,
  .duo:has(.pr--b[aria-expanded="true"]) .pr--b{left:28px;width:calc(100% - 28px);z-index:3}
  .duo:has(.pr--b:hover) .pr--a,.duo:has(.pr--b:focus-visible) .pr--a,
  .duo:has(.pr--b[aria-expanded="true"]) .pr--a{width:28px;box-shadow:inset -2px 0 0 var(--text)}
  /* Le contenu du bandeau reduit s'efface : 28px ne tiennent pas un titre. */
  .duo:has(.pr--a:hover) .pr--b .pr__dedans,.duo:has(.pr--b:hover) .pr--a .pr__dedans,
  .duo:has(.pr--a:focus-visible) .pr--b .pr__dedans,.duo:has(.pr--b:focus-visible) .pr--a .pr__dedans,
  .duo:has(.pr--a[aria-expanded="true"]) .pr--b .pr__dedans,
  .duo:has(.pr--b[aria-expanded="true"]) .pr--a .pr__dedans{opacity:0}

  /* Le carre noir occupe le haut de sa case, et s'etend vers le bas a l'ouverture. */
  .cell--p2 .pr{position:absolute;left:0;top:0;width:100%;height:254px;
    transition:height .5s cubic-bezier(.2,.7,.2,1)}
  .cell--p2 .pr:hover,.cell--p2 .pr:focus-visible,.cell--p2 .pr[aria-expanded="true"]{height:100%}

  .pr:hover .pr__detail,.pr:focus-visible .pr__detail,.pr[aria-expanded="true"] .pr__detail{
    opacity:1;max-height:200px;transition:opacity .3s .3s,max-height 0s}
  .pr:hover .pr__plus,.pr:focus-visible .pr__plus,.pr[aria-expanded="true"] .pr__plus{transform:rotate(45deg)}

  /* ═══ Citation ═══ */
  /* -3px de marge basse : la case fusionne visuellement avec le blanc du
     dessous, et sans ce chevauchement un filet d'un pixel reapparait sous elle
     (BRIEF §4.3). */
  /*
    LA CITATION PART DU HAUT, LE BOUTON RESTE EN BAS.

    Elle etait en justify-content:flex-end, donc TOUT le jeu de la rangee
    tombait au-dessus du texte : le haut valait ce qui restait, jamais une
    valeur voulue. Mesure, a rangee fixe de 342px : 105px de blanc au-dessus de
    la citation a 1200 (quatre lignes), 72 a 1120 (cinq), 39 a 960 (six), 6 a
    860 (sept) - et a 800, ou elle passe a neuf lignes, les deux premieres
    sortaient par le HAUT et l'overflow:hidden de la case les mangeait. C'est le
    propre de flex-end : le debordement sort du cote du depart.

    Le texte se cale donc sur son padding de 32px, et le bouton descend avec
    « margin-top:auto » - le meme procede que .os__cta juste a cote, et il faut
    qu'il soit le meme : le CTA Philosophy et la bande bleue de la case voisine
    sont alignes d'une colonne a l'autre. Le jeu passe entre les deux, la ou il
    ne se voit pas.

    Et la rangee devient un plancher (voir .comp) : a neuf lignes il n'y a plus
    de jeu a distribuer, il faut de la place en plus.
  */
  .citation{margin:0 0 -3px;z-index:2;padding:32px 32px 40px;
    display:flex;flex-direction:column;justify-content:flex-start;gap:24px}
  .citation .sb{margin-top:auto}
  .citation blockquote{margin:0;font-family:var(--display);font-size:var(--fs-section);
    font-weight:900;line-height:1.1;letter-spacing:-.015em}

  /* ═══ Operating system ═══ */
  .os{padding:var(--pad-square) var(--pad-square) 132px;display:flex;flex-direction:column;gap:16px}
  .os__eyebrow{font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.2em;text-transform:uppercase}
  .os__titre{margin:0;font-family:var(--display);font-size:var(--fs-section);font-weight:900;
    line-height:1.1;letter-spacing:-.015em}
  .os__texte{font-size:14px;line-height:1.55}
  .os__cta{margin-top:auto}
  /* La bande bleue du bas et son filet, cales sur la hauteur du CTA Philosophy
     de la case voisine : les deux s'alignent d'une colonne a l'autre. */
  .os__filet{position:absolute;left:0;right:0;bottom:84px;height:var(--rule);background:var(--text)}
  .os__bande{position:absolute;left:0;right:0;bottom:0;height:84px;background:var(--blue);transform-origin:left bottom}

  .rail{min-height:56px}

  /* ═══════════ Apparition au defilement ═══════════ */
  /*
    Toutes ces classes sont posees par src/scripts/grille.ts, jamais au build :
    sans script, aucune ne s'applique et la composition est simplement la.
    `attend` est l'etat de depart d'une case, `vu` celui qu'elle prend en
    entrant dans le champ.
  */
  .comp.pre{background:var(--white)}
  /* .segs, .seg, .seg--v/h et les keyframes traitV/traitH/pousse/monte sont
     descendus dans src/styles/motion.css : ils servent aussi a la composition
     des etudes de cas. Ne restent ici que les selecteurs qui nomment LES
     ELEMENTS de cette composition-ci. */
  /*
    1,1s et une courbe tres sortante (.16,1,.3,1) : le trait part vite puis se
    pose, comme une regle qu'on tire. A .7s en ease classique il claquait.
    Le retard, lui, vient du script - il est calcule sur la position, pour que
    les filets se rejoignent en diagonale depuis le coin haut gauche.
  */

  /* En attente : les aplats sont a zero, les textes absents. */
  .attend :is(.wt__fragment,.pr,.os__bande){transform:scale(0)}
  .attend :is(.wt__eyebrow,.wt__nom,.wt__accroche,.pr__titre,.os__eyebrow,.os__titre,.os__texte,.sb) ,
  .attend blockquote{opacity:0}

  /*
    L'aplat pousse depuis le coin que son transform-origin designe deja pour le
    survol : les deux gestes partent du meme point d'ancrage.

    --retard est pose PAR CASE, par le script, a partir de sa position dans la
    composition : la couleur arrive juste apres les deux filets qui la bordent.
    C'est ce qui fait que les blocs se remplissent chacun leur tour en suivant
    le trace, et non tous ensemble. Le texte suit sa propre couleur de 0,22s.
  */
  .vu :is(.wt__fragment,.pr,.os__bande){
    animation:pousse .6s cubic-bezier(.4,0,.2,1) var(--retard,0s) both}
  .vu :is(.wt__eyebrow,.wt__nom,.wt__accroche,.pr__titre,.os__eyebrow,.os__titre,.os__texte,.sb),
  .vu blockquote{
    animation:monte .7s ease-out calc(var(--retard,0s) + .18s) both}
  /* Les cartes du duo poussent depuis leur coin haut gauche, comme les aplats
     des cases - sinon elles grandiraient depuis leur centre. */
  .pr--a,.pr--b,.cell--p2 .pr{transform-origin:left top}

  /* ═══════════ Mobile : la grille s'empile (BRIEF §11) ═══════════ */
  /*
    CE N'EST PAS LA GRILLE QUI RETOMBE EN UNE COLONNE, c'est une autre
    composition. Les aplats changent de forme - le rectangle rouge de Surfaces
    devient un carre de 56, Language gagne un carre noir qu'elle n'a pas au
    bureau - et chaque case porte un divider vertical a 56px du bord. Le MEME
    markup les porte : ce sont des pseudo-elements et des fragments qu'on
    redimensionne, pas des blocs ajoutes.
  */
  @media(max-width:720px){
    /* La gouttiere de .shell retombe a 16px sous 720px (--sp-03), donc rien
       a reprendre ici. */
    /* border-top/bottom : la pile est fermee en haut et en bas, alors que la
       grille du bureau a ses bords ouverts. Valeur de la maquette mobile. */
    .comp{display:flex;flex-direction:column;clip-path:none;
      border-top:var(--rule) solid var(--text);border-bottom:var(--rule) solid var(--text);
      grid-template-columns:none;grid-template-rows:none;grid-template-areas:none}
    /* La rangee basse n'a pas de sens empilee : trois cases vides a la suite. */
    .rail{display:none}

    /*
      LE PADDING DEGAGE LE DIVIDER. 80px du cote ou il passe : sans ca le texte
      lui court dessous et la ligne traverse les mots. C'est ce qui manquait.
      Valeurs de MainMobile.dc.html.
    */
    /*
      LE CONTENU REVIENT DANS LE FLUX. Au bureau .wt est en position:absolute
      sur toute la case, et c'est la rangee de la grille qui fixe la hauteur.
      Empilees, les cases n'ont plus de rangee pour les porter : elles tombaient
      a zero et la composition se reduisait a ses filets. En position:relative,
      c'est le texte qui donne la hauteur - ce que fait la maquette mobile.
    */
    .wt{position:relative;inset:auto;padding:80px 24px 28px;gap:10px}
    .cell--w1 .wt{padding-right:80px;padding-left:24px}
    .cell--w2 .wt{padding-left:80px;padding-bottom:60px}
    .cell--w3 .wt{padding-right:80px}
    .wt__nom{font-size:28px;letter-spacing:-.02em}

    /* Governance : bande bleue de 56px, divider a droite qui part SOUS
       l'horizontale - il ne traverse pas la bande. */
    .cell--w1 .wt::after{content:"";position:absolute;z-index:0;
      right:56px;top:56px;bottom:0;width:var(--rule);background:var(--text)}
    /* Language : carre noir en haut a gauche, divider a gauche de l'horizontale
       jusqu'a la bande jaune, qui descend a 28px. */
    .cell--w2 .wt::before{content:"";position:absolute;z-index:0;left:0;top:0;
      width:56px;height:56px;background:var(--ink)}
    .cell--w2 .wt::after{content:"";position:absolute;z-index:0;
      left:56px;top:56px;bottom:28px;width:var(--rule);background:var(--text)}
    .cell--w2 .wt__fragment{height:28px}
    .wt__filet--bas{bottom:28px}
    /* Surfaces : carre rouge en haut a droite, divider sur toute la hauteur. */
    .cell--w3 .wt__fragment{width:56px;height:56px}
    .cell--w3 .wt::after{right:56px;top:0;bottom:0;height:auto;width:var(--rule)}

    /* ─── Le rail des trois principes ─── */
    /*
      .principes passe de display:contents a une piste a defilement, et .duo
      comme .cell--p2 passent a contents a leur tour : les trois boutons
      deviennent les items du rail. Un seul markup, deux dispositifs.
    */
    .principes{display:flex;gap:var(--rule);overflow-x:auto;scroll-snap-type:x mandatory;
      scrollbar-width:none;background:var(--text);padding:0}
    .principes::-webkit-scrollbar{display:none}
    .duo,.cell--p2{display:contents}
    .duo__filet{display:none}
    /* 290px : on voit le bord de la carte suivante, ce qui dit qu'il y en a
       une. Hauteur libre - c'est le contenu qui la fixe (§11). */
    .duo .pr,.cell--p2 .pr{position:static;flex:0 0 290px;width:290px;height:auto;
      scroll-snap-align:start;transition:none}
    .pr__dedans{position:static;padding:24px 24px 32px;gap:14px;transition:none}
    .pr__plus{top:24px;right:24px}
    /* Le « + » est DANS la carte sur mobile (au bureau il vit dans la marge de
       48px). Sans ce degagement, le titre passe dessous a la premiere ligne. */
    .pr__titre{padding-right:32px;font-size:21px}
    .cell--p2 .pr:hover,.cell--p2 .pr:focus-visible,.cell--p2 .pr[aria-expanded="true"]{height:auto}
    /* Au doigt il n'y a ni survol ni focus-visible : seul le clic ouvre. */
    .pr:hover .pr__detail,.pr:focus-visible .pr__detail{opacity:0;max-height:0}
    .pr[aria-expanded="true"] .pr__detail{opacity:1;max-height:400px}
    .pr:hover .pr__plus,.pr:focus-visible .pr__plus{transform:none}
    .pr[aria-expanded="true"] .pr__plus{transform:rotate(45deg)}

    .principes__pagination{display:flex;align-items:center;justify-content:space-between;
      gap:12px;padding:12px 0 0;background:var(--white)}
    .principes__points{display:flex;gap:6px}
    .principes__points i{width:10px;height:10px;background:var(--grey-mondrian)}
    .principes__points i.est-actif{background:var(--ink)}
    .principes__swipe{font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.12em;
      text-transform:uppercase;color:var(--ink-muted)}

    /* ─── Citation et Operating System ─── */
    .citation{margin:0;padding:32px 24px}
    .citation blockquote{font-size:26px;line-height:1.12}
    .os{padding:32px 24px 80px}
    .os__filet{bottom:56px}
    .os__bande{height:56px}
  }

  @media(prefers-reduced-motion:reduce){
    .wt__fragment,.pr,.pr__dedans,.pr__detail,.pr__plus,.wt__fleche{transition:none}
  }
</style>

<script>
  import { initLoader } from '../scripts/loader';

  initLoader();
  /* tracerGrille() est appele par Base.astro : il sert toutes les compositions
     de la page en une passe, et il y en a une par etude de cas aussi. */

  /*
    Les trois principes s'ouvrent au clic, en plus du survol et du focus.
    Indispensable sur telephone, ou aucun des deux autres n'existe (BRIEF §2.7).
    Un seul ouvert a la fois dans le duo : les deux s'y partagent la largeur,
    et les laisser ouverts ensemble ne voudrait rien dire.
  */
  const principes = [...document.querySelectorAll<HTMLButtonElement>('.pr')];
  principes.forEach((b) => {
    b.addEventListener('click', () => {
      const ouvert = b.getAttribute('aria-expanded') === 'true';
      const duo = b.closest('.duo');
      if (duo) duo.querySelectorAll('.pr').forEach((a) => a.setAttribute('aria-expanded', 'false'));
      b.setAttribute('aria-expanded', ouvert ? 'false' : 'true');
    });
  });

  /*
    Pagination du rail mobile. Elle n'existe qu'en dessous de 720px, ou
    .principes devient une piste a defilement ; au-dessus, les trois principes
    sont visibles d'un coup et il n'y a rien a paginer - d'ou la garde sur la
    hauteur de piste plutot qu'un matchMedia qui redirait le point de rupture
    deja ecrit dans le CSS.
  */
  const rail = document.querySelector<HTMLElement>('.principes');
  const points = [...document.querySelectorAll<HTMLElement>('.principes__points i')];
  if (rail && points.length) {
    const suivre = () => {
      if (rail.scrollWidth <= rail.clientWidth) return;
      const i = Math.round((rail.scrollLeft / (rail.scrollWidth - rail.clientWidth)) * (points.length - 1));
      points.forEach((p, n) => p.classList.toggle('est-actif', n === i));
    };
    rail.addEventListener('scroll', suivre, { passive: true });
    suivre();
  }
</script>
