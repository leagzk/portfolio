---
/*
  ═══ Etude de cas Language — Systematize a brand (BRIEF §5) ═══

  La page est refondue sur le gabarit Bauhaus. Ce qui a change par rapport a la
  version precedente, et pourquoi :

  LES SEPT CHAPITRES DEVIENNENT TROIS SECTIONS DEPLIABLES. La page faisait
  2 248 lignes et sept chapitres a plat, avec un sommaire flottant
  (<ChapterTabs>) pour s'y retrouver. Le brief la reorganise en trois temps -
  problem / approach / proof - poses sur une composition Mondrian : on voit les
  trois d'un coup d'oeil, chacun resume en deux lignes, et on ouvre celui qu'on
  veut lire. Le sommaire flottant n'a plus d'objet, les onglets non plus.

  LE TEXTE EST CELUI DE LA MAQUETTE, qui est la version relue et simplifiee
  (BRIEF §5.4). Il reprend tout le propos de l'ancienne page, resserre.

  LES VISUELS SONT CEUX DU REPO. La maquette pose des emplacements gris
  `[Capability map]`, `[R&D]`, `[Article page]` : chacun a son fichier dans
  src/assets/brand-system, et c'est ce fichier qui est pose. Les formats de la
  maquette (4/3, 16/9, 16/10, carre) sont tenus par le CADRE et non par
  l'image - voir Figure.astro.

  TOUTES LES ILLUSTRATIONS DE L'ANCIENNE PAGE SONT LA, ET LEURS DISPOSITIFS
  AVEC. La maquette ne gardait qu'une planche par concept pour 2020, huit
  couleurs de capabilities sur dix, huit personnages sur treize et cinq extraits
  de discovery sur sept. Les quatorze planches, les dix couleurs, les treize
  personnages et les sept extraits sont de retour - et avec eux les trois
  dispositifs qui leur appartenaient :

    · LA PILE QUI TOURNE (<Pile>) pour les sept surfaces d'un concept. La
      comparaison ne tient que si les deux colonnes montrent la MEME surface au
      MEME moment, ce qu'une suite qu'on fait defiler ne garantit pas.
    · LE CADRE QUI DEFILE (<CadreDefilant>) pour les pages entieres : la
      newsletter fait 7,5 fois sa largeur, l'article de sanofi.com 5 fois. En
      `contain` dans un cadre de 16/10 elles se reduisaient a une bande de 10 a
      12% - c'est ce que cette page faisait avant ce correctif.
    · LA LOUPE (<Loupe>) pour les planches de travail et les pages entieres :
      une mosaique de discovery ne se lit pas a 150px.

  Et les deux dessins au trait - brand-communication, brand-variation-visual -
  sont INLINES et non poses en <img>, contrairement aux personnages : eux seuls
  suivent --accent par currentColor, qui ne descend pas dans un <img>.

  LES SVG DES PERSONNAGES SONT CHARGES EN URL (`?url`) ET POSES EN <img>, PAS
  INLINES. Inliner ne servirait qu'a laisser currentColor descendre, et ces
  illustrations sont a plat - elles gardent leurs propres aplats. Et ca
  couterait cher : chacune porte un <style> interne avec des noms sortis
  d'Illustrator (.cls-1, .cls-2...), definis DIFFEREMMENT d'un fichier a
  l'autre. Dans un meme document, la derniere definition l'emporterait et les
  huit personnages sortiraient avec les couleurs du dernier inline.
*/
import Base from '../layouts/Base.astro';
import '../styles/etude.css';
import Hero from '../components/Hero.astro';
import ChiffresCles from '../components/ChiffresCles.astro';
import type { Chiffre } from '../components/ChiffresCles.astro';
import CarteDossier from '../components/CarteDossier.astro';
import Carrousel from '../components/Carrousel.astro';
import type { Vignette } from '../components/Carrousel.astro';
import Figure from '../components/Figure.astro';
import CadreDefilant from '../components/CadreDefilant.astro';
import Pile from '../components/Pile.astro';
import Loupe from '../components/Loupe.astro';
import Icone from '../components/Icone.astro';
import Tuiles from '../components/Tuiles.astro';
import type { Tuile } from '../components/Tuiles.astro';
import Bouton from '../components/Bouton.astro';
import { chercheurImages } from '../lib/images';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
/* INLINES, contrairement aux personnages : ces deux dessins-la suivent le theme
   par currentColor, ce qu'un <img> ne permet pas. */
import BrandCommunication from '../assets/brand-system/brand-communication.svg';
import BrandVariation from '../assets/brand-system/brand-variation-visual.svg';

/* Resolus a la compilation : un nom errone casse le build, la ou un chemin en
   chaine aurait produit un 404 silencieux en production. */
const planches = import.meta.glob<ImageMetadata>('../assets/brand-system/*.webp', {
  eager: true, import: 'default',
});
const img = chercheurImages(planches, 'brand-system');

const svg = import.meta.glob<string>('../assets/brand-system/*.svg', {
  eager: true, import: 'default', query: '?url',
});
const dessin = (nom: string): string => {
  const f = svg[`../assets/brand-system/${nom}.svg`];
  if (!f) throw new Error(`SVG introuvable dans src/assets/brand-system : ${nom}.svg`);
  return f;
};

/* ─── Chiffres cles (BRIEF §5.2) ─── */
const chiffres: Chiffre[] = [
  { nombre: '2,500', quoi: 'people shipping on-brand',
    contexte: 'From COMEX to front-line, with no bottleneck in the middle.' },
  { nombre: '200+', quoi: 'campaigns and internal events',
    contexte: 'All of them ran on the system. The default way things shipped.' },
  { nombre: '6,000', quoi: 'participants reached',
    contexte: "Sanofi's first hackathons, run on the platform. One idea shipped: Theia®, an app for patients living with sight loss." },
  { nombre: '1', quoi: 'standard, one pilot',
    contexte: 'The 2022 rebrand, translated for screens and piloted on sanofi.com.' },
];

/*
  ─── Dix capabilities, dix couleurs - et treize personnages ───

  Les trois derniers personnages (patients, physicians, health authorities) sont
  les INTERLOCUTEURS de la fonction, pas des capabilities : ils ont un visage,
  pas une couleur. C'est pour cela que les deux listes n'ont pas la meme
  longueur, et c'est le propos du nuancier - la couleur dit ce que la fonction
  COUVRE, le personnage dit a qui elle PARLE.
*/
const capacites = [
  { nom: 'R&D', hex: '#456730', fichier: 'research' },
  { nom: 'Development', hex: '#7EB066', fichier: 'development' },
  { nom: 'Medical & Regulatory', hex: '#0CAC95', fichier: 'medical' },
  { nom: 'Manufacturing', hex: '#CA5F51', fichier: 'manufatcuring' },
  { nom: 'Supply Chain', hex: '#FAA429', fichier: 'supplychain' },
  { nom: 'Sales & Marketing', hex: '#EBDC2E', fichier: 'salesmarketing' },
  { nom: 'Compliance', hex: '#7A5FA1', fichier: 'compliance' },
  { nom: 'Support Functions', hex: '#0594D0', fichier: 'supportfunction' },
  { nom: 'IT', hex: '#2F4F9D', fichier: 'IT' },
  { nom: 'Business Areas', hex: '#CCA878', fichier: 'businessareas' },
];

const interlocuteurs = [
  { nom: 'Patients', fichier: 'patients' },
  { nom: 'Physicians', fichier: 'physicians' },
  { nom: 'Health Authorities', fichier: 'healthauthorirties' },
];

const personnages: Vignette[] = [
  ...capacites.map((c) => ({
    url: dessin(c.fichier),
    alt: `Flat design character illustrating the ${c.nom} capability`,
    legende: c.nom,
  })),
  ...interlocuteurs.map((p) => ({
    url: dessin(p.fichier),
    alt: `Flat design character illustrating ${p.nom}, an interlocutor of the function`,
    legende: p.nom,
  })),
];

/* ─── La carte des capacites et les trois jeux d'iconographie qui en decoulent ─── */
const appariements = [
  { nom: 'its-capability-map', legende: 'Capability map',
    alt: 'Map of the IT business capabilities and the colour assigned to each' },
  { nom: 'its-iconography-research-development', legende: 'Research &amp; development',
    alt: 'Iconography set built for the Research and Development capability' },
  { nom: 'its-iconography-medical-regulatory', legende: 'Medical &amp; regulatory',
    alt: 'Iconography set built for the Medical and Regulatory capability' },
  { nom: 'its-iconography-business-units', legende: 'Business units',
    alt: 'Iconography set built for the Business Units capability' },
];

/*
  ─── Ce que les equipes ont fait avec la plateforme ───
  Trois livrables qu'on a eus entre les mains : la couverture du rapport
  trimestriel, sa page de synthese, et la newsletter du departement.

  LE RAPPORT EST UN DOCUMENT, LA NEWSLETTER EST UNE PAGE, et les deux ne tiennent
  pas dans le meme cadre. Les deux vues du rapport font 1,41 de rapport - un
  portrait, d'ou un cadre de 3/4 ou elles se logent a 94%. La newsletter fait
  1 800 de large pour 13 582 de haut : dans le meme cadre elle ne ferait que 10%
  de la largeur, donc elle passe dans un cadre qui defile.
*/
const adoption = [
  { nom: 'rd-report-cover-q4-2020', legende: 'ITS R&amp;D quarterly report',
    alt: 'Cover of the ITS R&D quarterly report carrying the platform' },
  { nom: 'rd-report-summary-view', legende: 'ITS R&amp;D report, summary spread',
    alt: 'Summary spread of the ITS R&D quarterly report carrying the platform' },
];
const newsletter = {
  src: img('digital-rd-newsletter'),
  legende: 'ITS R&amp;D newsletter',
  alt: 'The ITS R&D newsletter sent to the department',
};

/*
  ─── Les deux concepts de 2020, surface par surface ───

  Sept surfaces produites pour chacun, et L'ORDRE N'EST PAS INDIFFERENT : le
  deck d'abord (couverture, section, contenu), puis l'email et sa variation de
  service, puis le social. On descend du support le plus institutionnel au plus
  quotidien - et a chaque palier les deux colonnes montrent la MEME surface,
  sans quoi la comparaison ne tiendrait pas. C'est elle qui porte le propos, pas
  une planche prise seule.

  D'ou une pile qui tourne de part et d'autre plutot que quatorze vignettes :
  voir l'en-tete de src/components/Pile.astro.
*/
const surfaces = [
  { nom: 'slide-cover',             legende: 'Cover slide' },
  { nom: 'slide-section',           legende: 'Section slide' },
  { nom: 'slide',                   legende: 'Content slide' },
  { nom: 'email',                   legende: 'Email' },
  { nom: 'email-service-variation', legende: 'Email, service variation' },
  { nom: 'socialnetwork-picture',   legende: 'Social post' },
  { nom: 'socialnetwork-icon',      legende: 'Social post variation' },
];

const versions = [
  { rang: '01', titre: 'Evolution', retenu: true, base: -1 as -1,
    propos: 'The existing, made simple and fresh. Same equity, less weight - nothing to relearn, and a migration path already half-built.' },
  { rang: '02', titre: 'Reinterpreted', retenu: false, base: 1 as 1,
    propos: 'Bold, screen-first, and the one I argued for: a function shipping products should look like one.' },
].map((v) => ({
  ...v,
  planches: surfaces.map((sf) => ({
    src: img(`concept${v.rang}-${sf.nom}`),
    legende: sf.legende,
    alt: `${sf.legende} in the ${v.titre} concept`,
  })),
}));

/* ─── Ce que la marque corporate imposait ─── */
const contraintes = [
  { nom: 'sanofi-brandbook-color-palette', legende: 'Colour palette',
    alt: 'The corporate brand book page defining the colour palette' },
  { nom: 'sanofi-brandbook-logotype', legende: 'Logotype',
    alt: 'The corporate brand book page defining the logotype' },
  { nom: 'sanofi-brandbook-photography', legende: 'Photography',
    alt: 'The corporate brand book page defining photography' },
];

/*
  ─── La mosaique de la discovery : les sept extraits ───

  Sept extraits de tailles inegales, poses a la main : c'est une PLANCHE, pas
  une serie. Les surfaces disent lesquels portent le plus - le moodboard occupe
  quatre cases, la synthese concurrentielle et le prisme « people matter » une
  demi-rangee chacun - ce qu'une grille reguliere effacerait.

  LES CASES SONT ROGNEES, ET CHACUNE S'AGRANDIT. En `cover` les planches
  servent de matiere et non de document ; ce sont des pages de travail qu'on ne
  lit pas a 150px, donc chaque case est un bouton qui l'ouvre en entier dans la
  loupe. C'est ce que l'ancienne page faisait de ces memes sept planches.

  `aire` PASSE PAR --aire ET NON PAR `grid-area`, et ce n'est pas un detail :
  en style inline, le placement battrait la requete media qui remet la mosaique
  sur deux colonnes sous 860px, et les cases placees en colonnes 3 et 4 feraient
  naitre des colonnes implicites. Le `grid-area` n'est donc applique qu'au-dela
  du palier - voir etude.css.
*/
const extraits = [
  { nom: 'moodboard-notes-summary', aire: '1 / 1 / 3 / 3', legende: 'Moodboard notes',
    alt: 'Summary board of the notes gathered during the product design discovery' },
  { nom: 'competitors-findings-synthesis', aire: '1 / 3 / 2 / 5', legende: 'Competitors findings',
    alt: 'Synthesis of the competitor findings gathered during the product design discovery' },
  { nom: 'color-system-references', aire: '2 / 3 / 3 / 4', legende: 'Colour scale',
    alt: 'Colour scale references gathered during the product design discovery' },
  { nom: 'prism-art-deco-revival', aire: '2 / 4 / 3 / 5', legende: 'Art deco revival',
    alt: 'Art deco revival prism explored during the discovery' },
  { nom: 'prism-people-matter', aire: '3 / 1 / 4 / 3', legende: 'People matter',
    alt: 'People matter prism explored during the discovery' },
  { nom: 'prism-perspective', aire: '3 / 3 / 4 / 4', legende: 'Perspective',
    alt: 'Perspective prism explored during the discovery' },
  { nom: 'prism-scientific', aire: '3 / 4 / 4 / 5', legende: 'Scientific',
    alt: 'Scientific prism explored during the discovery' },
];

/*
  ─── Les trois pistes de 2023 ───
  CE SONT DES PAGES ENTIERES, comme les ecrans du pilote : 1 688 de large pour
  3 101 a 5 624 de haut. Elles reprennent donc le meme cadre, le meme --r et la
  meme vitesse - un troisieme dispositif pour le meme genre d'objet aurait fait
  lire trois series sans rapport la ou il n'y en a qu'une.
*/
const concepts = [
  { nom: 'visual-design-concept-1', titre: 'Clinical Revival',
    propos: 'Reinventing conventional Pharma standards through flexible but structured layouts to inspire trust, simplicity and focus, avoiding the unnecessary.',
    alt: 'Clinical Revival concept applied to a Sanofi page' },
  { nom: 'visual-design-concept-2', titre: 'Pharma-zine',
    propos: "Pushing the boundaries of traditional Pharma branding by adopting magazines' graphical conventions to create a bold and dynamic content-driven storytelling.",
    alt: 'Pharma-zine concept applied to a Sanofi page' },
  { nom: 'visual-design-concept-3', titre: 'Connecting the Dot',
    propos: 'Embracing the playfulness of the Sanofi dot story through motion design to maximize the recognition of the brand and propose a unique experience.',
    alt: 'Connecting the Dot concept applied to a Sanofi page' },
];

/*
  ─── Les ecrans du pilote ───
  QUATRE PAGES ENTIERES ET UN SCHEMA, et les deux ne se montrent pas pareil. Les
  quatre captures font 3 000 de large pour 5 200 a 15 186 de haut - l'article
  fait cinq fois sa largeur. Dans un cadre de 16/10 en `contain` il se reduisait
  a 12% de la largeur du cadre : `defile` les fait passer dans un cadre qui
  parcourt la page, et la loupe les ouvre en grand. Le schema des tokens, lui,
  fait 0,67 - il se loge entier dans le cadre, et n'a rien a parcourir.
*/
const pilote: Vignette[] = [
  { nom: 'elements-article', legende: 'sanofi.com &middot; Article page', defile: true,
    titre: 'Article page', alt: 'An article page of sanofi.com built on the standard' },
  { nom: 'elements-events', legende: 'sanofi.com &middot; Event page', defile: true,
    titre: 'Event page', alt: 'An events listing of sanofi.com built on the standard' },
  { nom: 'elements-search', legende: 'sanofi.com &middot; Search results', defile: true,
    titre: 'Search results', alt: 'A search results page of sanofi.com built on the standard' },
  { nom: 'elements-videogrid', legende: 'sanofi.com &middot; Video grid', defile: true,
    titre: 'Video grid', alt: 'A video grid of sanofi.com built on the standard' },
  { nom: 'tokens', legende: 'Where Elements Design System begins &middot; Tokens origin',
    alt: 'Token architecture linking colour modes, foundations and components' },
].map((e) => ({ src: img(e.nom), alt: e.alt, legende: e.legende, defile: e.defile, titre: e.titre }));

/*
  ─── La frise 2018 → 2023, en tuiles qui se retournent ───
  Le verbe en italique est le propos : il bascule a chaque palier et c'est le
  seul mot qui change. LES QUATRE VERBES DOIVENT DIFFERER - deux fois le meme
  dirait qu'il ne s'est rien passe entre les deux.
  Le surtitre est RAPPELE au verso : l'annee est le repere, on doit savoir de
  quel palier on lit le detail.
*/
const frise: Tuile[] = [
  { eyebrow: '2018', rappel: true, couleur: 'rouge',
    titre: 'communication <em>was</em> the system',
    texte: "Digital Communication Service Owner. IT's brand platform built end to end - brand, communication, production - for 2,500 people." },
  { eyebrow: '2020', rappel: true, couleur: 'bleu',
    titre: 'the system <em>outlived</em> its own identity',
    texte: 'A reorg reset the identity from the top. I versioned it instead of defending it - V1 made IT legible, V2 made it navigable.' },
  { eyebrow: '2022', rappel: true, couleur: 'jaune',
    titre: 'the brand <em>became</em> the system',
    texte: 'Sanofi unified every internal identity. As Product Design Lead, I translated it for screens - one standard, piloted on sanofi.com.' },
  { eyebrow: '2023', rappel: true, couleur: 'noir',
    titre: 'the system <em>grew</em> into the method',
    texte: "Understand each craft, translate it to the others, systematize what's left. That's where Elements Design System begins." },
];

/*
  ─── Les quatre pratiques standardisees ───
  L'ordre porte le « each one feeds the next » de l'entete : le rituel fait
  remonter le besoin, le calendrier l'arbitre, le plan le met en forme, la
  mesure dit ce qu'il a donne, et ca repart dans le rituel suivant.
  Pas de rappel du surtitre au verso (BRIEF §5.4).
*/
const pratiques: Tuile[] = [
  { eyebrow: 'Rituals', couleur: 'rouge', titre: 'Three directions, one practice.',
    texte: 'Inward, a design review where my work-study students and everyone with hands in the system showed the work and had it challenged. Across the team, a standing alignment between contact points. Outward, a recurring conversation with my perimeters, where needs surfaced early enough to be planned instead of absorbed. <strong>Craft, cohesion, demand.</strong>' },
  { eyebrow: 'Editorial calendar', couleur: 'bleu', titre: 'Run like a roadmap.',
    texte: 'Needs centralized from every digital entity, arbitrated together, locked for the quarter, reviewed at the next - so what shipped stayed on point instead of drifting toward whoever asked loudest. <strong>It became a commitment made with the people it bound.</strong>' },
  { eyebrow: 'Communication plans', couleur: 'jaune', titre: 'Nobody starts from a blank page.',
    texte: 'One standard format, structure already decided, so the time went into the content. Same artefact in both rooms - the one we worked from, the one we brought to the IT leadership board. It spread past my team without anyone mandating it. <strong>A shared format is one nobody has to explain.</strong>' },
  { eyebrow: 'Campaign metrics', couleur: 'noir', titre: 'Produced by default.',
    texte: "Engagement rate, open rate, reach, on dashboards that filled themselves. What makes numbers mean anything is the engineering under them: one collection method, one reporting frequency, one reading grid. <strong>Standardize how you measure, or you're not comparing campaigns - you're comparing methods.</strong>" },
];
---
<Base
  title="Language - Systematize a brand - Léa Giezek"
  description="At 2,500 people a brand isn't a charter, it's a shared language. Sanofi IT's brand platform, then the digital standard its rebrand landed on."
  noindex
>

  <Hero
    courant="system-brand"
    eyebrow="Systematize a brand · Sanofi · 2018 - 2022"
    filigrane="Language"
  >
    At 2,500 people, a brand isn't a charter, it's a shared language.
    <Fragment slot="intro">
      I built IT's brand platform to make an invisible function legible - then
      handed its people the language to talk about it themselves. In 2022, I took
      the part nobody had defined: what the new corporate brand becomes on a screen.
    </Fragment>
  </Hero>

  <div class="etude">

    <ChiffresCles chiffres={chiffres} />

    {/*
      ─── La composition des 3 cartes (BRIEF §5.3) ───
      data-grille : crochet du trace anime des filets (src/scripts/grille.ts),
      le meme que celui de l'accueil. Les cases decoratives portent un enfant
      .compo__plat qui pousse depuis son coin ; les cases blanches n'ont rien a
      animer et n'en ont donc pas.

      LES TROIS CARTES SONT ECRITES DANS L'ORDRE 01 → 02 → 03, pas dans celui de
      la composition : c'est le DOM qui donne la tabulation et l'empilement
      mobile. Leur place au bureau vient de `aire` (grid-area), qui ne depend pas
      de l'ordre du DOM. Les cases decoratives, elles, suivent la composition -
      elles sont aria-hidden et ne sont pas focalisables.
    */}
    <div class="compo" id="composition" data-grille>
      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 1 / 2 / 2"><span class="compo__plat compo__plat--gris"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 2 / 2 / 3"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 3 / 2 / 4"><span class="compo__plat compo__plat--bleu"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 1 / 3 / 2"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 2 / 3 / 3"><span class="compo__plat compo__plat--noir"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 3 / 3 / 4"><span class="compo__plat compo__plat--rouge"></span></div>

      <CarteDossier
        id="carte-problem"
        rang="01"
        intitule="The problem"
        titre="IT was a business driver - and nobody outside IT could see it."
        synthese="Everyone treated as a service desk what was actually driving value. Its role went unexplained, its image was dated, every team improvised the brand - and shadow IT filled the gap."
        couleur="rouge"
        commande="pan-problem"
        large
        aire="3 / 1 / 6 / 4"
      />

      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 6 / 2 / 7"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 6 / 3 / 7"><span class="compo__plat compo__plat--bleu"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 7 / 2 / 8"><span class="compo__plat compo__plat--gris"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 7 / 3 / 8"></div>

      <CarteDossier
        id="carte-approach"
        rang="02"
        intitule="The approach"
        titre="You can't templatize what nobody understands yet."
        synthese="Name IT's place in the value chain first, then build the platform and a production line anyone could pick up - and sell what coherence buys, department by department."
        couleur="bleu"
        commande="pan-approach"
        aire="1 / 4 / 3 / 6"
      />

      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 4 / 5 / 5"><span class="compo__plat compo__plat--jaune"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:5 / 4 / 6 / 5"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 5 / 4 / 6"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 6 / 4 / 7"><span class="compo__plat compo__plat--noir"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 7 / 4 / 8"></div>

      <CarteDossier
        id="carte-proof"
        rang="03"
        intitule="The proof"
        titre="Adopted without being enforced."
        synthese="2,500 people shipped on-brand without being asked. A reorg broke the identity, so I shipped a major - then translated the new corporate brand for screens, piloted on sanofi.com."
        couleur="jaune"
        commande="pan-proof"
        aire="4 / 5 / 6 / 8"
      />
    </div>

    {/* ═══════════ 01 · The problem ═══════════ */}
    <section class="pan" id="pan-problem" aria-labelledby="titre-problem">
    {/*
      UN TITRE DE NIVEAU 2, INVISIBLE MAIS DANS LE PLAN. La section etait
      nommee par la carte qui la commande (aria-labelledby sur le <button>) :
      elle avait donc un nom, mais aucun titre - et le plan du document sautait
      de h1 a h3, si bien qu'en naviguant par titres on passait du titre de la
      page aux sous-parties sans jamais rencontrer les trois temps du recit.
      Le titre porte le nom de la carte ; c'est lui qui nomme la section
      desormais, et le lien bouton → section reste assure par aria-controls.
    */}
      <h2 class="sr-only" id="titre-problem">01 &middot; The problem</h2>
      <div class="subsec">
        <div class="split">
          <p class="lead">IT wasn't a support function. It was a <em class="em-rouge">business driver</em> - and nobody outside IT could see it.</p>
          <div class="body">
            <p>That was the brief, and it wasn't a branding one. Sanofi needed its IT to weigh more across the value chain, and the obstacle was perception: everyone treated as a service desk what was actually driving business value. Its role went unexplained, its image was dated, and its communication was scattered across the whole function, every team improvising the brand.</p>
            <p>And illegibility has a price every multinational knows by name. Teams that can't see where IT begins or ends stop waiting and build their own - shadow IT, the tax an organisation pays for a function it can't read. A brand doesn't solve that on its own. Nothing solves it without one.</p>
            <p>A logo doesn't move that. Perception doesn't shift because the assets got prettier - it shifts when the function becomes legible, and when everyone inside it can say the same thing about what it does. <strong>That's two problems, and solving one without the other solves nothing.</strong> Understand first, systematize second. The move started here.</p>
          </div>
        </div>
      </div>
      <Bouton variante="bleu" class="suite" commande="carte-approach">Next: the approach →</Bouton>
    </section>

    {/* ═══════════ 02 · The approach ═══════════ */}
    <section class="pan" id="pan-approach" aria-labelledby="titre-approach">
      <h2 class="sr-only" id="titre-approach">02 &middot; The approach</h2>

      <div class="subsec">
        <p class="eb">The solution</p>
        <div class="split">
          <p class="lead">You can't templatize what nobody <em class="em-bleu">understands yet.</em></p>
          <div class="body">
            <p>Before a single template, I did the harder work: <strong>classifying and vulgarizing what IT actually did</strong> - naming its place in the value chain in words a manufacturing lead or a medical rep could use, then translating it graphically so it could be <em>seen</em>, not just read.</p>
            <p>That understanding is what a brand platform is built on, and I built the whole one: <strong>positioning, territory, personality, tone of voice</strong> - what IT stood for, and how it was allowed to sound. Not decoration laid over the function. The argument for it, made explicit.</p>
            <p>And none of it was built off to the side. The platform derived from Sanofi's own brand principles and stayed answerable to them - coherent with the corporate brand, and still distinct enough to be recognized on sight inside the ecosystem.</p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <h3 class="h3">The Sanofi brand was the constraint. <em class="em-rouge">The IT world was the playground.</em></h3>

        {/*
          --swc:5 : dix couleurs sur deux rangees de cinq. A huit colonnes, les
          deux dernieres seraient tombees seules sur une seconde rangee.
        */}
        <p class="eb">One colour per business capability</p>
        <ul class="sw" style="--swc:5">
          {capacites.map((c) => (
            <li class="swi">
              <div class="swc" style={`background:${c.hex}`}></div>
              <span>{c.nom}</span>
              <code>{c.hex}</code>
            </li>
          ))}
        </ul>

        {/*
          Les personnages : treize vignettes CARREES dont trois et demie se
          voient a la fois - la demie est ce qui dit qu'on peut defiler. Les dix
          capabilities d'abord, dans l'ordre du nuancier, puis les trois
          interlocuteurs : la serie se lit comme le nuancier, prolonge.
        */}
        <Carrousel
          label="Characters"
          eyebrow="Lively flat design characters"
          vignettes={personnages}
          ratio="1 / 1"
          largeur="calc((100% - 60px) / 3.4)"
          largeurMobile="70%"
          sizes="(min-width: 900px) 300px, 70vw"
        />

        <p class="eb">Sample of visual strategy pairing</p>
        <div class="four">
          {appariements.map((a) => (
            <Figure src={img(a.nom)} alt={a.alt} legende={a.legende} ratio="4 / 3"
              sizes="(min-width: 900px) 250px, 45vw" />
          ))}
        </div>
      </div>

      <div class="subsec">
        <div class="split">
          <p class="lead">A template per intent, <em class="em-bleu">not per person.</em></p>
          <div class="body">
            <p>Then the system that carried it: a colour architecture that scaled across entities, a visual language with its own rules of composition, and each digital entity given its own personality - matched to the business it served, and unmistakably Sanofi.</p>
            <p>None of which is worth anything until someone can pick it up. So the production line: <strong>shared libraries on Creative Cloud</strong>, where every asset lived once and updated everywhere at once - social, Microsoft suite, illustration kits, newsletters typed by objective rather than by sender.</p>
            <p>All of it built and systematized in the Adobe suite, for the people whose job is craft - then translated into the tools everyone else opens every morning. <strong>PowerPoint included, yes sir.</strong></p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">The adoption</p>
        <div class="split">
          <p class="lead">Nobody asks for <em class="em-rouge">an umbrella.</em> They ask for their own logo.</p>
          <div class="body">
            <p>Until then, everyone had done what they wanted. Every entity had its own visual habits, and every new program launched wanting its own logo - because a logo is what having a program looks like. <strong>Consolidation reads as a loss long before it reads as a gain.</strong> That was the real obstacle, and it wasn't a design problem.</p>
            <p>So I started where the decisions were made. Department by department across IT, I worked the leadership teams - and I didn't sell coherence, which nobody wants. I sold what coherence buys them: their people stop spending time on form and spend it on substance, one identity covers uses they'd otherwise fund one by one, and a program gets recognized because it belongs to something, not despite it.</p>
            <p>And I anchored the brand in what those leaders were already accountable for. Their strategy became the vehicle: the identity spoke through their priorities instead of alongside them, so adopting it wasn't extra work - it was how their agenda got heard. <strong>Change management doesn't run beside the strategy. It rides it.</strong></p>
          </div>
        </div>

        {/*
          Les trois livrables en PLEINE COLONNE et non dans la moitie du .split :
          ce sont des documents portrait, et trois cadres de 3/4 dans une colonne
          de 440px auraient fait 135px de large. Le cadre tient le format, voir
          l'en-tete de la liste `adoption`.
        */}
        <p class="eb">What the teams made with it</p>
        <div class="three">
          {adoption.map((a) => (
            <Figure src={img(a.nom)} alt={a.alt} legende={a.legende} ratio="3 / 4"
              sizes="(min-width: 900px) 340px, 45vw" />
          ))}
          <CadreDefilant
            src={newsletter.src}
            alt={newsletter.alt}
            legende={newsletter.legende}
            titre="ITS R&D newsletter"
            ratio="3 / 4"
            fr={0.75}
            sizes="(min-width: 900px) 340px, 45vw"
            widths={[400, 800, 1200]}
            declencheur="survol"
            zoom
          />
        </div>
      </div>

      <div class="subsec">
        <div class="split">
          <p class="lead">Selling it was the start. Making it <em class="em-bleu">a language people use</em> - not a charter they obey - was the job.</p>
          <ul class="pts">
            <li><strong>One contact point per department</strong> - mine were Vaccines, R&amp;D and Medical: a catalyst, not a gate.</li>
            <li>Leadership's messages and the front-line's assets pulled from <strong>the same platform</strong>, instead of two versions of the same story.</li>
            <li>Contribution and continuous improvement weren't policies. <strong>They were the only way a shared identity survives contact with fifteen roadmaps.</strong></li>
          </ul>
        </div>

        {/*
          LE DESSIN ET SON PROPOS. Le paragraphe des trois vitesses revient avec
          l'illustration qui l'accompagnait : les deux disaient la meme chose,
          separes l'un etait un item de liste et l'autre une decoration.
          L'encre suit --accent - c'est la seule raison pour laquelle ce SVG est
          inline et non pose en <img>. Voir .taught dans etude.css.
        */}
        <div class="taught">
          <div class="taught__viz" aria-hidden="true"><BrandCommunication /></div>
          <div class="body">
            <p>And a brand this size has to be taught, not announced. But "come to the session" is not a strategy for a function spread across time zones - so the training ran at three speeds. <strong>Guides on the intranet</strong>, for the person who needs it at 9pm. <strong>Short videos</strong>, for what you'd rather be shown than read. And the live formats for what needs a room: <strong>sharing sessions</strong> where an IT team walked everyone through a subject it owned, the platform reveal - what it was, how to adopt it, how to run the kits - and strategic webinars carried by leadership in person.</p>
            <p>Same content, three ways in. <strong>Nobody should have to guess how to use the thing, and nobody should have to wait for a calendar invite to find out.</strong></p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb">The operations</p>
        {/* le second dessin au trait, a la place qu'il occupait : contre les
            quatre pratiques, dont il est le filigrane. */}
        <div class="taught">
          <div class="taught__viz" aria-hidden="true"><BrandVariation /></div>
          <div class="pile">
            <p class="lead">I didn't just standardize the assets. I standardized <em class="em-rouge">the practice.</em></p>
            <div class="body">
              <p>The tools made people autonomous. But autonomy without a shared practice just scatters faster - so I standardized how the communication team itself worked. Four things, one way of running each - and each one feeds the next.</p>
            </div>
          </div>
        </div>
        <Tuiles tuiles={pratiques} label="The four standardized practices" hauteur={340} />
      </div>

      <div class="subsec">
        <div class="split">
          <p class="lead">Measured while it ran - <em class="em-bleu">not after the fact.</em></p>
          <div class="body">
            <p>Numbers only cover what they can see. So every quarter we ran a qualitative survey on the rest - starting with whether the sessions and the webinars had been worth the time people gave them. When the signal arrives on its own, a communication team stops defending its choices and starts adjusting them - and what it learns goes back into the next ritual, and the next quarter's calendar.</p>
            <p>And I built the autonomy into people, not just process: I mentored two work-study students and levelled up colleagues until they could run the system themselves. Self-service isn't a portal - it's the day nobody needs to ask you. <strong>Knowledge shared is autonomy that stays</strong> - the same conviction I'd scale into Elements' 35+ contributors years later.</p>
          </div>
        </div>
      </div>

      <div class="subsec">
        <div class="split">
          <p class="lead">The <em class="em-rouge">what</em> is assets, templates, identity. The <em class="em-rouge">how</em> is practices, method, measurement.</p>
          <div class="body">
            <p>Fragmentation lives in both, so I fixed both. The <strong>why</strong> is simpler. A digital function scattered across entities was meant to end up feeling like one - not looking unified, being unified, by people who worked the same way and could recognize each other's work at a glance.</p>
            <p>A shared identity makes a function legible to the outside. <strong>A shared practice makes it a community to itself.</strong></p>
          </div>
        </div>
      </div>

      <Bouton variante="bleu" class="suite" commande="carte-proof">Next: the proof →</Bouton>
    </section>

    {/* ═══════════ 03 · The proof ═══════════ */}
    <section class="pan" id="pan-proof" aria-labelledby="titre-proof">
      <h2 class="sr-only" id="titre-proof">03 &middot; The proof</h2>

      <div class="subsec">
        <p class="eb">The results</p>
        <div class="split">
          <p class="lead">A brand only counts when people use it <em class="em-rouge">without asking.</em></p>
          <div class="body">
            <p>They did - and the proof is what they made with it, not what I drew. The platform was never judged on how it looked. It was judged on whether people reached for the tools instead of improvising around them.</p>
            <p class="qt">Adopted without being enforced - and re-adopted when the identity underneath it changed. <strong>That's the only result a brand platform can claim.</strong></p>
          </div>
        </div>
        <Tuiles tuiles={frise} label="From 2018 to 2023" hauteur={240} />
      </div>

      <div class="subsec">
        <p class="eb">2020 - The system outlived its own identity</p>
        <div class="split">
          <p class="lead">A reorg is a breaking change.<br /><em class="em-bleu">I shipped a major of the brand platform.</em></p>
          <div class="pile">
            <div class="body">
              <p>In 2020, IT moved from service provider to enabler - one notch up, inside a digital transformation running across the whole company. New digital leadership came with it, and the digital identity was reset from the top. Positioning moved, territory moved - the problem underneath didn't. <strong>I didn't defend mine. I versioned it.</strong></p>
            </div>
            <ul class="pts">
              <li><strong>A refinement, not a rebuild</strong>: a leaner structure, organized around products and service lines. The machine held: calendar, contact points, sessions, webinars - and went to work on the migration.</li>
              <li>Campaigns became the migration path. <strong>Communication wasn't announcing the system. It was deploying it.</strong> There's no deprecation warning in PowerPoint: <strong>you can't break the previous version - you can only make the next one worth the switch.</strong></li>
            </ul>
          </div>
        </div>

        {/*
          LES DEUX CONCEPTS EN PLEINE COLONNE, pas dans la moitie d'un .vc. Sept
          surfaces de part et d'autre ne se comparent qu'a largeur egale : dans
          une colonne de 440px partagee en deux, chaque pile aurait fait 210px.
        */}
        <p class="eb">The two concepts, surface by surface</p>
        <div class="versus">
          {versions.map((v) => (
            <section class="vers" aria-label={`Concept ${v.rang}, ${v.titre}`}>
              <p class="eb">Concept {v.rang}</p>
              <p class="vers__nom">
                {v.titre}
                {/* le statut n'est pas une decoration : c'est lui qui dit lequel
                    des deux a ete retenu, et le propos du chapitre tient a ce que
                    ce ne soit pas celui que je defendais */}
                <span class:list={['tag', v.retenu && 'tag--on']}>{v.retenu ? 'Retained' : 'Not retained'}</span>
              </p>
              <p class="vers__propos">{v.propos}</p>
              <Pile
                label={`${v.titre} concept, seven surfaces`}
                planches={v.planches}
                base={v.base}
                ratio="4 / 3"
                sizes="(min-width: 900px) 480px, 92vw"
              />
            </section>
          ))}
        </div>

        {/*
          L'arbitrage, juste SOUS les deux piles. Il ne peut pas venir avant : on
          doit avoir vu les deux concepts pour que « j'ai defendu le 02 » veuille
          dire quelque chose.
        */}
        <p class="qt">Leadership picked 01. I'd argued for 02 - but 01 was the shorter migration, and the shortest path for the people moving is the one I've defended everywhere else. Taste on one side, adoption on the other. <strong>I arbitrated, and I shipped 01 like it had been my idea.</strong></p>
      </div>

      {/*
        Le tournant, sur le bloc noir. La maquette lui pose une largeur de 976px
        et un rectangle rouge en absolu - le brief §7 le signale comme fragile.
        Le bloc prend donc toute la colonne, et le rouge n'y est pas repose : la
        couleur est deja portee par la composition et par les tuiles de la frise
        juste au-dessus.
      */}
      <div class="dark">
        <p class="eb">The turning point</p>
        <h3 class="h3">A brand book doesn't survive contact with a screen.</h3>
        <p>The first time the ground moved, it was one function. The second time, it was the whole company. In 2022, Sanofi unified every internal identity into a single brand. The part nobody had defined was what that brand becomes once it's interactive - so I took it: <strong>translating the new corporate identity through a digital prism</strong>, and shipping the first concepts that proved it could hold on a product, not just on a page.</p>
        <p>I wasn't the only one moving - and by then I'd moved too. The product teams that appeared in the last reset had turned into a function: Sanofi stood up product design in 2021 with the creation of the Consumer Experience team, and I joined it as <strong>Product Design Lead</strong>, carrying four years of brand and communication in with me. So when the rebrand landed, the two forces looking for each other - brand on one side, product on the other - met in a role that had lived in both. <strong>That's the gap I've always worked in.</strong></p>
      </div>

      <div class="subsec">
        <p class="eb">2022 - The brand became the system</p>
        <div class="split split--haut">
          <div class="pile">
            <p class="lead">UI kits everywhere, <em class="em-rouge">one per entity,</em> none speaking to the others.</p>
            <div class="body">
              <p>Translating the brand meant looking hard at what it would land on. So I ran the discovery - a broad benchmark of the field, then an audit of what Sanofi already had. The finding was familiar: the exact fragmentation I'd spent four years removing from communication, sitting one layer deeper - in the interface itself.</p>
            </div>
          </div>
          <div class="pile pile--serre">
            <p class="eb">Product design discovery extract</p>
            <div class="mosaic" role="group" aria-label="Product design discovery extract">
              {extraits.map((e) => (
                <button type="button" class="zoom" data-loupe="image"
                  style={`--aire:${e.aire}`} data-legende={e.legende}
                  aria-label={`Enlarge ${e.legende}`}>
                  <Image src={img(e.nom)} alt={e.alt}
                    sizes="(min-width: 900px) 300px, 45vw" loading="lazy" decoding="async" />
                  <span class="zoom__badge" aria-hidden="true"><Icone nom="plus" taille={13} /></span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <p class="eb">Sample of corporate constraints</p>
        <div class="three">
          {contraintes.map((c) => (
            <Figure src={img(c.nom)} alt={c.alt} legende={c.legende} ratio="4 / 3"
              sizes="(min-width: 900px) 340px, 45vw" />
          ))}
        </div>
      </div>

      <div class="subsec">
        <p class="eb">2023 - The system grew into the method</p>
        <h3 class="h3 h3--lead">Converging to one standard <em class="em-rouge">to harmonize the experience of every digital touchpoints.</em></h3>
        <div class="body">
          <p>So I pushed the answer one level up. Not a brand adaptation per product: <strong>one standard for the portfolio</strong>, with sanofi.com as the pilot - the first real product to carry it, and the one that would tell us what the standard got right and what it didn't.</p>
        </div>
        <div class="three">
          {concepts.map((c) => (
            <CadreDefilant
              src={img(c.nom)}
              alt={c.alt}
              legende={`<strong>${c.titre}</strong> - ${c.propos}`}
              titre={c.titre}
              ratio="4 / 3"
              fr={1.3333}
              sizes="(min-width: 900px) 340px, 45vw"
              widths={[640, 1080, 1400]}
              declencheur="survol"
              zoom
            />
          ))}
        </div>
      </div>

      <div class="subsec">
        <Carrousel label="Pilot screens" vignettes={pilote} ratio="16 / 10" />
      </div>

      <div class="closing">
        <h2>A pilot isn't a proof. It's the fastest way to find out <em class="em-bleu">what you got wrong.</em></h2>
        <p class="cbody">Same conviction, different surface. Understand each craft, translate it to the others, systematize what's left - so people spend their expertise on what actually matters. <strong>The wait between experts is where time hides. I've been removing it, at bigger and bigger scale, for a decade.</strong> And that's where Elements Design System begins.</p>
        <Bouton variante="bleu" href="/system-practice-elements">Discover what came next →</Bouton>
      </div>
    </section>

  </div>

  {/* une seule loupe pour toutes les series agrandissables de la page */}
  <Loupe />

</Base>

<style is:global>
  /* ═══ Ce qui est propre a l'etude Language ═══ */

  /*
    LA COMPOSITION. Sept colonnes et cinq rangees, valeurs de la maquette
    (BRIEF §5.3). Les fr ne sont pas des douziemes arrondis : les colonnes
    fines - 9fr et surtout 4fr - sont ce qui fait respirer les trois aplats de
    la rangee du milieu, et les ramener a un pas regulier aplatirait la
    composition.

    LES RANGEES SONT DES PLANCHERS, PAS DES HAUTEURS FIXES. La maquette les
    pose en pixels - 170 / 75 / 30 / 245 / 60 - pour une colonne de 1120px et un
    seul point de rupture a 860. Entre les deux, les colonnes sont en `fr` et
    retrecissent pendant que les rangees, elles, ne bougent pas : la synthese de
    la carte 02 gagne des lignes et la carte, qui est en `overflow:hidden`, les
    AVALE. Mesure a 1072px de colonne : 5px manquants, soit un quart de ligne
    perdue sans que rien ne le signale.

    `minmax(Xpx, auto)` garde les valeurs de la maquette comme minimum et laisse
    la rangee grandir quand son contenu le demande. Au-dela de 1120px les
    proportions sont exactement celles de la maquette ; en dessous, la
    composition s'allonge de quelques pixels au lieu de rogner du texte.
    La troisieme rangee reste fixe : ces 30px sont un filet de respiration
    voulu mince, et les cartes qui la traversent peuvent grandir ailleurs.
  */
  /*
    AU-DESSUS DU POINT DE RUPTURE SEULEMENT. etude.css remet la composition sur
    une colonne sous 860px ; cette declaration-ci vit dans la page, donc PLUS
    LOIN dans le bundle, et a specificite egale c'est elle qui gagnerait - y
    compris dans le media query. Mesure du symptome : a 390px les sept colonnes
    tenaient, les cartes faisaient 56px de large pour 1243 de haut.
  */
  @media(min-width:861px){
    .compo{grid-template-columns:20fr 9fr 20fr 24fr 25fr 4fr 16fr;
      grid-template-rows:minmax(170px,auto) minmax(75px,auto) 30px
        minmax(245px,auto) minmax(60px,auto)}
    /*
      LA MOSAIQUE DE LA DISCOVERY : quatre colonnes, et les sept extraits poses
      a la main. Comme la composition ci-dessus, la valeur est posee ICI et non
      en style inline sur l'element : inline, elle battrait la requete media qui
      remet la mosaique sur deux colonnes sous 860px, et les cases placees en
      colonnes 3 et 4 feraient naitre des colonnes implicites. Mesure du
      symptome a 390px : les quatre colonnes tenaient, 79px de large chacune.
    */
    .mosaic{--cols:4}
  }

  /*
    Le mot en couleur des phrases fortes. En <em> et non en <span> : c'est bien
    une emphase, et le mot garde son sens souligne quand le CSS ne charge pas.
    L'italique est retire - la couleur suffit, et l'italique d'un 900 a 34px
    passe pour un defaut de rendu.
  */
  .pan .em-rouge,.pan .em-bleu,.pan .closing em{font-style:normal}
  .pan .em-rouge{color:var(--red)}
  .pan .em-bleu{color:var(--blue)}
  .pan .dark .em-rouge{color:var(--yellow)}

  /* Deux blocs empiles dans une colonne du .split - le lead et ses visuels, le
     surtitre et sa mosaique. */
  .pan .pile{display:flex;flex-direction:column;gap:28px;min-width:0}
  .pan .pile--serre{gap:12px}
  .pan .two--serre{gap:12px}
  .pan .split--haut{align-items:start}
  /* Le titre de 2023 est une phrase forte deguisee en titre de section : il
     porte le corps du lead, pas celui d'un h3. */
  .pan .h3--lead{font-size:var(--fs-lead)}

  @media(max-width:860px){
    .pan .h3--lead{font-size:28px}
  }
</style>

