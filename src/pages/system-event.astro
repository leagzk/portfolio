<script>
  import { revealAll } from '../scripts/reveal';
  import { fonduEnchaine } from '../scripts/crossfade';
  import { rendreDeplacable } from '../scripts/drag';
  import { carrousel } from '../scripts/carousel';

  revealAll('.ls-reveal', { threshold: 0, rootMargin: '0px 0px -10% 0px' });
  revealAll('.talk-card', { threshold: 0.2 });

  const stage = document.querySelector<HTMLElement>('.ls-suite__stage');
  if (stage) fonduEnchaine(stage, '.ls-suite__frame', 2200);

  rendreDeplacable('.ls-shape', '(max-width:900px)');

  const track = document.getElementById('lscarousel');
  if (track) {
    carrousel(track, {
      slides: '.ls-carousel__slide',
      dots: [...document.querySelectorAll<HTMLElement>('.ls-carousel__dots .ls-dot')],
      arc: { y: 18, deg: 4.5, scale: 0.05 },
      depart: Number(track.dataset.start ?? 0),
    });
  }
</script>
