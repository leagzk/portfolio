---
/*
  ═══ Etude de cas Surfaces — Systematize a moment (BRIEF §7) ═══

  PAS DE MAQUETTE ICI NON PLUS. Comme Governance, le brief demande d'appliquer
  le systeme (§7), pas de reproduire un artboard. Gabarit de Language (§5),
  composition dessinee ici - une troisieme grille, encore differente des deux
  autres : la carte du milieu traverse toute la hauteur, et la bande fine est
  verticale au lieu d'etre horizontale.

  LES TROIS TEMPS NE S'APPELLENT PAS problem / approach / proof, et c'est
  voulu. Ces trois mots-la sont ceux d'un dossier d'entreprise ; plaques sur un
  evenement ils sonneraient faux, et le brief §0bis demande justement que cette
  page porte la preuve que la creativite depasse l'ecran. Le recit a ses
  propres trois temps : LA CONTRAINTE (deux objets loues, cinq mots), LE
  SYSTEME (cinquante surfaces, la scenographie, le jeu), LA TRANSMISSION (le
  guide de production, et ce que les gens en ont fait). La mecanique du gabarit
  est la meme ; seuls les intitules suivent l'histoire.

  LA DIRECTION CREATIVE EST RENDUE EXPLICITE (BRIEF §0bis) : les cinq mots sont
  presentes comme ce qu'ils etaient - le brief donne a tout le monde, suppliers
  compris -, le guide de production comme le document de direction, et les neuf
  prestataires comme ceux qu'il a fallu diriger. Rien n'est invente : ces trois
  elements etaient deja dans la page, disperses.

  TOUT LE CONTENU ET TOUS LES VISUELS SONT CONSERVES. Les trente et une images,
  les neuf credits, le specimen typographique, les trois formes deplacables, le
  fondu de la suite d'invitation et les trois comparaisons guide/realise sont
  la. Ce qui tombe, ce sont les dispositifs que le gabarit remplace : le
  sommaire flottant et les quatre surtitres de chapitre.
*/
import Base from '../layouts/Base.astro';
import '../styles/etude.css';
import Hero from '../components/Hero.astro';
import ChiffresCles from '../components/ChiffresCles.astro';
import type { Chiffre } from '../components/ChiffresCles.astro';
import CarteDossier from '../components/CarteDossier.astro';
import Carrousel from '../components/Carrousel.astro';
import type { Vignette } from '../components/Carrousel.astro';
import Figure from '../components/Figure.astro';
import Bouton from '../components/Bouton.astro';
import Icone from '../components/Icone.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Loupe from '../components/Loupe.astro';
import { chercheurImages } from '../lib/images';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
  Toutes les images en une fois plutot qu'en trente et un imports. Un nom
  errone casse le build ici, au lieu de produire un 404 silencieux.

  CREDITS DANS LES FICHIERS : photos = Madeleine Photographe / studiomadeleine.fr,
  pages de guide = Lea Giezek. Ils survivent a l'optimisation grace au service
  d'image maison (src/imageService.mjs) ; sharp les supprimerait sinon.
*/
const fichiers = import.meta.glob<ImageMetadata>('../assets/living-system/*.webp', {
  eager: true, import: 'default',
});
const img = chercheurImages(fichiers, 'living-system');

/*
  ─── Chiffres cles (BRIEF §5.2) ───
  Ceux d'un evenement ne sont pas ceux d'une plateforme, et c'est le propos :
  la duree, l'etendue, les prestataires diriges, et le fait que ce soit une
  TROISIEME edition - c'est elle qui prouve que le systeme se versionne.
*/
const chiffres: Chiffre[] = [
  { nombre: '1 an+', quoi: 'from first object to last jar', couleur: 'bleu', motif: 'plein',
    contexte: 'Designed and orchestrated end to end, alongside the day job.' },
  { nombre: '50+', quoi: 'surfaces, one identity', couleur: 'jaune', motif: 'carre',
    contexte: 'Paper, fabric, metal, wood - and a pre-event WhatsApp community.' },
  { nombre: '9', quoi: 'suppliers directed from one guide', couleur: 'noir', motif: 'plein',
    contexte: 'One page per zone, one owner per page. Executed without me in the room.' },
  { nombre: '3rd', quoi: 'edition, each bigger than the last', couleur: 'rouge', motif: 'bande',
    contexte: "A full identity every time, an escape game every time. I don't repeat a system - I version it." },
];

/*
  ─── Les neuf surfaces du carrousel ───
  Ajouter une image = une entree ici. Credit XMP : Madeleine Photographe.
*/
const surfaces: Vignette[] = [
  { nom: 'identity-welcome-sign', legende: 'Signage',
    alt: 'Welcome sign on an easel showing the event monogram, beside stacked metal trunks' },
  { nom: 'identity-invitation-suite', legende: 'Stationery',
    alt: 'Invitation suite of layered printed cards and coloured envelopes' },
  { nom: 'identity-monogram-arch', legende: 'Scenography',
    alt: 'Monogram disc and a striped disc hanging from the ceremony arch above a floral pedestal' },
  { nom: 'identity-cards', legende: 'Message cards',
    alt: "Wall rack holding message cards in the identity's colours and patterns" },
  { nom: 'identity-place-setting', legende: 'Table setting',
    alt: 'Place setting built on the patterned plate, with a monogram coaster and printed cards laid on it' },
  { nom: 'identity-message-desk', legende: 'Writing desk',
    alt: 'Writing desk set up for guests with coloured pens and a framed instruction card' },
  { nom: 'identity-dresscode', legende: 'Dresscode',
    alt: 'The dress code worn, seen from behind on a gravel path: a sequinned open-back top, a long white skirt, a white hair bow and a wildflower bouquet held low' },
  { nom: 'identity-guest-gift', legende: 'Guest gift',
    alt: "Enamel heart pin in the identity's ochre, worn on a navy lapel beside a bow tie in the scalloped pattern" },
  { nom: 'game-cats-board', legende: 'Collaborative game',
    alt: 'Print artwork for the first riddle: a nine by nine colour-region grid with its single rule set above it' },
].map((s) => ({ src: img(s.nom), alt: s.alt, legende: s.legende, titre: s.legende }));

/*
  Palette prise sur la glacure de l'assiette Popolo. Les noms sont en francais,
  d'ou le lang="fr" sur chacun : sans lui une synthese vocale anglaise les
  ecorcherait.
*/
const couleurs = [
  { hex: '#008C68', nom: 'Vert' },
  { hex: '#455192', nom: 'Bleu' },
  { hex: '#F05863', nom: 'Rouge' },
  { hex: '#F7A800', nom: 'Jaune' },
  { hex: '#FDC1BD', nom: 'Rose' },
];

/* Les trois etapes du jeu, dans l'ordre ou on les vit. */
const etapes = [
  { nom: 'game-locked', rang: '01', titre: 'The constraint',
    propos: 'A locked trunk, a combination, and clues scattered across the day.',
    alt: 'Hands working a combination padlock on a metal trunk, playing cards and jars set out on the lid' },
  { nom: 'game-opened', rang: '02', titre: 'The crack',
    propos: 'Progression built so the last step feels earned, not handed over.',
    alt: 'Opened trunk revealing a framed congratulations card above rows of jars' },
  { nom: 'game-reward', rang: '03', titre: 'The payoff',
    propos: 'The reward carries the identity too. The system runs to the last object.',
    alt: 'Rows of jars packed in the trunk, each labelled with the event monogram on striped paper' },
];

/*
  Les neuf prestataires. data-label reprend le nom : le CSS s'en sert pour
  reserver la largeur du gras au survol, sans faire sauter la mise en page.
*/
const credits = [
  { role: 'Artwork & event design', nom: 'Léa Giezek' },
  { role: 'Photography', nom: 'Madeleine Photographe ©', href: 'https://studiomadeleine.fr/' },
  { role: 'Day-of coordination', nom: 'Hera & Harmonia', href: 'https://hera-et-harmonia.com/' },
  { role: 'Venue', nom: 'Le Grand Breuil', href: 'https://www.legrandbreuil.com/' },
  { role: 'Furniture', nom: 'Agence Parade', href: 'https://agence-parade.fr/' },
  { role: 'Print', nom: 'Les Ateliers Paquereau', href: 'https://www.imprimerie-paquereau.com/' },
  { role: 'Floral design', nom: 'Les Nanas', href: 'https://lesnanas-studiofloral.com/' },
  { role: 'Tableware & linen', nom: 'Maison Options', href: 'https://www.options.fr/' },
  { role: 'Cocktail bar', nom: 'Le Horse Bar', href: 'https://sobarsodrink.squarespace.com/' },
];
---
<Base
  title="Surfaces - Systematize a moment - Léa Giezek"
  description="One live experience treated as a design system: identity, staging, a six-puzzle centrepiece and the production guide that let others run it without me."
  brandFonts
>{/* brandFonts : le specimen .spec charge fino-sans et serenity via Adobe Fonts */}

  <Hero
    courant="system-event"
    eyebrow="Systematize a moment · Living System · 3rd edition"
    filigrane="Surfaces"
    mesure={12.9}
  >
    Same systems thinking, same care - just off the screen.
    <Fragment slot="intro">
      Over more than a year, I designed and orchestrated a live event from end to
      end - one identity, one experience, held together across every surface and
      every supplier. No repository. No deploy pipeline. Just the discipline of
      making a hundred moving parts feel like one thing.
    </Fragment>
  </Hero>

  <div class="etude">

    <ChiffresCles chiffres={chiffres} label="The measure of it" variante="mondrian" />

    {/*
      ─── La composition des 3 cartes ───
      Troisieme grille du site, encore differente des deux autres : sept
      colonnes, QUATRE rangees, la bande fine est VERTICALE (la quatrieme
      colonne) au lieu d'etre horizontale, et la carte du milieu traverse toute
      la hauteur. Les trois cartes font 472x291, 363x535 et 472x241 : trois
      formes, pas trois variantes d'un meme rectangle.
    */}
    <div class="compo" id="composition" data-grille>
      <CarteDossier
        id="carte-contrainte"
        rang="01"
        intitule="The constraint"
        titre="It started with two rented objects."
        synthese="Not a moodboard: a plate and an armchair we could actually put in the space. One gave the pattern language, the other gave the posture - and five words came out of them before anything was drawn."
        couleur="rouge"
        commande="pan-contrainte"
        large
        aire="1 / 1 / 3 / 4"
      />

      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 4 / 2 / 5"><span class="compo__plat compo__plat--jaune"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 4 / 3 / 5"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 4 / 4 / 5"><span class="compo__plat compo__plat--noir"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:4 / 4 / 5 / 5"></div>

      <CarteDossier
        id="carte-systeme"
        rang="02"
        intitule="The system"
        titre="One identity, fifty-plus surfaces, zero inconsistency."
        synthese="Declined on paper, fabric, metal and wood - then staged in the space, and closed by an escape game built from zero. The test was the boring surfaces."
        couleur="bleu"
        commande="pan-systeme"
        aire="1 / 5 / 5 / 7"
      />

      <div class="compo__decor" aria-hidden="true" style="grid-area:1 / 7 / 2 / 8"></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:2 / 7 / 3 / 8"><span class="compo__plat compo__plat--rouge"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:3 / 7 / 4 / 8"><span class="compo__plat compo__plat--gris"></span></div>
      <div class="compo__decor" aria-hidden="true" style="grid-area:4 / 7 / 5 / 8"></div>

      <CarteDossier
        id="carte-transmission"
        rang="03"
        intitule="The handover"
        titre="Precise enough to be run without me in the room."
        synthese="One page per zone, one owner per page. I briefed every supplier from it, handed the day to a coordinator - and got to be in the experience instead of running it."
        couleur="jaune"
        commande="pan-transmission"
        aire="3 / 1 / 5 / 4"
      />
    </div>

    {/* ═══════════ 01 · The constraint ═══════════ */}
    <section class="pan" id="pan-contrainte" aria-labelledby="titre-contrainte">
      <h2 class="sr-only" id="titre-contrainte">01 &middot; The constraint</h2>

      <div class="subsec">
        {/* « Here, off the screen, exactly as it does on it » - la phrase est
            dans le bloc. Seule sous-partie du chapitre sans surtitre. */}
        <p class="eb" data-sommaire>Off the screen</p>
        <div class="split">
          <p class="lead">A living system isn't one you finish. It's one that takes its real shape <em class="em-rouge">in the hands of the people who use it.</em></p>
          <div class="pile">
            <div class="body">
              <p>Here, off the screen, exactly as it does on it. Not product. Not digital. Not communication. A living one - and it held together just the same.</p>
              <p>It's the proof I keep coming back to: <strong>my way of working doesn't depend on the medium.</strong> Systems thinking, brand coherence, experience design - they hold whether the output ships to production or lives in a garden for one day.</p>
            </div>
            <Figure
              src={img('staging-arch')}
              alt="Ceremony arch hung with shapes from the event's visual identity, framed by floral pedestals and two seats"
              legende="The system, in the world"
              ratio="3 / 4"
              ajuste="cover"
              sizes="(min-width: 900px) 420px, 90vw"
            />
          </div>
        </div>
      </div>

      <div class="subsec">
        <p class="eb" data-sommaire>Where it came from</p>
        <div class="split">
          <p class="lead">Starting from a constraint <em class="em-rouge">you don't own.</em></p>
          <div class="body">
            <p><strong>The whole thing started with two objects.</strong> Not a moodboard and not a colour study - two rented pieces we could actually put in the space. The <strong>Popolo</strong> plate: scalloped rim, hand-painted florals, cobalt and ochre. The <strong>Roly Poly</strong> armchair: fat legs, round shoulders, no straight line anywhere. One gave the pattern language. The other gave the posture. Then making every other decision agree with them - that's most of the job on the platform too.</p>
            <p>Five words came out of them, written down before anything was drawn: <strong>shapes, type, colors, conviviality and playfulness.</strong> Then systematised end to end across the whole experience, from the first envelope to the last jar label.</p>
            <p>The scallop became the die-cut on the stationery and the discs hung from the arch. The chair's soft geometry became the arched panels on the signage. The palette came straight off the glaze. And the last two - conviviality and playfulness, the ones that aren't visual properties at all - <strong>are the reason the day ended up with an escape game in it.</strong></p>
          </div>
        </div>
        <p class="qt">Those five words were the brief - mine, and everyone else's. <strong>Every supplier was briefed from them, and every arbitration came back to them.</strong> That is the whole of the creative direction: not a mood, a short list you can hold someone to.</p>
      </div>

      <div class="subsec">
        <p class="eb" data-sommaire>The system itself</p>
        <div class="trois-blocs">
          <div class="bloc">
            <p class="bloc__t">Shapes</p>
            {/*
              Trois decoupes, prises sur le bord de l'assiette et la silhouette
              du fauteuil. Elles sont DEPLACABLES au-dela de 900px - c'est le
              geste du brief, on les pose sur la table - et redeviennent un rang
              fixe en dessous, ou un glisser volerait le defilement tactile.
            */}
            <ul class="formes" aria-label="The three cut-out shapes">
              <li class="forme" style="--x:0%;--y:0px;--rot:-8deg">
                <svg viewBox="0 0 155.09 155.09" aria-hidden="true"><circle cx="77.54" cy="77.54" r="77.54" /></svg>
                <b>Circle</b>
              </li>
              <li class="forme" style="--x:34%;--y:84px;--rot:5deg">
                <svg viewBox="0 0 135.38 144.45" aria-hidden="true"><path d="M86.34,0H0s0,119.69,0,119.69c0,13.67,11.08,24.75,24.75,24.75h110.62s0-95.41,0-95.41C135.38,21.95,113.42,0,86.34,0Z" /></svg>
                <b>Square</b>
              </li>
              <li class="forme" style="--x:66%;--y:12px;--rot:-4deg">
                <svg viewBox="0 0 164.64 171.5" aria-hidden="true"><path d="M5.28,76l-1.81-2.23c-7.07-8.7-2.81-21.8,8.02-24.68l2.78-.74c7.07-1.88,11.85-8.46,11.46-15.77l-.15-2.87c-.6-11.19,10.54-19.29,21-15.25l2.68,1.03c6.83,2.63,14.56.12,18.54-6.02l1.56-2.41c6.09-9.41,19.86-9.41,25.95,0l1.56,2.41c3.98,6.14,11.71,8.66,18.54,6.02l2.68-1.03c10.46-4.03,21.6,4.06,21,15.25l-.15,2.87c-.39,7.31,4.39,13.89,11.46,15.77l2.78.74c10.83,2.88,15.09,15.98,8.02,24.68l-1.81,2.23c-4.61,5.68-4.61,13.81,0,19.49l1.81,2.23c7.07,8.7,2.81,21.8-8.02,24.68l-2.78.74c-7.07,1.88-11.85,8.46-11.46,15.77l.15,2.87c.6,11.19-10.54,19.29-21,15.25l-2.68-1.03c-6.83-2.63-14.56-.12-18.54,6.02l-1.56,2.41c-6.09,9.41-19.86,9.41-25.95,0l-1.56-2.41c-3.97-6.14-11.71-8.66-18.54-6.02l-2.68,1.03c-10.46,4.03-21.6-4.06-21-15.25l.15-2.87c.39-7.31-4.39-13.89-11.46-15.77l-2.78-.74c-10.83-2.88-15.09-15.98-8.02-24.68l1.81-2.23c4.61-5.68,4.61-13.81,0-19.49Z" /></svg>
                <b>Star</b>
              </li>
            </ul>
            <p class="cap">Three cut-outs, taken off the plate's rim and the chair's silhouette. Every badge, tag, disc and die-cut in the identity is one of these three.</p>
          </div>

          <div class="bloc">
            <p class="bloc__t">Colors</p>
            <ul class="sw" style="--swc:5">
              {couleurs.map((c) => (
                <li class="swi">
                  <div class="swc" style={`background:${c.hex}`}></div>
                  <span lang="fr">{c.nom}</span>
                  <code>{c.hex}</code>
                </li>
              ))}
            </ul>
            <p class="cap">Taken straight off the glaze of the Popolo plate.</p>
          </div>

          <div class="bloc">
            <p class="bloc__t">Type</p>
            <div class="spec">
              <p class="spec__display">Aa</p>
              <div class="spec__meta">
                <p class="spec__nom">Fino Sans</p>
                <p class="spec__usage">Display - titles, numbers, anything set large. High contrast, tight, a little theatrical.</p>
              </div>
            </div>
            <div class="spec">
              <p class="spec__sans">Aa</p>
              <div class="spec__meta">
                <p class="spec__nom">Serenity</p>
                <p class="spec__usage">Text - rules, timings, instructions. Plain enough to disappear behind the display face.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Le pied de chapitre : retour au sommaire a gauche, chapitre suivant
          a droite. Voir .pan__pied dans etude.css et [data-haut] dans
          src/scripts/dossier.ts. */}
      <div class="pan__pied">
        <button class="pan__haut" type="button" data-haut aria-label="Back to the top of the chapters">
          <Icone nom="fleche-haut" taille={20} />
        </button>
        <Bouton variante="bleu" class="suite" commande="carte-systeme">Next: the system →</Bouton>
      </div>
    </section>

    {/* ═══════════ 02 · The system ═══════════ */}
    <section class="pan" id="pan-systeme" aria-labelledby="titre-systeme">
      <h2 class="sr-only" id="titre-systeme">02 &middot; The system</h2>

      <div class="subsec">
        <div class="split">
          <p class="lead">Nothing was left to chance, <em class="em-bleu">and nothing drifted.</em></p>
          <div class="body">
            <p>A full visual identity, declined across every physical surface the day would touch - and even before it, animating the pre-event through a WhatsApp community. A monogram, a palette, signage, stationery, room tags, table names, favours, packaging. <strong>Dozens of touchpoints, one language</strong> - the same coherence I hold across 45+ digital products, applied to paper, fabric, metal and wood.</p>
          </div>
        </div>
        <Carrousel
          label="The surfaces"
          eyebrow="One identity, fifty-plus surfaces"
          vignettes={surfaces}
          ratio="4 / 3"
          fr={1.3333}
          largeur="62%"
          sizes="(min-width: 900px) 660px, 90vw"
        />
      </div>

      <div class="subsec">
        <p class="eb" data-sommaire>The test</p>
        <div class="split">
          <p class="lead">The test was <em class="em-bleu">the boring surfaces.</em></p>
          <div class="body">
            <p>Anyone can be charming on an invitation. The proof is on the signage nobody is meant to enjoy - where to leave your glass, welcome signage to your room to share care. Same display face, same stripes, same jokes.</p>
            <p>That's where <strong>conviviality and playfulness</strong> stopped being words on a moodboard and became a rule I had to keep, on the two hundredth decision as much as the first.</p>
          </div>
        </div>
        <div class="two">
          <Figure src={img('signage-door-tag')} legende="Room tag, in place" ratio="4 / 3" ajuste="cover"
            alt="Striped door tag hanging from a bedroom handle, naming the room in the identity's display type"
            sizes="(min-width: 900px) 520px, 90vw" />
          <Figure src={img('print-glass-rules')} legende="Glass rules - 100 × 150 mm" ratio="4 / 3"
            alt="Print artwork for the small card explaining what to do with your glass through the evening"
            sizes="(min-width: 900px) 520px, 90vw" />
        </div>
      </div>

      <div class="subsec">
        <p class="eb" data-sommaire>Printed, in the hand</p>
        <div class="two">
          <Figure src={img('identity-invitation-detail')} legende="The invitation, printed" ratio="4 / 3" ajuste="cover"
            alt="Close view of the printed invitation: die-cut cards, coloured blocks and a heart sticker on a wooden table"
            sizes="(min-width: 900px) 520px, 90vw" />
          {/*
            LA SUITE SE FOND D'UN ETAT A L'AUTRE, trois images au meme endroit :
            la pile fermee, ouverte, puis posee. Trois vignettes cote a cote
            auraient montre trois photos ; le fondu montre un objet qu'on
            deplie. src/scripts/crossfade.ts, 2,2s par etat.
          */}
          <figure class="fig">
            <div class="fig__cadre suite" style="aspect-ratio:4 / 3;--fit:contain">
              <Image class="suite__etat is-on" src={img('suite-state-1')} alt="The invitation suite laid flat, first arrangement" sizes="(min-width: 900px) 520px, 90vw" loading="lazy" decoding="async" />
              <Image class="suite__etat" src={img('suite-state-2')} alt="The invitation suite fully opened out, every card visible" sizes="(min-width: 900px) 520px, 90vw" loading="lazy" decoding="async" />
              <Image class="suite__etat" src={img('suite-state-3')} alt="The invitation suite arranged in place" sizes="(min-width: 900px) 520px, 90vw" loading="lazy" decoding="async" />
            </div>
            <figcaption class="cap">The suite, unfolding</figcaption>
          </figure>
        </div>
      </div>

      <div class="subsec">
        <p class="eb" data-sommaire>Staging</p>
        <div class="split">
          <p class="lead">Space, <em class="em-bleu">staged.</em></p>
          <div class="body">
            <p>An implantation plan for the day, then the scenography that brought it to life: the arch, the seating, the floral pedestals, the palette carried into every corner of the space.</p>
            <p>The system on paper, and the system in the world - <strong>the same jump from specification to production I run on the platform</strong>, made physical.</p>
          </div>
        </div>
        <div class="two">
          <Figure src={img('staging-hall')} legende="The room, at scale" ratio="4 / 3" ajuste="cover"
            alt="Reception hall under exposed beams and string lights, long tables laid for a hundred guests"
            sizes="(min-width: 900px) 520px, 90vw" />
          <Figure src={img('staging-table')} legende="Tablescape" ratio="4 / 3" ajuste="cover"
            alt="Long table with patterned plates, gold cutlery and single-stem vases running down the centre"
            sizes="(min-width: 900px) 520px, 90vw" />
          <Figure src={img('staging-glass')} legende="Place card" ratio="4 / 3" ajuste="cover"
            alt="Place card clipped to a wine glass on the laid table, beside a small vase of ranunculus"
            sizes="(min-width: 900px) 520px, 90vw" />
          <Figure src={img('staging-flowers')} legende="Palette" ratio="4 / 3" ajuste="cover"
            alt="Close view of the flower palette: white daisies, blue cornflowers and pink blooms"
            sizes="(min-width: 900px) 520px, 90vw" />
        </div>
        <BeforeAfter
          spec={{ src: img('spec-zone-seating'), alt: 'Page from the production guide: mockup of the seating panels with the material checklist' }}
          built={{ src: img('staging-entrance-evening'), alt: 'The seating panels installed at the venue doorway at dusk, flanked by floral columns' }}
          caption="Drawn in Illustrator, briefed to four suppliers, standing at the door twelve months later."
        />
      </div>

      <div class="subsec">
        <p class="eb" data-sommaire>The centrepiece</p>
        <div class="split">
          <p class="lead">A game, <em class="em-bleu">by design.</em></p>
          <div class="body">
            <p>An escape game, designed from zero - rules, clues, progression, reward. A locked trunk, a sequence to crack, a payoff at the end. Experience design in its purest form: a system of constraints and steps that has to <em>feel</em> effortless while being tightly engineered underneath.</p>
            <p><strong>Six riddles, six different mechanics for six essential clues to unlock one final chest, all together.</strong> Each had to be learnable in thirty seconds, solvable by people holding a drink, and unmistakably part of the same day as the invitation and the table.</p>
          </div>
        </div>
        <Figure src={img('game-setup-wide')} legende="The game, set up in the courtyard" ratio="16 / 9" ajuste="cover"
          alt="The escape game set up in the courtyard: painted trunks, a mirrored clue panel and the first floral arrangement"
          sizes="(min-width: 900px) 1040px, 92vw" />
        <div class="three">
          {etapes.map((e) => (
            <Figure
              src={img(e.nom)}
              alt={e.alt}
              legende={`<strong>${e.rang} &middot; ${e.titre}</strong> ${e.propos}`}
              ratio="4 / 3"
              ajuste="cover"
              sizes="(min-width: 900px) 340px, 45vw"
            />
          ))}
        </div>
        <div class="body">
          <p>But here's what I love most about it: <strong>it only became itself once people played it.</strong> I designed the frame - tight, deliberate, engineered underneath - and the experience took its real shape in their hands, evolving as they moved through it, in ways no plan could fully script.</p>
        </div>
        <p class="qt">Shipped empty. <strong>Finished by the people who played it.</strong></p>
        <BeforeAfter
          spec={{ src: img('spec-zone-murdle'), alt: 'Production guide page for the deduction game: empty grid on an easel, material checklist and set-up notes' }}
          built={{ src: img('game-murdle'), alt: 'The same deduction board after play, its grid filled with pink and green wooden tokens' }}
          builtLabel="Played"
          caption="The deduction grid, before anyone touched it and after a hundred people did."
        />
        <BeforeAfter
          spec={{ src: img('spec-zone-wordsearch'), alt: 'Production guide page for the word-grid game: blank poster on an easel with its material checklist' }}
          built={{ src: img('game-wordsearch'), alt: 'The word grid mid-game, crossed through with chalk lines as players work it out together' }}
          builtLabel="Played"
          caption="I drew the grid. The marks on it aren't mine - and that was always the point."
        />
        <div class="body">
          <p>That's the whole truth about the systems I build: <strong>you design them for the people who'll use them, not for yourself - and they come alive the moment you let go.</strong> An escape game, a design system, a platform: same principle.</p>
          <p class="qt">The frame is mine. <strong>The life is theirs.</strong></p>
        </div>
      </div>

      {/* Le pied de chapitre : retour au sommaire a gauche, chapitre suivant
          a droite. Voir .pan__pied dans etude.css et [data-haut] dans
          src/scripts/dossier.ts. */}
      <div class="pan__pied">
        <button class="pan__haut" type="button" data-haut aria-label="Back to the top of the chapters">
          <Icone nom="fleche-haut" taille={20} />
        </button>
        <Bouton variante="jaune" class="suite" commande="carte-transmission">Next: the handover →</Bouton>
      </div>
    </section>

    {/* ═══════════ 03 · The handover ═══════════ */}
    <section class="pan" id="pan-transmission" aria-labelledby="titre-transmission">
      <h2 class="sr-only" id="titre-transmission">03 &middot; The handover</h2>

      <div class="dark">
        <p class="eb" data-sommaire>The part nobody sees</p>
        <h3 class="h3">One page per zone, one owner per page.</h3>
        <p>Behind the identity and the staging: coordination. Florist, caterer, photographer, venue, rentals - a full ecosystem of suppliers, each with their own constraints, all pulling toward one coherent experience.</p>
        <p>I wrote it all down. Zone by zone: what goes where, what it's made of, what it's for. <strong>A production guide precise enough to be executed without me in the room</strong> - then I handed the day itself to Hera &amp; Harmonia, who ran it from the brief. <strong>That's the whole method.</strong></p>
        <p>Because the point was never to hold every thread myself. It was to build something clear enough that someone else could carry it, and to trust them to. On the day, the system held, and I got to be <em>in</em> the experience instead of running it.</p>
        <p class="dark__chute">The same move as everything else I build: design the system, iterate with stakeholders, brief the owners, step back and collect the feedback. It works in a repo. It works in a garden.</p>
      </div>

      <div class="subsec">
        <Figure src={img('coordination-embrace')} legende="Inside it, not behind it." ratio="16 / 9" ajuste="cover"
          alt="Guests embracing at the event, the designer among them rather than running the day"
          sizes="(min-width: 900px) 1040px, 92vw" />
      </div>

      <div class="subsec">
        <p class="eb" data-sommaire>Credits</p>
        <div class="split">
          <p class="lead">Vision and execution directed by me - <em class="em-jaune">everything else by people far better than me at their own craft.</em></p>
          <dl class="credits">
            {credits.map((c) => (
              <div class="credits__ligne">
                {/* pas de set:html : le role est du texte brut, et set:html
                    laisserait passer un & nu la ou il faut &amp; */}
                <dt>{c.role}</dt>
                <dd>
                  {c.href
                    ? <a href={c.href} target="_blank" rel="noopener noreferrer" data-label={c.nom}>{c.nom}<span class="sr-only"> (opens in a new tab)</span></a>
                    : <span class="credits__moi">{c.nom}</span>}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <div class="closing">
        <h2>I don't just repeat a system. <em class="em-jaune">I version it.</em></h2>
        <p class="cbody">This wasn't a one-off. It was the third edition - each one bigger than the last: a full identity every time, an escape game every time, the level raised at every turn. <strong>The pattern doesn't stop at the screen - and it doesn't stop at work either.</strong></p>
        <Bouton variante="bleu" href="/system-practice-elements">See it at global scale →</Bouton>
      </div>

      {/* LE PIED DU DERNIER CHAPITRE. A gauche, le meme retour en haut
          qu'ailleurs : il remonte sans rien refermer. A droite, pas de
          « Next: ... » - il n'y a pas de tuile 04, et le sommaire des
          trois cartes est reduit a celle-ci ; ce bouton-la le rouvre. Les deux
          remontent, l'un garde le chapitre ouvert, l'autre referme tout.
          Voir .pan__pied dans etude.css et dossier.ts. */}
      <div class="pan__pied">
        <button class="pan__haut" type="button" data-haut aria-label="Back to the top of the chapters">
          <Icone nom="fleche-haut" taille={20} />
        </button>
      </div>
    </section>

  </div>

  {/* une seule loupe pour toutes les series agrandissables de la page */}
  <Loupe />

</Base>

<style is:global>
  /* ═══ Ce qui est propre a l'etude Surfaces ═══ */

  /*
    LA COMPOSITION. Sept colonnes et QUATRE rangees - les deux autres etudes en
    ont cinq. La bande fine est VERTICALE ici (la quatrieme colonne, 8fr) au
    lieu d'etre horizontale, et la carte du milieu traverse toute la hauteur.
    Mesure a 1072 : 472x291, 363x535 et 472x241. Trois formes, pas trois
    variantes d'un meme rectangle.

    Rangees en minmax : en pixels fixes, la synthese gagne des lignes entre 861
    et 1120 pendant que la rangee ne bouge pas, et la carte - en overflow
    hidden - les avale. Defaut mesure a l'etape 4, pas question de le refaire.

    Au-dessus du point de rupture seulement : etude.css remet la composition
    sur une colonne sous 860px, et cette declaration vit plus loin dans le
    bundle - a specificite egale elle gagnerait, media query comprise.
  */
  @media(min-width:861px){
    .compo{grid-template-columns:20fr 12fr 20fr 8fr 26fr 14fr 18fr;
      grid-template-rows:minmax(170px,auto) minmax(95px,auto)
        minmax(120px,auto) minmax(75px,auto)}
  }

  /* ─── Les trois blocs du systeme : formes, couleurs, type ─── */
  .pan .trois-blocs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
    gap:var(--rule-fine);background:var(--text);
    border:var(--rule-fine) solid var(--text)}
  .pan .bloc{background:var(--white);padding:28px 24px;display:flex;
    flex-direction:column;gap:16px;min-width:0}
  .pan .bloc__t{margin:0;font-size:var(--fs-eyebrow);font-weight:700;
    letter-spacing:.2em;text-transform:uppercase}
  .pan .bloc .sw{gap:8px}
  .pan .bloc .cap{margin-top:auto}

  /*
    ─── Les trois decoupes ───
    DEPLACABLES AU-DELA DE 900px, et c'est le geste du brief : on les pose sur
    la table, on les tourne, on regarde ce qu'elles donnent ensemble. En
    dessous elles redeviennent un rang fixe - un glisser y volerait le
    defilement tactile, et rendreDeplacable() est appele avec ce seuil.
    Pas de degrade ici, contrairement a l'ancienne page : le gabarit n'en a
    aucun, et un aplat franc par forme dit la meme chose dans sa langue.
  */
  .pan .formes{list-style:none;position:relative;height:230px;margin:0;padding:0;
    touch-action:none}
  .pan .forme{position:absolute;left:var(--x);top:var(--y);display:flex;
    flex-direction:column;align-items:center;gap:10px;
    transform:rotate(var(--rot));cursor:grab;user-select:none;
    transition:transform .22s cubic-bezier(.22,1,.36,1)}
  .pan .forme svg{width:82px;height:82px;display:block;overflow:visible}
  .pan .forme svg :is(circle,path){fill:var(--text);transition:fill .28s ease}
  .pan .forme:nth-child(1):hover svg :is(circle,path),
  .pan .forme:nth-child(1).grabbing svg :is(circle,path){fill:var(--red)}
  .pan .forme:nth-child(2):hover svg :is(circle,path),
  .pan .forme:nth-child(2).grabbing svg :is(circle,path){fill:var(--blue)}
  .pan .forme:nth-child(3):hover svg :is(circle,path),
  .pan .forme:nth-child(3).grabbing svg :is(circle,path){fill:var(--yellow)}
  .pan .forme b{font-size:11px;font-weight:700;letter-spacing:.12em;
    text-transform:uppercase;color:var(--ink-muted)}
  .pan .forme:hover{transform:rotate(0deg) scale(1.06)}
  .pan .forme.grabbing{cursor:grabbing;transform:rotate(0deg) scale(1.08);z-index:30}

  /*
    ─── Le specimen typographique ───
    Les deux polices du projet, servies par le kit Adobe (brandFonts dans
    <Base>). Ce sont les SEULES polices tierces du site, et elles ne se
    chargent que sur cette page.
  */
  .pan .spec{--brand-display:"fino-sans",Georgia,serif;
    --brand-sans:"serenity",system-ui,sans-serif;
    display:flex;align-items:baseline;gap:16px;padding:14px 0;
    border-top:var(--rule-fine) solid var(--text)}
  .pan .spec__display{margin:0;font-family:var(--brand-display);font-weight:700;
    font-size:44px;line-height:.9}
  .pan .spec__sans{margin:0;font-family:var(--brand-sans);font-weight:500;
    font-size:40px;line-height:.9}
  .pan .spec__meta{min-width:0}
  .pan .spec__nom{margin:0;font-size:14px;font-weight:700}
  .pan .spec__usage{margin:3px 0 0;font-size:13px;line-height:1.5;
    color:var(--ink-muted)}

  /*
    ─── La suite d'invitation qui se deplie ───
    Trois etats au MEME endroit, en fondu. Trois vignettes cote a cote
    auraient montre trois photos ; le fondu montre un objet qu'on deplie.
  */
  .pan .suite{position:relative}
  .pan .suite .suite__etat{position:absolute;inset:0;width:100%;height:100%;
    object-fit:contain;opacity:0;transition:opacity .9s ease}
  .pan .suite .suite__etat.is-on{opacity:1}

  /* ─── Les neuf credits ─── */
  .pan .credits{margin:0;display:grid;
    grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:20px 28px}
  .pan .credits__ligne{display:flex;flex-direction:column;gap:5px;min-width:0}
  .pan .credits__ligne dt{font-size:11px;font-weight:700;letter-spacing:.14em;
    text-transform:uppercase;color:var(--ink-muted)}
  .pan .credits__ligne dd{margin:0;font-size:16px;line-height:1.3}
  .pan .credits__ligne a{text-decoration:none;font-weight:500;color:var(--text);
    border-bottom:var(--rule-fine) solid var(--blue);transition:font-weight .2s}
  /* ::after reserve la largeur du gras : sans lui, le survol ferait sauter la
     mise en page de toute la colonne. */
  .pan .credits__ligne a::after{content:attr(data-label);display:block;height:0;
    overflow:hidden;visibility:hidden;font-weight:700;pointer-events:none}
  .pan .credits__ligne a:hover{font-weight:700}
  .pan .credits__moi{font-weight:700}

  @media(max-width:860px){
    .pan .trois-blocs{grid-template-columns:1fr}
    /* Les formes redeviennent un rang : plus de glisser, plus de position
       absolue - en dessous de ce seuil le geste volerait le defilement. */
    .pan .formes{height:auto;display:flex;gap:28px;touch-action:auto;
      padding:4px 0 0;flex-wrap:wrap}
    .pan .forme{position:static;cursor:default;transform:none}
    .pan .forme:hover,.pan .forme.grabbing{transform:none}
    .pan .spec__display{font-size:38px}
    .pan .spec__sans{font-size:34px}
  }

  @media(prefers-reduced-motion:reduce){
    .pan .suite .suite__etat{transition:none}
  }
</style>

<script>
  import { initDossier } from '../scripts/dossier';
  import { initLoupe } from '../scripts/loupe';
  import { suivreCadres } from '../scripts/vues';
  import { fonduEnchaine } from '../scripts/crossfade';
  import { rendreDeplacable } from '../scripts/drag';

  initDossier();
  initLoupe();
  suivreCadres();

  /* La suite d'invitation : trois etats, 2,2s chacun. */
  const scene = document.querySelector<HTMLElement>('.suite');
  if (scene) fonduEnchaine(scene, '.suite__etat', 2200);

  /* Les trois decoupes, deplacables seulement au-dela du palier mobile. */
  rendreDeplacable('.forme', '(max-width:860px)');
</script>
