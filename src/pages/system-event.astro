  .ls-credits__row dd{margin:0;font-size:16px;line-height:1.3}
  /* meme mecanique que la nav : la largeur du gras est reservee, pas de saut au survol */
  .ls-credits__row a{position:relative;text-decoration:none;font-weight:500;color:var(--ink);transition:color .28s ease}
  .ls-credits__row a::after{content:attr(data-label);display:block;height:0;overflow:hidden;visibility:hidden;font-weight:700;pointer-events:none}
  .ls-credits__row a:hover{font-weight:700}
  .ls-credits__self{font-weight:700;color:var(--ink)}
  .ls-credits__note{margin-top:clamp(20px,2.4vw,28px);font-size:12px;line-height:1.7;color:var(--ink-muted)}
  @media(max-width:560px){
    .ls-credits__row{flex-direction:column;align-items:flex-start;gap:4px}
    .ls-credits__row dd{text-align:left}
  }

  /* --- reveals ------------------------------------------------------- */
  .js .ls-reveal{opacity:0;transform:translateY(18px)}
  .js .ls-reveal.in{opacity:1;transform:none;transition:opacity .6s ease,transform .7s cubic-bezier(.22,1,.36,1)}

  @media(max-width:900px){
    .ls-thesis{grid-template-columns:1fr;gap:clamp(20px,4vw,32px)}
    .ls-thesis__fig{aspect-ratio:4/3}
    /* les trois piliers s'empilent en pleine largeur ; seuls Shapes et
       Colors se swipent, chacun dans son propre rail (voir 560px) */
    .ls-system{grid-template-columns:1fr;gap:clamp(28px,5vw,40px)}
    /* tablette : plus de chevauchement, alignement ferre a gauche */
    .ls-shapes{height:auto;display:flex;align-items:flex-start;justify-content:flex-start;gap:clamp(28px,5vw,56px);touch-action:auto;padding:4px 0 0}
    .ls-shape{position:static;cursor:default;transform:none}
    .ls-shape:hover,.ls-shape.grabbing{transform:none}
    .ls-print{grid-template-columns:1fr;gap:clamp(20px,4vw,28px)}
    .ls-idgrid{grid-template-columns:1fr;gap:clamp(24px,4vw,36px)}
    .ls-gamehead{grid-template-columns:1fr;gap:clamp(20px,4vw,28px)}
    .ls-gamehead__top{margin-bottom:0}
    .ls-origin{grid-template-columns:1fr;gap:clamp(20px,4vw,32px)}
    .ls-split{grid-template-columns:1fr;gap:clamp(20px,4vw,32px)}
    .ls-split__text{position:static}
    .ls-claim{max-width:none}
    .ls-steps{grid-template-columns:1fr;gap:clamp(28px,6vw,40px)}
    .ls-step{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(16px,3vw,24px);align-items:center}
    .ls-step .ls-fig{grid-row:span 3;aspect-ratio:1}
    .ls-step__t{margin-top:0}
    .ba{gap:clamp(20px,4vw,28px)}
    .ls-signage{grid-template-columns:1fr;gap:clamp(20px,4vw,28px)}
    /* la seconde carte depasse du cadre : le geste est suggere */
    .ls-signage__figs{display:flex;overflow-x:auto;scroll-snap-type:x proximity;touch-action:pan-x;
      gap:14px;padding-bottom:8px;scrollbar-width:none;-webkit-overflow-scrolling:touch;
      margin-right:calc(-1 * clamp(16px,3vw,24px))}
    .ls-signage__figs::-webkit-scrollbar{display:none}
    .ls-signage__figs > figure{flex:0 0 78%;scroll-snap-align:start}
    .ls-signage__figs > figure:last-child{flex-basis:70%}
  }
  @media(max-width:720px){
    .banner{flex-direction:column;align-items:flex-start;text-align:left;min-height:0;padding:calc(var(--mobbar-h) + 16px) clamp(16px,5vw,24px) clamp(32px,11vw,96px)}
    .banner__inner{padding:0;margin-top:clamp(8px,2.5vw,16px)}
    .ba{grid-template-columns:1fr}
    .ba__frame{aspect-ratio:auto}
    .ba__frame img{height:auto}
  }
  @media(max-width:560px){
    /* les pastilles restent sur une ligne : carrousel swipable plutot que retour a la ligne */
    .ls-swatches{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;touch-action:pan-x;
      gap:12px;padding-bottom:8px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .ls-swatches::-webkit-scrollbar{display:none}
    .ls-swatches li{flex:0 0 clamp(78px,26vw,104px);scroll-snap-align:center}
    /* petit ecran : les formes deviennent un carrousel swipable.
       touch-action:pan-x laisse le geste horizontal au navigateur ;
       sans ca le swipe natif est bloque. */
    .ls-shapes{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;touch-action:pan-x;
      gap:clamp(24px,8vw,44px);padding:4px 0 14px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .ls-shapes::-webkit-scrollbar{display:none}
    .ls-shape{flex:0 0 auto;scroll-snap-align:center}
    .ls-shape svg{width:96px;height:96px}
    .ls-step{grid-template-columns:1fr}
    .ls-step .ls-fig{grid-row:auto;aspect-ratio:4/3}
    .ls-step__t{margin-top:14px}
    .ls-fig--wide{aspect-ratio:4/3}
  }
  @media(prefers-reduced-motion:reduce){
    .js .ls-reveal,.js .ls-reveal.in{opacity:1;transform:none;transition:none}
  }
</style>

<script is:inline>
  (function(){
    var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function reveal(els,opts){
      if(reduce || !("IntersectionObserver" in window)){ els.forEach(function(e){e.classList.add("in");}); return; }
      var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target);}});},opts);
      els.forEach(function(e){io.observe(e);});
    }
    reveal([].slice.call(document.querySelectorAll(".ls-reveal")),{threshold:0,rootMargin:"0px 0px -10% 0px"});
    reveal([].slice.call(document.querySelectorAll(".talk-card")),{threshold:0.2});

    /* faire-part : cycle des trois etats quand le bloc est visible */
    var stage=document.querySelector('.ls-suite__stage');
    if(stage && !reduce){
      var frames=[].slice.call(stage.querySelectorAll('.ls-suite__frame')), i=0, timer=null;
      function step(){ frames[i].classList.remove('is-on'); i=(i+1)%frames.length; frames[i].classList.add('is-on'); }
      if("IntersectionObserver" in window){
        new IntersectionObserver(function(es){es.forEach(function(e){
          if(e.isIntersecting && !timer){ timer=setInterval(step,2200); }
          else if(!e.isIntersecting && timer){ clearInterval(timer); timer=null; }
        });},{threshold:.25}).observe(stage);
      } else { timer=setInterval(step,2200); }
    }

    /* formes dragables : meme mecanique que les tuiles de la page d'accueil */
    var z=10;
    [].slice.call(document.querySelectorAll('.ls-shape')).forEach(function(c){
      var ox=0,oy=0,dragging=false;
      c.addEventListener('pointerdown',function(e){
        if(window.matchMedia('(max-width:900px)').matches) return;
        dragging=true; c.setPointerCapture(e.pointerId); c.classList.add('grabbing'); c.style.zIndex=++z;
        var r=c.getBoundingClientRect(); ox=e.clientX-r.left; oy=e.clientY-r.top;
      });
      c.addEventListener('pointermove',function(e){
        if(!dragging) return;
        var p=c.parentElement.getBoundingClientRect();
        var x=e.clientX-p.left-ox, y=e.clientY-p.top-oy;
        x=Math.max(0,Math.min(x,p.width-c.offsetWidth));
        y=Math.max(0,Math.min(y,p.height-c.offsetHeight));
        c.style.left=x+'px'; c.style.top=y+'px';
      });
      function end(){ dragging=false; c.classList.remove('grabbing'); }
      c.addEventListener('pointerup',end); c.addEventListener('pointercancel',end);
    });

    /* carrousel : arc au defilement + pastilles, comme sur l'accueil */
    (function(){
      var track=document.getElementById('lscarousel'); if(!track) return;
      var slides=[].slice.call(track.querySelectorAll('.ls-carousel__slide'));
      var dots=[].slice.call(document.querySelectorAll('.ls-carousel__dots .ls-dot'));
      function centerOf(el){ return el.offsetLeft + el.offsetWidth/2; }
      function scrollTo(i,smooth){ var el=slides[i]; if(!el) return;
        var t=el.offsetLeft-(track.clientWidth-el.offsetWidth)/2;
        t=Math.max(0,Math.min(t,track.scrollWidth-track.clientWidth));
        track.scrollTo({left:t,behavior:smooth?'smooth':'auto'}); }
      function activeIndex(){ var mid=track.scrollLeft+track.clientWidth/2,best=0,bd=Infinity;
        slides.forEach(function(el,i){var d=Math.abs(centerOf(el)-mid); if(d<bd){bd=d;best=i;}}); return best; }
      function syncDots(){ var a=activeIndex();
        dots.forEach(function(d,i){ if(i===a){d.setAttribute('aria-current','true');}else{d.removeAttribute('aria-current');} }); }
      function applyArc(){ if(reduce) return; var mid=track.scrollLeft+track.clientWidth/2;
        slides.forEach(function(el){ var d=(centerOf(el)-mid)/track.clientWidth;
          if(d>1)d=1; if(d<-1)d=-1;
          el.style.transform='translateY('+(Math.abs(d)*18).toFixed(1)+'px) rotate('+(d*4.5).toFixed(2)+'deg) scale('+(1-Math.abs(d)*0.05).toFixed(3)+')'; }); }
      dots.forEach(function(d,i){ d.addEventListener('click',function(){ scrollTo(i,true); }); });
      var raf; track.addEventListener('scroll',function(){ if(raf)cancelAnimationFrame(raf);
        raf=requestAnimationFrame(function(){ syncDots(); applyArc(); }); });
      syncDots(); applyArc();
      window.addEventListener('load',function(){ syncDots(); applyArc(); });
    })();
  })();
</script>
