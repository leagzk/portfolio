---
import Base from '../layouts/Base.astro';
import '../styles/case-study.css';
import PageIntro from '../components/PageIntro.astro';
import Banner from '../components/Banner.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Carousel from '../components/Carousel.astro';
import BeforeAfter from '../components/BeforeAfter.astro';

/*
  Toutes les images de la page, chargees en une fois plutot qu'en 31 imports.
  Difference majeure avec les anciens chemins en chaine : un nom errone casse
  le build ici, au lieu de produire un 404 silencieux en production.
*/
const fichiers = import.meta.glob<ImageMetadata>('../assets/living-system/*.webp', {
  eager: true,
  import: 'default',
});
const img = (nom: string): ImageMetadata => {
  const cle = `../assets/living-system/${nom}.webp`;
  const f = fichiers[cle];
  if (!f) throw new Error(`Image introuvable dans src/assets/living-system : ${nom}.webp`);
  return f;
};

/*
  IMAGES : `src/assets/living-system/` - plus /public/, elles passent desormais
  par astro:assets (redimensionnement + srcset au build).
  - photos     : credit EXIF/XMP Madeleine Photographe / studiomadeleine.fr
  - pages spec : credit EXIF/XMP Lea Giezek (c'est ton document)
  Ces credits survivent a l'optimisation grace au service d'image maison
  (src/imageService.mjs) : sharp les supprimerait sinon.
*/

/*
  Les sept surfaces du carrousel "One identity, fifty-plus surfaces".
  Ajouter une image = une entree ici. Les pastilles de pagination en sont
  derivees, elles ne peuvent plus se desynchroniser.
  Credit XMP des photos : Madeleine Photographe (voir en tete de fichier).
*/
const surfaces = [
    { src: img('identity-welcome-sign'), caption: 'Signage',
    alt: "Welcome sign on an easel showing the event monogram, beside stacked metal trunks" },
    { src: img('identity-invitation-suite'), caption: 'Stationery',
    alt: "Invitation suite of layered printed cards and coloured envelopes" },
    { src: img('identity-monogram-arch'), caption: 'Scenography',
    alt: "Monogram disc and a striped disc hanging from the ceremony arch above a floral pedestal" },
    { src: img('identity-cards'), caption: 'Message cards',
    alt: "Wall rack holding message cards in the identity's colours and patterns" },
    { src: img('identity-place-setting'), caption: 'Table setting',
    alt: "Place setting built on the patterned plate, with a monogram coaster and printed cards laid on it" },
    { src: img('identity-message-desk'), caption: 'Writing desk',
    alt: "Writing desk set up for guests with coloured pens and a framed instruction card" },
    { src: img('identity-dresscode'), caption: 'Dresscode',
    alt: "The dress code worn, seen from behind on a gravel path: a sequinned open-back top, a long white skirt, a white hair bow and a wildflower bouquet held low" },
    { src: img('identity-guest-gift'), caption: 'Guest gift',
    alt: "Enamel heart pin in the identity's ochre, worn on a navy lapel beside a bow tie in the scalloped pattern" },
    { src: img('game-cats-board'), caption: 'Collaborative game',
    alt: "Print artwork for the first riddle: a nine by nine colour-region grid with its single rule set above it" },
];

/*
  Palette du projet, prise sur la glacure de l'assiette Popolo.
  Les noms sont en francais - d'ou le lang="fr" sur chaque <b>, sans quoi
  une synthese vocale anglaise les ecorcherait.
*/
const couleurs = [
  { hex: '#008C68', nom: 'Vert' },
  { hex: '#455192', nom: 'Bleu' },
  { hex: '#F05863', nom: 'Rouge' },
  { hex: '#F7A800', nom: 'Jaune' },
  { hex: '#FDC1BD', nom: 'Rose' },
];

/*
  Les neuf prestataires de l'evenement. data-label reprend le nom : le CSS s'en
  sert pour reserver la largeur du gras au survol, sans faire sauter la mise en
  page - meme procede que .topnav a::after.
*/
const credits = [
  { role: "Artwork & event design", nom: "Léa Giezek" },
  { role: "Photography", nom: "Madeleine Photographe\u00a0©", href: 'https://studiomadeleine.fr/' },
  { role: "Day-of coordination", nom: "Hera & Harmonia", href: 'https://hera-et-harmonia.com/' },
  { role: "Venue", nom: "Le Grand Breuil", href: 'https://www.legrandbreuil.com/' },
  { role: "Furniture", nom: "Agence Parade", href: 'https://agence-parade.fr/' },
  { role: "Print", nom: "Les Ateliers Paquereau", href: 'https://www.imprimerie-paquereau.com/' },
  { role: "Floral design", nom: "Les Nanas", href: 'https://lesnanas-studiofloral.com/' },
  { role: "Tableware & linen", nom: "Maison Options", href: 'https://www.options.fr/' },
  { role: "Cocktail bar", nom: "Le Horse Bar", href: 'https://sobarsodrink.squarespace.com/' },
];
---
<Base title="Living System - Léa Giezek"
  description="A case study: one live event treated as a design system. Identity, staging, a six-puzzle centrepiece and the production guide that let others run it."
  current="system-event">

<!-- CARD 1 : banner + intro -->
  <div class="card">
    <Banner home>
        <p class="banner__standards">Same systems thinking, same care -<br>just off the <span class="banner__culture">screen.</span></p>
      
    </Banner>

    <PageIntro eyebrow="Living System">
      <p class="p-intro__lead">Over more than a year, I designed and orchestrated a live event from end to end - one identity, one experience, held together across every surface and every supplier. No repository. No deploy pipeline. Just the discipline of making a hundred moving parts feel like one thing.</p>
      <p class="p-intro__lead">It's the proof I keep coming back to: <b>my way of working doesn't depend on the medium.</b> Systems thinking, brand coherence, experience design - they hold whether the output ships to production or lives in a garden for one day.</p>
    
    </PageIntro>
  </div>

  <!-- THESIS -->
  <section class="ls-thesis ls-reveal" aria-label="The system, in the world">
    <figure class="ls-fig ls-thesis__fig">
      <Image src={img('staging-arch')} alt="Ceremony arch hung with shapes from the event's visual identity, framed by floral pedestals and two seats" layout="constrained" sizes="(min-width: 900px) 500px, 100vw" loading="eager" decoding="async" />
    </figure>
    <div class="ls-thesis__body">
      <p class="ls-pull">A living system isn't one you finish. It's one that takes its real shape <em>in the hands of the people who use it</em> - here, off the screen, exactly as it does on it.</p>
      <p class="ls-note">Not product. Not digital. Not communication. A living one - and it held together just the same.</p>
    </div>
  </section>

  <!-- 01 IDENTITY -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-identity">
    <div class="ls-head">
      <p class="ls-eyebrow"><span>01 - Identity</span></p>
      <h2 class="ls-title" id="ch-identity">One identity, everywhere.</h2>
      <p class="ls-lede">Starting from a constraint you don't own, then making every other decision agree with it. That's most of the job on the platform too.</p>
    </div>

    <div class="ls-idgrid">
      <div class="ls-idgrid__text">
        <div class="ls-origin">
          <div class="ls-origin__body">
            <p class="ls-body"><b>The whole thing started with two objects.</b> Not a moodboard and not a colour study - two rented pieces we could actually put in the space. The <b>Popolo</b> plate: scalloped rim, hand-painted florals, cobalt and ochre. The <b>Roly Poly</b> armchair: fat legs, round shoulders, no straight line anywhere. One gave the pattern language. The other gave the posture.</p>
            <p class="ls-body">Five words came out of them, written down before anything was drawn: <b>shapes, type, colors, conviviality and playfulness.</b> Then systematised end to end across the whole experience, from the first envelope to the last jar label.</p>
            <p class="ls-body">The scallop became the die-cut on the stationery and the discs hung from the arch. The chair's soft geometry became the arched panels on the signage. The palette came straight off the glaze. And the last two - conviviality and playfulness, the ones that aren't visual properties at all - <b>are the reason the day ended up with an escape game in it.</b></p>
          </div>
        </div>


        <div class="ls-head ls-head--after">
          <p class="ls-body">A full visual identity, declined across every physical surface the day would touch - and even before it, animating the pre-event through a WhatsApp community. A monogram, a palette, signage, stationery, room tags, table names, favours, packaging. <b>Dozens of touchpoints, one language</b> - the same coherence I hold across 45+ digital products, applied to paper, fabric, metal and wood.</p>
        </div>
      </div>
      <div class="ls-system">
        <div class="ls-system__block">
          <p class="ls-system__label">Shapes</p>
          <ul class="ls-shapes" aria-label="The three cut-out shapes">
          <li class="ls-shape" style="--x:0%;--y:0px;--rot:-8deg;--grad-ref:url(#lsgrad0)">
            <svg viewBox="0 0 155.09 155.09" aria-hidden="true"><defs><linearGradient id="lsgrad0" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="var(--shape-a)"/><stop offset="1" stop-color="var(--shape-b)"/></linearGradient></defs><circle cx="77.54" cy="77.54" r="77.54" fill="url(#lsgrad0)"/></svg>
            <b>Circle</b>
          </li>
          <li class="ls-shape" style="--x:36%;--y:96px;--rot:5deg;--grad-ref:url(#lsgrad1)">
            <svg viewBox="0 0 135.38 144.45" aria-hidden="true"><defs><linearGradient id="lsgrad1" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="var(--shape-a)"/><stop offset="1" stop-color="var(--shape-b)"/></linearGradient></defs><path fill="url(#lsgrad1)" d="M86.34,0H0s0,119.69,0,119.69c0,13.67,11.08,24.75,24.75,24.75h110.62s0-95.41,0-95.41C135.38,21.95,113.42,0,86.34,0Z"/></svg>
            <b>Square</b>
          </li>
          <li class="ls-shape" style="--x:70%;--y:14px;--rot:-4deg;--grad-ref:url(#lsgrad2)">
            <svg viewBox="0 0 164.64 171.5" aria-hidden="true"><defs><linearGradient id="lsgrad2" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="var(--shape-a)"/><stop offset="1" stop-color="var(--shape-b)"/></linearGradient></defs><path fill="url(#lsgrad2)" d="M5.28,76l-1.81-2.23c-7.07-8.7-2.81-21.8,8.02-24.68l2.78-.74c7.07-1.88,11.85-8.46,11.46-15.77l-.15-2.87c-.6-11.19,10.54-19.29,21-15.25l2.68,1.03c6.83,2.63,14.56.12,18.54-6.02l1.56-2.41c6.09-9.41,19.86-9.41,25.95,0l1.56,2.41c3.98,6.14,11.71,8.66,18.54,6.02l2.68-1.03c10.46-4.03,21.6,4.06,21,15.25l-.15,2.87c-.39,7.31,4.39,13.89,11.46,15.77l2.78.74c10.83,2.88,15.09,15.98,8.02,24.68l-1.81,2.23c-4.61,5.68-4.61,13.81,0,19.49l1.81,2.23c7.07,8.7,2.81,21.8-8.02,24.68l-2.78.74c-7.07,1.88-11.85,8.46-11.46,15.77l.15,2.87c.6,11.19-10.54,19.29-21,15.25l-2.68-1.03c-6.83-2.63-14.56-.12-18.54,6.02l-1.56,2.41c-6.09,9.41-19.86,9.41-25.95,0l-1.56-2.41c-3.97-6.14-11.71-8.66-18.54-6.02l-2.68,1.03c-10.46,4.03-21.6-4.06-21-15.25l.15-2.87c.39-7.31-4.39-13.89-11.46-15.77l-2.78-.74c-10.83-2.88-15.09-15.98-8.02-24.68l1.81-2.23c4.61-5.68,4.61-13.81,0-19.49Z"/></svg>
            <b>Star</b>
          </li>
          </ul>
          <p class="ls-shapes__note">Three cut-outs, taken off the plate's rim and the chair's silhouette. Every badge, tag, disc and die-cut in the identity is one of these three.</p>
        </div>

        <div class="ls-system__block">
          <p class="ls-system__label">Colors</p>
          <ul class="ls-swatches">
            {couleurs.map((c) => (
              <li>
                <span class="ls-swatch" style={`--c:${c.hex}`}></span>
                <b lang="fr">{c.nom}</b>
                <code>{c.hex}</code>
              </li>
            ))}
          </ul>
        </div>

        <div class="ls-system__block">
          <p class="ls-system__label">Type</p>
          <div class="ls-type">
            <p class="ls-type__display">Aa</p>
            <div class="ls-type__meta">
              <p class="ls-type__name">Fino Sans</p>
              <p class="ls-type__use">Display - titles, numbers, anything set large. High contrast, tight, a little theatrical.</p>
            </div>
          </div>
          <div class="ls-type">
            <p class="ls-type__sans">Aa</p>
            <div class="ls-type__meta">
              <p class="ls-type__name">Serenity</p>
              <p class="ls-type__use">Text - rules, timings, instructions. Plain enough to disappear behind the display face.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <h3 class="ls-claim ls-claim--head">Nothing was left to chance, and nothing drifted. <b>One identity, fifty-plus surfaces, zero inconsistency.</b></h3>

    <Carousel id="lscarousel" label="Choose a surface" itemLabel="Surface" start={1} slides={surfaces} />

    <div class="ls-signage">
      <div class="ls-signage__text">
        <p class="ls-sub">The test was the boring surfaces.</p>
        <p class="ls-body">Anyone can be charming on an invitation. The proof is on the signage nobody is meant to enjoy - where to leave your glass, welcome signage to your room to share care. Same display face, same stripes, same jokes.</p>
        <p class="ls-body">That's where <b>conviviality and playfulness</b> stopped being words on a moodboard and became a rule I had to keep, on the two hundredth decision as much as the first.</p>
      </div>
      <div class="ls-signage__figs">
        <figure class="ls-fig">
          <Image src={img('signage-door-tag')} alt="Striped door tag hanging from a bedroom handle, naming the room in the identity's display type" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
          <figcaption class="ls-cap">Room tag, in place</figcaption>
        </figure>
        <figure class="ls-fig ls-fig--flat">
          <Image src={img('print-glass-rules')} alt="Print artwork for the small card explaining what to do with your glass through the evening" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
          <figcaption class="ls-cap">Glass rules - 100 × 150 mm</figcaption>
        </figure>
      </div>
    </div>

    <div class="ls-print">
      <figure class="ls-print__art">
        {/* .ls-print__frame porte le border-radius, le fond et le contour de theme */}
        <div class="ls-print__frame">
          <Image src={img('identity-invitation-detail')} alt="Close view of the printed invitation: die-cut cards, coloured blocks and a heart sticker on a wooden table" layout="constrained" sizes="(min-width: 900px) 500px, 100vw" loading="lazy" decoding="async" />
        </div>
        <figcaption class="ls-cap">Printed, in the hand</figcaption>
      </figure>
      <figure class="ls-print__suite">
        <div class="ls-suite__stage">
          <Image class="ls-suite__frame is-on" src={img('suite-state-1')} alt="The invitation suite laid flat, first arrangement" layout="constrained" sizes="(min-width: 900px) 500px, 100vw" loading="lazy" decoding="async" />
          <Image class="ls-suite__frame" src={img('suite-state-2')} alt="The invitation suite fully opened out, every card visible" layout="constrained" sizes="(min-width: 900px) 500px, 100vw" loading="lazy" decoding="async" />
          <Image class="ls-suite__frame" src={img('suite-state-3')} alt="The invitation suite arranged in place" layout="constrained" sizes="(min-width: 900px) 500px, 100vw" loading="lazy" decoding="async" />
        </div>
      </figure>
    </div>

  </section>

  <!-- 02 STAGING -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-staging">
    <div class="ls-split">
      <div class="ls-split__text">
        <p class="ls-eyebrow"><span>02 - Staging</span></p>
        <h2 class="ls-title" id="ch-staging">Space, staged.</h2>
        <p class="ls-body">An implantation plan for the day, then the scenography that brought it to life: the arch, the seating, the floral pedestals, the palette carried into every corner of the space.</p>
        <p class="ls-body">The system on paper, and the system in the world - <b>the same jump from specification to production I run on the platform</b>, made physical.</p>
      </div>
      <div class="ls-split__media">
        <figure class="ls-fig">
          <Image src={img('staging-hall')} alt="Reception hall under exposed beams and string lights, long tables laid for a hundred guests" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
          <figcaption class="ls-cap">The room, at scale</figcaption>
        </figure>
        <figure class="ls-fig">
          <Image src={img('staging-table')} alt="Long table with patterned plates, gold cutlery and single-stem vases running down the centre" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
          <figcaption class="ls-cap">Tablescape</figcaption>
        </figure>
        <div class="ls-pair">
          <figure class="ls-fig">
            <Image src={img('staging-glass')} alt="Place card clipped to a wine glass on the laid table, beside a small vase of ranunculus" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
            <figcaption class="ls-cap">Place card</figcaption>
          </figure>
          <figure class="ls-fig">
            <Image src={img('staging-flowers')} alt="Close view of the flower palette: white daisies, blue cornflowers and pink blooms" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
            <figcaption class="ls-cap">Palette</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <BeforeAfter
      spec={{ src: img('spec-zone-seating'), alt: "Page from the production guide: mockup of the seating panels with the material checklist" }}
      built={{ src: img('staging-entrance-evening'), alt: "The seating panels installed at the venue doorway at dusk, flanked by floral columns" }}
      caption="Drawn in Illustrator, briefed to four suppliers, standing at the door twelve months later."
    />
  </section>

  <!-- 03 THE GAME -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-game">
    <div class="ls-gamehead">
      <div class="ls-gamehead__top">
        <p class="ls-eyebrow"><span>03 - The centrepiece</span></p>
        <h2 class="ls-title" id="ch-game">A game, by design.</h2>
      </div>
      <p class="ls-body ls-gamehead__body">An escape game, designed from zero - rules, clues, progression, reward. A locked trunk, a sequence to crack, a payoff at the end. Experience design in its purest form: a system of constraints and steps that has to <em>feel</em> effortless while being tightly engineered underneath.</p>
      <figure class="ls-gamehead__fig">
        <Image src={img('game-setup-wide')} alt="The escape game set up in the courtyard: painted trunks, a mirrored clue panel and the first floral arrangement" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
      </figure>
    </div>


    <p class="ls-body ls-body--wide"><b>Six riddles, six different mechanics for six essential clues to unlock one final chest, all together.</b> Each had to be learnable in thirty seconds, solvable by people holding a drink, and unmistakably part of the same day as the invitation and the table.</p>

    <ol class="ls-steps">
      <li class="ls-step">
        <figure class="ls-fig">
          <Image src={img('game-locked')} alt="Hands working a combination padlock on a metal trunk, playing cards and jars set out on the lid" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
        </figure>
        <p class="ls-step__t"><span class="ls-step__n">01</span>The constraint</p>
        <p class="ls-step__b">A locked trunk, a combination, and clues scattered across the day.</p>
      </li>
      <li class="ls-step">
        <figure class="ls-fig">
          <Image src={img('game-opened')} alt="Opened trunk revealing a framed congratulations card above rows of jars" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
        </figure>
        <p class="ls-step__t"><span class="ls-step__n">02</span>The crack</p>
        <p class="ls-step__b">Progression built so the last step feels earned, not handed over.</p>
      </li>
      <li class="ls-step">
        <figure class="ls-fig">
          <Image src={img('game-reward')} alt="Rows of jars packed in the trunk, each labelled with the event monogram on striped paper" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
        </figure>
        <p class="ls-step__t"><span class="ls-step__n">03</span>The payoff</p>
        <p class="ls-step__b">The reward carries the identity too. The system runs to the last object.</p>
      </li>
    </ol>

    <div class="ls-body ls-body--wide">
      <p>But here's what I love most about it: <b>it only became itself once people played it.</b> I designed the frame - tight, deliberate, engineered underneath - and the experience took its real shape in their hands, evolving as they moved through it, in ways no plan could fully script.</p>
    </div>

    <p class="ls-sub">Shipped empty.<br><b>Finished by the people who played it.</b></p>

    <BeforeAfter
      spec={{ src: img('spec-zone-murdle'), alt: "Production guide page for the deduction game: empty grid on an easel, material checklist and set-up notes" }}
      built={{ src: img('game-murdle'), alt: "The same deduction board after play, its grid filled with pink and green wooden tokens" }}
      builtLabel="Played"
      caption="The deduction grid, before anyone touched it and after a hundred people did."
    />

    <BeforeAfter
      spec={{ src: img('spec-zone-wordsearch'), alt: "Production guide page for the word-grid game: blank poster on an easel with its material checklist" }}
      built={{ src: img('game-wordsearch'), alt: "The word grid mid-game, crossed through with chalk lines as players work it out together" }}
      builtLabel="Played"
      caption="I drew the grid. The marks on it aren't mine - and that was always the point."
    />

    <div class="ls-body ls-body--wide">
      <p>That's the whole truth about the systems I build: <b>you design them for the people who'll use them, not for yourself - and they come alive the moment you let go.</b> An escape game, a design system, a platform: same principle.</p>
    </div>

    <p class="ls-claim ls-claim--big">The frame is mine.<br><b>The life is theirs.</b></p>
  </section>

  <!-- 04 COORDINATION -->
  <section class="ls-chapter ls-reveal" aria-labelledby="ch-coordination">
    <div class="card ls-dark">
      <div class="ls-dark__inner">
        <p class="ls-eyebrow ls-eyebrow--light"><span>04 - Coordination</span></p>
        <h2 class="ls-title" id="ch-coordination">The part nobody sees.</h2>
        <div class="ls-body ls-body--light">
          <p>Behind the identity and the staging: coordination. Florist, caterer, photographer, venue, rentals - a full ecosystem of suppliers, each with their own constraints, all pulling toward one coherent experience.</p>
          <p>I wrote it all down. Zone by zone: what goes where, what it's made of, what it's for. <b>A production guide precise enough to be executed without me in the room</b> - then I handed the day itself to <a href="https://hera-et-harmonia.com/" target="_blank" rel="noopener noreferrer">Hera &amp; Harmonia</a>, who ran it from the brief. <b>One page per zone, one owner per page. That's the whole method.</b></p>
        </div>


        <div class="ls-body ls-body--light">
          <p>Because the point was never to hold every thread myself. It was to build something clear enough that someone else could carry it, and to trust them to. On the day, the system held, and I got to be <em>in</em> the experience instead of running it.</p>
        </div>

        <figure class="ls-fig ls-fig--wide">
          <Image src={img('coordination-embrace')} alt="Guests embracing at the event, the designer among them rather than running the day" layout="constrained" sizes="(min-width: 1080px) 1040px, 100vw" loading="lazy" decoding="async" />
          <figcaption class="ls-cap ls-cap--light">Inside it, not behind it.</figcaption>
        </figure>

        <p class="ls-note ls-note--light">The same move as everything else I build: design the system, iterate with stakeholders, brief the owners, step back and collect the feedback. It works in a repo. It works in a garden.</p>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  {/* pas de titre a pointer ici, la chute est en <p> : d'ou l'aria-label */}
  <section class="ls-closing ls-reveal" aria-label="In closing">
    <p class="ls-closing__t">I don't just repeat a system.<br>I <em>version</em> it.</p>
    <p class="ls-closing__b">This wasn't a one-off. It was the third edition - each one bigger than the last: a full identity every time, an escape game every time, the level raised at every turn. The pattern doesn't stop at the screen - and it doesn't stop at work either.</p>
  </section>

  <!-- CREDITS -->
  <section class="ls-credits ls-reveal" aria-labelledby="ch-credits">
    <h2 class="ls-credits__t" id="ch-credits">Credits</h2>
    <p class="ls-credits__intro">Vision and execution directed by me, but everything else was operated by people far better than me at their own craft.</p>
      <dl class="ls-credits__list">
        {credits.map((c) => (
          <div class="ls-credits__row">
            {/* pas de set:html : le role est du texte brut, et set:html laisserait
                passer un & nu la ou il faut &amp; */}
            <dt>{c.role}</dt>
            <dd>
              {c.href
                ? <a href={c.href} target="_blank" rel="noopener noreferrer" data-label={c.nom}>{c.nom}</a>
                : <span class="ls-credits__self">{c.nom}</span>}
            </dd>
          </div>
        ))}
      </dl>
  </section>


</Base>

<style is:global>
