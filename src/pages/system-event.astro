          <div class="bloc">
            <p class="bloc__t">Type</p>
            <div class="spec">
              <p class="spec__display">Aa</p>
              <div class="spec__meta">
                <p class="spec__nom">Fino Sans</p>
                <p class="spec__usage">Display - titles, numbers, anything set large. High contrast, tight, a little theatrical.</p>
              </div>
            </div>
            <div class="spec">
              <p class="spec__sans">Aa</p>
              <div class="spec__meta">
                <p class="spec__nom">Serenity</p>
