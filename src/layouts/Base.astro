---
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/motion.css';
import '../styles/shared.css';

export interface Props {
  title: string;
  /** resume de la page : meta description + Open Graph. ~155 caracteres. */
  description: string;
  /** cle de l'entree de nav active : philosophy | operating-system | system-practice-elements | system-brand | system-event */
  current?: string;
  /** ecran de chargement, reserve a la page d'accueil */
  loader?: boolean;
  /** page tenue hors des moteurs de recherche (brouillons) */
  noindex?: boolean;
  /** visuel de partage propre a la page, relatif a la racine du site */
  ogImage?: string;
}
const {
  title,
  description,
  current,
  loader = false,
  noindex = false,
  ogImage = '/og-default.png',
} = Astro.props;

/* URL absolues : requises par Open Graph, qui refuse les chemins relatifs. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

/* Carte d'identite structuree, pour que Google relie le site a la personne. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Léa Giezek',
  jobTitle: 'Design & Experience Systems Lead',
  description:
    'Cultivating practice, not just systems, through Design Leadership and Community Building.',
  url: Astro.site?.href,
  email: 'mailto:giezek.lea@gmail.com',
  sameAs: ['https://www.linkedin.com/in/lea-giezek/'],
};

/*
  Seules les pages redigees figurent dans la nav. Les deux brouillons restants
  (operating-system, system-brand) sont accessibles en direct mais sortent du
  menu et portent noindex tant qu'ils affichent "Page en cours de redaction".
  Pour en remettre une en ligne : la reinscrire ici et retirer son attribut
  noindex dans la page.

  system-practice-elements fait exception : elle est dans le menu mais garde son
  noindex, et reste filtree du sitemap. Le texte est complet, les visuels non -
  trois emplacements y sont encore visibles. Le lien permet de la faire lire ;
  le noindex evite qu'elle soit indexee dans cet etat. A lever avec les visuels.
*/
const main = [
  { key: 'philosophy', href: '/philosophy', label: 'Philosophy' },
];
const work = [
  { key: 'system-practice-elements', href: '/system-practice-elements', label: 'Systematized a Practice' },
  { key: 'system-event', href: '/system-event', label: 'Systematized a Moment' },
];
/*
  La page courante est-elle une des entrees de « Selected work » ? Sur une page
  de case study, la marque de position vivait dans le menu deroulant - donc
  invisible tant qu'on ne l'ouvrait pas, et la nav fermee ne disait plus ou on
  se trouvait. Le declencheur la porte desormais.
  Un drapeau et pas un aria-current : le bouton n'ouvre pas une page, c'est le
  lien du menu qui est la page courante et qui garde la semantique. Deux marques
  « courant » dans le meme groupe se liraient deux fois a l'oreille.
*/
const workCourant = work.some((i) => i.key === current);
---
<!DOCTYPE html>
<html lang="en" data-theme="spicy">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!--
  Seul script qui doit rester inline ET dans le <head>. Deux raisons :

  1. Il restaure le theme choisi avant le premier rendu. Place plus bas, le
     visiteur verrait le theme par defaut clignoter avant le sien.
  2. Il pose la classe .js, dont dependent .js .drag .dcard, .js .tenet et
     .js .ls-reveal (opacity:0 en attente de leur animation d'entree). Pose
     trop tard, le contenu apparait puis disparait pour se re-animer.

  Un <script> bundle par Astro serait type="module", donc differe : trop tard
  dans les deux cas. Garder ce bloc court et sans import.
-->
<script is:inline>
(function () {
  var root = document.documentElement;
  root.classList.add('js');
  try {
    var saved = localStorage.getItem('theme');
    // liste blanche : ne jamais ecrire dans le DOM une valeur brute du stockage
    if (saved === 'spicy' || saved === 'contrast' || saved === 'mono') {
      root.setAttribute('data-theme', saved);
    }
  } catch (e) {
    /* navigation privee ou stockage refuse : on garde le theme par defaut */
  }
})();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Partage social : sans ces balises, un lien poste sur LinkedIn n'affiche ni image ni resume -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Léa Giezek" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#E84140" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://use.typekit.net" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Momo+Trust+Display&family=Maven+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
<!--
  Kit Adobe Fonts : "fino-sans" et "serenity", les polices du projet Living System.
  Utilisees uniquement par le specimen de /system-event (--brand-display, --brand-sans).
-->
<link rel="stylesheet" href="https://use.typekit.net/hdf1vwn.css" />
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
</head>
<body>
<!--
  Premier element focusable du document. Il etait auparavant place apres le
  hamburger et les quatre boutons du dock : il fallait cinq Tab pour l'atteindre,
  ce qui annulait sa raison d'etre.
-->
<a class="sr-only" href="#main">Skip to content</a>
{loader && <div class="loader" id="loader" aria-hidden="true"><div class="loader__panel"></div><div class="loader__fly" id="fly"><span class="loader__ring"></span><span class="loader__circle"><span class="loader__pepper">&#127798;</span></span></div></div>}
<div class:list={['app', loader && 'app--reveal']}>
<div class="mobbar" id="mobbar" aria-hidden="true"></div>
<header class="topdock">
  <div class="topdock__inner">
    <button class="hamb" id="hamb" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <div class="pepperegg" id="pepperegg">
      <div class="pepperegg__sw" id="themesw" role="group" aria-label="Colour theme">
        <button class="swatch sw-spicy" data-set="spicy" aria-pressed="true" aria-label="Spicy theme"></button>
        <button class="swatch sw-contrast" data-set="contrast" aria-pressed="false" aria-label="Mondrian theme"></button>
        <button class="swatch sw-mono" data-set="mono" aria-pressed="false" aria-label="Mono theme"></button>
      </div>
      <button class="banner__pepper" id="pepperbtn" aria-label="Colour theme" aria-controls="themesw" aria-expanded="false">🌶️</button>
    </div>
  </div>
</header>
<div class="shell">

  <nav class="topnav" aria-label="Primary">
    {main.map(i => <a href={i.href} data-label={i.label} aria-current={current === i.key ? 'page' : undefined}>{i.label}</a>)}
    <div class="navgroup">
      <button class="navgroup__trigger" id="worktrigger" data-current={workCourant ? 'true' : undefined} aria-expanded="false" aria-controls="workmenu"><span class="navgroup__label" data-label="Selected work">Selected work</span><svg class="navgroup__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
      <div class="navgroup__menu" id="workmenu" role="group" aria-labelledby="worktrigger">
        {work.map(i => <a href={i.href} aria-current={current === i.key ? 'page' : undefined}>{i.label}</a>)}
      </div>
    </div>
    <a href="#connect" data-label="Connect">Connect</a>
  </nav>

  <nav class="mobmenu" id="mobmenu" aria-hidden="true" aria-label="Menu">
    <button class="mobmenu__close" id="mobclose" aria-label="Close menu">&#10005;</button>
    {/* Sous 720px, .banner__home est masque et la nav n'avait aucun lien vers
        l'accueil : depuis une sous-page, le retour etait impossible. */}
    <a href="/" aria-current={current === undefined ? 'page' : undefined}>Home</a>
    {[...main, ...work].map(i => <a href={i.href} aria-current={current === i.key ? 'page' : undefined}>{i.label}</a>)}
    <a href="#connect">Connect</a>
  </nav>

  {/* tabindex="-1" : sans lui, le lien d'evitement fait defiler la page mais ne
      deplace pas reellement le focus dans plusieurs navigateurs. */}
  <main id="main" tabindex="-1">
    <slot />
  </main>

<!-- FOOTER : Let's talk (identical across all pages) -->
  <footer class="card talk-card" id="connect">
    <div class="talk">
      <h2 class="talk__head">Let's talk.</h2>
      <p class="talk__body">Conviction, delivery, and care - I hold all three at the same heat. A team that isn't well can't shine, and can't ship. <b>That's not the soft part of the job. It's the foundation.</b></p>
      <div class="talk__links">
        <a class="btn3" href="mailto:giezek.lea@gmail.com"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>Email</a>
        <a class="btn3" href="https://www.linkedin.com/in/lea-giezek/" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.3-.02-2.96-1.8-2.96-1.8 0-2.08 1.4-2.08 2.86V21H9z"/></svg>LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        <a class="btn3" href="/Lea-Giezek-CV.pdf" download><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>Download CV<span class="sr-only"> (PDF, 3.6 Mo)</span></a>
      </div>
      <p class="talk__legal">&copy; <b>L&eacute;a GIEZEK</b> - 2026<br>Designed by a human, developed with Claude, deployed with Vercel, iterated with peers. <b>Never alone.</b></p>
    </div>
  </footer>

</div>
</div>

<style is:global>
  /* surcharges de theme du chrome - vivaient dans tokens.css, qui ne doit
     contenir que des declarations de custom properties */
  [data-theme="contrast"] .topnav.stuck{border:var(--edge-w) solid var(--edge);border-top:none}
  [data-theme="contrast"] .navgroup__menu a:hover{background:var(--highlight);color:var(--on-highlight)}
  [data-theme="mono"] .navgroup__menu a:hover{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 2px #070304}
  [data-theme="contrast"] .navgroup__menu{border:var(--edge-w) solid var(--edge);border-top:none;left:-2px;right:-2px}
  [data-theme="contrast"] .topnav.menuopen{border:var(--edge-w) solid var(--edge);border-top:none;border-bottom:none}
  [data-theme="contrast"] .topnav a[aria-current="page"]::before{background:var(--highlight);height:6px;bottom:-8px;border:var(--edge-w) solid var(--edge);border-radius:0}
  [data-theme="contrast"] .navgroup__trigger[data-current] .navgroup__label::before{background:var(--highlight);height:6px;bottom:-8px;border:var(--edge-w) solid var(--edge);border-radius:0}
  [data-theme="contrast"] .mobmenu a[aria-current="page"]{color:var(--highlight)}
  @media(max-width:720px){
  [data-theme="contrast"] .mobbar{border:var(--edge-w) solid var(--edge);border-top:none}
}
  /*
    Chrome rendu par ce layout : nav, dock, menu mobile, loader, pied de page.
    Le CSS propre a une page vit desormais dans cette page ; les regles
    partagees vivent dans src/styles/. Voir le commentaire de shared.css
    pour la raison pour laquelle elles ne peuvent pas etre scopees ici.
  */
  .topnav{position:sticky;top:0;z-index:50;display:flex;justify-content:center;flex-wrap:wrap;align-items:center;gap:clamp(16px,3vw,40px);min-height:var(--mobbar-h);padding:0;border-radius:0 0 var(--r-xl) var(--r-xl);transition:background .28s ease,box-shadow .28s ease}
  .topnav.stuck{background:var(--canvas);box-shadow:0 4px 16px rgba(7,3,4,.08)}
  .topnav a{position:relative;text-decoration:none;font-weight:500;font-size:16px;color:var(--ink);white-space:nowrap;transition:color .28s ease}
  .topnav a::after{content:attr(data-label);display:block;height:0;overflow:hidden;visibility:hidden;font-weight:700;pointer-events:none}
  .topnav a:hover{font-weight:700}
  .navgroup{position:static;display:flex;align-items:center}
  /*
    line-height:inherit est ce qui aligne le trait de « Selected work » sur
    celui des autres entrees. Un <button> ne suit pas la ligne du document : les
    navigateurs lui imposent `line-height:normal`, soit ~1.2 la ou les liens
    heritent du 1.62 du corps. Sa boite faisait donc 19px contre 26, et le trait
    - accroche au bas de cette boite par `bottom:-8px` - remontait de 4px.
    Corriger la hauteur de ligne plutot que compenser le `bottom` : les deux
    reglages restent alors une seule valeur, et un changement de graisse ou de
    corps ne les desolidarise pas.
  */
  .navgroup__trigger{position:relative;display:inline-flex;align-items:center;gap:8px;font-family:var(--body);font-weight:500;font-size:16px;line-height:inherit;color:var(--ink);background:none;border:none;padding:0;cursor:pointer;white-space:nowrap;transition:color .28s ease}
  .navgroup__label::after{content:attr(data-label);display:block;height:0;overflow:hidden;visibility:hidden;font-weight:700;pointer-events:none}
  .navgroup__trigger:hover .navgroup__label,.navgroup.open .navgroup__label{font-weight:700}
  .navgroup__chev{width:16px;height:16px;flex:none;transition:transform .22s ease}
  .navgroup.open .navgroup__chev{transform:rotate(180deg);color:var(--accent)}
  .navgroup__menu{position:absolute;left:0;right:0;top:calc(100% - 16px);z-index:2;display:flex;justify-content:center;flex-wrap:wrap;gap:8px;padding:0 8px 16px;background:var(--canvas);border-radius:0 0 var(--r-xl) var(--r-xl);box-shadow:0 20px 16px -4px rgba(7,3,4,.10);opacity:0;visibility:hidden;transform:translateY(-8px);transition:opacity .22s ease,transform .26s cubic-bezier(.22,1,.36,1),visibility .26s}
  .navgroup:hover .navgroup__menu,.navgroup:focus-within .navgroup__menu,.navgroup.open .navgroup__menu{opacity:1;visibility:visible;transform:none}
  .navgroup__menu a{padding:12px 20px;border-radius:var(--r-pill);font-size:16px;font-weight:500;color:var(--ink);text-decoration:none;white-space:nowrap;transition:background .18s ease,color .18s ease,box-shadow .18s ease}
  .navgroup__menu a:hover{background:var(--ink);color:#fff;font-weight:500}
  .topnav.menuopen{background:var(--canvas);border-bottom-left-radius:0;border-bottom-right-radius:0;box-shadow:none}
  .topnav.menuopen:not(.stuck){z-index:52}
  .topnav.menuopen > a{color:var(--ink-muted)}
  .topnav.menuopen > a[aria-current="page"]{font-weight:500}
  .topnav.menuopen > a[aria-current="page"]::before{opacity:0}
  .hamb{display:none;flex-direction:column;justify-content:center;gap:4px;width:40px;height:32px;padding:8px 4px;background:transparent;border:none;cursor:pointer}
  .hamb span{display:block;width:24px;height:2.5px;background:#fff;border-radius:2px}
  .mobmenu{display:none}
  .mobbar{display:none}
  .topdock{position:fixed;top:0;left:0;right:0;z-index:51;pointer-events:none}
  .topdock__inner{max-width:1080px;margin:0 auto;height:var(--mobbar-h);display:flex;align-items:center;padding-left:calc(var(--sp-03) + var(--sp-09));padding-right:calc(var(--sp-03) + var(--sp-05))}
  .topdock__inner > *{pointer-events:auto}
  .mobmenu.open{display:flex;position:fixed;inset:0;z-index:60;background:#070304;flex-direction:column;justify-content:center;gap:8px;padding:28px}
  .mobmenu a{color:#fff;text-decoration:none;font-family:var(--display);font-weight:400;font-size:clamp(28px,8vw,44px);letter-spacing:-.01em;padding:8px 0}
  .mobmenu__close{position:absolute;top:16px;left:16px;background:transparent;border:none;color:#fff;font-size:32px;line-height:1;cursor:pointer}
  .loader{position:fixed;inset:0;z-index:100;pointer-events:none}
  .loader__panel{position:absolute;inset:0;background:var(--hero-grad);z-index:1;transition:opacity .55s ease}
  .loader__fly{position:fixed;left:50%;top:50%;z-index:2;width:clamp(100px,13vw,140px);height:clamp(100px,13vw,140px);transform:translate(-50%,-50%);transition:transform .85s cubic-bezier(.62,0,.2,1);will-change:transform}
  .loader__ring{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(255,255,255,.65);transform:scale(.72);opacity:0;animation:ringPulse 1.15s ease-out .55s}
  .loader__circle{width:100%;height:100%;border-radius:50%;background:#FFFDFB;display:grid;place-items:center;transform:scale(0);animation:circleIn .7s cubic-bezier(.34,1.56,.64,1) .12s forwards;box-shadow:0 14px 44px rgba(120,20,5,.32)}
  .loader__pepper{font-size:clamp(44px,6vw,64px);line-height:1;transform:scale(0) rotate(-28deg);animation:pepperIn .62s cubic-bezier(.34,1.56,.64,1) .42s forwards}
  .app--reveal{opacity:0;animation:appIn .6s ease 1.0s forwards}
  .pepperegg{position:relative;margin-left:auto;display:flex;align-items:center;gap:12px;transform-origin:right center;transform:translateY(calc(var(--mobbar-h)/2 + var(--sp-03) + var(--sp-21)/2));transition:transform .38s cubic-bezier(.22,1,.36,1)}
  .topdock.stuck .pepperegg{transform:scale(.78)}
  .pepperegg__sw{position:absolute;right:100%;padding-right:12px;top:50%;display:flex;gap:8px;align-items:center;opacity:0;pointer-events:none;transform:translate(8px,-50%);transition:transform .32s cubic-bezier(.22,1,.36,1),opacity .28s}
  .pepperegg:hover .pepperegg__sw,.pepperegg:focus-within .pepperegg__sw,.pepperegg.open .pepperegg__sw{opacity:1;pointer-events:auto;transform:translate(0,-50%)}
  .pepperegg.picked .pepperegg__sw{opacity:0;pointer-events:none;transform:translate(8px,-50%)}
  .banner__pepper{position:relative;flex:none;width:var(--sp-21);height:var(--sp-21);border-radius:50%;background:#FFFDFB;border:none;cursor:pointer;display:grid;place-items:center;font-size:clamp(24px,3vw,32px);box-shadow:0 6px 20px rgba(120,20,5,.25)}
  .banner__pepper::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:2px solid var(--ring);opacity:0;pointer-events:none}
  .banner__pepper:hover::after{animation:tilePulse .9s ease-out}
  .talk__legal{margin-top:var(--sp-17);padding-top:var(--sp-03);border-top:1px solid rgba(255,255,255,.16);font-size:12px;line-height:1.7;letter-spacing:.02em;color:rgba(255,255,255,.62)}
  .talk__legal b{font-weight:600;color:rgba(255,255,255,.82)}
  .talk{padding:clamp(32px,4vw,52px)}
  .talk__head{font-family:var(--display);font-weight:400;font-size:clamp(28px,3.4vw,44px);letter-spacing:-.02em}
  .talk__body{font-size:clamp(16px,1.6vw,20px);color:var(--ink-soft);margin-top:16px;max-width:60ch}
  .talk__body b{color:var(--ink)}
  .talk__links{display:flex;gap:24px;flex-wrap:wrap;margin-top:24px}
  .talk-card .talk__head{color:#fff;white-space:nowrap;transition:font-size .7s cubic-bezier(.22,1,.36,1)}
  .talk-card.in .talk__head{font-size:clamp(48px,12vw,148px);line-height:.92;letter-spacing:-.03em}
  .talk-card .talk__body{color:rgba(255,255,255,.94)}
  .talk-card .talk__body b{color:#fff}
  .swatch{width:28px;height:28px;border-radius:50%;border:1.5px solid var(--line);cursor:pointer;padding:0;transition:transform .15s}
  .swatch:hover{transform:scale(1.14)}
  .swatch[aria-pressed="true"]{box-shadow:0 0 0 2px var(--card),0 0 0 4px var(--ink)}
  .sw-spicy{background:linear-gradient(135deg,#E84140,#FFE1C5)}
  .sw-mono{background:linear-gradient(135deg,#232320,#83827A)}
  .sw-contrast{background:linear-gradient(#111,#111) 58% 0/2.5px 100% no-repeat,linear-gradient(#111,#111) 0 55%/100% 2.5px no-repeat,conic-gradient(from 90deg at 58% 55%,#0B57A4 0 25%,#fff 25% 50%,#D0021B 50% 75%,#F7D000 75% 100%)}
  .topnav a[aria-current="page"]{font-weight:700}
  .topnav a[aria-current="page"]::before{content:"";position:absolute;left:0;right:0;bottom:-8px;height:2px;border-radius:2px;background:var(--accent);transition:opacity .28s ease}
  /*
    Le declencheur « Selected work » n'est pas un <a> : la regle ci-dessus ne
    l'atteint pas, d'ou ce jumeau. Le trait est pose sur le LABEL et non sur le
    bouton, sinon il aurait aussi souligne le chevron - les autres entrees
    soulignent leur texte, pas leur boite.
  */
  .navgroup__trigger[data-current] .navgroup__label{font-weight:700;position:relative}
  .navgroup__trigger[data-current] .navgroup__label::before{content:"";position:absolute;left:0;right:0;bottom:-8px;height:2px;border-radius:2px;background:var(--accent);transition:opacity .28s ease}
  /*
    Les entrees du menu deroulant, elles, n'ont plus de trait. Ce sont des
    pastilles arrondies : un soulignement pose 8px sous elles est le vocabulaire
    de la nav principale applique la ou il ne veut rien dire - et en Mondrian
    c'etait une barre jaune de 6px cerclee de noir sous une pilule. La graisse
    suffit a marquer la page courante une fois le menu ouvert.
  */
  .navgroup__menu a[aria-current="page"]::before{content:none}
  .mobmenu a[aria-current="page"]{color:var(--accent)}
  @media(max-width:720px){
  .topnav{display:none}
  .hamb{display:flex}
  .pepperegg,.topdock.stuck .pepperegg{transform:none}
