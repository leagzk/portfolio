---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/motion.css';
import '../styles/shared.css';
import Icone from '../components/Icone.astro';

export interface Props {
  title: string;
  /** resume de la page : meta description + Open Graph. ~155 caracteres. */
  description: string;
  /** ecran de chargement, reserve a la page d'accueil */
  loader?: boolean;
  /** page tenue hors des moteurs de recherche (brouillons) */
  noindex?: boolean;
  /** visuel de partage propre a la page, relatif a la racine du site */
  ogImage?: string;
  /**
   * Charge le kit Adobe Fonts (fino-sans, serenity). Reserve aux pages qui
   * montrent un specimen de la marque Living System - aujourd'hui la seule
   * /system-event. Voir le commentaire du <link> dans le <head>.
   */
  brandFonts?: boolean;
}
const {
  title,
  description,
  loader = false,
  noindex = false,
  ogImage = '/og-default.png',
  brandFonts = false,
} = Astro.props;

/* URL absolues : requises par Open Graph, qui refuse les chemins relatifs. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

/* Carte d'identite structuree, pour que Google relie le site a la personne. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Léa Giezek',
  jobTitle: 'Design & Experience Systems Lead',
  description:
    'Cultivating practice, not just systems, through Design Leadership and Community Building.',
  url: Astro.site?.href,
  email: 'mailto:giezek.lea@gmail.com',
  sameAs: ['https://www.linkedin.com/in/lea-giezek/'],
};

/*
  LA NAVIGATION A DEMENAGE DANS <Hero>. Le brief la pose dans la bande noire
  (§2.1) : il n'y a plus de barre collante, plus de dock fixe, plus de menu
  deroulant. Les entrees sont declarees dans src/lib/nav.ts, et chaque page
  passe sa cle `courant` au Hero plutot qu'a ce layout.

  Ce qui reste ici : le <head>, le lien d'evitement, le loader, le <main> et le
  pied de page - ce qui est vraiment commun aux sept pages.

  Trois pages gardent leur `noindex` et restent filtrees du sitemap dans
  astro.config.mjs - operating-system, system-practice-elements et system-brand.
  Elles sont donc visibles pour qui parcourt le site, invisibles pour les
  moteurs. Les deux se retirent EN MEME TEMPS le jour ou une page est jugee
  publiable : l'attribut dans la page, et l'entree dans le filtre du sitemap.
*/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!--
  Seul script qui doit rester inline ET dans le <head>. Il pose la classe .js,
  dont dependent .js .drag .dcard, .js .tenet et .js .ls-reveal (opacity:0 en
  attente de leur animation d'entree). Posee trop tard, le contenu apparait
  puis disparait pour se re-animer.

  Un <script> bundle par Astro serait type="module", donc differe : trop tard.
  Garder ce bloc court et sans import.

  Il restaurait aussi le theme choisi depuis localStorage avant le premier
  rendu. Le redesign n'a plus qu'un seul jeu de valeurs (voir tokens.css) : la
  lecture du stockage est tombee avec le selecteur.
-->
<script is:inline>
(function () {
  document.documentElement.classList.add('js');
})();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Partage social : sans ces balises, un lien poste sur LinkedIn n'affiche ni image ni resume -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Léa Giezek" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0A0708" />

<!--
  Les deux polices du site sont servies par notre domaine (src/styles/fonts.css).
  On precharge le seul sous-ensemble utilise au premier rendu, le latin : la
  declaration @font-face vit dans un CSS que le navigateur doit d'abord lire,
  donc sans ce preload les titres s'affichent une fraction de seconde en
  system-ui. Ne pas y ajouter latin-ext, que la plupart des pages ne touchent
  jamais - ce serait 40 Ko preleves sur le chemin critique pour rien.
-->
<link rel="preload" href="/fonts/HankenGrotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/MavenPro-latin.woff2" as="font" type="font/woff2" crossorigin />

{/*
  Kit Adobe Fonts : "fino-sans" et "serenity", les polices du projet Living System.
  Utilisees par le seul specimen de /system-event (--brand-display, --brand-sans),
  d'ou le chargement sous condition et non dans toutes les pages.

  Cette feuille reste tierce, contrairement aux deux autres polices : la licence
  Adobe Fonts interdit d'heberger les fichiers soi-meme, il faut passer par leur
  CDN. C'est la seule origine externe que la CSP de vercel.json autorise, et la
  restreindre a une page limite d'autant la surface qu'un proxy d'entreprise peut
  couper. Si le specimen disparait, retirer cette origine de la CSP en meme temps.
*/}
{brandFonts && (
  <>
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/hdf1vwn.css" />
  </>
)}
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
</head>
<body>
<!--
  Premier element focusable du document. Il etait auparavant place apres le
  hamburger et les quatre boutons du dock : il fallait cinq Tab pour l'atteindre,
  ce qui annulait sa raison d'etre.
-->
<a class="sr-only" href="#main">Skip to content</a>
{loader && <div class="loader" id="loader" aria-hidden="true"><div class="loader__panel"></div><div class="loader__fly" id="fly"><span class="loader__circle"></span></div></div>}
<div class:list={['app', loader && 'app--reveal']}>
<div class="shell">

  {/* tabindex="-1" : sans lui, le lien d'evitement fait defiler la page mais ne
      deplace pas reellement le focus dans plusieurs navigateurs. */}
  <main id="main" tabindex="-1">
    <slot />
  </main>

<!-- FOOTER : Let's talk (identical across all pages) -->
  <footer class="card talk-card" id="connect">
    <div class="talk">
      <h2 class="talk__head">Let's talk.</h2>
      <p class="talk__body">Conviction, delivery, and care - I hold all three at the same heat. A team that isn't well can't shine, and can't ship. <b>That's not the soft part of the job. It's the foundation.</b></p>
      <div class="talk__links">
        <a class="btn3" href="mailto:giezek.lea@gmail.com"><Icone nom="mail" taille={20} />Email</a>
        <a class="btn3" href="https://www.linkedin.com/in/lea-giezek/" target="_blank" rel="noopener noreferrer"><Icone nom="linkedin" taille={20} />LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        <a class="btn3" href="/Lea-Giezek-CV.pdf" download><Icone nom="telecharger" taille={20} />Download CV<span class="sr-only"> (PDF, 3.6 Mo)</span></a>
      </div>
      <p class="talk__legal">&copy; <b>L&eacute;a GIEZEK</b> - 2026<br>Designed by a human, developed with Claude, deployed with Vercel, iterated with peers. <b>Never alone.</b></p>
    </div>
  </footer>

</div>
</div>

<style is:global>
  /*
    LES SURCHARGES DE THEME ONT DISPARU D'ICI. Dix regles y commutaient le
    chrome entre `spicy`, `mono` et `contrast`. Le site n'a plus qu'un jeu de
    valeurs : celles de `contrast` sont repliees dans les regles de base
    ci-dessous, celles de `mono` sont tombees.
    Ce chrome - nav deroulante, dock, barre mobile - est entierement refait a
    l'etape 2 du redesign (nav a six liens ferree a droite dans le hero noir).
    Ce qui suit le tient debout d'ici la, il n'est pas la forme visee.
  */
  /*
    Chrome rendu par ce layout : nav, dock, menu mobile, loader, pied de page.
    Le CSS propre a une page vit desormais dans cette page ; les regles
    partagees vivent dans src/styles/. Voir le commentaire de shared.css
    pour la raison pour laquelle elles ne peuvent pas etre scopees ici.
  */
  /*
    LE CSS DU CHROME A SUIVI SON MARKUP DANS <Hero>. Vivaient ici : la nav
    collante et son menu deroulant, le dock fixe, la barre mobile fantome, le
    hamburger et le panneau plein ecran - environ 80 regles qui se repondaient
    entre ce fichier, chrome.ts et les surcharges de page.

    Ce qui reste : le loader et le pied de page, les deux seules choses que ce
    layout rend encore.
  */
  .loader{position:fixed;inset:0;z-index:100;pointer-events:none}
  .loader__panel{position:absolute;inset:0;background:var(--hero-grad);z-index:1;transition:opacity .55s ease}
  .loader__fly{position:fixed;left:50%;top:50%;z-index:2;width:clamp(100px,13vw,140px);height:clamp(100px,13vw,140px);transform:translate(-50%,-50%);transition:transform .85s cubic-bezier(.62,0,.2,1),opacity .5s ease;will-change:transform}
  /*
    La photo, seule au centre du panneau noir (BRIEF §3.1). Elle remplace le
    piment, et avec lui l'anneau qui pulsait autour et l'ombre cremeuse : sur un
    fond noir il n'y a plus rien a decoller, et « seule » veut dire seule.
    Le disque ne porte plus d'enfant, il EST la photo.
  */
  .loader__circle{display:block;width:100%;height:100%;border-radius:50%;background:var(--portrait) center/cover no-repeat;transform:scale(0);animation:circleIn .7s cubic-bezier(.34,1.56,.64,1) .12s forwards}
  .app--reveal{opacity:0;animation:appIn .6s ease 1.0s forwards}
  /* Colle au contenu : l'ecart ne venait pas du footer - qui est deja a
     margin-bottom:0 - mais de la marge basse du dernier bloc du <main>. */
  main > :last-child{margin-bottom:0}
  .talk__legal{margin-top:var(--sp-17);padding-top:var(--sp-03);border-top:1px solid rgba(255,255,255,.16);font-size:12px;line-height:1.7;letter-spacing:.02em;color:rgba(255,255,255,.62)}
  .talk__legal b{font-weight:600;color:rgba(255,255,255,.82)}
  .talk{padding:clamp(32px,4vw,52px)}
  .talk__head{font-family:var(--display);font-weight:900;font-size:clamp(28px,3.4vw,44px);letter-spacing:-.03em}
  .talk__body{font-size:clamp(16px,1.6vw,20px);color:var(--ink-soft);margin-top:16px;max-width:60ch}
  .talk__body b{color:var(--ink)}
  .talk__links{display:flex;gap:24px;flex-wrap:wrap;margin-top:24px}
  .talk-card .talk__head{color:#fff;white-space:nowrap;transition:font-size .7s cubic-bezier(.22,1,.36,1)}
  .talk-card.in .talk__head{font-size:clamp(48px,12vw,148px);line-height:.92;letter-spacing:-.03em}
  .talk-card .talk__body{color:rgba(255,255,255,.94)}
  .talk-card .talk__body b{color:#fff}
  @media(max-width:720px){
  .talk-card.in .talk__head{font-size:clamp(32px,10vw,56px)}
  .talk__links{flex-direction:column;align-items:flex-start;gap:8px}
}
  @media(prefers-reduced-motion:reduce){
  .loader{display:none}
  .app--reveal{opacity:1;animation:none}
  .talk-card .talk__head{transition:none}
}
</style>

<script>
  import { initChrome } from '../scripts/chrome';
  import { revealAll } from '../scripts/reveal';
  import { ajusterFiligranes } from '../scripts/filigrane';

  initChrome();
  /* Le hero est rendu par les sept pages : la mise a l'echelle du mot en
     filigrane est donc la responsabilite du layout, comme le pied de page. */
  ajusterFiligranes();

  /*
    Le pied de page est rendu ICI, sur les 7 pages : son entree en scene est donc
    la responsabilite du layout. Chacune des cinq pages a script le redeclarait,
    et l'accueil le faisait differemment - `if (!mouvementReduit())`, ce qui
    laissait son « Let's talk. » au petit corps sous mouvement reduit quand les
    quatre autres sautaient au grand. Un ecart documente comme « conserve tel
    quel », mais que rien ne justifiait : c'est le meme pied de page.
    Il est desormais uniforme, et aligne sur le comportement majoritaire - le
    titre prend sa grande taille partout, sans transition sous mouvement reduit
    (voir la clause prefers-reduced-motion plus haut).
  */
  revealAll('.talk-card', { threshold: 0.2 });
</script>
</body>
</html>
