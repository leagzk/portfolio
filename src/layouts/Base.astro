---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/motion.css';
import '../styles/shared.css';
import Icone from '../components/Icone.astro';
import { CV_HREF, CV_POIDS } from '../lib/cv';

export interface Props {
  title: string;
  /** resume de la page : meta description + Open Graph. ~155 caracteres. */
  description: string;
  /** ecran de chargement, reserve a la page d'accueil */
  loader?: boolean;
  /** page tenue hors des moteurs de recherche (brouillons) */
  noindex?: boolean;
  /** visuel de partage propre a la page, relatif a la racine du site */
  ogImage?: string;
  /**
   * Charge le kit Adobe Fonts (fino-sans, serenity). Reserve aux pages qui
   * montrent un specimen de la marque Living System - aujourd'hui la seule
   * /system-event. Voir le commentaire du <link> dans le <head>.
   */
  brandFonts?: boolean;
}
const {
  title,
  description,
  loader = false,
  noindex = false,
  ogImage = '/og-default.png',
  brandFonts = false,
} = Astro.props;

/* URL absolues : requises par Open Graph, qui refuse les chemins relatifs. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

/* Carte d'identite structuree, pour que Google relie le site a la personne. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Léa Giezek',
  jobTitle: 'Design & Experience Systems Lead',
  description:
    'Cultivating practice, not just systems, through Design Leadership and Community Building.',
  url: Astro.site?.href,
  email: 'mailto:giezek.lea@gmail.com',
  sameAs: ['https://www.linkedin.com/in/lea-giezek/'],
};

/*
  LA NAVIGATION A DEMENAGE DANS <Hero>. Le brief la pose dans la bande noire
  (§2.1) : il n'y a plus de barre collante, plus de dock fixe, plus de menu
  deroulant. Les entrees sont declarees dans src/lib/nav.ts, et chaque page
  passe sa cle `courant` au Hero plutot qu'a ce layout.

  Ce qui reste ici : le <head>, le lien d'evitement, le loader, le <main> et le
  pied de page - ce qui est vraiment commun aux sept pages.

  `noindex` ne sert plus qu'a la 404. Les trois etudes de cas le portaient le
  temps d'etre redigees ; elles le sont, et les trois verrous sont tombes
  ensemble - l'attribut ici, l'entree dans le filtre du sitemap
  (astro.config.mjs) et le `Disallow` de public/robots.txt. Ils ne font le
  travail qu'a trois, et le dernier est le plus trompeur : un `Disallow`
  empeche le crawl, donc empeche Google de LIRE le noindex. Le laisser aurait
  tenu les pages hors de l'index malgre les deux autres.
*/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!--
  Seul script qui doit rester inline ET dans le <head>. Il pose la classe .js,
  dont dependent .js .drag .dcard, .js .tenet et .js .ls-reveal (opacity:0 en
  attente de leur animation d'entree). Posee trop tard, le contenu apparait
  puis disparait pour se re-animer.

  Un <script> bundle par Astro serait type="module", donc differe : trop tard.
  Garder ce bloc court et sans import.

  Il restaurait aussi le theme choisi depuis localStorage avant le premier
  rendu. Le redesign n'a plus qu'un seul jeu de valeurs (voir tokens.css) : la
  lecture du stockage est tombee avec le selecteur.
-->
<script is:inline>
(function () {
  document.documentElement.classList.add('js');
})();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Partage social : sans ces balises, un lien poste sur LinkedIn n'affiche ni image ni resume -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Léa Giezek" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
{/* 627 et non 630 : c'est la hauteur reelle du fichier (BRIEF §9). Une hauteur
    declaree fausse fait recadrer la vignette par certains clients. */}
<meta property="og:image:height" content="627" />
<meta property="og:image:alt" content="Design systems ship standards. Experience systems grow culture. - Léa Giezek" />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!--
  TROIS DECLARATIONS, ET CHACUNE SERT A QUELQU'UN. Le SVG est le favicon reel -
  net a toutes les tailles, et il porte sa variante pour les onglets sombres
  (BRIEF §10). Le .ico est le repli des navigateurs qui ignorent le SVG, et le
  seul format que Windows accepte pour un raccourci ; il contient le 16 et le
  32. Le PNG de 32 sert aux agregateurs et aux applications qui refusent l'ico.

  L'ORDRE COMPTE : un navigateur qui comprend le SVG prend la derniere
  declaration qu'il sait lire, donc le SVG vient APRES l'ico.

  Les cinq fichiers sont fabriques par « npm run identite » - voir
  scripts/identite.mjs. Ne pas les retoucher a la main : ils se refont.
-->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0A0708" />

<!--
  Les deux polices du site sont servies par notre domaine (src/styles/fonts.css).
  On precharge le seul sous-ensemble utilise au premier rendu, le latin : la
  declaration @font-face vit dans un CSS que le navigateur doit d'abord lire,
  donc sans ce preload les titres s'affichent une fraction de seconde en
  system-ui. Ne pas y ajouter latin-ext, que la plupart des pages ne touchent
  jamais - ce serait 40 Ko preleves sur le chemin critique pour rien.
-->
<link rel="preload" href="/fonts/HankenGrotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/MavenPro-latin.woff2" as="font" type="font/woff2" crossorigin />

{/*
  Kit Adobe Fonts : "fino-sans" et "serenity", les polices du projet Living System.
  Utilisees par le seul specimen de /system-event (--brand-display, --brand-sans),
  d'ou le chargement sous condition et non dans toutes les pages.

  Cette feuille reste tierce, contrairement aux deux autres polices : la licence
  Adobe Fonts interdit d'heberger les fichiers soi-meme, il faut passer par leur
  CDN. C'est la seule origine externe que la CSP de vercel.json autorise, et la
  restreindre a une page limite d'autant la surface qu'un proxy d'entreprise peut
  couper. Si le specimen disparait, retirer cette origine de la CSP en meme temps.
*/}
{brandFonts && (
  <>
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/hdf1vwn.css" />
  </>
)}
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
</head>
<body>
<!--
  Premier element focusable du document. Il etait auparavant place apres le
  hamburger et les quatre boutons du dock : il fallait cinq Tab pour l'atteindre,
  ce qui annulait sa raison d'etre.
-->
<a class="sr-only" href="#main">Skip to content</a>
{loader && (
  <div class="loader" id="loader" aria-hidden="true">
    <div class="loader__panel"></div>
    {/*
      LE TRAIT VIT HORS DE .loader__fly, et il le faut : il traverse l'ecran
      entier, alors que .loader__fly se met a l'echelle du portrait au moment
      du vol. Dedans, il aurait retreci avec la photo.
      Les trois carres sont poses DESSUS, aux endroits que le trait atteint en
      s'ouvrant - jamais au centre, ou la photo les couvrirait.
    */}
    <div class="loader__trait" id="trait" aria-hidden="true">
      <span class="loader__carre loader__carre--rouge"></span>
      <span class="loader__carre loader__carre--bleu"></span>
      <span class="loader__carre loader__carre--jaune"></span>
    </div>
    <div class="loader__fly" id="fly">
      {/*
        L'ANNEAU EST UN TRACE, PAS UNE PULSATION. Un <svg> et non une bordure :
        seul un trace peut se dessiner, et c'est le geste de tout le site - les
        filets de la composition se tracent, ils n'apparaissent pas.
        LE DASHARRAY EST LA VRAIE CIRCONFERENCE, PLUS pathLength. Il valait
        pathLength="1", qui normalise la longueur du trace a 1 et rend le
        dasharray independant du rayon. C'est elegant, et WebKit ne l'honore
        pas sur un <circle> : sur iPhone le trace se dessinait de travers
        pendant que le reste du loader restait en place. Le viewBox ne bouge
        jamais - 100 unites, r=49 - donc la circonference vaut toujours
        2*PI*49 = 307,88 unites, et un nombre ecrit est aussi stable qu'une
        normalisation. Seul un changement de `r` demanderait de le recalculer.
      */}
      <svg class="loader__anneau" id="anneau" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="49" />
      </svg>
      <span class="loader__circle"></span>
    </div>
  </div>
)}
<div class:list={['app', loader && 'app--reveal']}>
<div class="shell">

  {/* tabindex="-1" : sans lui, le lien d'evitement fait defiler la page mais ne
      deplace pas reellement le focus dans plusieurs navigateurs. */}
  <main id="main" tabindex="-1">
    <slot />
  </main>

<!-- FOOTER : Let's talk (identical across all pages) -->
  <footer class="card talk-card" id="connect">
    <div class="talk">
      <h2 class="talk__head">Let's talk.</h2>
      <p class="talk__body">Conviction, delivery, and care - I hold all three at the same heat. A team that isn't well can't shine, and can't ship. <b>That's not the soft part of the job. It's the foundation.</b></p>
      <div class="talk__links">
        <a class="btn3" href="mailto:giezek.lea@gmail.com"><Icone nom="mail" taille={20} />Email</a>
        <a class="btn3" href="https://www.linkedin.com/in/lea-giezek/" target="_blank" rel="noopener noreferrer"><Icone nom="linkedin" taille={20} />LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        <a class="btn3" href={CV_HREF} download><Icone nom="telecharger" taille={20} />Download CV<span class="sr-only"> ({CV_POIDS})</span></a>
      </div>
      <p class="talk__legal">&copy; <b>L&eacute;a GIEZEK</b> - 2026<br>Designed by a human, developed with Claude, deployed with Vercel, iterated with peers. <b>Never alone.</b></p>
    </div>
  </footer>

</div>
</div>

<style is:global>
  /*
    LES SURCHARGES DE THEME ONT DISPARU D'ICI. Dix regles y commutaient le
    chrome entre `spicy`, `mono` et `contrast`. Le site n'a plus qu'un jeu de
    valeurs : celles de `contrast` sont repliees dans les regles de base
    ci-dessous, celles de `mono` sont tombees.
    Ce chrome - nav deroulante, dock, barre mobile - est entierement refait a
    l'etape 2 du redesign (nav a six liens ferree a droite dans le hero noir).
    Ce qui suit le tient debout d'ici la, il n'est pas la forme visee.
  */
  /*
    Chrome rendu par ce layout : nav, dock, menu mobile, loader, pied de page.
    Le CSS propre a une page vit desormais dans cette page ; les regles
    partagees vivent dans src/styles/. Voir le commentaire de shared.css
    pour la raison pour laquelle elles ne peuvent pas etre scopees ici.
  */
  /*
    LE CSS DU CHROME A SUIVI SON MARKUP DANS <Hero>. Vivaient ici : la nav
    collante et son menu deroulant, le dock fixe, la barre mobile fantome, le
    hamburger et le panneau plein ecran - environ 80 regles qui se repondaient
    entre ce fichier, chrome.ts et les surcharges de page.

    Ce qui reste : le loader et le pied de page, les deux seules choses que ce
    layout rend encore.
  */
  .loader{position:fixed;inset:0;z-index:100;pointer-events:none}
  .loader__panel{position:absolute;inset:0;background:var(--hero-grad);z-index:1;transition:opacity .55s ease}
  .loader__fly{position:fixed;left:50%;top:50%;z-index:2;width:clamp(100px,13vw,140px);height:clamp(100px,13vw,140px);transform:translate(-50%,-50%);transition:transform .85s cubic-bezier(.62,0,.2,1),opacity .5s ease;will-change:transform}
  /*
    La photo, seule au centre du panneau noir (BRIEF §3.1). Le disque ne porte
    pas d'enfant, il EST la photo.
  */
  .loader__circle{position:relative;z-index:1;display:block;width:100%;height:100%;
    border-radius:50%;background:var(--portrait) center/cover no-repeat;
    transform:scale(0);animation:circleIn .7s cubic-bezier(.34,1.56,.64,1) .12s forwards}

  /*
    ═══ UN TRAIT QUI FAIT LE TOUR, PUIS FILE DROIT ═══

    Trois anneaux qui pulsaient en boucle donnaient un effet stroboscopique -
    trois ondes qui se chassent, et rien qui aille quelque part. Le geste est
    refait dans la langue du site : UN trait blanc, propre, qui se trace.

    Trois temps, dans cet ordre :
      1. l'anneau se TRACE autour de la photo, une fois, sans repetition
         (0,15 → 1,0s) ;
      2. le trait s'OUVRE depuis le centre de l'ecran, a gauche et a droite,
         sur la ligne de la photo (0,95 → 1,45s) ;
      3. trois carres de 12px - rouge, bleu, jaune - POUSSENT sur ce trait aux
         endroits qu'il vient d'atteindre (1,15 / 1,28 / 1,38s).

    C'est la grammaire de la composition : les filets se tracent, les aplats
    poussent depuis un coin. Le loader la dit en petit avant que la page ne la
    dise en grand.

    Le decor est EFFACE PAR LE SCRIPT au depart du vol - l'anneau parce qu'il
    suivrait la photo et se mettrait a l'echelle de la cible, le trait parce
    qu'il n'a plus rien a annoncer.
  */
  /*
    will-change : CE N'EST PAS UNE OPTIMISATION, C'EST LE CORRECTIF D'UN BUG
    DE RENDU WEBKIT. Sur iPhone - et donc dans Chrome iOS, qui tourne sur le
    meme moteur - l'anneau se peignait DECALE d'environ 25px en haut a droite
    de la photo, alors que ses boites se mesuraient parfaitement concentriques.
    Un defaut de peinture, pas de geometrie.

    REPRODUIT SOUS LE WEBKIT DE PLAYWRIGHT, puis isole : le decalage disparait
    des qu'on force l'anneau dans sa propre couche de composition. L'element
    vit dans .loader__fly, qui est en position:fixed avec will-change:transform
    et une transition - WebKit rasterise alors le SVG avec la couche du parent
    et se trompe d'origine. `will-change:transform` lui en donne une a lui, et
    le trace retombe juste. `transform:translateZ(0)` corrige a l'identique ;
    on garde la forme declarative, celle que .loader__fly emploie deja.

    NI pathLength NI vector-effect N'Y ETAIENT POUR QUELQUE CHOSE. Les deux ont
    ete soupconnes et testes un par un sous WebKit : le decalage restait
    identique dans les quatre combinaisons.
  */
  .loader__anneau{position:absolute;inset:-9px;z-index:0;overflow:visible;
    transform:rotate(-90deg);will-change:transform;transition:opacity .3s ease}
  /* vector-effect : l'epaisseur reste a 1,5px quelle que soit la taille rendue,
     au lieu d'etre multipliee par l'echelle du viewBox. */
  .loader__anneau circle{fill:none;stroke:var(--white);stroke-width:1.5;
    vector-effect:non-scaling-stroke;
    stroke-dasharray:307.88;stroke-dashoffset:307.88;
    animation:tracerAnneau .85s cubic-bezier(.65,0,.35,1) .15s forwards}
  @keyframes tracerAnneau{to{stroke-dashoffset:0}}

  /*
    LE CONTENEUR NE S'ETIRE PAS, SON ::before SI. Le trait etait le conteneur
    lui-meme, et les trois carres etaient donc etires avec lui : entre 1,15 et
    1,45s ils se seraient affiches en lamelles verticales, puis seraient
    revenus carres d'un coup. Le ::before porte seul le scaleX ; les carres,
    poses dans un conteneur qui ne bouge pas, gardent leur forme.
  */
  .loader__trait{position:fixed;left:0;right:0;top:50%;z-index:1;height:12px;
    margin-top:-6px;transition:opacity .3s ease}
  .loader__trait::before{content:"";position:absolute;left:0;right:0;top:50%;
    height:1.5px;margin-top:-.75px;background:var(--white);
    transform:scaleX(0);transform-origin:center;
    animation:filerTrait .5s cubic-bezier(.16,1,.3,1) .95s forwards}
  @keyframes filerTrait{to{transform:scaleX(1)}}

  /* Les carres ne sont PAS au centre : la photo les couvrirait. Ils tombent la
     ou le trait arrive quand ils poussent. */
  .loader__carre{position:absolute;top:50%;width:12px;height:12px;
    margin-top:-6px;transform:scale(0);transform-origin:center;
    animation:pousseCarre .32s cubic-bezier(.34,1.56,.64,1) forwards}
  .loader__carre--rouge{left:19%;background:var(--red);animation-delay:1.15s}
  .loader__carre--bleu{left:74%;background:var(--blue);animation-delay:1.28s}
  .loader__carre--jaune{left:88%;background:var(--yellow);animation-delay:1.38s}
  @keyframes pousseCarre{to{transform:scale(1)}}
  .app--reveal{opacity:0;animation:appIn .6s ease 1.0s forwards}
  /* Colle au contenu : l'ecart ne venait pas du footer - qui est deja a
     margin-bottom:0 - mais de la marge basse du dernier bloc du <main>. */
  main > :last-child{margin-bottom:0}
  .talk__legal{margin-top:var(--sp-17);padding-top:var(--sp-03);border-top:1px solid rgba(255,255,255,.16);font-size:12px;line-height:1.7;letter-spacing:.02em;color:rgba(255,255,255,.62)}
  .talk__legal b{font-weight:600;color:rgba(255,255,255,.82)}
  .talk{padding:clamp(32px,4vw,52px)}
  .talk__head{font-family:var(--display);font-weight:900;font-size:clamp(28px,3.4vw,44px);letter-spacing:-.03em}
  .talk__body{font-size:clamp(16px,1.6vw,20px);color:var(--ink-soft);margin-top:16px;max-width:60ch}
  .talk__body b{color:var(--ink)}
  .talk__links{display:flex;gap:24px;flex-wrap:wrap;margin-top:24px}
  .talk-card .talk__head{color:#fff;white-space:nowrap;transition:font-size .7s cubic-bezier(.22,1,.36,1)}
  .talk-card.in .talk__head{font-size:clamp(48px,12vw,148px);line-height:.92;letter-spacing:-.03em}
  .talk-card .talk__body{color:rgba(255,255,255,.94)}
  .talk-card .talk__body b{color:#fff}
  @media(max-width:720px){
  .talk-card.in .talk__head{font-size:clamp(32px,10vw,56px)}
  .talk__links{flex-direction:column;align-items:flex-start;gap:8px}
}
  @media(prefers-reduced-motion:reduce){
  .loader{display:none}
  .app--reveal{opacity:1;animation:none}
  .talk-card .talk__head{transition:none}
}
</style>

<script>
  import { initChrome } from '../scripts/chrome';
  import { revealAll } from '../scripts/reveal';
  import { ajusterFiligranes } from '../scripts/filigrane';
  import { tracerGrille } from '../scripts/grille';

  initChrome();
  /* Le hero est rendu par les sept pages : la mise a l'echelle du mot en
     filigrane est donc la responsabilite du layout, comme le pied de page. */
  ajusterFiligranes();

  /*
    Le pied de page est rendu ICI, sur les 7 pages : son entree en scene est donc
    la responsabilite du layout. Chacune des cinq pages a script le redeclarait,
    et l'accueil le faisait differemment - `if (!mouvementReduit())`, ce qui
    laissait son « Let's talk. » au petit corps sous mouvement reduit quand les
    quatre autres sautaient au grand. Un ecart documente comme « conserve tel
    quel », mais que rien ne justifiait : c'est le meme pied de page.
    Il est desormais uniforme, et aligne sur le comportement majoritaire - le
    titre prend sa grande taille partout, sans transition sous mouvement reduit
    (voir la clause prefers-reduced-motion plus haut).
  */
  revealAll('.talk-card', { threshold: 0.2 });

  /*
    La construction des compositions Mondrian (BRIEF §4.1). Appelee ici et non
    dans les pages : il y en a desormais DEUX - l'accueil et chaque etude de
    cas - et le script les sert toutes en une passe (il boucle sur
    [data-grille]). Appele depuis les pages, il l'etait dans l'une et oublie
    dans l'autre : la composition de Language s'affichait d'un coup, sans que
    rien ne le signale. Meme raison que ajusterFiligranes ci-dessus.
  */
  tracerGrille();
</script>
</body>
</html>
