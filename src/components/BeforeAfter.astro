---
/*
  Diptyque "Specified / Built" : la page de specification a gauche, le resultat
  reel a droite. Trois instances dans /system-event, structurellement identiques
  et jusqu'ici recopiees en entier - 11 lignes chacune pour quatre valeurs qui
  changent.

  Le libelle de droite varie selon ce que la photo montre : "Built" pour ce qui a
  ete construit, "Played" pour ce que les invites ont fait du dispositif. C'est
  une nuance editoriale, d'ou la prop plutot qu'une valeur figee.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Cote {
  src: ImageMetadata;
  alt: string;
}

export interface Props {
  spec: Cote;
  built: Cote;
  /** "Built" par defaut ; "Played" quand la photo montre le dispositif en usage */
  builtLabel?: string;
  specLabel?: string;
  caption: string;
  /** ratio des deux cadres, pilote la CSS via --ba-ratio */
  ratio?: string;
}

const {
  spec,
  built,
  builtLabel = 'Built',
  specLabel = 'Specified',
  caption,
  ratio = '4/5',
} = Astro.props;

/*
  .ba reste sur deux colonnes a toutes les largeurs, y compris en mobile :
  chaque cote occupe donc environ 50vw, jamais 100vw.
*/
const TAILLES = '(min-width: 1080px) 500px, 50vw';
---
<figure class="ba" style={`--ba-ratio:${ratio}`}>
  {/*
    .ba__frame n'est pas decoratif : il porte l'aspect-ratio, le border-radius,
    l'overflow:hidden qui rogne l'image, le fond, et le contour de theme
    (--edge-w/--edge). Sans lui l'image sort nue, a angles droits.
  */}
  <div class="ba__side ba__side--spec">
    <p class="ba__label">{specLabel}</p>
    <div class="ba__frame">
      <Image src={spec.src} alt={spec.alt} layout="constrained" sizes={TAILLES} loading="lazy" decoding="async" />
    </div>
  </div>
  <div class="ba__side ba__side--built">
    <p class="ba__label">{builtLabel}</p>
    <div class="ba__frame">
      <Image src={built.src} alt={built.alt} layout="constrained" sizes={TAILLES} loading="lazy" decoding="async" />
    </div>
  </div>
  <figcaption class="ba__cap">{caption}</figcaption>
</figure>

<style is:global>
  /*
    ═══ Guide / realise ═══

    LE STYLE VIT DANS LE COMPOSANT, et c'est un changement : il etait dans
    case-study.css, que la page qui s'en sert n'importe plus depuis son passage
    au gabarit Bauhaus - le dispositif se serait affiche nu. Les regles de
    case-study.css sont donc desormais sans utilisateur ; elles tomberont avec
    le reste de l'ancien gabarit.

    HABILLAGE BAUHAUS : aucun arrondi, un filet de 1,5px, du blanc. Le cadre
    n'est pas decoratif - il porte le rapport, le rognage et le fond. Sans lui
    l'image sort nue et les deux cotes ne s'alignent plus.

    DEUX COLONNES A TOUTES LES LARGEURS, mobile compris : la comparaison EST le
    propos, et deux cotes empiles ne se comparent pas - il faudrait faire
    defiler entre les deux. Chaque cote occupe donc 50vw au plus petit.
  */
  .ba{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:stretch;margin:0}
  .ba__side{display:flex;flex-direction:column;min-width:0}
  .ba__label{display:inline-flex;align-items:center;gap:8px;margin:0 0 12px;
    font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.2em;
    text-transform:uppercase;color:var(--text)}
  .ba__label::before{content:"";width:18px;height:var(--rule-fine);background:currentColor}
  /* Le cote « realise » prend l'accent : c'est lui qui repond. */
  .ba__side--built .ba__label{color:var(--blue)}
  .ba__frame{flex:1 1 auto;aspect-ratio:var(--ba-ratio,4/5);overflow:hidden;
    background:var(--white);line-height:0;
    border:var(--rule-fine) solid var(--text)}
  .ba__frame img{width:100%;height:100%;object-fit:cover;display:block}
  /*
    Le cote « guide » est une PAGE, pas une photo : elle se montre entiere, sur
    du blanc, avec de l'air autour. La rogner reviendrait a couper la moitie
    des consignes qu'elle porte.
  */
  .ba__side--spec .ba__frame{aspect-ratio:auto;display:flex;align-items:center;
    justify-content:center;padding:12px}
  .ba__side--spec .ba__frame img{width:100%;height:auto;max-height:100%;object-fit:contain}
  .ba__cap{grid-column:1 / -1;margin-top:14px;font-size:var(--fs-caption);
    line-height:1.55;color:var(--ink-muted);max-width:62ch}
</style>
