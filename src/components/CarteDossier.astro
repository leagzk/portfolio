---
/*
  Une des trois cartes depliables d'une etude de cas (BRIEF §5.3).

  La carte est un RESUME QUI SE SCANNE : surtitre numerote, « + » ferre a
  droite sur la ligne du surtitre, titre, et une synthese de deux ou trois
  lignes. Elle ne contient pas le contenu deplie - celui-ci est une <section>
  posee SOUS la composition, parce qu'une carte de 440px ne peut pas porter
  trois mille mots et que la grille Mondrian doit rester intacte quand on
  ouvre.

  D'ou `aria-controls` : c'est le seul lien entre le bouton et son contenu, et
  il est indispensable ici puisque les deux ne sont pas voisins dans le DOM.
  Voir .dcarte dans src/styles/etude.css pour le pourquoi de la divulgation
  plutot que des onglets.

  AUCUNE CARTE N'EST OUVERTE AU CHARGEMENT (BRIEF §5.3) : aria-expanded est
  ecrit a "false" au build, et le script n'y touche qu'au clic. L'etat de
  depart est donc le meme avec et sans JavaScript.

  L'ORDRE DU DOM EST 01 → 02 → 03, et c'est la page qui s'en charge. La maquette
  ecrit les cartes dans l'ordre de la composition - 02 en haut, donc 02 en
  premier - et remet l'empilement d'aplomb avec `order` sous 860px. Mais `order`
  ne deplace QUE le rendu : la tabulation et la lecture a l'oreille restaient en
  02, 01, 03. En posant les cartes numerotees dans le DOM, `grid-area` fait le
  placement au bureau, le flux fait l'empilement sur telephone, et l'ordre de
  tabulation est le bon partout - sans propriete `order` a tenir a jour.
*/
import Icone from './Icone.astro';

export interface Props {
  /** identifiant du bouton - cible des « Next: … » de fin de section */
  id: string;
  /** le rang, tel qu'il s'affiche : « 01 » */
  rang: string;
  /** l'intitule du surtitre, sans le rang : « The problem » */
  intitule: string;
  titre: string;
  /** la synthese de 2-3 lignes, pour la lecture en survol */
  synthese: string;
  couleur: 'rouge' | 'bleu' | 'jaune';
  /** id de la <section> depliee que cette carte commande */
  commande: string;
  /** la carte la plus grande de la composition porte un titre d'un cran de plus */
  large?: boolean;
  /** position dans la grille, en `grid-area` - propre a chaque composition */
  aire: string;
}
const {
  id, rang, intitule, titre, synthese, couleur, commande,
  large = false, aire,
} = Astro.props;
---
<button
  id={id}
  class:list={['dcarte', `dcarte--${couleur}`, large && 'dcarte--large']}
  type="button"
  aria-expanded="false"
  aria-controls={commande}
  style={`grid-area:${aire}`}
>
  <span class:list={['dcarte__plat']} aria-hidden="true"></span>
  <span class="dcarte__txt dcarte__eyebrow">
    <span>{rang} &middot; {intitule}</span>
    <Icone nom="plus" taille={20} class="dcarte__plus" />
  </span>
  <span class="dcarte__txt dcarte__corps">
    {/* data-copy : un <button> ne peut pas contenir de <p>, donc rien ici ne
        serait sorti dans l'export de contenu. Voir scripts/export-content.mjs. */}
    <span class="dcarte__titre" data-copy>{titre}</span>
    <span class="dcarte__synthese" data-copy>{synthese}</span>
  </span>
</button>
