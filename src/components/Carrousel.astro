---
/*
  Carrousel du gabarit Bauhaus (BRIEF §2.6).

  Piste en `overflow-x:auto` + scroll-snap, la vignette suivante qui DEPASSE -
  c'est elle qui dit qu'on peut defiler, pas une pastille. En-tete : eyebrow a
  gauche, deux fleches carrees a droite, qui defilent de 75% de la largeur
  visible. Pas de 100% : en laissant depasser un quart on garde le fil de la
  serie.

  IL A REMPLACE <Carousel>, qui est parti avec l'ancien gabarit. L'ancien
  posait la hauteur des vignettes et laissait suivre la largeur ; celui-ci fait
  l'inverse, parce que les series du site sont des carres et des formats
  paysage, pas des portraits. Il n'a pas de pastilles : la vignette suivante
  qui depasse dit deja qu'on peut defiler.

  LA PISTE EST FOCALISABLE. `tabindex="0"` sur un conteneur defilant, c'est ce
  qui donne les fleches du clavier : sans lui la serie est inaccessible a qui
  n'a pas de souris, les deux boutons ne permettant que des sauts de 75%.
*/
import Icone from './Icone.astro';
import Figure from './Figure.astro';
import CadreDefilant from './CadreDefilant.astro';
import type { ImageMetadata } from 'astro';

export interface Vignette {
  src?: ImageMetadata;
  /** SVG charge en `?url` */
  url?: string;
  alt: string;
  legende: string;
  /*
    UNE PAGE ENTIERE ET NON UNE VIGNETTE. Les captures de sanofi.com font deux a
    cinq fois leur largeur en hauteur : dans un cadre de 16/10 en `contain`,
    l'article se reduit a 12% de la largeur du cadre. Ces vignettes-la passent
    donc dans un cadre qui defile, et s'ouvrent dans la loupe.
    Voir src/components/CadreDefilant.astro.
  */
  defile?: boolean;
  /** intitule court, en texte simple : pour la loupe et l'etiquette du bouton.
      Omis, c'est l'alt qui sert - et il fait une phrase entiere. */
  titre?: string;
}

export interface Props {
  /** intitule de la serie, pour les lecteurs d'ecran et les fleches */
  label: string;
  /** surtitre a gauche de l'en-tete. Omis, l'en-tete se reduit aux fleches. */
  eyebrow?: string;
  vignettes: Vignette[];
  /*
    MARGE INTERIEURE DES CADRES. Les captures d'ecran et les documents
    remplissent leur cadre : c'est ce qu'on veut, le cadre EST le bord de la
    page montree. Les illustrations, elles, n'ont pas de bord a elles - posees
    en `contain`, leur dessin vient taper les quatre cotes de l'aplat. `aere`
    leur rend un blanc tournant.
  */
  aere?: boolean;
  /** rapport des vignettes : « 1 / 1 » pour les personnages, « 16 / 10 » pour le pilote */
  ratio?: string;
  /** LE MEME rapport en nombre (largeur / hauteur) : les cadres defilants en
      deduisent leur course. A tenir synchronise avec `ratio`. */
  fr?: number;
  /** largeur d'une vignette au bureau, en CSS */
  largeur?: string;
  /** et sous 860px, ou il n'en tient qu'une */
  largeurMobile?: string;
  /**
   * NOMBRE DE COLONNES AU BUREAU. Pose, la serie cesse d'etre une piste
   * au-dela de 860px et devient une MOSAIQUE : tout se voit d'un coup, les
   * fleches disparaissent, et il n'y a plus rien a faire defiler.
   *
   * SOUS 860px ELLE REDEVIENT UNE PISTE, toujours. Une mosaique de cinq
   * captures sur un telephone, c'est cinq ecrans de haut a traverser avant
   * d'atteindre la suite du chapitre ; le doigt, lui, balaie.
   *
   * Omis, la serie reste une piste partout - c'est le cas des series longues,
   * ou la mosaique ferait une page a elle seule.
   */
  mosaique?: number;
  sizes?: string;
}
const {
  label, eyebrow, vignettes, mosaique, aere = false,
  ratio = '16 / 10',
  fr = 1.6,
  largeur = '72%',
  largeurMobile = '88%',
  sizes = '(min-width: 900px) 760px, 90vw',
} = Astro.props;
---
<div
  class:list={['carrousel', mosaique && 'carrousel--mosaique', aere && 'carrousel--aere']}
  style={`--slide-w:${largeur};--slide-w-mob:${largeurMobile}${mosaique ? `;--mos-cols:${mosaique}` : ''}`}
>
  <div class="carrousel__tete">
    {eyebrow && <p class="eb">{eyebrow}</p>}
    <div class="carrousel__fleches">
      <button class="carrousel__btn" type="button" data-sens="-1" aria-label={`Previous ${label}`}>
        <Icone nom="fleche-gauche" taille={18} />
      </button>
      <button class="carrousel__btn" type="button" data-sens="1" aria-label={`Next ${label}`}>
        <Icone nom="fleche-droite" taille={18} />
      </button>
    </div>
  </div>
  {/*
    LA PAGINATION EST SOUS LE CONTENU, ET C'EST LE DISPOSITIF DU SITE. Les
    tuiles et les trois principes de l'accueil paginent deja ainsi : une
    rangee de carres de 10px, le courant en encre, et le mot « Swipe » a
    l'autre bout tant qu'on est au doigt. Un carrousel qui compterait
    autrement dirait la meme chose d'une troisieme facon.

    `aria-hidden` : la piste s'annonce deja comme un groupe nomme, et une
    rangee de carres qui change au defilement n'a rien a dire a l'oreille.
  */}
  <div class="carrousel__piste" tabindex="0" role="group" aria-label={label}>
    {vignettes.map((v) => (
      v.defile && v.src ? (
        <CadreDefilant
          class="carrousel__slide"
          src={v.src}
          alt={v.alt}
          legende={v.legende}
          titre={v.titre ?? v.alt}
          ratio={ratio}
          fr={fr}
          sizes={sizes}
          widths={[640, 1080, 1400]}
          declencheur="survol"
          zoom
        />
      ) : (
        <Figure
          class="carrousel__slide"
          src={v.src}
          url={v.url}
          alt={v.alt}
          legende={v.legende}
          ratio={ratio}
          sizes={sizes}
          aere={aere}
        />
      )
    ))}
  </div>
  <div class="carrousel__pagination" aria-hidden="true">
    <span class="carrousel__points">{vignettes.map(() => <i></i>)}</span>
    <span class="carrousel__swipe">Swipe &rarr;</span>
  </div>
</div>

<style is:global>
  /*
    DOUZE PIXELS, ET C'EST LA MESURE DES AUTRES SURTITRES. Le surtitre d'un
    carrousel vit dans sa tete, donc son ecart au contenu vient du `gap` de ce
    composant et non de la sous-partie qui l'accueille. Il valait 20px quand
    tous les autres surtitres d'une etude en posent 12 - le `gap` de 32 de la
    sous-partie, moins les 20 de marge negative que `.eb` porte.

    Sur une page qui enchaine trois surtitres et trois series, l'un d'eux
    respirait donc huit pixels de plus que ses voisins, ce qui se voit d'autant
    mieux qu'ils se suivent.
  */
  .carrousel{display:flex;flex-direction:column;gap:12px}
  .carrousel__tete{display:flex;justify-content:space-between;align-items:center;gap:16px}
  .carrousel__fleches{display:flex;gap:8px;margin-left:auto;align-items:center}
  /* Memes valeurs que `.tuiles__pagination` : meme rangee, meme carre, meme
     ecart. Deux paginations qui se ressemblent a dix pixels pres se liraient
     comme deux dispositifs. */
  .carrousel__pagination{display:flex;align-items:center;justify-content:space-between;
    gap:12px;padding:12px 0}
  .carrousel__points{display:flex;gap:6px;flex-wrap:wrap}
  .carrousel__points i{width:10px;height:10px;background:var(--grey-mondrian)}
  .carrousel__points i.est-actif{background:var(--ink)}
  /* Le mot ne s'adresse qu'au doigt : au bureau, ce sont les fleches qui
     disent le geste, et elles sont dans l'en-tete. */
  .carrousel__swipe{display:none;font-size:var(--fs-eyebrow);font-weight:700;
    letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted)}
  /* Carre, bordure 1,5px, rempli de noir au survol - comme les boutons du
     gabarit, aucun arrondi (BRIEF §1). 44px : la cible tactile minimale. */
  .carrousel__btn{display:grid;place-items:center;width:44px;height:44px;padding:0;
    border:var(--rule-fine) solid var(--text);background:none;color:var(--text);
    cursor:pointer;transition:background .2s,color .2s}
  .carrousel__btn:hover,.carrousel__btn:focus-visible{background:var(--text);color:var(--white)}
  .carrousel__btn:focus-visible{outline:3px solid var(--focus);outline-offset:3px}

  .carrousel__piste{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;
    scroll-behavior:smooth;padding-bottom:8px;scrollbar-width:thin}
  .carrousel__piste:focus-visible{outline:3px solid var(--focus);outline-offset:4px}
  .carrousel__slide{flex:0 0 var(--slide-w,72%);scroll-snap-align:start}

  @media(max-width:860px){
    .carrousel__slide{flex:0 0 var(--slide-w-mob,88%)}
    /*
      AU DOIGT, PAS DE FLECHES. C'est l'arbitrage pose pour tout le site : le
      bureau recoit des fleches, le telephone le glissement - les dix autres
      bandes des etudes n'ont jamais eu que lui, et deux paires de boutons de
      44px au-dessus d'une piste qu'on fait defiler du pouce ne servent qu'a
      prendre de la hauteur. Le compte reste : c'est lui qui dit ce que la
      piste cache.
    */
    .carrousel__btn{display:none}
    .carrousel__swipe{display:block}
  }

  /*
    ─── La mosaique, au-dela du palier seulement ───

    La piste devient une grille : plus de debordement, donc plus de
    `scroll-snap` ni de piste focalisable, et plus de fleches - il n'y a plus
    rien a faire defiler. `flex:none` reprend le `flex:0 0 var(--slide-w)` des
    vignettes, qui n'a plus de sens hors d'un flux flex.

    LE `tabindex` DE LA PISTE EST RETIRE PAR LE SCRIPT et non par le CSS : un
    attribut ne se supprime pas en feuille de style, et une piste qui ne defile
    plus mais reste focalisable ajoute un arret de tabulation qui ne mene nulle
    part. Voir le script en bas de ce fichier.
  */
  @media(min-width:861px){
    .carrousel--mosaique .carrousel__piste{display:grid;
      grid-template-columns:repeat(var(--mos-cols,2),minmax(0,1fr));
      overflow:visible;scroll-snap-type:none;padding-bottom:0}
    .carrousel--mosaique .carrousel__slide{flex:none;scroll-snap-align:none}
    .carrousel--mosaique .carrousel__fleches{display:none}
  }
  /* `scroll-behavior:smooth` est ignore par le navigateur lui-meme sous
     prefers-reduced-motion ; on le retire quand meme pour les navigateurs qui
     ne font le lien que sur la propriete CSS. */
  @media(prefers-reduced-motion:reduce){
    .carrousel__piste{scroll-behavior:auto}
  }
</style>

<script>
  /*
    Astro n'emet ce script qu'une fois par page, quel que soit le nombre
    d'instances : d'ou la boucle sur toutes les pistes. Chaque paire de fleches
    est cherchee a partir de SA piste, jamais dans le document - deux carrousels
    sur la meme page se commanderaient l'un l'autre.
  */
  document.querySelectorAll<HTMLElement>('.carrousel').forEach((car) => {
    const piste = car.querySelector<HTMLElement>('.carrousel__piste');
    if (!piste) return;
    car.querySelectorAll<HTMLElement>('.carrousel__btn').forEach((b) => {
      b.addEventListener('click', () => {
        piste.scrollBy({ left: piste.clientWidth * 0.75 * Number(b.dataset.sens) });
      });
    });

    /*
      LE `tabindex` SUIT CE QUE LA PISTE PEUT FAIRE. Il est ecrit dans le HTML
      parce qu'une piste qui defile DOIT etre focalisable - c'est ce qui donne
      les fleches du clavier a qui n'a pas de souris. Mais en mosaique elle ne
      defile plus, et un arret de tabulation qui ne mene nulle part fait perdre
      du temps a tout le monde. On le retire quand il n'y a rien a parcourir,
      et on le rend des que la mosaique redevient une piste - au
      redimensionnement comme au premier rendu.
    */
    const suivreTabindex = () => {
      const defile = piste.scrollWidth > piste.clientWidth + 1;
      if (defile) piste.setAttribute('tabindex', '0');
      else piste.removeAttribute('tabindex');
    };
    /*
      LE RANG SE DEDUIT DU DEFILEMENT, pas d'un compteur qu'on incremente : les
      fleches, le pouce et les fleches du clavier bougent tous la meme piste,
      et une seule source evite qu'ils divergent. Meme calcul que les points
      de `.tuiles--piste`.
    */
    const points = [...car.querySelectorAll<HTMLElement>('.carrousel__points i')];
    const n = points.length;
    const suivreRang = () => {
      if (n < 2) return;
      const course = piste.scrollWidth - piste.clientWidth;
      const i = course > 1 ? Math.round((piste.scrollLeft / course) * (n - 1)) : 0;
      points.forEach((p, k) => p.classList.toggle('est-actif', k === i));
    };
    suivreRang();
    piste.addEventListener('scroll', suivreRang, { passive: true });

    suivreTabindex();
    addEventListener('resize', () => { suivreTabindex(); suivreRang(); }, { passive: true });
  });
</script>
