---
/*
  Un visuel legende, dans le gabarit des etudes de cas (BRIEF §5.4).

  TROIS SOURCES POSSIBLES, UNE SEULE BOITE. `src` pour une image de
  src/assets - dimensions lues dans le fichier, nom errone = build casse ;
  `url` pour un SVG charge en `?url`, qui doit rester un <img> et non etre
  inline (voir l'en-tete de system-brand.astro : les .cls-N d'Illustrator se
  marcheraient dessus) ; ni l'un ni l'autre, et la boite reste un emplacement
  gris explicitement en attente d'image.

  LE CADRE PORTE LE RAPPORT, PAS L'IMAGE. La maquette fixe le format de chaque
  serie - 4/3, 16/9, 16/10, carre - pour que les rangees s'alignent. Mais les
  fichiers ne l'ont pas : ce sont des planches de travail, et plusieurs font
  1,42. En `cover` on perdrait vingt pour cent en haut et en bas de chacune.
  Le cadre tient donc le format de la serie et l'image s'y loge ENTIERE
  (`contain`), sur le gris des emplacements. Rien n'est rogne, les rangees
  restent alignees. `ajuste="cover"` existe pour les cas ou le cadrage ne coute
  rien - la mosaique de la discovery, ou les planches servent de matiere.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icone from './Icone.astro';

export interface Props {
  src?: ImageMetadata;
  /** SVG charge en `?url` - pose en <img>, jamais inline */
  url?: string;
  /** texte alternatif descriptif. Vide uniquement si la legende dit tout. */
  alt: string;
  /** legende visible. Peut porter du HTML (pastilles, gras). */
  legende?: string;
  /** rapport du cadre, en notation CSS : « 4 / 3 ». Omis, l'image donne le sien. */
  ratio?: string;
  ajuste?: 'contain' | 'cover';
  /** largeur d'AFFICHAGE, pour que le navigateur choisisse la bonne resolution */
  sizes?: string;
  /** intitule de l'emplacement quand il n'y a pas encore d'image */
  attente?: string;
  /** classes supplementaires - le parent decide de la place qu'elle occupe */
  class?: string;
  /*
    LA LOUPE. Une planche de travail - une carte des capabilities, un jeu
    d'iconographie, une page de brandbook - ne se lit pas a 250px de large :
    elle y sert de matiere, et il faut pouvoir l'ouvrir en grand. `zoom` fait
    du cadre un bouton que src/scripts/loupe.ts ramasse comme les cases de la
    mosaique, dont il reprend `.zoom` et son badge.

    PAS SUR TOUTES LES FIGURES : une capture de produit ou un document montre
    en entier n'a rien de plus a reveler, et un badge de loupe sur chacune
    promettrait un agrandissement sans objet.
  */
  zoom?: boolean;
  /*
    BLANC TOURNANT. Une planche posee - page de brandbook, rapport, carte des
    capabilities - n'a pas de bord a elle et ne doit pas venir au ras du filet.
    Une capture plein cadre, si : son cadre EST le bord de ce qu'elle montre.
    Meme nom que l'option du carrousel, meme raison.
  */
  aere?: boolean;
}
const {
  src, url, alt, legende, ratio, ajuste = 'contain',
  sizes = '(min-width: 900px) 340px, 90vw', attente, class: classe,
  zoom = false, aere = false,
} = Astro.props;

/* La loupe lit `data-legende` ; sans legende visible, le texte alternatif en
   tient lieu plutot que d'ouvrir une vue sans titre. */
const titreLoupe = legende ?? alt;

const styleCadre = [
  ratio && `aspect-ratio:${ratio}`,
  `--fit:${ajuste}`,
].filter(Boolean).join(';');
---
<figure class:list={['fig', aere && 'fig--aere', classe]}>
  <div class="fig__cadre" style={styleCadre}>
    {zoom && (src || url) ? (
      <button type="button" class="zoom" data-loupe="image"
        data-legende={titreLoupe} aria-label={`Enlarge ${alt}`}>
        {src
          ? <Image src={src} alt={alt} sizes={sizes} loading="lazy" decoding="async" />
          : <img src={url} alt={alt} loading="lazy" decoding="async" />}
        <span class="zoom__badge" aria-hidden="true"><Icone nom="loupe" taille={13} /></span>
      </button>
    ) : (
      <Fragment>
        {src && (
          <Image src={src} alt={alt} sizes={sizes} loading="lazy" decoding="async" />
        )}
        {!src && url && <img src={url} alt={alt} loading="lazy" decoding="async" />}
        {!src && !url && <span class="fig__attente">{attente ?? alt}</span>}
      </Fragment>
    )}
  </div>
  {legende && <figcaption class="cap" set:html={legende} />}
</figure>
