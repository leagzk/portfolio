---
/*
  Tuiles qui se retournent (BRIEF §2.5).

  Une grille d'aplats primaires separes par des filets noirs. Recto : la
  couleur, le titre, et le « + » en haut a droite. Verso : le texte, sur blanc.

  LES FILETS SONT LE FOND, PAS DES BORDURES. La grille porte le noir et un
  `gap` de 1.5px ; chaque tuile pose son propre fond par-dessus. Des bordures
  donneraient 3px entre deux tuiles voisines et 1.5px aux extremites - la
  grille mondrianesque veut un trait d'epaisseur constante.

  LE RETOURNEMENT REPOND A TROIS GESTES, et il en faut trois. Le survol pour la
  souris ; `:focus-visible` pour le clavier, sans quoi la tuile est une impasse
  pour qui n'a pas de souris ; et le clic, qui pose une classe - parce qu'un
  appui tactile ne declenche NI survol ni focus-visible, et que le brief exige
  le tap mobile. Les trois mènent au meme etat.

  C'EST UN <button> et pas une <div> cliquable : il entre dans l'ordre de
  tabulation tout seul, il repond a Entree et Espace tout seul, et il s'annonce
  comme actionnable. `aria-expanded` dit lequel des deux cotes est montre.
*/
import Icone from './Icone.astro';

export interface Tuile {
  /**
   * Le titre du recto. Il peut porter du HTML : la frise 2018→2023 met en
   * italique le verbe qui pivote d'un palier au suivant - « communication
   * <em>was</em> the system » -, et c'est LUI le propos. Ecrit en texte, il
   * faudrait soit renoncer a l'italique, soit decouper le titre en trois props.
   * Le contenu vient de la page, jamais d'une saisie : rien a assainir.
   */
  titre: string;
  /** le texte du verso. HTML autorise, meme raison que `titre`. */
  texte: string;
  couleur: 'rouge' | 'bleu' | 'jaune' | 'noir' | 'blanc';
  /**
   * `grid-area` quand la tuile est une CASE d'une composition, et non un
   * element de la grille interne de cette serie. L'aire est portee par la
   * tuile et pas par la serie : les trois sobrietes d'Operating System
   * occupent trois aires qui ne se touchent pas - deux au-dessus du bloc
   * 03, une a sa droite -, et une serie entiere ne peut en occuper qu'une.
   * Des qu'une tuile en a une, la serie passe en `display:contents` au
   * bureau et en piste a defilement sous le palier.
   */
  aire?: string;
  /** surtitre du recto - l'annee pour la frise, le nom de la pratique sinon */
  eyebrow?: string;
  /**
   * Repeter le surtitre au verso. La frise le fait - l'annee est le repere, on
   * doit savoir de quel palier on lit le detail - les quatre pratiques non
   * (BRIEF §5.4 : « verso sans eyebrow »).
   */
  rappel?: boolean;
}

export interface Props {
  tuiles: Tuile[];
  /** nombre de colonnes au bureau ; en dessous de 720px la grille passe a 1 */
  colonnes?: number;
  /** nom du groupe pour les lecteurs d'ecran */
  label: string;
  /**
   * Hauteur d'une tuile. Posee et non deduite d'un rapport : les series n'ont
   * pas le meme contenu au verso - la frise tient en trois lignes, les quatre
   * pratiques en dix - et c'est le VERSO qui decide de la hauteur. A rapport
   * fixe, la serie la plus bavarde deborderait ou il faudrait rapetisser son
   * texte.
   */
  hauteur?: number;
  /**
   * Passe la serie en piste a defilement SOUS LE PALIER. Une serie de cases
   * l'est deja d'office - elle n'a pas le choix, la composition s'empile -
   * mais une serie ordinaire peut le demander : trois tuiles l'une sous
   * l'autre font trois ecrans a traverser, et la piste n'en fait qu'un.
   */
  piste?: boolean;
  /** Largeur d'une tuile sur la piste. Le reste montre le bord de la suivante. */
  largeurMobile?: string;
}
const { tuiles, colonnes = 4, label, hauteur = 240, piste = false,
  largeurMobile = '290px' } = Astro.props;
/*
  Une serie DE CASES des qu'une tuile porte son aire. Elle perd alors son fond
  noir et son cadre - les filets du Mondrian sont deja portes par la case
  elle-meme, les doubler donnerait 3px la ou le trait en vaut 1,5 - et elle
  gagne sa pagination, qui n'a d'objet que sur la piste mobile.
*/
const enCases = tuiles.some((t) => t.aire);
/*
  UNE SEULE PISTE POUR LES DEUX CAS. Les cases y arrivent par necessite, les
  autres par choix, mais le dispositif est le meme - meme defilement, meme
  accroche, meme pagination, meme script. `--cases` ne garde que ce qui lui
  est propre : la perte du fond et du cadre.
*/
const surPiste = enCases || piste;
---
<ul class:list={['tuiles', enCases && 'tuiles--cases', surPiste && 'tuiles--piste']}
    style={`--tuiles-cols:${colonnes};--tuile-h:${hauteur}px;--tuile-w-mob:${largeurMobile}`}
    aria-label={label}>
  {tuiles.map((t) => (
    <li class:list={['tuile', t.aire && 'tuile--case']} style={t.aire ? `grid-area:${t.aire}` : undefined}>
      <button class="tuile__pivot" type="button" aria-expanded="false">
        <span class:list={['tuile__face', 'tuile__recto', `tuile--${t.couleur}`]}>
          {/*
            L'ESPACE EST ECRIT, SINON LES DEUX TEXTES SE COLLENT. Le nom
            accessible d'un bouton est la concatenation de ses textes : sans
            noeud blanc entre le numero et le titre, une synthese vocale lisait
            « 01Brand », et « Experience Foundations01 » a la jonction
            suivante. Le `{' '}` pose ce noeud ; il ne change rien a
            l'affichage, le surtitre etant un bloc.
          */}
          {t.eyebrow && <span class="tuile__eyebrow">{t.eyebrow}</span>}{' '}
          <span class="tuile__titre" set:html={t.titre} />
          {/* La fleche circulaire et non un « + » : cette tuile ne deplie rien,
              elle se retourne. Voir `tourner` dans Icone.astro. */}
          <Icone nom="tourner" taille={18} class="tuile__tourne" />
        </span>{' '}
        {/* Meme raison entre les deux FACES : le titre du recto finit par un
            point et le texte du verso commence par une majuscule, donc sans ce
            noeud blanc on entendait « brought back.Every component ». */}
        <span class="tuile__face tuile__verso">
          {/*
            LE RAPPEL EST VISUEL, PAS VOCAL. Le verso reste dans l'arbre
            d'accessibilite meme non retourne, donc son numero s'annoncait une
            seconde fois dans le meme bouton. Il ne dit rien que le recto n'ait
            deja dit.
          */}
          {t.rappel && t.eyebrow && <span class="tuile__eyebrow" aria-hidden="true">{t.eyebrow}</span>}
          <span class="tuile__texte" set:html={t.texte} />
        </span>
      </button>
    </li>
  ))}
</ul>
{surPiste && (
  /*
    LA PAGINATION DE LA PISTE, SOEUR DE LA SERIE ET NON SON ENFANT. Dans une
    serie passee en `display:contents`, elle deviendrait une case de la
    composition ; a cote, elle n'existe que sous le palier, ou le CSS la
    rallume. C'est la construction de .principes__pagination sur l'accueil,
    et le trace de la grille sait deja ignorer un enfant en display:none.
  */
  <div class="tuiles__pagination" aria-hidden="true">
    <span class="tuiles__points">{tuiles.map(() => <i></i>)}</span>
    <span class="tuiles__swipe">Swipe →</span>
  </div>
)}

<style is:global>
  /* Le cadre est une vraie bordure, le reste du noir est le FOND que le `gap`
     laisse voir : les filets interieurs doivent faire 1,5px et pas 3. */
  .tuiles{display:grid;grid-template-columns:repeat(var(--tuiles-cols,4),minmax(0,1fr));
    gap:var(--rule-fine);background:var(--text);
    border:var(--rule-fine) solid var(--text);list-style:none;margin:0;padding:0}
  .tuile{display:grid;min-width:0}
  /*
    LA SERIE POSEE DANS UNE COMPOSITION. Elle ne porte plus ni fond ni cadre :
    la case de la grille lui donne deja son trait. La marge interieure tombe a
    24px, comme les autres petites cases du site - le carre de droite fait
    177px a 861, dont 56 seraient partis en marge a 28.
  */
  /*
    ═══ UNE SERIE DE CASES, DEUX DISPOSITIFS ═══

    AU BUREAU elle n'existe pas : `display:contents` la retire, et ses tuiles
    remontent dans la composition comme si elles y etaient posees une a une,
    chacune a son aire. C'est ce que fait .principes sur l'accueil, et le
    trace des filets sait deja aplatir un enfant en contents (voir `cases`
    dans src/scripts/grille.ts).

    SOUS LE PALIER la composition s'empile sur une colonne, et trois carres
    l'un sous l'autre font trois ecrans a faire defiler. La serie redevient
    donc une boite : une piste a defilement horizontal, une tuile par ecran,
    avec le bord de la suivante qui depasse pour dire qu'il y en a une. Meme
    dispositif, meme largeur de carte et meme pagination que le rail des
    trois principes de l'accueil - c'est le comportement du site des qu'un
    palier impose l'empilement.
  */
  @media(min-width:861px){
    .tuiles--cases{display:contents}
  }
  .tuile--case .tuile__face{padding:24px}
  /*
    Le recto n'a plus qu'une ligne, et `space-between` la renverrait en haut -
    il n'a plus deux choses a ecarter. Le titre se cale donc en bas, la ou le
    repere et le propos le tenaient a deux, et la ou les cases de la
    composition posent deja le leur. */
  .tuile--case .tuile__recto{justify-content:flex-end}
  /*
    13px ET NON 14, et c'est le corps que `.clef__detail` emploie deja pour
    la meme situation : un texte de verso dans une case etroite. A 861px le
    carre de droite fait 177 et n'offre que 129px de colonne. */
  .tuile--case .tuile__verso{font-size:13px;line-height:1.5}

  /*
    ═══ LE CARRE TIENT SES DEUX FACES ═══

    Une tuile du gabarit fait la hauteur de sa face la plus haute, et c'est
    toujours le VERSO. Posee dans une composition, cette hauteur-la ne lui
    appartient plus : la case est carree. La piste, la tuile, le bouton ET la
    rangee du bouton - ou les deux faces se superposent - sont donc bornes a
    la hauteur de la case. Sans cette derniere borne, le bouton etait bien
    carre mais sa rangee interieure gardait la hauteur du verso, et le recto,
    qui s'y etire, redescendait son titre 14px sous le bord.

    ET LE VERSO TIENT DEDANS. Il a grandi un temps par-dessus ses voisines -
    au corps du gabarit, il demandait 227px pour un carre de 177 a 861px.
    C'etait la description qui etait trop longue, pas le carre trop petit :
    resserree, et au corps que `.clef__detail` emploie deja pour un verso
    dans une case etroite, elle tient partout - 28px de marge au plus serre.
    Rien ne sort du carre, donc rien n'a besoin d'en sortir.
  */
  @media(min-width:861px){
    .tuile--case{grid-template-rows:minmax(0,1fr);min-height:0}
    .tuile--case .tuile__pivot{min-height:0;height:100%;grid-template-rows:minmax(0,1fr)}
  }

  /* La perspective vit sur le bouton ; chaque face est son enfant direct et
     tourne pour son propre compte - l'une vers 180deg, l'autre de 180 vers 360.
     backface-visibility fait le reste : a tout instant une seule est face a
     nous. Pas de conteneur intermediaire, donc pas de transform-style a poser.

     LES DEUX FACES SONT SUPERPOSEES EN GRILLE, PAS EN ABSOLU, et `--tuile-h`
     est un PLANCHER. En absolu, les faces ne comptaient pas dans la hauteur du
     bouton : celle-ci etait posee, et le verso le plus bavard - « Rituals »,
     dix lignes - la depassait de 7px a 1024px de colonne, et de plus de cent a
     866px. Un debord de texte, pas une coupe : les faces n'ont pas d'overflow,
     le texte sortait sur la tuile voisine. Dans la meme cellule de grille, la
     rangee prend la hauteur de la face la plus haute, les quatre tuiles la
     partagent, et rien ne deborde a aucune largeur. */
  .tuile__pivot{position:relative;display:grid;width:100%;min-height:var(--tuile-h,240px);
    padding:0;border:none;background:none;cursor:pointer;perspective:1200px;
    font:inherit;color:inherit;text-align:left}
  .tuile__face{grid-area:1 / 1;display:flex;flex-direction:column;
    padding:28px;backface-visibility:hidden;
    transition:transform .7s cubic-bezier(.4,0,.2,1)}
  /* Surtitre en haut, titre en bas : le recto se lit du repere vers le propos. */
  .tuile__recto{justify-content:space-between}
  /* Le verso cale son texte EN HAUT et non au centre : les quatre pratiques en
     ont dix lignes, et un bloc centre puis un bloc cale en haut dans la meme
     rangee ne se liraient pas comme une serie. */
  .tuile__verso{background:var(--white);color:var(--text-body);
    transform:rotateY(180deg);justify-content:flex-start;gap:10px;
    font-size:14px;line-height:1.6}
  .tuile__verso strong,.tuile__verso b{color:var(--text)}
  /*
    LE SURVOL EST RESERVE AUX APPAREILS QUI SURVOLENT. Sur iOS, un appui
    laisse `:hover` colle sur l'element jusqu'au prochain appui ailleurs : le
    second tap repassait bien `aria-expanded` a false, mais le survol fantome
    tenait la tuile retournee, et elle ne revenait jamais d'elle-meme. Le
    `hover:hover` le rend aux souris et aux trackpads ; au doigt, seul
    l'attribut decide, et c'est lui que le script bascule.
  */
  .tuile__pivot:focus-visible .tuile__face,
  .tuile__pivot[aria-expanded="true"] .tuile__face{transform:rotateY(180deg)}
  .tuile__pivot:focus-visible .tuile__verso,
  .tuile__pivot[aria-expanded="true"] .tuile__verso{transform:rotateY(360deg)}
  @media(hover:hover){
    .tuile__pivot:hover .tuile__face{transform:rotateY(180deg)}
    .tuile__pivot:hover .tuile__verso{transform:rotateY(360deg)}
  }

  /* Monospace et non capitales espacees : c'est un REPERE - une annee, le nom
     d'une pratique -, pas un surtitre de section. La maquette l'ecrit en <code>
     et la distinction se voit : on ne confond pas « 2018 » avec « THE RESULTS ». */
  .tuile__eyebrow{font-family:ui-monospace,monospace;font-size:13px;opacity:.8}
  .tuile__titre{font-family:var(--display);font-weight:900;font-size:22px;
    line-height:1.15}
  .tuile__titre em{font-style:italic}
  /*
    Toujours au meme endroit dans l'encadre (BRIEF §2.7), 16px du coin comme
    les carres de l'accueil.

    IL NE BOUGE PAS, ET C'EST VOULU. Le « + » qu'il remplace pivotait en « x »
    pour dire que la carte se refermait ; faire tourner celui-ci d'un demi-tour
    semblait suivre le geste de la tuile - sauf qu'il ne se verrait jamais. Le
    dessin vit sur le RECTO, et le recto est precisement la face qui part
    (`backface-visibility:hidden`). L'animation se serait terminee sur une face
    tournee vers le mur. La tuile qui se retourne EST le retour : l'icone
    annonce le geste, elle n'a pas a le mimer.
  */
  .tuile__tourne{position:absolute;top:16px;right:16px}

  .tuile--rouge{background:var(--red);color:var(--white)}
  .tuile--bleu{background:var(--blue);color:var(--white)}
  .tuile--jaune{background:var(--yellow);color:var(--text)}
  .tuile--noir{background:var(--ink);color:var(--white)}
  /*
    LE BLANC EST UNE CINQUIEME TEINTE, PAS UNE ABSENCE. Dans une serie posee
    sur fond noir avec ses filets, une tuile blanche est un TROU dans l'aplat -
    c'est la case blanche du Mondrian, que la composition de l'accueil utilise
    deja. Elle garde donc son cadre par le `gap` de la grille.

    ELLE PERD EN REVANCHE L'INDICE COULEUR DU RETOURNEMENT : le verso est
    blanc lui aussi, donc seul le texte change. La fleche et la rotation
    restent, mais la tuile blanche s'annonce moins que les quatre autres.
  */
  .tuile--blanc{background:var(--white);color:var(--text)}
  .tuile__pivot:focus-visible{outline:3px solid var(--focus);outline-offset:-6px}

  /*
    ─── La piste, sous le palier de la composition ───
    860 et non 720 : c'est a 861px que `.compo` repasse sur une colonne
    (etude.css), et la serie doit basculer au MEME endroit que la composition
    qui la porte - une tuile large comme un ecran dans une grille a six
    colonnes n'aurait aucun sens.
  */
  /* Eteinte par defaut, et declaree AVANT la requete qui la rallume : une
     requete media n'ajoute aucune specificite, donc a egalite c'est l'ordre
     qui tranche. Ecrite apres, elle reprenait le dessus sous le palier. */
  .tuiles__pagination{display:none}

  @media(max-width:860px){
    .tuiles--piste{display:flex;overflow-x:auto;
      scroll-snap-type:x mandatory;scrollbar-width:none}
    .tuiles--piste::-webkit-scrollbar{display:none}
    /* Une serie de cases perd en plus son cadre : les filets du Mondrian sont
       deja portes par la case. Une serie ordinaire garde le sien, et la piste
       defile alors DANS son encadre. */
    .tuiles--cases{background:var(--text);border:0;padding:0}
    /* 290px par defaut : la meme carte que le rail de l'accueil, et le bord de
       la suivante reste visible sur un telephone de 375. */
    .tuiles--piste > .tuile{flex:0 0 var(--tuile-w-mob,290px);scroll-snap-align:start}
    /*
      `min-height:0` : la pagination est un enfant direct de `.compo`, donc
      la regle mobile qui donne 170px de plancher aux CASES l'attrapait aussi
      - 170px de blanc mort sous la piste pour trois points et un mot. Ce
      n'est pas une case, c'est une legende.
    */
    .compo .tuiles__pagination{min-height:0}
    /* Padding symetrique : le filet du perimetre passe sous la pagination, et
       sans degagement en bas les points le touchaient. Meme valeur que
       .principes__pagination sur l'accueil - les deux rails se paginent
       pareil. */
    .tuiles__pagination{display:flex;align-items:center;justify-content:space-between;
      gap:12px;padding:12px 0;background:var(--white)}
  }
  .tuiles__points{display:flex;gap:6px}
  .tuiles__points i{width:10px;height:10px;background:var(--grey-mondrian)}
  .tuiles__points i.est-actif{background:var(--ink)}
  .tuiles__swipe{font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.12em;
    text-transform:uppercase;color:var(--ink-muted)}

  @media(max-width:720px){
    .tuiles{grid-template-columns:1fr}
    .tuile__face{padding:24px}
  }
  @media(prefers-reduced-motion:reduce){
    .tuile__face{transition:none}
  }
</style>

<script>
  /*
    Le clic pose aria-expanded, que le CSS lit pour tenir le retournement. On
    n'ajoute pas de classe en plus : l'attribut porte DEJA l'etat pour les
    lecteurs d'ecran, et en faire aussi le crochet de style garantit que
    l'affichage et l'annonce ne peuvent pas diverger.
  */
  /*
    UNE SEULE RETOURNEE A LA FOIS, PAR SERIE. Deux versos ouverts cote a cote
    donnent deux blocs de texte blanc dans une rangee de couleurs, et on ne
    sait plus lequel on vient d'ouvrir. On ferme donc les voisines - celles de
    la MEME serie seulement, deux series voisines n'ayant pas a se repondre.
  */
  document.querySelectorAll<HTMLButtonElement>('.tuile__pivot').forEach((b) => {
    b.addEventListener('click', () => {
      const ouvre = b.getAttribute('aria-expanded') !== 'true';
      if (ouvre) {
        const serie = b.closest('.tuiles') ?? document;
        serie.querySelectorAll<HTMLButtonElement>('.tuile__pivot').forEach((autre) => {
          if (autre !== b) autre.setAttribute('aria-expanded', 'false');
        });
      }
      b.setAttribute('aria-expanded', ouvre ? 'true' : 'false');
    });
  });

  /*
    Les points de la piste. Ils ne servent que sous le palier, ou la serie
    defile ; au-dessus elle est en display:contents et ne defile pas - d'ou
    la garde sur la largeur reelle de la piste plutot qu'un matchMedia qui
    redirait le point de rupture deja ecrit dans le CSS. Meme reglage que
    .principes__points sur l'accueil.
  */
  document.querySelectorAll<HTMLElement>('.tuiles--piste').forEach((piste) => {
    const pagination = piste.nextElementSibling;
    const points = pagination ? [...pagination.querySelectorAll<HTMLElement>('i')] : [];
    if (!points.length) return;
    const suivre = () => {
      if (piste.scrollWidth <= piste.clientWidth) return;
      const i = Math.round((piste.scrollLeft / (piste.scrollWidth - piste.clientWidth)) * (points.length - 1));
      points.forEach((p, n) => p.classList.toggle('est-actif', n === i));
    };
    piste.addEventListener('scroll', suivre, { passive: true });
    suivre();
  });
</script>
