---
/*
  Les chiffres cles d'une etude de cas (BRIEF §5.2).

  DEUX FORMES, ET C'EST LA PAGE QUI CHOISIT.

  « bandeau » - la forme d'origine : des colonnes blanches separees par des
  filets VERTICAUX, qui ne touchent pas le hero au-dessus et descendent jusqu'au
  cadre de la composition en dessous. Ils relient les deux, la ou une rangee de
  cartes aurait fait un bloc de plus.

  « mondrian » - des APLATS DE COULEUR DEPLIABLES, sur le modele des principes
  de l'accueil : le nombre et son intitule se lisent d'emblee, le contexte
  arrive au survol, au focus ou au clic. Une grande case typographique les
  accompagne - sur Governance, la definition du systeme et le renvoi vers la
  page qui dit comment l'equipe travaille. Le bandeau cesse alors d'etre une
  rangee pour devenir une composition, comme celle qui le suit.

  POURQUOI DEPLIABLE PLUTOT QUE TOUT VISIBLE : la ligne de contexte est ce qui
  donne sa valeur au chiffre, mais c'est aussi ce qui empeche de les compter
  d'un coup d'oeil. Repliee, elle laisse cinq nombres se lire en une seconde ;
  depliee, elle les explique un par un. Les deux lectures ont leur moment, et
  le « + » dit qu'il y en a une seconde.

  Le CSS est dans src/styles/etude.css, avec le reste du gabarit : la page
  l'importe deja, et un <style> scope ici ne traverserait pas la frontiere du
  slot de toute facon.

  QUATRE OU CINQ, PAS N. Le bandeau compte ses colonnes (`--cles-n`), et sous
  860px il passe a deux : une colonne qui ouvre une rangee perd sa bordure
  gauche, et la derniere, si elle est seule, prend les deux colonnes. Au-dela de
  cinq les nombres a 56px ne tiennent plus leur ligne - mesure a 1280px : cinq
  colonnes font 214px, six en feraient 178. La forme mondrian, elle, en demande
  exactement cinq : son gabarit est dessine, pas calcule. Le garde reste au
  build plutot qu'a l'oeil.
*/
import Icone from './Icone.astro';

export interface Chiffre {
  /** le nombre, tel qu'il s'ecrit : « 2,500 », « 200+ », « 1 » */
  nombre: string;
  /** ce que le nombre compte - une phrase nominale, sans verbe */
  quoi: string;
  /** la ligne de contexte, qui dit ce que le chiffre vaut */
  contexte: string;
  /** forme mondrian seulement : la couleur de la case ou de son fragment */
  couleur?: 'rouge' | 'bleu' | 'jaune' | 'gris' | 'noir';
  /**
   * COMMENT LA COULEUR SE POSE, et c'est la recette de l'accueil.
   *
   * `plein` - toute la case est de couleur. `bande` et `carre` - la case
   * reste BLANCHE et la couleur n'y tient qu'un fragment : une bande en bas,
   * un carre dans le coin, comme `.wt__fragment` sur l'accueil.
   *
   * CINQ APLATS PLEINS COTE A COTE, C'EST UNE PALETTE, PAS UNE COMPOSITION.
   * Ce qui rend l'accueil graphique n'est pas la quantite de couleur, c'est sa
   * RARETE : trois aplats pleins au milieu de cases blanches que la couleur ne
   * fait qu'effleurer. On reprend ce dosage.
   */
  motif?: 'plein' | 'bande' | 'carre';
}

export interface Props {
  chiffres: Chiffre[];
  /** intitule du groupe pour les lecteurs d'ecran */
  label?: string;
  /** « bandeau » par defaut ; « mondrian » attend cinq chiffres et un slot */
  variante?: 'bandeau' | 'mondrian';
}
const { chiffres, label = 'Proof points', variante = 'bandeau' } = Astro.props;
const mondrian = variante === 'mondrian';

if (!mondrian && (chiffres.length < 4 || chiffres.length > 5)) {
  throw new Error(`<ChiffresCles> attend 4 ou 5 chiffres, reçu ${chiffres.length}`);
}
if (mondrian && (chiffres.length < 4 || chiffres.length > 5)) {
  throw new Error(
    `<ChiffresCles variante="mondrian"> attend 4 ou 5 chiffres, reçu ${chiffres.length}`,
  );
}
/*
  LA CASE DE DEFINITION EST FACULTATIVE, et c'est ce qui rend la forme
  reutilisable. Governance a une phrase qui dit ce qu'EST le systeme ; les deux
  autres etudes n'en ont pas, et leur en inventer une pour remplir un gabarit
  serait prendre le probleme a l'envers. Sans elle, les chiffres prennent toute
  la largeur sur une seule rangee.
*/
const avecDef = Astro.slots.has('definition');

/*
  DEUX RANGEES DE BANDES, ET NON DOUZE COLONNES - et c'est ce qui permet aux
  tuiles de SE POUSSER. Sur l'accueil, survoler un principe le fait s'etendre
  et reduit son voisin a une bande de 28px ; une grille ne sait pas faire ce
  geste-la, parce que ses colonnes sont communes a toutes les rangees et que
  les deux n'ont pas le meme decoupage. Chaque rangee est donc une bande a
  elle, et ses cases se partagent la largeur en proportion.

  LES PROPORTIONS SONT CELLES DU DESSIN : 3-2-2 en haut, 3-4 en bas, sur les
  sept unites de la moitie gauche. Le plus large des nombres ouvre - « 100% »
  demande 150px a 48 de corps, et trois unites lui en donnent 266 ; deux ne
  lui en auraient laisse que 177.

  L'ORDRE DU DOM EST L'ORDRE VISUEL, et comme ce sont des boutons, c'est aussi
  l'ordre de tabulation.
*/
/*
  LES PROPORTIONS SONT CELLES DU DESSIN, et elles dependent de ce que la bande
  a a porter.

  AVEC LA DEFINITION : deux rangees sur la moitie gauche, 3-2-2 en haut et 3-4
  en bas, sur sept unites. Le plus large des nombres ouvre - « 100% » demande
  150px a 48 de corps, et trois unites lui en donnent 266 ; deux ne lui en
  auraient laisse que 177.

  SANS ELLE : une seule rangee de quatre, sur les douze unites, en 3-2-4-3. Une
  bande de deux rangees pour quatre chiffres ferait des cases de 620px de large
  pour trois mots - du vide, pas de la composition.
*/
const UNITES = avecDef ? [3, 2, 2, 3, 4] : [3, 2, 4, 3];
const RANGEES = avecDef
  ? [{ depart: 0, fin: 3 }, { depart: 3, fin: 5 }]
  : [{ depart: 0, fin: chiffres.length }];
---
{/*
  data-filets : crochet du trace anime (src/scripts/grille.ts). Les filets de
  ce bandeau sont de vraies bordures CSS et non des `gap` ; le script les
  releve comme il releve ceux d'une composition, et le MEME front les traverse
  - le bandeau et la composition qui le suit se touchent, ils ne font qu'un
  bloc. En forme mondrian les filets viennent des `gap` sur fond noir, comme
  dans la composition : le script releve les memes aretes dans les deux cas.
*/}
{mondrian ? (
  <section
    class:list={['cles', 'cles--mondrian', !avecDef && 'cles--mondrian-seul']}
    data-filets
    aria-label={label}
  >
    {/*
      LA CASE PORTE LA GRILLE, LE PANNEAU PORTE LA COULEUR - et c'est le
      montage des principes de l'accueil, repris tel quel. Le bouton remplit sa
      case ; c'est la CASE qui s'etend ou se reduit quand on la survole, et ses
      voisines qui lui font de la place.

      data-cases : la rangee n'est pas une case, ce sont ses enfants qui en
      sont. Le trace anime descend donc d'un cran - voir src/scripts/grille.ts.
    */}
    {RANGEES.map((r) => (
      <div class="clef-rangee" data-cases>
      {chiffres.slice(r.depart, r.fin).map((c, j) => {
        const i = r.depart + j;
        return (
      <div class="clef-case" style={`--u:${UNITES[i]}`}>
        <button
          class:list={[
            'clef',
            `clef--${c.motif ?? 'plein'}`,
            c.couleur && `clef--${c.couleur}`,
          ]}
          type="button"
          aria-expanded="false"
        >
          {c.motif && c.motif !== 'plein' && (
            <span class="clef__frag" aria-hidden="true"></span>
          )}
          <span class="clef__dedans">
            {/* data-copy : un <button> ne peut pas porter de <p>, donc rien ici
                ne sortirait dans l'export de contenu sans ce crochet. Voir
                scripts/export-content.mjs. */}
            <span class="clef__nb" data-copy>{c.nombre}</span>
            <span class="clef__bas">
              <span class="clef__quoi" data-copy>{c.quoi}</span>
              <span class="clef__detail" data-copy>{c.contexte}</span>
            </span>
            {/* Deux dessins, un seul visible : la fleche qui ouvre cede la
                place a celle qui referme. Un « + » qui pivote en « x » dit
                « ceci s'ouvre ailleurs » ; ici le contenu se deplie sur place. */}
            <span class="clef__ico" aria-hidden="true">
              <Icone nom="agrandir" taille={18} class="clef__ico--o" />
              <Icone nom="reduire" taille={18} class="clef__ico--f" />
            </span>
          </span>
        </button>
      </div>
        );
      })}
      </div>
    ))}
    {avecDef && (
      <div class="clef-def">
        <slot name="definition" />
        {/* Le filet et la bande ferment la case, comme sur le bloc Operating
            System de l'accueil - voir .clef-def dans etude.css. */}
        <span class="clef-def__filet" aria-hidden="true"></span>
        <span class="clef-def__bande" aria-hidden="true"></span>
      </div>
    )}
  </section>
) : (
  <section class="cles" data-filets aria-label={label} style={`--cles-n:${chiffres.length}`}>
    {chiffres.map((c) => (
      <div class="cles__col">
        <span class="cles__nb">{c.nombre}</span>
        <span class="cles__quoi">{c.quoi}</span>
        <span class="cles__ctx">{c.contexte}</span>
      </div>
    ))}
  </section>
)}
