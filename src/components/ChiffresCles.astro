---
/*
  Les chiffres cles d'une etude de cas (BRIEF §5.2).

  Quatre colonnes separees par des filets VERTICAUX, et c'est tout le propos du
  dispositif : les filets ne touchent pas le hero au-dessus et descendent
  jusqu'au cadre de la composition en dessous. Ils relient les deux, la ou une
  rangee de cartes aurait fait un bloc de plus.

  Le CSS est dans src/styles/etude.css, avec le reste du gabarit : la page
  l'importe deja, et un <style> scope ici ne traverserait pas la frontiere du
  slot de toute facon.

  QUATRE OU CINQ, PAS N. Le bandeau compte desormais ses colonnes (`--cles-n`),
  et sous 860px il passe a deux : une colonne qui ouvre une rangee perd sa
  bordure gauche, et la derniere, si elle est seule, prend les deux colonnes.
  Au-dela de cinq les nombres a 56px ne tiennent plus leur ligne - mesure a
  1280px : cinq colonnes font 214px, six en feraient 178. Le garde reste au
  build plutot qu'a l'oeil.
*/
export interface Chiffre {
  /** le nombre, tel qu'il s'ecrit : « 2,500 », « 200+ », « 1 » */
  nombre: string;
  /** ce que le nombre compte - une phrase nominale, sans verbe */
  quoi: string;
  /** la ligne de contexte, qui dit ce que le chiffre vaut */
  contexte: string;
}

export interface Props {
  chiffres: Chiffre[];
  /** intitule du groupe pour les lecteurs d'ecran */
  label?: string;
}
const { chiffres, label = 'Proof points' } = Astro.props;
if (chiffres.length < 4 || chiffres.length > 5) {
  throw new Error(`<ChiffresCles> attend 4 ou 5 chiffres, reçu ${chiffres.length}`);
}
---
{/*
  data-filets : crochet du trace anime (src/scripts/grille.ts). Les filets de
  ce bandeau sont de vraies bordures CSS et non des `gap` ; le script les
  releve comme il releve ceux d'une composition, et le MEME front les traverse
  - le bandeau et la composition qui le suit se touchent, ils ne font qu'un
  bloc.
*/}
{/*
  LE NOMBRE DE COLONNES SUIT LE NOMBRE DE CHIFFRES, et n'est pas ecrit en dur
  dans la feuille de style : les etudes n'en ont pas toutes autant. Governance
  en porte cinq depuis qu'elle prouve aussi la direction d'equipe ; les autres
  en gardent quatre, et `--cles-n` vaut 4 par defaut dans etude.css.
*/}
<section class="cles" data-filets aria-label={label} style={`--cles-n:${chiffres.length}`}>
  {chiffres.map((c) => (
    <div class="cles__col">
      <span class="cles__nb">{c.nombre}</span>
      <span class="cles__quoi">{c.quoi}</span>
      <span class="cles__ctx">{c.contexte}</span>
    </div>
  ))}
</section>
