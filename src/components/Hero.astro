---
/*
  Le hero : bande noire pleine largeur, identique sur les sept pages (BRIEF §2.2).

  IL REMPLACE <Banner> ET TOUTE LA NAV. Le brief pose la navigation DANS le hero
  (§2.1) : il n'y a donc plus de barre collante au-dessus du contenu, plus de
  dock fixe, plus de menu deroulant « Selected work ». Les trois vivaient dans
  Base.astro et se coordonnaient a trois endroits (CSS du layout, chrome.ts,
  surcharges par page). Tout est ici.

  Le menu mobile plein ecran est ici AUSSI, bien qu'il soit un calque et non une
  partie de la bande : c'est le hamburger de ce composant qui l'ouvre, et les
  separer remettrait une coordination par identifiants entre deux fichiers -
  exactement ce qu'on vient de retirer.

  PLEINE LARGEUR DEPUIS L'INTERIEUR DE .shell. Le hero est rendu dans le <main>,
  lui-meme dans la colonne de 1120px ; il en sort par la marge negative
  habituelle du projet (100vw + calc(50% - 50vw)). C'est deja ce que font
  .ls-carousel__track et .eq-band, et c'est l'overflow-x:hidden de reset.css qui
  absorbe le debord de la barre de defilement.

  LE TITRE EST LE <h1>. Il etait un <p class="banner__standards">, et le <h1>
  vivait dans <PageIntro>, sur l'eyebrow - un h1 de 12px en capitales pendant
  que le titre de 68px n'etait pas un titre. Le hero reprend donc le h1, et
  PageIntro rend desormais son eyebrow en <p>. Aucun texte ne disparait, la
  hierarchie change de porteur.
*/
import Icone from './Icone.astro';
import { CV_HREF, CV_POIDS } from '../lib/cv';
import { entrees } from '../lib/nav';

export interface Props {
  /** cle de l'entree de nav active - voir src/lib/nav.ts */
  courant?: string;
  /** surtitre au-dessus du titre. Omis, rien n'est rendu (pas de bloc vide). */
  eyebrow?: string;
  /** le mot en filigrane, bord a bord en bas de la bande */
  filigrane: string;
  /** accueil : la cellule de gauche de la nav reste vide, sinon icone maison */
  accueil?: boolean;
  /*
    Portrait rond. Il a DEUX formes selon la largeur, et c'est le meme noeud
    logique : cercle de 360px pose a droite du texte au bureau (BRIEF §3.1),
    avatar de 56px dans la signature sous l'intro en dessous de 720px (§11).
    Reserve a l'accueil.
  */
  portrait?: boolean;
  /*
    Ancre de la fleche de defilement. Renseignee, la bande occupe toute la
    hauteur de la fenetre et une fleche animee invite a descendre. Reserve a
    l'accueil : ailleurs le contenu commence assez haut pour se voir.
  */
  defiler?: string;
}
const { courant, eyebrow, filigrane, accueil = false, portrait = false, defiler } = Astro.props;
---
{/*
  LE BANDEAU EST COLLANT, ET IL EST FRERE DU HERO - PAS SON ENFANT.

  Le brief dessine la nav dans la bande noire, ce qui invite a la poser dans
  <header class="hero">. Mais .hero porte overflow:hidden pour contenir le
  filigrane, et un overflow cree un conteneur de defilement : un position:sticky
  pose dedans ne colle qu'au bas de CETTE boite, puis s'arrete avec elle. La nav
  se serait decrochee des la fin du hero.

  Le bandeau est donc sorti et pose juste au-dessus, sur le meme noir. Visuellement
  c'est la meme bande continue ; techniquement il colle a la fenetre, sur toute la
  longueur de la page. Son fond est opaque en permanence et non pose au defilement :
  au-dela du hero il passe sur du blanc, et des liens blancs sur blanc ne se lisent
  pas.
*/}
<div class="chrome">
  {/*
    ─── Barre mobile : zone blanche + hamburger, bloc jaune CV (BRIEF §11) ───
    <nav> et non <div> : elle porte le declencheur du menu et le raccourci CV,
    donc c'est du chrome, identique sur les sept pages. La balise le dit, et
    scripts/export-content.mjs l'ecarte par la meme regle que les autres <nav>.
  */}
  <nav class="hero__barre" aria-label="Mobile">
    <button class="hamb" id="hamb" aria-label="Open menu" aria-expanded="false" aria-controls="mobmenu">
      <span></span><span></span><span></span>
    </button>
    <a class="hero__cv" href={CV_HREF} download>
      Download CV<Icone nom="telecharger" />
      <span class="sr-only"> ({CV_POIDS})</span>
    </a>
  </nav>

  {/* ─── Nav bureau : grille 48px 1fr, liens ferres a droite (BRIEF §2.1) ─── */}
  <nav class="hero__nav shell" aria-label="Primary">
    <div class="hero__accueil">
      {!accueil && <a href="/" aria-label="Home"><Icone nom="maison" taille={22} /></a>}
    </div>
    <ul class="hero__liens">
      {entrees.map((e) => (
        <li>
          <a href={e.href} aria-current={courant === e.cle ? 'page' : undefined}>{e.libelle}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<header class:list={['hero', accueil && 'hero--accueil']}>
  <div class:list={['hero__corps', 'shell', portrait && 'hero__corps--portrait']}>
    <div class="hero__texte">
      {/*
        L'EYEBROW VIT DANS LA SIGNATURE, et ce n'est pas un detour. Sous 720px
        le brief veut l'avatar, puis « Léa Giezek », puis l'eyebrow sous le nom
        (§11) : l'eyebrow doit donc etre dans le meme bloc que le nom pour se
        caler sous lui, et pas sous l'avatar. Au bureau, ce meme bloc remonte
        au-dessus du titre par `order` et ne montre que l'eyebrow.
        Un seul noeud, deux places - plutot que le meme texte ecrit deux fois,
        qu'un lecteur d'ecran lirait deux fois.
      */}
      {(eyebrow || portrait) && (
        <div class="hero__signature">
          {portrait && <span class="hero__avatar" data-portrait role="img" aria-label="Portrait of Léa Giezek"></span>}
          <span class="hero__id">
            {portrait && <span class="hero__nom">Léa Giezek</span>}
            {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}
          </span>
        </div>
      )}
      <h1 class="hero__titre"><slot /></h1>
      <div class="hero__intro"><slot name="intro" /></div>
      <slot name="cta" />
    </div>
    {portrait && (
      <div class="hero__media">
        <span class="hero__cercle" data-portrait role="img" aria-label="Portrait of Léa Giezek"></span>
      </div>
    )}
  </div>

  {/*
    Le viewBox ecrit ici est un SECOURS, pas une mesure : il sert tant que le
    script n'a pas tourne, et si jamais il ne tourne pas. Il est volontairement
    large - un mot trop petit se remarque moins qu'un mot tronque.
  */}
  <svg class="hero__filigrane" data-filigrane viewBox="0 0 1000 240" aria-hidden="true" focusable="false">
    <text x="0" y="200" font-size="240">{filigrane}</text>
  </svg>

  {/*
    UN <a> ET PAS UN BOUTON. Elle mene quelque part - le haut de la
    composition - donc elle doit etre un lien : atteignable au clavier,
    ouvrable dans un onglet, et annoncee comme une destination. Le defilement
    doux vient de `scroll-behavior` sur html, qui se desactive tout seul sous
    mouvement reduit.
  */}
  {defiler && (
    <a class="hero__defiler" href={`#${defiler}`}>
      <span class="sr-only">Reveal the work</span>
      <span class="hero__defiler-icone" aria-hidden="true"><Icone nom="plus" taille={28} /></span>
    </a>
  )}
</header>

{/* ─── Menu mobile plein ecran, ouvert par le hamburger ci-dessus ─── */}
<nav class="mobmenu" id="mobmenu" aria-hidden="true" aria-label="Menu">
  <button class="mobmenu__close" id="mobclose" aria-label="Close menu">&#10005;</button>
  <a href="/" aria-current={accueil ? 'page' : undefined}>Home</a>
  {entrees.filter((e) => e.groupe === 'principal').map((e) => (
    <a href={e.href} aria-current={courant === e.cle ? 'page' : undefined}>{e.libelle}</a>
  ))}

  {/*
    Les trois recits sont annonces par leur surtitre et tenus sous un filet,
    exactement comme les trois moyens de contact plus bas : c'est la meme
    lecture, et elle dit que ces trois-la forment une serie.
  */}
  <div class="mobmenu__groupe">
    <p class="mobmenu__eyebrow">Selected work</p>
    <hr class="mobmenu__rule" />
    {entrees.filter((e) => e.groupe === 'travaux').map((e) => (
      <a href={e.href} aria-current={courant === e.cle ? 'page' : undefined}>{e.libelle}</a>
    ))}
  </div>

  <div class="mobmenu__groupe">
    <p class="mobmenu__eyebrow">Let's talk</p>
    <hr class="mobmenu__rule" />
    <div class="mobmenu__liens">
      <a class="btn3" href="mailto:giezek.lea@gmail.com"><Icone nom="mail" taille={20} />Email</a>
      <a class="btn3" href="https://www.linkedin.com/in/lea-giezek/" target="_blank" rel="noopener noreferrer"><Icone nom="linkedin" taille={20} />LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
      <a class="btn3" href={CV_HREF} download><Icone nom="telecharger" taille={20} />Download CV<span class="sr-only"> ({CV_POIDS})</span></a>
    </div>
  </div>
</nav>

<style is:global>
  /*
    En global : le titre et l'intro arrivent par <slot>, donc avec le hash de la
    PAGE. Une regle scopee ne franchirait pas cette frontiere.
  */

  /* ═══ La bande ═══ */
  /*
    PAS DE display:flex ICI, ET C'EST UNE CORRECTION. En flex colonne, un enfant
    qui porte `margin:0 auto` - ce que fait .shell pour se centrer - cesse d'etre
    etire par le conteneur et se dimensionne sur son contenu : la colonne tombait
    a 856px au lieu de 1120, et les liens de nav n'atteignaient plus le bord
    droit. En flux normal, max-width + marges auto centrent sans rien reduire.
  */
  .hero{position:relative;width:100vw;margin-left:calc(50% - 50vw);margin-bottom:72px;
    background:var(--ink);color:var(--white);overflow:hidden;
    min-height:min(80vh,720px);display:flex;flex-direction:column}
  /*
    HERO PLEIN ECRAN quand il porte la fleche de defilement. On retire la
    hauteur du bandeau collant, sinon la bande depasse d'autant et la fleche
    tombe sous la ligne de flottaison - ce qui lui fait perdre sa raison d'etre.
    `svh` et non `vh` : sur telephone, `vh` compte la barre d'adresse comme si
    elle etait toujours retractee, et la fleche se retrouve dessous.
  */
  .hero:has(.hero__defiler){min-height:calc(100svh - var(--chrome-h))}
  .hero__corps{flex:1}

  /* ═══ Bandeau collant ═══ */
  /* Pleine largeur par la marge negative habituelle du projet, comme .hero. */
  .chrome{position:sticky;top:0;z-index:50;width:100vw;margin-left:calc(50% - 50vw);
    background:var(--ink)}

  /* ═══ Nav bureau ═══ */
  .hero__nav{display:grid;grid-template-columns:48px 1fr;align-items:center;
    gap:var(--gutter);padding-top:var(--sp-03);padding-bottom:var(--sp-03)}
  /*
    width:100% sur les enfants en .shell. .hero est redevenu un flex colonne
    pour pousser la fleche en bas ; or un enfant qui porte `margin:0 auto` n'y
    est plus etire et se dimensionne sur son contenu - le piege deja rencontre
    sur le bandeau. On rend l'etirement explicite.
  */
  .hero > .shell,.hero__corps{width:100%}
  /* L'icone maison, seule et sans rond : c'est le lien de retour des pages
     interieures. Sur l'accueil la cellule reste vide - elle tient la colonne,
     pour que les liens tombent au meme endroit d'une page a l'autre. */
  /*
    UNE CIBLE DE 44px POUR UNE ICONE DE 22. Le lien epousait son icone : 22x22,
    sous le minimum de 24 de la WCAG 2.5.8, et la seule cible aussi petite du
    site. La boite passe a 44 - la cible tactile confortable - et la marge
    negative de 11px garde l'icone exactement ou elle etait : la colonne de la
    nav fait 48px, l'icone restait calee a gauche, et sans cette compensation
    elle se serait recentree 11px plus loin.
  */
  .hero__accueil a{display:grid;place-items:center;width:44px;height:44px;
    margin-left:-11px;color:var(--white);opacity:.92;transition:opacity .2s}
  .hero__accueil a:hover{opacity:1}
  .hero__liens{display:flex;flex-wrap:wrap;justify-content:flex-end;
    gap:clamp(16px,2.4vw,32px);list-style:none;margin:0;padding:0}
  .hero__liens a{position:relative;display:inline-block;padding-bottom:6px;
    color:var(--white);text-decoration:none;font-weight:500;font-size:var(--fs-body);
    white-space:nowrap;transition:color .22s ease}
  .hero__liens a:hover{color:var(--yellow)}
  /* Soulignement jaune 3px sur la page ouverte (BRIEF §2.1) */
  .hero__liens a[aria-current="page"]{color:var(--yellow)}
  .hero__liens a[aria-current="page"]::after{content:"";position:absolute;left:0;right:0;bottom:0;
    height:3px;background:var(--yellow)}
  .hero .sb:focus-visible,.hero__liens a:focus-visible,.hero__accueil a:focus-visible{
    outline:3px solid var(--yellow);outline-offset:4px}

  /* ═══ Contenu ═══ */
  /* 112px sous la nav, 96px avant le bas : le texte est cale en HAUT de la
     bande et non centre verticalement (BRIEF §2.2). D'ou flex-start plutot
     qu'un justify-content:center. */
  /* 112px sous la nav (BRIEF §2.2). La nav vivant maintenant dans le bandeau
     au-dessus, c'est le padding haut du hero qui porte seul cet ecart. */
  .hero__corps{position:relative;z-index:1;padding-top:112px;padding-bottom:96px}
  /*
    Accueil : le texte et la photo en deux colonnes, 112px d'ecart, cales en
    HAUT l'un de l'autre - le cercle s'aligne sur la ligne de l'eyebrow, pas
    sur le milieu du bloc (BRIEF §3.1).
  */
  .hero__corps--portrait{display:grid;grid-template-columns:minmax(0,1fr) 360px;
    gap:112px;align-items:start}
  .hero__texte{display:flex;flex-direction:column;min-width:0}
  .hero__cercle{display:block;width:360px;height:360px;border-radius:50%;
    background:var(--portrait) center/cover no-repeat}

  /* La signature remonte au-dessus du titre au bureau et n'y montre que
     l'eyebrow ; l'avatar et le nom sont la forme mobile (BRIEF §11). */
  .hero__signature{order:-1;display:flex;align-items:center;gap:12px}
  .hero__id{display:flex;flex-direction:column;gap:2px;min-width:0}
  .hero__avatar,.hero__nom{display:none}
  .hero__eyebrow{font-size:var(--fs-eyebrow);font-weight:700;letter-spacing:.2em;
    text-transform:uppercase;color:var(--on-ink-eyebrow)}
  .hero__titre{font-family:var(--display);font-weight:900;font-size:var(--fs-h1);
    line-height:1;letter-spacing:-.03em;color:var(--white);max-width:760px;margin-top:24px}
  .hero__intro:empty{display:none}
  .hero__intro{font-size:var(--fs-intro);line-height:1.65;color:var(--on-ink);
    max-width:560px;margin-top:28px}
  .hero__intro b{font-weight:700;color:var(--white)}
  .hero__corps .sb{margin-top:32px}

  /* ═══ Le « + » qui ouvre la composition ═══ */
  /*
    UN « + » ET PAS UNE FLECHE. C'est le signe de revelation du site - il ouvre
    les tuiles, les principes, les cartes de Language. L'employer ici dit la
    meme chose : il y a quelque chose dessous, et c'est toi qui l'ouvres.

    IL ARRIVE APRES COUP, a 2,4s. Pose d'emblee il entrerait en concurrence
    avec le titre ; arrive une fois la page lue, il se remarque. L'apparition
    est un fondu, pas un rebond : le rebond reclame l'attention en continu, et
    ce n'est pas ce qu'on demande a une invitation.
  */
  .hero__defiler{position:relative;z-index:1;display:flex;justify-content:center;
    padding-bottom:var(--sp-09);color:var(--on-ink-eyebrow);transition:color .25s ease}
  .hero__defiler:hover{color:var(--yellow)}
  .hero__defiler:focus-visible{outline:3px solid var(--yellow);outline-offset:4px}
  .hero__defiler-icone{display:block;opacity:0;
    animation:parait .9s cubic-bezier(.16,1,.3,1) 2.4s both;
    transition:transform .45s cubic-bezier(.2,.7,.2,1)}
  @keyframes parait{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
  /* Pivote en x comme partout ailleurs : le contenu est revele. */
  .hero__defiler:hover .hero__defiler-icone,
  .hero__defiler:focus-visible .hero__defiler-icone,
  .hero__defiler.ouvert .hero__defiler-icone{transform:rotate(45deg)}

  /* ═══ Filigrane ═══ */
  /* height:auto + viewBox mesure = mise a l'echelle uniforme pleine largeur.
     Voir src/scripts/filigrane.ts pour le pourquoi de la mesure. */
  .hero__filigrane{position:absolute;left:0;bottom:0;z-index:0;
    display:block;width:100%;height:auto;pointer-events:none;user-select:none}
  .hero__filigrane text{font-family:var(--display);font-weight:900;
    letter-spacing:-.045em;fill:rgba(255,255,255,.07)}

  /* ═══ Barre mobile ═══ */
  .hero__barre{display:none}
  .hamb{display:flex;flex-direction:column;justify-content:center;gap:5px;
    width:64px;height:100%;padding:0 20px;background:none;border:none;cursor:pointer}
  /* trois barres a angles droits (BRIEF §11) */
  .hamb span{display:block;width:24px;height:2.5px;background:var(--text);border-radius:0}

  @media(max-width:720px){
    .hero{min-height:0;margin-bottom:0;--chrome-h:64px}
    .hero__defiler{padding-bottom:var(--sp-12)}
    .hero__nav{display:none}
    /* La barre touche le haut de l'ecran et le hero ; le filet de 2px court
       sous toute sa largeur, et un second separe le bloc jaune. */
    .hero__barre{display:grid;grid-template-columns:1fr auto;align-items:stretch;
      height:64px;background:var(--white);border-bottom:var(--rule) solid var(--text)}
    .hero__cv{display:inline-flex;align-items:center;gap:8px;height:100%;padding:0 16px;
      background:var(--yellow);color:var(--text);text-decoration:none;
      border-left:var(--rule) solid var(--text);
      font-family:var(--display);font-weight:700;font-size:var(--fs-body-s)}
    .hero__cv:active{opacity:.85}
    .hero__corps{padding-top:var(--sp-14);padding-bottom:var(--sp-18)}
    .hero__corps--portrait{display:block}
    .hero__titre{font-size:var(--fs-h1-mob);max-width:none;margin-top:0}
    .hero__intro{font-size:var(--fs-body);max-width:none}
    /*
      L'accueil descend a 36px la ou les pages interieures tiennent a 44px :
      son titre fait deux phrases quand les autres en font une. Valeur de
      MainMobile.dc.html, qui prime sur le 44px du tableau du §1.
    */
    .hero--accueil .hero__titre{font-size:36px;line-height:1.02}
    /* La signature reprend sa place : sous l'intro, avatar a gauche, nom et
       eyebrow empiles a droite (BRIEF §11). */
    .hero__signature{order:3;margin-top:var(--sp-03)}
    /*
      L'accueil n'a pas de CTA dans le hero sous 720px : le bloc jaune
      « Download CV » de la barre le porte deja, et le brief (§11) range la
      signature juste apres l'intro. Deux fois le meme bouton a 150px d'ecart
      ne serait pas une insistance, ce serait un doublon.
      Les pages interieures gardent le leur : elles n'ont pas ce bloc jaune.
    */
    .hero--accueil .hero__texte > .sb{display:none}
    .hero__avatar{display:block;width:56px;height:56px;flex:none;border-radius:50%;
      background:var(--portrait) center/cover no-repeat}
    .hero__nom{display:block;font-family:var(--display);font-weight:900;
      font-size:22px;line-height:1.1;color:var(--white)}
    .hero__eyebrow{font-size:10px}
    .hero__media{display:none}
    /* Pas de filigrane sur mobile (BRIEF §11) */
    .hero__filigrane{display:none}
    .hero__portrait{width:56px;height:56px;border-radius:50%;
      background:var(--portrait) center/cover no-repeat;margin-bottom:var(--sp-03)}
  }
  @media(min-width:721px){
    .hero__portrait{display:none}
  }

  /* ═══ Menu mobile plein ecran ═══ */
  /*
    overflow-y:auto : sur un telephone bas, ou avec une taille de police systeme
    agrandie, les huit entrees et les trois boutons peuvent depasser - et un
    panneau plein ecran qui deborde sans defiler rend ses derniers liens
    inatteignables.
  */
  .mobmenu{display:none}
  .mobmenu.open{display:flex;position:fixed;inset:0;z-index:60;background:var(--ink);
    flex-direction:column;justify-content:center;gap:4px;padding:28px;overflow-y:auto}
  .mobmenu > a,.mobmenu__groupe > a{color:var(--white);text-decoration:none;
    font-family:var(--display);font-weight:900;font-size:clamp(18px,5vw,26px);
    letter-spacing:-.02em;padding:6px 0}
  .mobmenu > a[aria-current="page"],.mobmenu__groupe > a[aria-current="page"]{color:var(--yellow)}
  .mobmenu__groupe{display:flex;flex-direction:column;width:max-content;max-width:100%}
  .mobmenu__eyebrow{margin:18px 0 0;font-size:var(--fs-eyebrow);font-weight:700;
    letter-spacing:.2em;text-transform:uppercase;color:var(--on-ink-eyebrow)}
  .mobmenu__rule{width:100%;height:var(--rule);margin:8px 0 10px;border:0;background:rgba(255,255,255,.18)}
  .mobmenu__liens{display:flex;flex-direction:column;align-items:flex-start;gap:2px}
  .mobmenu__close{position:absolute;top:16px;left:16px;background:transparent;border:none;
    color:var(--white);font-size:32px;line-height:1;cursor:pointer}

  @media(prefers-reduced-motion:reduce){
    .hero__liens a{transition:none}
    /* Sans mouvement, le « + » est simplement la - il ne doit pas rester
       invisible parce que son animation d'apparition ne tourne pas. */
    .hero__defiler-icone{animation:none;opacity:1;transition:none}
  }
</style>
