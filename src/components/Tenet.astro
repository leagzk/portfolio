---
/*
  Une conviction du manifeste. Six instances dans /philosophy.

  On mutualise l'echafaudage - le grand chiffre, l'eyebrow, le titre - et on
  laisse le corps en slot. Ce corps est de la prose editoriale avec du <b> et
  du <em> : la passer en chaine HTML dans un tableau ferait perdre la coloration
  syntaxique et rendrait la relecture penible, pour un gain de lignes marginal.

  Le chiffre est repris tel quel dans data-num, que le CSS reinjecte sous 900px
  via .tenet__idx::before{content:attr(data-num) " - "} : sous ce seuil le grand
  chiffre disparait et l'eyebrow devient "01 - The premise".
*/
export interface Props {
  /** deux chiffres, "01" a "06" */
  num: string;
  /** court intitule : "The premise", "The method"... ; omis, l'eyebrow ne porte que le chiffre */
  idx?: string;
  title: string;
  /** ancre du principe, posee sur le <h2> : cible des liens de <ChapterTabs> */
  id?: string;
}
const { num, idx, title, id } = Astro.props;
---
<article class="tenet">
  <div class="tenet__lead">
    <span class="tenet__num" aria-hidden="true">{num}</span>
    <div class="tenet__head">
      <span class="tenet__idx" data-num={num}>{idx}</span>
      <h2 class="tenet__title" id={id}>{title}</h2>
    </div>
  </div>
  <div class="tenet__body">
    <slot />
  </div>
</article>

<style is:global>
  /*
    Ces regles vivaient dans philosophy.astro, donc le composant rendait du
    markup nu partout ailleurs. Elles descendent ici : Astro les emet avec
    toute page qui importe Tenet, et seulement celles-la.

    is:global et non scope : le corps arrive par <slot />, donc ecrit dans la
    page appelante, et un style scope d'Astro ne franchit pas cette frontiere -
    .tenet__body p ne matcherait jamais.
  */
  .tenet{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(60px,6.5vw,88px);padding:var(--sp-19) 0;border-top:1px solid var(--line)}
  .tenet:first-of-type{border-top:none;padding-top:0}
  .tenet__lead{position:relative;display:flex;align-items:stretch;gap:var(--sp-02)}
  .tenet__num{flex:none;width:2ch;font-family:var(--display);font-weight:400;font-size:clamp(48px,6vw,72px);line-height:1;font-variant-numeric:tabular-nums;color:var(--accent);margin-top:-.11em}
  .tenet__head{flex:1;min-width:0}
  .tenet__idx{font-family:var(--display);font-weight:400;font-size:12px;line-height:1;margin-top:-.125em;letter-spacing:.16em;color:var(--accent);display:block}
  .tenet__title{font-family:var(--display);font-weight:400;font-size:clamp(20px,2.2vw,28px);line-height:1.12;letter-spacing:-.02em;color:var(--ink);margin-top:12px;hyphens:none}
  .tenet__body{font-size:clamp(16px,1.6vw,20px);color:var(--ink-soft);max-width:60ch}
  .tenet__body + .tenet__body{margin-top:1em}
  .tenet__body p + p{margin-top:1.15em}
  .tenet__body b{color:var(--ink);font-weight:700}
  .tenet__body em{font-style:italic;color:var(--ink)}
  .js .tenet{opacity:0;transform:translateY(16px)}
  .js .tenet.in{opacity:1;transform:none;transition:opacity .6s ease,transform .6s cubic-bezier(.22,1,.36,1)}
  .js .tenet__num{opacity:0;transform:translateX(-16px) scale(.96);transform-origin:left center}
  .js .tenet__idx{opacity:0;transform:translateY(8px)}
  .js .tenet__title{opacity:0;transform:translateY(12px)}
  .js .tenet.in .tenet__num{opacity:1;transform:none;transition:opacity .7s ease .08s,transform .7s cubic-bezier(.22,1,.36,1) .08s}
  .js .tenet.in .tenet__idx{opacity:1;transform:none;transition:opacity .6s ease .24s,transform .6s cubic-bezier(.22,1,.36,1) .24s}
  .js .tenet.in .tenet__title{opacity:1;transform:none;transition:opacity .6s ease .36s,transform .6s cubic-bezier(.22,1,.36,1) .36s}
  /* palier harmonise : etait 880px, aligne sur le 900px de system-event */
  @media(max-width:900px){
  .tenet{grid-template-columns:1fr;gap:clamp(40px,6vw,48px)}
  .tenet__lead{display:block}
  .tenet__num{display:none}
  .tenet__idx::before{content:attr(data-num) " · "}
  .tenet__title{margin-top:8px;line-height:1.2}
}
  @media(prefers-reduced-motion:reduce){
  .js .tenet{opacity:1;transform:none}
  .js .tenet__num,.js .tenet__idx,.js .tenet__title{opacity:1;transform:none;transition:none}
}
  /*
    Sans intitule, l'eyebrow ferait doublon avec le grand chiffre pose a cote :
    on l'efface plutot que de laisser une ligne vide de 12px pousser le titre.
    Sous 900px le grand chiffre disparait, et c'est l'eyebrow qui reprend le
    numero - meme role que le ::before ci-dessus, sans le separateur qui
    pendrait dans le vide faute d'intitule.

    :empty ajoute un cran de specificite, ces deux regles l'emportent donc sur
    leurs equivalents sans pseudo-classe quel que soit l'ordre du bundle.
  */
  .tenet__idx:empty{display:none}
  @media(max-width:900px){
    .tenet__idx:empty{display:block}
    .tenet__idx:empty::before{content:attr(data-num)}
  }
</style>
