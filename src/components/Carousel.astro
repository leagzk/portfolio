---
/*
  Carrousel de surfaces.

  Le markup etait ecrit a la main : sept <li> d'un cote, sept <button> de
  pagination de l'autre, sans rien qui relie les deux. Ajouter une image
  supposait de modifier les deux listes au bon endroit, et rien ne signalait
  l'oubli - les pastilles pouvaient silencieusement ne plus correspondre aux
  vignettes. Ici les pastilles sont derivees de `slides` : le nombre ne peut
  plus diverger.

  Le CSS (.ls-carousel*, .ls-dot) vit dans src/styles/case-study.css, importe
  par les pages de case study. Il y a ete descendu depuis system-event.astro
  avec ses surcharges de theme, ce qui rend le composant utilisable ailleurs :
  un <style> scope ici ne traverserait pas la frontiere du slot de toute facon.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Slide {
  /**
   * Image importee depuis src/assets, pas un chemin en chaine : les dimensions
   * viennent du fichier et une image manquante casse le build au lieu de
   * produire un 404 silencieux en production.
   */
  src: ImageMetadata;
  /** texte alternatif descriptif - jamais vide, ces images portent du sens */
  alt: string;
  /** legende visible sous la vignette */
  caption: string;
}

export interface Props {
  id: string;
  /** aria-label du groupe de pastilles */
  label: string;
  /** prefixe des pastilles : "Surface" donne aria-label="Surface 1" */
  itemLabel?: string;
  /** vignette centree a l'ouverture ; ses voisines sont rognees, ce qui signale qu'on peut defiler */
  start?: number;
  /*
    Largeur d'AFFICHAGE d'une vignette. Le defaut vaut pour les photos portrait
    de /system-event. Une vignette paysage occupe beaucoup plus large a hauteur
    egale - .ls-carousel__fig img fixe la hauteur et laisse filer la largeur -
    et garder ce defaut ferait telecharger une image deux fois trop petite,
    donc floue. A recalculer des que le ratio des visuels change.
  */
  sizes?: string;
  /*
    Vignettes paysage. Par defaut c'est la HAUTEUR qui est fixee et la largeur
    qui suit le ratio - juste pour des portraits, ruineux pour du 16/9 : sur un
    ecran de 375px une vignette fait alors 498px de large, et on ne voit jamais
    une image entiere, seulement un fragment de chacune. Ce drapeau inverse le
    pilote sous 720px : la largeur se cale sur l'ecran, la hauteur suit.
  */
  wide?: boolean;
  /*
    Carrousel tenu DANS la colonne, au lieu de saigner d'un bord a l'autre.

    Le defaut de ce composant est le plein cadre : `margin:0 calc(50% - 50vw)` +
    `width:100vw`, avec un padding lateral en --bleed-pad pour que la premiere
    vignette reste calee sur la colonne de texte pendant que la serie file hors
    ecran. C'est juste pour un carrousel qui occupe toute la largeur, et ruineux
    des qu'on en met deux cote a cote : chacun deborderait sur l'autre et sur les
    marges de la page.
    La variante rend la largeur au conteneur et cale la vignette sur LUI - c'est
    alors la colonne qui decide, pas la fenetre.
  */
  colonne?: boolean;
  slides: Slide[];
}

const {
  id,
  label,
  itemLabel = 'Item',
  start = 0,
  sizes = '(min-width: 900px) 340px, 60vw',
  wide = false,
  colonne = false,
  slides,
} = Astro.props;
---
<div class:list={['ls-carousel', wide && 'ls-carousel--wide', colonne && 'ls-carousel--col']}>
  <ul class="ls-carousel__track" id={id} data-start={start}>
    {slides.map((s) => (
      <li class="ls-carousel__slide">
        <figure class="ls-carousel__fig">
          {/*
            sizes decrit la largeur d'AFFICHAGE, pas celle du fichier. Sans cette
            indication le navigateur suppose 100vw et telecharge trop gros ; avec
            une valeur trop basse il telecharge trop petit et l'image est floue.
            Voir la prop du meme nom.
          */}
          <Image
            src={s.src}
            alt={s.alt}
            layout="constrained"
            sizes={sizes}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{s.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
  <div class="ls-carousel__dots" role="group" aria-label={label}>
    {slides.map((_, i) => (
      <button
        class="ls-dot"
        type="button"
        aria-label={`${itemLabel} ${i + 1}`}
        aria-current={i === start ? 'true' : undefined}
      ></button>
    ))}
  </div>
</div>

<script>
  /*
    Le composant se cable lui-meme, comme <Equations> pose son propre reveal.
    Les deux pages qui l'utilisent repetaient sinon le meme bloc d'amorcage -
    getElementById, garde, memes options - et ne le repetaient deja pas tout a
    fait pareil : l'une cherchait ses pastilles dans le document entier, ce qui
    aurait croise les series le jour ou une page en porterait deux. La recherche
    part donc de la piste, et l'`id` de la prop n'a plus a servir de crochet.

    Astro n'emet ce script qu'une fois par page, quel que soit le nombre
    d'instances : d'ou la boucle sur toutes les pistes plutot qu'un seul element.
    `data-start` porte la vignette d'ouverture - c'est la meme valeur que celle
    qui pose aria-current au build, donc les deux ne peuvent pas diverger.
  */
  import { carrousel, ARC_VIGNETTE } from '../scripts/carousel';

  document.querySelectorAll<HTMLElement>('.ls-carousel__track').forEach((piste) => {
    carrousel(piste, {
      slides: '.ls-carousel__slide',
      dots: [...(piste.parentElement?.querySelectorAll<HTMLElement>('.ls-carousel__dots .ls-dot') ?? [])],
      arc: ARC_VIGNETTE,
      depart: Number(piste.dataset.start ?? 0),
    });
  });
</script>
